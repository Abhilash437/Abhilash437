extra_labels = np.arange(remainder)\n        community_labels = np.concatenate([extra_labels, community_labels])\n    rng.shuffle(community_labels)\n\n    adjacency = np.zeros((n_nodes, n_nodes))\n    for i in range(n_nodes):\n        for j in range(i + 1, n_nodes):\n            same_community = (community_labels[i] == community_labels[j])\n            p_edge = p_in if same_community else p_out\n            if rng.rand() < p_edge:\n                adjacency[i, j] = 1\n                adjacency[j, i] = 1\n\n    return community_labels, adjacency\n\ndef add_temporal_drift(p_in_base, p_out_base, t, T_max, drift_type='none'):\n    \"\"\"Add temporal dynamics to SBM edge probabilities.\"\"\"\n    if drift_type == 'none':\n        return p_in_base, p_out_base\n    elif drift_type == 'periodic':\n        phase = 2 * np.pi * t / T_max\n        p_in_t = p_in_base + 0.3 * p_in_base * np.sin(phase)\n        p_out_t = p_out_base + 0.3 * p_out_base * np.sin(phase)\n    elif drift_type == 'linear':\n        trend = (t / T_max)\n        p_in_t = p_in_base * (1 - 0.05 * trend)\n        p_out_t = p_out_base * (1 + 0.10 * trend)\n    else:\n        raise ValueError(f'Unknown drift_type: {drift_type}')\n\n    return np.clip(p_in_t, 0, 1), np.clip(p_out_t, 0, 1)\n\ndef generate_graph_sequence(n_nodes, n_communities, p_in_base, p_out_base,\n                           sequence_length, drift_type='none',\n                           switch_prob=0.05, persistence=0.3, seed=42):\n    \"\"\"\n    Enhanced version: Adds Dynamic Communities and Edge Persistence.\n    \"\"\"\n    rng = np.random.RandomState(seed)\n\n    # Initial community assignment\n    nodes_per_community = n_nodes // n_communities\n    community_labels = np.repeat(np.arange(n_communities), nodes_per_community)\n    if n_nodes % n_communities > 0:\n        community_labels = np.concatenate([community_labels, np.arange(n_nodes % n_communities)])\n    rng.shuffle(community_labels)\n\n    adjacencies = []\n    prev_adj = np.zeros((n_nodes, n_nodes)) # Track previous state for persistence\n\n    for t in range(sequence_length):\n        # --- NEW: Dynamic Community Membership ---\n        # Nodes switch communities with a small probability\n        for i in range(n_nodes):\n            if rng.rand() < switch_prob:\n                community_labels[i] = rng.randint(0, n_communities)\n\n        p_in, p_out = add_temporal_drift(p_in_base, p_out_base, t, sequence_length, drift_type=drift_type)\n\n        adjacency = np.zeros((n_nodes, n_nodes))\n        for i in range(n_nodes):\n            for j in range(i + 1, n_nodes):\n                same_community = (community_labels[i] == community_labels[j])\n                p_base = p_in if same_community else p_out\n\n                # --- NEW: Edge Persistence ---\n                # If an edge existed at t-1, it's much more likely to exist at t\n                if prev_adj[i, j] == 1:\n                    p_final = p_base + (1 - p_base) * persistence\n                else:\n                    p_final = p_base * (1 - persistence)\n\n                # Base edge sampling\n                edge = 1 if rng.rand() < p_final else 0\n\n                # --- NEW: Noise injection ---\n                if rng.rand() < 0.02:  # 2% noise\n                    edge = 1 - edge  # flip\n\n                adjacency[i, j] = edge\n                adjacency[j, i] = edge\n\n        adjacencies.append(adjacency)\n        prev_adj = adjacency # Update history\n\n    return community_labels, adjacencies","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T14:59:57.757638Z","iopub.execute_input":"2026-05-18T14:59:57.758060Z","iopub.status.idle":"2026-05-18T14:59:57.771317Z","shell.execute_reply.started":"2026-05-18T14:59:57.758024Z","shell.execute_reply":"2026-05-18T14:59:57.770567Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# SBM Variants\nSBM_VARIANTS = {\n    'SBM-Dynamic-Hard': {\n        'n_nodes': 100,\n        'n_communities': 4,\n        'p_in': 0.30,\n        'p_out': 0.05,\n        'drift_type': 'periodic',\n        'switch_prob': 0.25,   # High rate of nodes switching communities\n        'persistence': 0.3     # Strong temporal correlation\n    },\n    'SBM-Signal-Strong': {\n        'n_nodes': 100,\n        'n_communities': 3,\n        'p_in': 0.35,\n        'p_out': 0.01,\n        'drift_type': 'none',\n        'switch_prob': 0.02,\n        'persistence': 0.9\n    },\n\n    'SBM-Signal-Medium': {\n        'n_nodes': 100,\n        'n_communities': 3,\n        'p_in': 0.30,\n        'p_out': 0.05,\n        'drift_type': 'periodic',\n        'switch_prob': 0.10,\n        'persistence': 0.6\n    }\n}\n\nSEQUENCE_LENGTH = 100\nN_SEEDS = 5\n\nprint(f\"Generating {len(SBM_VARIANTS)} variants × {N_SEEDS} seeds = {len(SBM_VARIANTS) * N_SEEDS} sequences\\n\")\n\nfor variant_name, params in SBM_VARIANTS.items():\n    print(f\"Variant: {variant_name}\")\n    print(f\"  Nodes: {params['n_nodes']}, Communities: {params['n_communities']}\")\n    print(f\"  p_in: {params['p_in']}, p_out: {params['p_out']}, drift: {params['drift_type']}\")\n\n    variant_dir = DATA_DIR / variant_name\n    variant_dir.mkdir(parents=True, exist_ok=True)\n\n    for seed in range(N_SEEDS):\n        seed_dir = variant_dir / f'seed_{seed}'\n        seed_dir.mkdir(parents=True, exist_ok=True)\n\n        # Generate sequence\n        labels, sequences = generate_graph_sequence(\n            n_nodes=params['n_nodes'],\n            n_communities=params['n_communities'],\n            p_in_base=params['p_in'],\n            p_out_base=params['p_out'],\n            sequence_length=SEQUENCE_LENGTH,\n            drift_type=params['drift_type'],\n            seed=seed + 1000 * hash(variant_name) % 10000\n        )\n\n        # Save\n        adj_tensor = torch.from_numpy(np.array(sequences, dtype=np.float32))\n        torch.save(adj_tensor, seed_dir / 'graphs.pt')\n        np.save(seed_dir / 'community_labels.npy', labels)\n\n        edge_counts = [int(np.sum(adj) // 2) for adj in sequences]\n        meta = {\n            'variant': variant_name, 'seed': seed,\n            'n_nodes': params['n_nodes'], 'n_communities': params['n_communities'],\n            'p_in': params['p_in'], 'p_out': params['p_out'],\n            'drift_type': params['drift_type'], 'edge_counts': edge_counts\n        }\n        with open(seed_dir / 'meta.json', 'w') as f:\n            json.dump(meta, f, indent=2)\n\n        print(f\"  Seed {seed}: edges {min(edge_counts)}–{max(edge_counts)}\")\n\nprint(f\"\\nData generation complete!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:00:29.461312Z","iopub.execute_input":"2026-05-18T15:00:29.461842Z","iopub.status.idle":"2026-05-18T15:00:42.281263Z","shell.execute_reply.started":"2026-05-18T15:00:29.461810Z","shell.execute_reply":"2026-05-18T15:00:42.280537Z"}},"outputs":[{"name":"stdout","text":"Generating 3 variants × 5 seeds = 15 sequences\n\nVariant: SBM-Dynamic-Hard\n  Nodes: 100, Communities: 4\n  p_in: 0.3, p_out: 0.05, drift: periodic\n  Seed 0: edges 472–844\n  Seed 1: edges 465–882\n  Seed 2: edges 466–852\n  Seed 3: edges 481–874\n  Seed 4: edges 470–880\nVariant: SBM-Signal-Strong\n  Nodes: 100, Communities: 3\n  p_in: 0.35, p_out: 0.01, drift: none\n  Seed 0: edges 517–776\n  Seed 1: edges 493–762\n  Seed 2: edges 451–790\n  Seed 3: edges 505–756\n  Seed 4: edges 512–762\nVariant: SBM-Signal-Medium\n  Nodes: 100, Communities: 3\n  p_in: 0.3, p_out: 0.05, drift: periodic\n  Seed 0: edges 496–974\n  Seed 1: edges 514–985\n  Seed 2: edges 556–982\n  Seed 3: edges 517–983\n  Seed 4: edges 547–975\n\nData generation complete!\n","output_type":"stream"}],"execution_count":6},{"cell_type":"code","source":"# GNN Encoder and Decoder\nclass GraphEncoder(nn.Module):\n    \"\"\"GCN Encoder: Graph to Latent Vector\n\n    Parameters\n    ----------\n    latent_dim  : int  — size of output latent vector z\n    hidden_dim  : int  — GCN hidden dimension\n    in_channels : int  — number of input node features.\n                         Use 1 for SBM (degree only).\n                         Use 3 for JODIE (degree, norm_degree, node_type).\n    n_users     : int  — number of user nodes, used only when in_channels=3\n                         to compute the bipartite node-type indicator.\n                         Set to num_nodes // 2 if unknown.\n    \"\"\"\n\n    def __init__(self, latent_dim=32, hidden_dim=64, in_channels=1, n_users=None):\n        super().__init__()\n        self.latent_dim  = latent_dim\n        self.in_channels = in_channels\n        self.n_users     = n_users          # only used when in_channels=3\n        self.gc1 = GCNConv(in_channels, hidden_dim)\n        self.gc2 = GCNConv(hidden_dim, hidden_dim)\n        self.fc  = nn.Linear(hidden_dim, latent_dim)\n\n    def forward(self, edge_index, num_nodes, x=None):\n        if edge_index.numel() == 0:\n            return torch.zeros((1, self.latent_dim), device=edge_index.device)\n        if x is None:\n            # raw degree\n            deg  = torch.zeros(num_nodes, device=edge_index.device)\n            ones = torch.ones(edge_index.shape[1], device=edge_index.device)\n            deg.scatter_add_(0, edge_index[0], ones)   # (num_nodes,)\n\n            if self.in_channels == 1:\n                x = deg.unsqueeze(1)                   # (num_nodes, 1)\n\n            else:\n                # Normalised degree\n                # Captures relative activity within the snapshot.\n                # A node with the highest degree gets value 1.0; isolated\n                # nodes get 0.0. Varies more than raw degree across snapshots.\n                max_deg  = deg.max().clamp(min=1.0)\n                norm_deg = deg / max_deg               # (num_nodes,)\n\n                # Bipartite node-type indicator\n                # This is free structural information from the index layout.\n                # It tells the GCN which side of the bipartite graph each\n                # node belongs to, so messages are interpreted correctly.\n                n_u       = self.n_users if self.n_users is not None else num_nodes // 2\n                node_type = torch.zeros(num_nodes, device=edge_index.device)\n                node_type[n_u:] = 1.0                  # (num_nodes,)\n\n                # Stack into (num_nodes, 3)\n                x = torch.stack([deg, norm_deg, node_type], dim=1)\n\n        h = F.relu(self.gc1(x, edge_index))\n        h = F.relu(self.gc2(h, edge_index))\n\n        # Global mean pooling: average node embeddings to graph embedding\n        z = h.mean(dim=0, keepdim=True)   # (1, hidden_dim)\n        z = self.fc(z)                     # (1, latent_dim)\n        return z\n\n\nclass GraphDecoder(nn.Module):\n    \"\"\"MLP Decoder: Latent Vector to Edge Probabilities\"\"\"\n\n    def __init__(self, latent_dim=32, n_nodes=100, hidden_dim=64):\n        super().__init__()\n        self.n_nodes = n_nodes\n        self.n_edges = n_nodes * (n_nodes - 1) // 2\n\n        self.net = nn.Sequential(\n            nn.Linear(latent_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, self.n_edges)\n        )\n\n    def forward(self, z):\n        edges = self.net(z)  # (batch, n_edges)\n        return edges\n\n    def reconstruct_adjacency(self, z):\n        \"\"\"Reconstruct full adjacency matrix from latent vector.\"\"\"\n        edges = self.forward(z).squeeze(0)  # (n_edges,)\n\n        # Fill upper triangle\n        adj = torch.zeros(self.n_nodes, self.n_nodes, device=z.device)\n        triu_idx = torch.triu_indices(self.n_nodes, self.n_nodes, offset=1).to(DEVICE)\n        adj[triu_idx[0], triu_idx[1]] = edges\n        adj = adj + adj.t()\n        return adj # These are now raw logits\n\n\nprint(\"Encoder and Decoder classes defined\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:00:42.282278Z","iopub.execute_input":"2026-05-18T15:00:42.282668Z","iopub.status.idle":"2026-05-18T15:00:42.295876Z","shell.execute_reply.started":"2026-05-18T15:00:42.282636Z","shell.execute_reply":"2026-05-18T15:00:42.295263Z"}},"outputs":[{"name":"stdout","text":"Encoder and Decoder classes defined\n","output_type":"stream"}],"execution_count":7},{"cell_type":"code","source":"# Training of encoder and decoder\n\nLATENT_DIMS = [16, 32, 64, 128]\nENCODER_EPOCHS = 100\nENCODER_LR = 1e-3\n\n# Group variants by n_nodes to determine which encoder-decoders we need\nUNIQUE_N_NODES = sorted(set(params['n_nodes'] for params in SBM_VARIANTS.values()))\nprint(f\"Unique n_nodes values: {UNIQUE_N_NODES}\")\n\n# Map each variant to its n_nodes (for later use in encoding/evaluation)\nVARIANT_TO_N_NODES = {name: params['n_nodes'] for name, params in SBM_VARIANTS.items()}\n\ndef train_encoder_decoder(n_nodes, latent_dim, train_graphs, n_epochs=30, lr=1e-3):\n    \"\"\"Train encoder-decoder for graphs with n_nodes nodes.\"\"\"\n    enc = GraphEncoder(latent_dim=latent_dim).to(DEVICE)\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n\n    optimizer = Adam(list(enc.parameters()) + list(dec.parameters()), lr=lr)\n\n    enc.train()\n    dec.train()\n\n    for epoch in range(n_epochs):\n        total_loss = 0\n        for adj_t in train_graphs:\n            adj_t = adj_t.to(DEVICE)\n            edge_index = torch.from_numpy(np.array(np.where(adj_t.cpu().numpy()))).long().to(DEVICE)\n\n            z = enc(edge_index, num_nodes=n_nodes)\n            # Inside train_encoder_decoder loop:\n            adj_pred = dec.reconstruct_adjacency(z)\n\n            num_ones = adj_t.sum()\n            num_zeros = adj_t.numel() - num_ones\n            # Proper weight: how many times more non-edges there are than edges\n            pw_val = max((num_zeros / num_ones).item() if num_ones > 0 else 1.0, 10.0)\n\n            loss = F.binary_cross_entropy_with_logits(\n                adj_pred, adj_t, pos_weight=torch.tensor([pw_val], device=DEVICE)\n            )\n\n            optimizer.zero_grad()\n            loss.backward()\n            optimizer.step()\n            total_loss += loss.item()\n\n        if (epoch + 1) % 10 == 0:\n            print(f\"    Epoch {epoch+1}/{n_epochs}, Loss: {total_loss/len(train_graphs):.4f}\")\n\n    return enc.eval(), dec.eval()\n\n\n# Co-training of encoder-Koopman-decoder -> By default this is not enabled, \n# this is used as an abalation study, enable this for the co-training results only\n# Key idea: instead of training encoder purely for reconstruction,\n# we add a dynamics loss that forces z_{t+1} ≈ K·z_t in latent space.\n# The encoder now has TWO objectives simultaneously:\n#   1. L_recon  = BCEWithLogits between decoded adj and true adj\n#   2. L_dynamics = ||z_{t+1} - K·z_t||^2  (latent linearity)\n#   3. L_spectral = ReLU(|λ_max(K)| - 1)^2  (stability)\n\n# ==============================================================\n# PATCHED: train_encoder_decoder_cotrain\n# Change from original: collects variance_log = [(epoch, z_var)]\n# at every epoch, and returns it as a 4th value.\n# ==============================================================\n\ndef train_encoder_decoder_cotrain(n_nodes, latent_dim, train_graph_sequences,\n                                   alpha=1.0, beta=0.1, gamma=0.1, delta=2.0,\n                                   in_channels=1, n_users=None,\n                                   n_epochs=50, lr=1e-3):\n    enc = GraphEncoder(latent_dim=latent_dim,\n                       in_channels=in_channels,\n                       n_users=n_users).to(DEVICE)\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    K   = nn.Linear(latent_dim, latent_dim, bias=False).to(DEVICE)\n\n    optimizer = Adam(\n        list(enc.parameters()) + list(dec.parameters()) + list(K.parameters()),\n        lr=lr\n    )\n\n    T = len(train_graph_sequences)\n\n    variance_log = []   # list of floats, index = epoch number\n\n    for epoch in range(n_epochs):\n        enc.train(); dec.train(); K.train()\n        total_recon, total_dyn, total_spec, total_collapse = 0.0, 0.0, 0.0, 0.0\n\n        z_all = []\n        for t in range(T):\n            adj_t = train_graph_sequences[t].to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy()))\n            ).long().to(DEVICE)\n            z_t = enc(edge_index, num_nodes=n_nodes)\n            z_all.append(z_t)\n\n        z_seq = torch.cat(z_all, dim=0)   # (T, latent_dim)\n\n        l_recon = torch.tensor(0.0, device=DEVICE)\n        for t in range(T):\n            adj_t    = train_graph_sequences[t].to(DEVICE)\n            adj_pred = dec.reconstruct_adjacency(z_seq[t].unsqueeze(0))\n            num_ones  = adj_t.sum()\n            num_zeros = adj_t.numel() - num_ones\n            pw_val    = (num_zeros / num_ones) if num_ones > 0 else 1.0\n            l_recon  += F.binary_cross_entropy_with_logits(\n                adj_pred, adj_t,\n                pos_weight=torch.tensor([pw_val], device=DEVICE)\n            )\n        l_recon = l_recon / T\n\n        z_pred_next   = K(z_seq[:-1])\n        z_actual_next = z_seq[1:]\n        l_dynamics    = F.mse_loss(z_pred_next, z_actual_next)\n\n        z_seq_centered = z_seq - z_seq.mean(dim=0, keepdim=True)\n        z_scale        = z_seq.detach().pow(2).mean().clamp(min=1e-6)\n        threshold      = 0.01 * z_scale\n        l_collapse     = torch.relu(threshold - z_seq_centered.var(dim=0)).mean()\n\n        evals      = torch.linalg.eigvals(K.weight)\n        l_spectral = torch.relu(torch.max(torch.abs(evals)) - 1.0) ** 2\n\n        loss = alpha * l_recon + beta * l_dynamics + gamma * l_spectral + delta * l_collapse\n\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n\n        total_recon    += l_recon.item()\n        total_dyn      += l_dynamics.item()\n        total_spec     += l_spectral.item()\n        total_collapse += l_collapse.item()\n\n        with torch.no_grad():\n            z_var = z_seq_centered.var(dim=0).mean().item()\n        variance_log.append(z_var)   # index = epoch\n\n        if (epoch + 1) % 10 == 0:\n            print(f\"    Epoch {epoch+1}/{n_epochs} | \"\n                  f\"Recon: {total_recon:.4f}  \"\n                  f\"Dyn: {total_dyn:.4f}  \"\n                  f\"Spec: {total_spec:.6f}  \"\n                  f\"Collapse: {l_collapse.item():.6f}  \"\n                  f\"LatentVar: {z_var:.4f}\")\n\n    return enc.eval(), dec.eval(), K.eval(), variance_log\n\n# Set USE_COTRAIN = False to reproduce the original two-stage results\n# Set USE_COTRAIN = True to run Step 3 co-training\nUSE_COTRAIN = False  # <--- change this to enable co-training\n\n# Co-training weight configurations to ablate\nCOTRAIN_CONFIGS = {\n    'recon_only':       dict(alpha=1.0, beta=0.0,  gamma=0.0,  delta=0.0),\n    'cotrain_balanced': dict(alpha=1.0, beta=0.1,  gamma=0.1,  delta=2.0),\n    'dynamics_heavy':   dict(alpha=0.5, beta=0.3,  gamma=0.1,  delta=2.0),\n}\n\nACTIVE_CONFIG_NAME = 'cotrain_balanced'\nACTIVE_CONFIG      = COTRAIN_CONFIGS[ACTIVE_CONFIG_NAME]\n\nprint(f\"Training mode: {'CO-TRAIN' if USE_COTRAIN else 'TWO-STAGE'}\")\nif USE_COTRAIN:\n    print(f\"Active config: {ACTIVE_CONFIG_NAME} → {ACTIVE_CONFIG}\")\n\nconfig_tag = ACTIVE_CONFIG_NAME if USE_COTRAIN else 'two_stage'\n# Training loop\nprint(f\"\\nTraining encoder-decoder for {len(UNIQUE_N_NODES)} n_nodes groups × {len(LATENT_DIMS)} latent dimensions...\\n\")\n\ntrained_encoders  = {}\ntrained_decoders  = {}\ntrained_K_cotrain = {}  # only populated when USE_COTRAIN=True\nsbm_variance_logs = {}\n\nfor n_nodes in UNIQUE_N_NODES:\n    training_variant = None\n    for name, params in SBM_VARIANTS.items():\n        if params['n_nodes'] == n_nodes:\n            training_variant = name\n            break\n    if(training_variant == 'JODIE-Wikipedia'):\n        continue\n\n    reference_graphs = torch.load(DATA_DIR / training_variant / 'seed_0' / 'graphs.pt')\n    print(f\"\\nTraining for n_nodes={n_nodes} (using {training_variant} data):\")\n\n    for latent_dim in LATENT_DIMS:\n        print(f\"  latent_dim={latent_dim}...\")\n\n        if USE_COTRAIN:\n            enc, dec, K_learned, variance_log = train_encoder_decoder_cotrain(\n                n_nodes=n_nodes,\n                latent_dim=latent_dim,\n                train_graph_sequences=reference_graphs,\n                n_epochs=ENCODER_EPOCHS,\n                **ACTIVE_CONFIG\n            )\n            trained_K_cotrain[(n_nodes, latent_dim)] = K_learned\n            sbm_variance_logs[(n_nodes, latent_dim)] = variance_log\n        else:\n            enc, dec = train_encoder_decoder(\n                n_nodes=n_nodes,\n                latent_dim=latent_dim,\n                train_graphs=reference_graphs,\n                n_epochs=ENCODER_EPOCHS\n            )\n\n        # Save path includes config name when co-training, so results don't overwrite\n        config_tag = ACTIVE_CONFIG_NAME if USE_COTRAIN else 'two_stage'\n        model_dir  = MODELS_DIR / 'SBM' / config_tag / f'n_nodes={n_nodes}' / f'latent_dim={latent_dim}'\n        model_dir.mkdir(parents=True, exist_ok=True)\n        torch.save(enc.state_dict(), model_dir / 'encoder.pt')\n        torch.save(dec.state_dict(), model_dir / 'decoder.pt')\n        if USE_COTRAIN:\n            torch.save(K_learned.state_dict(), model_dir / 'K_cotrain.pt')\n\n        trained_encoders[(n_nodes, latent_dim)]  = enc\n        trained_decoders[(n_nodes, latent_dim)]  = dec\n        print(f\"    ✓ Saved to {model_dir}\")\n\nprint(\"\\n All encoder-decoders trained and saved!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:00:42.297719Z","iopub.execute_input":"2026-05-18T15:00:42.297960Z","iopub.status.idle":"2026-05-18T15:05:02.491710Z","shell.execute_reply.started":"2026-05-18T15:00:42.297932Z","shell.execute_reply":"2026