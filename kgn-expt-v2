= [z_train]\n    test_loader = [z_test]\n\n    return train_loader, test_loader\n\n\ndef compute_loss(z_pred, z_true, model, spectral_penalty_weight=0.1):\n    \"\"\"Compute loss with optional spectral penalty for Koopman models.\"\"\"\n    recon_loss = F.mse_loss(z_pred, z_true)\n\n    if hasattr(model, 'spectral_loss'):\n        spec_loss = model.spectral_loss()\n    else:\n        spec_loss = torch.tensor(0.0, device=z_pred.device)\n\n    return recon_loss + spectral_penalty_weight * spec_loss\n\n\nprint(\"Utility functions defined\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T10:57:51.530686Z","iopub.execute_input":"2026-05-16T10:57:51.531136Z","iopub.status.idle":"2026-05-16T10:57:51.552213Z","shell.execute_reply.started":"2026-05-16T10:57:51.531109Z","shell.execute_reply":"2026-05-16T10:57:51.551591Z"}},"outputs":[{"name":"stdout","text":"Utility functions defined\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# Training\n\ndef train_single_model(\n    model, train_loader, test_loader,\n    mode='single_step',\n    epochs=50,\n    learning_rate=1e-3,\n    weight_decay=1e-4,\n    spectral_penalty_weight=0.1,\n    rollout_weight=0.3,     \n    rollout_steps=2,         \n    patience=15,\n    verbose=False\n):\n    optimizer = Adam(model.parameters(), lr=learning_rate, weight_decay=weight_decay)\n    scheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=20, gamma=0.9)\n\n    best_test_loss = float('inf')\n    best_state = None\n    patience_counter = 0\n    history = {'train_loss': [], 'test_loss': []}\n\n    model.train()\n\n    for epoch in range(epochs):\n        train_loss = 0.0\n        n_batches = 0\n\n        # TRAINING\n        if mode == 'single_step':\n            for z_in, z_out in train_loader:\n                z_in, z_out = z_in.to(DEVICE), z_out.to(DEVICE)\n\n                z_pred = model(z_in)\n\n                if z_out.dim() == 1:\n                    z_out = z_out.unsquee