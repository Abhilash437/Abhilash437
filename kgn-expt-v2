im=32, hidden_dim=64, in_channels=1, n_users=None):\n        super().__init__()\n        self.latent_dim  = latent_dim\n        self.in_channels = in_channels\n        self.n_users     = n_users          # only used when in_channels=3\n        self.gc1 = GCNConv(in_channels, hidden_dim)\n        self.gc2 = GCNConv(hidden_dim, hidden_dim)\n        self.fc  = nn.Linear(hidden_dim, latent_dim)\n\n    def forward(self, edge_index, num_nodes, x=None):\n        if edge_index.numel() == 0:\n            return torch.zeros((1, self.latent_dim), device=edge_index.device)\n        if x is None:\n            # raw degree\n            deg  = torch.zeros(num_nodes, device=edge_index.device)\n            ones = torch.ones(edge_index.shape[1], device=edge_index.device)\n            deg.scatter_add_(0, edge_index[0], ones)   # (num_nodes,)\n\n            if self.in_channels == 1:\n                x = deg.unsqueeze(1)                   # (num_nodes, 1)\n\n            else:\n                # Normalised degree\n                # Captures relative activity within the snapshot.\n                # A node with the highest degree gets value 1.0; isolated\n                # nodes get 0.0. Varies more than raw degree across snapshots.\n                max_deg  = deg.max().clamp(min=1.0)\n                norm_deg = deg / max_deg               # (num_nodes,)\n\n                # Bipartite node-type indicator\n                # This is free structural information from the index layout.\n                # It tells the GCN which side of the bipartite graph each\n                # node belongs to, so messages are interpreted correctly.\n                n_u       = self.n_users if self.n_users is not None else num_nodes // 2\n                node_type = torch.zeros(num_nodes, device=edge_index.device)\n                node_type[n_u:] = 1.0                  # (num_nodes,)\n\n                # Stack into (num_nodes, 3)\n                x = torch.stack([deg, norm_deg, node_type], dim=1)\n\n        h = F.relu(self.gc1(x, edge_index))\n        h = F.relu(self.gc2(h, edge_index))\n\n        # Global mean pooling: average node embeddings to graph embedding\n        z = h.mean(dim=0, keepdim=True)   # (1, hidden_dim)\n        z = self.fc(z)                     # (1, latent_dim)\n        return z\n\n\nclass GraphDecoder(nn.Module):\n    \"\"\"MLP Decoder: Latent Vector to Edge Probabilities\"\"\"\n\n    def __init__(self, latent_dim=32, n_nodes=100, hidden_dim=64):\n        super().__init__()\n        self.n_nodes = n_nodes\n        self.n_edges = n_nodes * (n_nodes - 1) // 2\n\n        self.net = nn.Sequential(\n            nn.Linear(latent_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, self.n_edges)\n        )\n\n    def forward(self, z):\n        edges = self.net(z)  # (batch, n_edges)\n        return edges\n\n    def reconstruct_adjacency(self, z):\n        \"\"\"Reconstruct full adjacency matrix from latent vector.\"\"\"\n        edges = self.forward(z).squeeze(0)  # (n_edges,)\n\n        # Fill upper triangle\n        adj = torch.zeros(self.n_nodes, self.n_nodes, device=z.device)\n        triu_idx = torch.triu_indices(self.n_nodes, self.n_nodes, offset=1).to(DEVICE)\n        adj[triu_idx[0], triu_idx[1]] = edges\n        adj = adj + adj.t()\n        return adj # These are now raw logits\n\n\nprint(\"Encoder and Decoder classes defined\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T10:54:38.093217Z","iopub.execute_input":"2026-05-16T10:54:38.093524Z","iopub.status.idle":"2026-05-16T10:54:38.105318Z","shell.execute_reply.started":"2026-05-16T10:54:38.093495Z","shell.execute_reply":"2026-05-16T10:54:38.104635Z"}},"outputs":[{"name":"stdout","text":"Encoder and Decoder classes defined\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# Training of encoder and decoder\n\nLATENT_DIMS = [16, 32, 64, 128]\nENCODER_EPOCHS = 100\nENCODER_LR = 1e-3\n\n# Group variants by n_nodes to determine which encoder-decoders we need\nUNIQUE_N_NODES = sorted(set(params['n_nodes'] for params in SBM_VARIANTS.values()))\nprint(f\"Unique n_nodes values: {UNIQUE_N_NODES}\")\n\n# Map each variant to its n_nodes (for later use in encoding/evaluation)\nVARIANT_TO_N_NODES = {name: params['n_nodes'] for name, params in SBM_VARIANTS.items()}\n\ndef train_encoder_decoder(n_nodes, latent_dim, train_graphs, n_epochs=30, lr=1e-3):\n    \"\"\"Train encoder-decoder for graphs with n_nodes nodes.\"\"\"\n    enc = GraphEncoder(latent_dim=latent_dim).to(DEVICE)\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n\n    optimizer = Adam(list(enc.parameters()) + list(dec.parameters()), lr=lr)\n\n    enc.train()\n    dec.train()\n\n    for epoch in range(n_epochs):\n        total_loss = 0\n        for adj_t in train_graphs:\n            adj_t = adj_t.to(DEVICE)\n            edge_index = torch.from_numpy(np.array(np.where(adj_t.cpu().numpy()))).long().to(DEVICE)\n\n            z = enc(edge_index, num_nodes=n_nodes)\n            # Inside train_encoder_decoder loop:\n            adj_pred = dec.reconstruct_adjacency(z)\n\n            num_ones = adj_t.sum()\n            num_zeros = adj_t.numel() - num_ones\n            # Proper weight: how many times more non-edges there are than edges\n            pw_val = max((num_zeros / num_ones).item() if num_ones > 0 else 1.0, 10.0)\n\n            loss = F.binary_cross_entropy_with_logits(\n                adj_pred, adj_t, pos_weight=torch.tensor([pw_val], device=DEVICE)\n            )\n\n            optimizer.zero_grad()\n            loss.backward()\n            optimizer.step()\n            total_loss += loss.item()\n\n        if (epoch + 1) % 10 == 0:\n            print(f\"    Epoch {epoch+1}/{n_epochs}, Loss: {total_loss/len(train_graphs):.4f}\")\n\n    return enc.eval(), dec.eval()\n\n\n# Co-training of encoder-Koopman-decoder -> By default this is not enabled, \n# this is used as an abalation study, enable this for the co-training results only\n# Key idea: instead of training encoder purely for reconstruction,\n# we add a dynamics loss that forces z_{t+1} ≈ K·z_t in latent space.\n# The encoder now has TWO objectives simultaneously:\n#   1. L_recon  = BCEWithLogits between decoded adj and true adj\n#   2. L_dynamics = ||z_{t+1} - K·z_t||^2  (latent linearity)\n#   3. L_spectral = ReLU(|λ_max(K)| - 1)^2  (stability)\n\n# ==============================================================\n# PATCHED: train_encoder_decoder_cotrain\n# Change from original: collects variance_log = [(epoch, z_var)]\n# at every epoch, and returns it as a 4th value.\n# ==============================================================\n\ndef train_encoder_decoder_cotrain(n_nodes, latent_dim, train_graph_sequences,\n                                   alpha=1.0, beta=0.1, gamma=0.1, delta=2.0,\n                                   in_channels=1, n_users=None,\n                                   n_epochs=50, lr=1e-3):\n    enc = GraphEncoder(latent_dim=latent_dim,\n                       in_channels=in_channels,\n                       n_users=n_users).to(DEVICE)\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    K   = nn.Linear(latent_dim, latent_dim, bias=False).to(DEVICE)\n\n    optimizer = Adam(\n        list(enc.parameters()) + list(dec.parameters()) + list(K.parameters()),\n        lr=lr\n    )\n\n    T = len(train_graph_sequences)\n\n    variance_log = []   # list of floats, index = epoch number\n\n    for epoch in range(n_epochs):\n        enc.train(); dec.train(); K.train()\n        total_recon, total_dyn, total_spec, total_collapse = 0.0, 0.0, 0.0, 0.0\n\n        z_all = []\n        for t in range(T):\n            adj_t = train_graph_sequences[t].to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy()))\n            ).long().to(DEVICE)\n            z_t = enc(edge_index, num_nodes=n_nodes)\n            z_all.append(z_t)\n\n        z_seq = torch.cat(z_all, dim=0)   # (T, latent_dim)\n\n        l_recon = torch.tensor(0.0, device=DEVICE)\n        for t in range(T):\n            adj_t    = train_graph_sequences[t].to(DEVICE)\n            adj_pred = dec.reconstruct_adjacency(z_seq[t].unsqueeze(0))\n            num_ones  = adj_t.sum()\n            num_zeros = adj_t.numel() - num_ones\n            pw_val    = (num_zeros / num_ones) if num_ones > 0 else 1.0\n            l_recon  += F.binary_cross_entropy_with_logits(\n                adj_pred, adj_t,\n                pos_weight=torch.tensor([pw_val], device=DEVICE)\n            )\n        l_recon = l_recon / T\n\n        z_pred_next   = K(z_seq[:-1])\n        z_actual_next = z_seq[1:]\n        l_dynamics    = F.mse_loss(z_pred_next, z_actual_next)\n\n        z_seq_centered = z_seq - z_seq.mean(dim=0, keepdim=True)\n        z_scale        = z_seq.detach().pow(2).mean().clamp(min=1e-6)\n        threshold      = 0.01 * z_scale\n        l_collapse     = torch.relu(threshold - z_seq_centered.var(dim=0)).mean()\n\n        evals      = torch.linalg.eigvals(K.weight)\n        l_spectral = torch.relu(torch.max(torch.abs(evals)) - 1.0) ** 2\n\n        loss = alpha * l_recon + beta * l_dynamics + gamma * l_spectral + delta * l_collapse\n\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n\n        total_recon    += l_recon.item()\n        total_dyn      += l_dynamics.item()\n        total_spec     += l_spectral.item()\n        total_collapse += l_collapse.item()\n\n        with torch.no_grad():\n            z_var = z_seq_centered.var(dim=0).mean().item()\n        variance_log.append(z_var)   # index = epoch\n\n        if (epoch + 1) % 10 == 0:\n            print(f\"    Epoch {epoch+1}/{n_epochs} | \"\n                  f\"Recon: {total_recon:.4f}  \"\n                  f\"Dyn: {total_dyn:.4f}  \"\n                  f\"Spec: {total_spec:.6f}  \"\n                  f\"Collapse: {l_collapse.item():.6f}  \"\n                  f\"LatentVar: {z_var:.4f}\")\n\n    return enc.eval(), dec.eval(), K.eval(), variance_log\n\n# Set USE_COTRAIN = False to reproduce the original two-stage results\n# Set USE_COTRAIN = True to run Step 3 co-training\nUSE_COTRAIN = False  # <--- change this to enable co-training\n\n# Co-training weight configurations to ablate\nCOTRAIN_CONFIGS = {\n    'recon_only':       dict(alpha=1.0, beta=0.0,  gamma=0.0,  delta=0.0),\n    'cotrain_balanced': dict(alpha=1.0, beta=0.1,  gamma=0.1,  delta=2.0),\n    'dynamics_heavy':   dict(alpha=0.5, beta=0.3,  gamma=0.1,  delta=2.0),\n}\n\nACTIVE_CONFIG_NAME = 'cotrain_balanced'\nACTIVE_CONFIG      = COTRAIN_CONFIGS[ACTIVE_CONFIG_NAME]\n\nprint(f\"Training mode: {'CO-TRAIN' if USE_COTRAIN else 'TWO-STAGE'}\")\nif USE_COTRAIN:\n    print(f\"Active config: {ACTIVE_CONFIG_NAME} → {ACTIVE_CONFIG}\")\n\nconfig_tag = ACTIVE_CONFIG_NAME if USE_COTRAIN else 'two_stage'\n# Training loop\nprint(f\"\\nTraining encoder-decoder for {len(UNIQUE_N_NODES)} n_nodes groups × {len(LATENT_DIMS)} latent dimensions...\\n\")\n\ntrained_encoders  = {}\ntrained_decoders  = {}\ntrained_K_cotrain = {}  # only populated when USE_COTRAIN=True\n\nfor n_nodes in UNIQUE_N_NODES:\n    training_variant = None\n    for name, params in SBM_VARIANTS.items():\n        if params['n_nodes'] == n_nodes:\n            training_variant = name\n            break\n    if(training_variant == 'JODIE-Wikipedia'):\n        continue\n\n    reference_graphs = torch.load(DATA_DIR / training_variant / 'seed_0' / 'graphs.pt')\n    print(f\"\\nTraining for n_nodes={n_nodes} (using {training_variant} data):\")\n\n    for latent_dim in LATENT_DIMS:\n        print(f\"  latent_dim={latent_dim}...\")\n\n        if USE_COTRAIN:\n            enc, dec, K_learned, sbm_variance_logs = train_encoder_decoder_cotrain(\n                n_nodes=n_nodes,\n                latent_dim=latent_dim,\n                train_graph_sequences=reference_graphs,\n                n_epochs=ENCODER_EPOCHS,\n                **ACTIVE_CONFIG\n            )\n            trained_K_cotrain[(n_nodes, latent_dim)] = K_learned\n        else:\n            enc, dec = train_encoder_decoder(\n                n_nodes=n_nodes,\n                latent_dim=latent_dim,\n                train_graphs=reference_graphs,\n                n_epochs=ENCODER_EPOCHS\n            )\n\n        # Save path includes config name when co-training, so results don't overwrite\n        config_tag = ACTIVE_CONFIG_NAME if USE_COTRAIN else 'two_stage'\n        model_dir  = MODELS_DIR / 'SBM' / config_tag / f'n_nodes={n_nodes}' / f'latent_dim={latent_dim}'\n        model_dir.mkdir(parents=True, exist_ok=True)\n        torch.save(enc.state_dict(), model_dir / 'encoder.pt')\n        torch.save(dec.state_dict(), model_dir / 'decoder.pt')\n        if USE_COTRAIN:\n            torch.save(K_learned.state_dict(), model_dir / 'K_cotrain.pt')\n\n        trained_encoders[(n_nodes, latent_dim)]  = enc\n        trained_decoders[(n_nodes, latent_dim)]  = dec\n        print(f\"    ✓ Saved to {model_dir}\")\n\nprint(\"\\n All encoder-decoders trained and saved!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T12:45:28.571450Z","iopub.execute_input":"2026-05-16T12:45:28.571944Z","iopub.status.idle":"2026-05-16T12:48:05.220498Z","shell.execute_reply.started":"2026-05-16T12:45:28.571896Z","shell.execute_reply":"2026-05-16T12:48:05.219695Z"}},"outputs":[{"name":"stdout","text":"Unique n_nodes values: [100, 150]\nTraining mode: CO-TRAIN\nActive config: cotrain_balanced → {'alpha': 1.0, 'beta': 0.1, 'gamma': 0.1, 'delta': 2.0}\n\nTraining encoder-decoder for 2 n_nodes groups × 4 latent dimensions...\n\n\nTraining for n_nodes=100 (using SBM-Dynamic-Hard data):\n  latent_dim=16...\n    Epoch 10/100 | Recon: 1.1989  Dyn: 0.0647  Spec: 0.000000  Collapse: 0.000237  LatentVar: 0.0021\n    Epoch 20/100 | Recon: 1.1877  Dyn: 0.0161  Spec: 0.000000  Co