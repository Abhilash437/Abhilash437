tract trajectories\n            z_list = []\n            for t in range(T):\n                edge_index = torch.from_numpy(np.array(np.where(adj_seq[t] > 0))).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n            z_stack = torch.cat(z_list, dim=0)\n            \n            for t in range(T - 1):\n                current_horizon = min(max_horizon, T - t - 1)\n                if current_horizon == 0: continue\n                \n                z_start = z_stack[t].unsqueeze(0)\n                \n                # Rollouts\n                z_rk = z_start.clone()\n                z_rm = z_start.clone()\n                \n                h_wg = torch.zeros(1, gru_model.hidden_dim, device=DEVICE)\n                for tw in range(t + 1):\n                    _, h_wg = gru_model(z_stack[tw].unsqueeze(0), h_wg)\n                z_rg = z_start.clone()\n                h_rg = h_wg.clone()\n                \n                for h in range(1, current_horizon + 1):\n                    # Step forward\n                    z_rk = koopman_model(z_rk)\n                    z_rm = mlp_model(z_rm)\n                    z_rg, h_rg = gru_model(z_rg, h_rg)\n                    \n                    target = z_stack[t + h].unsqueeze(0)\n                    \n                    # Store step-specific squared error\n                    koop_step_errors[h].append(F.mse_loss(z_rk, target).item())\n                    mlp_step_errors[h].append(F.mse_loss(z_rm, target).item())\n                    gru_step_errors[h].append(F.mse_loss(z_rg, target).item())\n                    \n    # Compute means for each step\n    steps = sorted(koop_step_errors.keys())\n    avg_koop = [np.mean(koop_step_errors[h]) for h in steps]\n    avg_mlp  = [np.mean(mlp_step_errors[h]) for h in steps]\n    avg_gru  = [np.mean(gru_step_errors[h]) for h in steps]\n    \n    # Plotting\n    plt.figure(figsize=(10, 6))\n    plt.plot(steps, avg_koop, marker='o', color='darkorange', linewidth=2, label='Our Deep Koopman Predictor')\n    plt.plot(steps, avg_mlp, marker='s', color='mediumpurple', linewidth=1.5, linestyle='--', label='MLP Transition Baseline')\n    plt.plot(steps, avg_gru, marker='^', color='teal', linewidth=1.5, linestyle='-.', label='Stateful GRU Baseline')\n    \n    plt.title(\"Autoregressive Error Accumulation Across Extended Horizon\", fontsize=12, fontweight='bold')\n    plt.xlabel(\"Prediction Horizon Lookahead (Steps)\", fontsize=10)\n    plt.ylabel(\"Mean Squared Error (MSE)\", fontsize=10)\n    plt.xticks(steps)\n    plt.grid(True, linestyle='--', alpha=0.5)\n    plt.legend(loc='upper left', fontsize=10)\n    \n    plt.tight_layout()\n    plt.savefig(os.path.join(SAVE_DIR, \"horizon_error_accumulation.png\"), dpi=300)\n    plt.show()\n\n# Run error accumulation plot\nplot_error_accumulation(sup_encoder_v7, train_subject_graphs, koopman_forecaster, bench_mlp, bench_gru, ABIDE_LATENT_DIM)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:38:48.154440Z","iopub.execute_input":"2026-05-24T06:38:48.154714Z","iopub.status.idle":"2026-05-24T06:38:53.648374Z","shell.execute_reply.started":"2026-05-24T06:38:48.154684Z","shell.execute_reply":"2026-05-24T06:38:53.647417Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/dist-packages/numpy/_core/fromnumeric.py:3596: RuntimeWarning: Mean of empty slice.\n  return _methods._mean(a, axis=axis, dtype=dtype,\n/usr/local/lib/python3.12/dist-packages/numpy/_core/_methods.py:138: RuntimeWarning: invalid value encountered in scalar divide\n  ret = ret.dtype.type(ret / rcount)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x600 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":30},{"cell_type":"code","source":"# Cell 59 — Ground-Truth vs. Model Rollout Alignment Tracking\n#\n# Objectives:\n# 1. Isolate a single subject sequence to visualize real-time tracking.\n# 2. Overlay autoregressive model rollouts against true latent dimension changes.\n\ndef plot_subject_trajectory_tracking(encoder, subject_graph, koopman_model, mlp_model, gru_model, latent_dim, target_dim_idx=0):\n    encoder.eval(); koopman_model.eval(); mlp_model.eval(); gru_model.eval()\n    \n    T = subject_graph.shape[0]\n    \n    # Extract the true path\n    with torch.no_grad():\n        z_list = []\n        for t in range(T):\n            edge_index = torch.from_numpy(np.array(np.where(subject_graph[t] > 0))).long().to(DEVICE)\n            z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, latent_dim, device=DEVICE)\n            z_list.append(z_t)\n        z_true = torch.cat(z_list, dim=0).cpu().numpy() # Shape: (T, latent_dim)\n        \n    # Generate full rollouts from t=0 seed\n    koop_rollout = [z_true[0, target_dim_idx]]\n    mlp_rollout  = [z_true[0, target_dim_idx]]\n    gru_rollout  = [z_true[0, target_dim_idx]]\n    \n    with torch.no_grad():\n        # Seed initialization\n        z_rk = torch.from_numpy(z_true[0]).unsqueeze(0).to(DEVICE)\n        z_rm = z_rk.clone()\n        z_rg = z_rk.clone()\n        h_rg = torch.zeros(1, gru_model.hidden_dim, device=DEVICE)\n        \n        for t in range(1, T):\n            z_rk = koopman_model(z_rk)\n            z_rm = mlp_model(z_rm)\n            z_rg, h_rg = gru_model(z_rg, h_rg)\n            \n            koop_rollout.append(z_rk[0, target_dim_idx].item())\n            mlp_rollout.append(z_rm[0, target_dim_idx].item())\n            gru_rollout.append(z_rg[0, target_dim_idx].item())\n            \n    # Plotting tracking alignment\n    time_steps = np.arange(T)\n    plt.figure(figsize=(12, 5))\n    plt.plot(time_steps, z_true[:, target_dim_idx], label='True Latent Trajectory', color='black', linewidth=2.5, zorder=2)\n    plt.plot(time_steps, koop_rollout, label='Koopman Forecast Rollout', color='darkorange', linewidth=1.5, linestyle='-')\n    plt.plot(time_steps, mlp_rollout, label='MLP Forecast Rollout', color='mediumpurple', linewidth=1.5, linestyle='--')\n    plt.plot(time_steps, gru_rollout, label='Stateful GRU Forecast Rollout', color='teal', linewidth=1.5, linestyle='-.')\n    \n    plt.title(f\"20-Step Pure Autoregressive Rollout Tracking Comparison (Latent Dimension {target_dim_idx})\", fontsize=12, fontweight='bold')\n    plt.xlabel(\"fMRI Sequence Timeline (Time Steps)\", fontsize=10)\n    plt.ylabel(f\"Latent Activation Value (Z[{target_dim_idx}])\", fontsize=10)\n    plt.grid(True, linestyle='--', alpha=0.5)\n    plt.legend(loc='best', fontsize=10)\n    \n    plt.tight_layout()\n    plt.savefig(os.path.join(SAVE_DIR, \"subject_trajectory_tracking.png\"), dpi=300)\n    plt.show()\n\n# Run the alignment tracker on Subject 0\nplot_subject_trajectory_tracking(\n    encoder=sup_encoder_v7,\n    subject_graph=train_subject_graphs[0],\n    koopman_model=koopman_forecaster,\n    mlp_model=bench_mlp,\n    gru_model=bench_gru,\n    latent_dim=ABIDE_LATENT_DIM,\n    target_dim_idx=0 # Auditing Latent Node Index 0\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:38:53.649864Z","iopub.execute_input":"2026-05-24T06:38:53.650155Z","iopub.status.idle":"2026-05-24T06:38:54.555763Z","shell.execute_reply.started":"2026-05-24T06:38:53.650123Z","shell.execute_reply":"2026-05-24T06:38:54.554852Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":31},{"cell_type":"code","source":"# Cell 60 — Post-Hoc Subject-Specific Spectral Decomposition Analysis (Fixed Strings & Labels)\n#\n# Objectives:\n# 1. Use raw string literals (r\"...\") to bypass Python sequence escaping.\n# 2. Interface with your workspace's actual 'subject_labels' array.\n# 3. Generate the clinical eigenvalue spectra profiles cleanly.\n\nimport cmath\nimport os\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\ndef analyze_koopman_spectral_biomarkers(encoder, train_subject_graphs, subject_labels, latent_dim):\n    encoder.eval()\n    \n    asd_eigenvalues = []\n    td_eigenvalues = []\n    \n    # Store global metrics for statistical verification\n    asd_max_mags = []\n    td_max_mags = []\n    asd_frequencies = []\n    td_frequencies = []\n    \n    print(\"=\" * 65)\n    print(\"RUNNING SPECTRAL DECOMPOSITION ON SUBJECT DYNAMICS\")\n    print(\"=\" * 65)\n    \n    # Post-hoc ridge parameter ensures mathematical inversion stability\n    alpha_ridge = 1e-4\n    \n    for idx in range(len(train_subject_graphs)):\n        adj_seq = train_subject_graphs[idx]\n        label = subject_labels[idx]\n        T = adj_seq.shape[0]\n        if T < 3: continue\n        \n        # 1. Extract frozen subject trajectories from your encoder\n        with torch.no_grad():\n            z_list = []\n            for t in range(T):\n                edge_index = torch.from_numpy(np.array(np.where(adj_seq[t] > 0))).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n            Z = torch.cat(z_list, dim=0).cpu().numpy() # Shape: (T, latent_dim)\n            \n        # 2. Formulate State Shift Arrays: X_t and X_{t+1}\n        X = Z[:-1, :] \n        Y = Z[1:, :]  \n        \n        # 3. Compute Subject-Specific Empirical Koopman Matrix via Ridge Regression\n        XTX = np.dot(X.T, X) + alpha_ridge * np.eye(latent_dim)\n        XTY = np.dot(X.T, Y)\n        K_subject = np.dot(np.linalg.inv(XTX), XTY)\n        \n        # 4. Extract Complex Eigenvalue Spectrum\n        evals, _ = np.linalg.eig(K_subject)\n        \n        # 5. Map Dynamics to Frequencies and Magnitudes\n        magnitudes = np.abs(evals)\n        frequencies = np.array([cmath.phase(ev) / (2 * np.pi) for ev in evals])\n        \n        if label == 1: # ASD Cohort\n            asd_eigenvalues.extend(evals)\n            asd_max_mags.append(np.max(magnitudes))\n            asd_frequencies.extend(frequencies[frequencies > 0]) \n        else: # Typically Developing Controls (TD)\n            td_eigenvalues.extend(evals)\n            td_max_mags.append(np.max(magnitudes))\n            td_frequencies.extend(frequencies[frequencies > 0])\n\n    asd_evals = np.array(asd_eigenvalues)\n    td_evals = np.array(td_eigenvalues)\n    \n    # ────────────────────────────────────────────────────────\n    # DIAGNOSTIC PLOT 1: COMPLEX PLANAR MAP (Using Raw Strings)\n    # ────────────────────────────────────────────────────────\n    plt.figure(figsize=(8, 8))\n    \n    # Plot mathematical Unit Circle boundary line\n    theta = np.linspace(0, 2*np.pi, 200)\n    plt.plot(np.cos(theta), np.sin(theta), color='black', linestyle='--', alpha=0.6, label='Unit Circle (Stability Bounds)')\n    \n    # Scatter spectral vectors across Real vs Imaginary components\n    plt.scatter(td_evals.real, td_evals.imag, color='teal', alpha=0.4, marker='o', s=25, label='Typically Developing (TD)')\n    plt.scatter(asd_evals.real, asd_evals.imag, color='darkorange', alpha=0.4, marker='x', s=30, label='Autism Spectrum (ASD)')\n    \n    plt.title(\"Koopman Spectral Footprint: ASD vs. TD Eigenvalue Domain\", fontsize=12, fontweight='bold')\n    plt.xlabel(r\"Real Component ($\\mathcal{R}e(\\lambda)$)\", fontsize=10)\n    plt.ylabel(r\"Imaginary Component ($\\mathcal{I}m(\\lambda)$)\", fontsize=10)\n    plt.axhline(0, color='gray', linestyle=':', alpha=0.5)\n    plt.axvline(0, color='gray', linestyle=':', alpha=0.5)\n    plt.grid(True, linestyle='--', alpha=0.3)\n    plt.legend(loc='upper right', fontsize=10)\n    plt.axis('equal')\n    \n    plt.tight_layout()\n    plt.savefig(os.path.join(SAVE_DIR, \"koopman_spectral_plane.png\"), dpi=300)\n    plt.show()\n    \n    # ────────────────────────────────────────────────────────\n    # DIAGNOSTIC PLOT 2: DISTRIBUTION OF CYCLICAL MODES\n    # ────────────────────────────────────────────────────────\n    plt.figure(figsize=(10, 5))\n    sns.kdeplot(td_frequencies, fill=True, color='teal', label='Typically Developing (TD)', bw_adjust=0.7, alpha=0.4, linewidth=2)\n    sns.kdeplot(asd_frequencies, fill=True, color='darkorange', label='Autism Spectrum (ASD)', bw_adjust=0.7, alpha=0.4, linewidth=2)\n    \n    plt.title(\"Latent Trajectory Oscillation Profile: Dominant Frequency Signatures\", fontsize=12, fontweight='bold')\n    plt.xlabel(r\"Normalized Latent Cycle Frequency ($f = \\theta / 2\\pi$)\", fontsize=10)\n    plt.ylabel(\"Density Estimation\", fontsize=10)\n    plt.grid(True, linestyle='--', alpha=0.3)\n    plt.legend(loc='upper right', fontsize=10)\n    \n    plt.tight_layout()\n    plt.savefig(os.path.join(SAVE_DIR, \"koopman_frequency_distribution.png\"), dpi=300)\n    plt.show()\n    \n    print(\"\\n\" + \"-\"*50)\n    print(\"QUANTITATIVE DYNAMICS PROFILE SUMMARY\")\n    print(\"-\"*50)\n    print(f\"Mean Max Eigenvalue Magnitude (TD)  : {np.mean(td_max_mags):.5f}\")\n    print(f\"Mean Max Eigenvalue Magnitude (ASD) : {np.mean(asd_max_mags):.5f}\")\n    print(f\"Peak Frequency Mode observed (TD)   : {np.mean(td_frequencies):.5f}\")\n    print(f\"Peak Frequency Mode observed (ASD)  : {np.mean(asd_frequencies):.5f}\")\n    print(\"-\" * 50)\n    \n    return {\"asd_evals\": asd_evals, \"td_evals\": td_evals}\n\n# Re-run execution mapping directly to your workspace variable array\nspectral_data = analyze_koopman_spectral_biomarkers(\n    encoder=sup_encoder_v7,\n    train_subject_graphs=train_subject_graphs,\n    subject_labels=train_subject_labels, # Successfully pointed to native notebook array\n    latent_dim=ABIDE_LATENT_DIM\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:38:54.556824Z","iopub.execute_input":"2026-05-24T06:38:54.557092Z","iopub.status.idle":"2026-05-24T06:38:58.209010Z","shell.execute_reply.started":"2026-05-24T06:38:54.557060Z","shell.execute_reply":"2026-05-24T06:38:58.207938Z"}},"outputs":[{"name":"stdout","text":"=================================================================\nRUNNING SPECTRAL DECOMPOSITION ON SUBJECT DYNAMICS\n=================================================================\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x800 with 1 Axes>","image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"<Figure size 1000x500 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\n--------------------------------------------------\nQUANTITATIVE DYNAMICS PROFILE SUMMARY\n--------------------------------------------------\nMean Max Eigenvalue Magnitude (TD)  : 1.00016\nMean Max Eigenvalue Magnitude (ASD) : 1.02016\nPeak Frequency Mode observed (TD)   : 0.32019\nPeak Frequency Mode observed (ASD)  : 0.32974\n--------------------------------------------------\n","output_type":"stream"}],"execution_count":32},{"cell_type":"code","source":"# Cell 61 — Rigorous Statistical Validation of Low-to-Mid Frequency Mass\n#\n# Objectives:\n# 1. Isolate the exact frequency mass in the [0.15, 0.35] band for every subject.\n# 2. Run a Mann-Whitney U test to test for non-parametric distribution shifts.\n# 3. Execute a 10,000-iteration Permutation Test to compute an exact p-value.\n\nimport cmath\nimport numpy as np\nfrom scipy.stats import mannwhitneyu\n\ndef verify_frequency_mass_significance(encoder, train_subject_graphs, subject_labels, latent_dim):\n    encoder.eval()\n    \n    asd_masses = []\n    td_masses = []\n    alpha_ridge = 1e-4\n    \n    # Define our target window of genuine neurodynamics\n    f_low, f_high = 0.15, 0.35\n    \n    for idx in range(len(train_subject_graphs)):\n        adj_seq = train_subject_graphs[idx]\n        label = subject_labels[idx]\n        T = adj_seq.shape[0]\n        if T < 3: continue\n        \n        # 1. Extract frozen trajectories\n        with torch.no_grad():\n            z_list = []\n            for t in range(T):\n                edge_index = torch.from_numpy(np.array(np.where(adj_seq[t] > 0))).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n            Z = torch.cat(z_list, dim=0).cpu().numpy()\n            \n        # 2. Compute individual Empirical Koopman matrix\n        X = Z[:-1, :]\n        Y = Z[1:, :]\n        XTX = np.dot(X.T, X) + alpha_ridge * np.eye(latent_dim)\n        XTY = np.dot(X.T, Y)\n        K_subject = np.dot(np.linalg.inv(XTX), XTY)\n        \n        # 3. Extract frequencies from complex angles\n        evals, _ = np.linalg.eig(K_subject)\n        frequencies = np.array([cmath.phase(ev) / (2 * np.pi) for ev in evals])\n        active_freqs = frequencies[frequencies > 0] # Filter out negative mirror frequencies\n        \n        if len(active_freqs) == 0: continue\n            \n        # 4. Calculate the fraction of active modes landing in our target band\n        modes_in_band = np.sum((active_freqs >= f_low) & (active_freqs <= f_high))\n        mass_fraction = modes_in_band / len(active_freqs)\n        \n        if label == 1:\n            asd_masses.append(mass_fraction)\n        else:\n            td_masses.append(mass_fraction)\n            \n    asd_masses = np.array(asd_masses)\n    td_masses = np.array(td_masses)\n    \n    # ────────────────────────────────────────────────────────\n    # STATISTICAL TESTING 1: MANN-WHITNEY U TEST\n    # ────────────────────────────────────────────────────────\n    u_stat, mwu_p = mannwhitneyu(asd_masses, td_masses, alternative='two-sided')\n    \n    # ────────────────────────────────────────────────────────\n    # STATISTICAL TESTING 2: PERMUTATION TEST (10,000 Shuffles)\n    # ────────────────────────────────────────────────────────\n    combined_masses = np.concatenate([asd_masses, td_masses])\n    n_asd = len(asd_masses)\n    observed_diff = np.abs(np.mean(asd_masses) - np.mean(td_masses))\n    \n    count_extreme = 0\n    n_permutations = 10000\n    \n    np.random.seed(42) # Ensure consistency across runs\n    for _ in range(n_permutations):\n        shuffled = np.random.permutation(combined_masses)\n        perm_asd = shuffled[:n_asd]\n        perm_td = shuffled[n_asd:]\n        perm_diff = np.abs(np.mean(perm_asd) - np.mean(perm_td))\n        if perm_diff >= observed_diff:\n            count_extreme += 1\n            \n    permutation_p = count_extreme / n_permutations\n    \n    # ────────────────────────────────────────────────────────\n    # PRINT RESULTS\n    # ────────────────────────────────────────────────────────\n    print(\"=\" * 65)\n    print(f\"RIGOROUS STATISTICAL AUDIT FOR BAND [{f_low}, {f_high}]\")\n    print(\"=\" * 65)\n    print(f\"TD Mean Mass Fraction  : {np.mean(td_masses):.4f} (n={len(td_masses)})\")\n    print(f\"ASD Mean Mass Fraction : {np.mean(asd_masses):.4f} (n={len(asd_masses)})\")\n    print(f\"Observed Delta         : {observed_diff:.4f}\")\n    print(\"-\" * 65)\n    print(f\"Mann-Whitney U p-value : {mwu_p:.6f}\")\n    print(f\"Permutation p-value    : {permutation_p:.6f} (over {n_permutations} shuffles)\")\n    print(\"=\" * 65)\n    \n    if permutation_p < 0.05:\n        print(\"RESULT: Statistically Significant! The distributional shift is genuine.\")\n    else:\n        print(\"RESULT: Not Statistically Significant. The visual variance is within baseline noise margins.\")\n        \n    return {\"mwu_p\": mwu_p, \"permutation_p\": permutation_p}\n\n# Execute the test\nstat_results = verify_frequency_mass_significance(\n    encoder=sup_encoder_v7,\n    train_subject_graphs=train_subject_graphs,\n    subject_labels=train_subject_labels,\n    latent_dim=ABIDE_LATENT_DIM\n)","metadata":{"trusted":true