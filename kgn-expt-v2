                'mode'      : mode,\n                            'latent_dim': latent_dim,\n                            'seed'      : 0,\n                            'step'      : step,\n                            'f1'        : f1,\n                        })\n\n            print(\"evaluated.\")\n\n# Merge JODIE results into df_final\ndf_jodie = pd.DataFrame(jodie_rows)\n\n\ncsv_path = RESULTS_DIR / 'comparison_table.csv'\nif csv_path.exists():\n    df_final = pd.read_csv(csv_path)\n    df_final = pd.concat([df_final, df_jodie], ignore_index=True)\nelse:\n    df_final = df_jodie\n\ndf_final.to_csv(csv_path, index=False)\n\nprint(f\"\\n✓ JODIE results added. df_final now has {len(df_final)} rows.\")\nprint(f\"  Variants: {df_final['variant'].unique().tolist()}\")\nprint(f\"  Saved to {RESULTS_DIR / 'comparison_table.csv'}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T12:25:49.702144Z","iopub.execute_input":"2026-05-16T12:25:49.702354Z","iopub.status.idle":"2026-05-16T12:27:22.855277Z"}},"outputs":[{"name":"stdout","text":"Training transition models on JODIE-Wikipedia...\n\nModels: ['Koopman', 'MLP', 'GRU']\nModes:  ['single_step', 'stateful']\nLatent dims: [32, 64]\nEval steps: [1, 5, 10, 20]\n\n  Koopman / single_step / dim=32 ... trained. evaluated.\n  Koopman / stateful / dim=32 ... trained. evaluated.\n  MLP / single_step / dim=32 ... trained. evaluated.\n  MLP / stateful / dim=32 ... trained. evaluated.\n  GRU / single_step / dim=32 ... trained. evaluated.\n  GRU / stateful / dim=32 ... trained. evaluated.\n  Koopman / single_step / dim=64 ... trained. evaluated.\n  Koopman / stateful / dim=64 ... trained. evaluated.\n  MLP / single_step / dim=64 ... trained. evaluated.\n  MLP / stateful / dim=64 ... trained. evaluated.\n  GRU / single_step / dim=64 ... trained. evaluated.\n  GRU / stateful / dim=64 ... trained. evaluated.\n\n✓ JODIE results added. df_final now has 255408 rows.\n  Variants: ['SBM-Dynamic-Hard', 'SBM-Signal-Strong',