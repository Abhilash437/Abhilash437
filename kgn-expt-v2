bels[idx]\n        \n        with torch.no_grad():\n            z_list = []\n            for t in range(T):\n                edge_index = torch.from_numpy(np.array(np.where(adj_seq[t] > 0))).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, ABIDE_LATENT_DIM, device=DEVICE)\n                z_list.append(z_t)\n            z_stack = torch.cat(z_list, dim=0).cpu().numpy() # Shape: (T, latent_dim)\n            \n        all_trajectories.append(z_stack)\n        subject_metadata.append({'idx': idx, 'label': label, 'length': T})\n        \n    # Fit PCA globally across all selected trajectories to establish a shared 2D space\n    flat_all_z = np.concatenate(all_trajectories, axis=0)\n    pca = PCA(n_components=2)\n    pca.fit(flat_all_z)\n    \n    # Plotting configuration\n    plt.figure(figsize=(10, 8))\n    \n    asd_legend_added = False\n    td_legend_added = False\n    \n    for traj, meta in zip(all_trajectories, subject_metadata):\n        # Project this specific subject's trajectory to 2D\n        traj_2d = pca.transform(traj)\n        \n        if meta['label'] == 1:\n            color = 'crimson'\n            marker = 'o'\n        else:\n            color = 'dodgerblue'\n            marker = 's'\n            \n        # Draw the continuous time-evolution line\n        plt.plot(traj_2d[:, 0], traj_2d[:, 1], color=color, alpha=0.4, linestyle='-', linewidth=1.5)\n        \n        # Scatter the discrete temporal transitions with a gradient alpha to show directional flow\n        T = meta['length']\n        for t in range(T):\n            alpha = 0.3 + 0.7 * (t / T)  # Fades in over time to indicate vector direction\n            plt.scatter(traj_2d[t, 0], traj_2d[t, 1], color=color, marker=marker, alpha=alpha, edgecolors='none', s=45)\n            \n        # Highlight the starting state (t=0)\n        plt.scatter(traj_2d[0, 0], traj_2d[0, 1], color='black', marker='x', s=60, zorder=5)