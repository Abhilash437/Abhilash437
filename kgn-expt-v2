hape check — expect (n_timepoints, 116)\n        # Some sites return (116, n_timepoints) — transpose if needed\n        if ts.ndim == 2 and ts.shape[0] == 116 and ts.shape[1] != 116:\n            ts = ts.T   # fix transposed arrays\n\n        if ts.ndim != 2:\n            print(f\"  Subject {i}: skipped (unexpected shape {ts.shape})\")\n            continue\n\n        if ts.shape[1] != 116:\n            print(f\"  Subject {i}: skipped (expected 116 ROIs, got {ts.shape[1]})\")\n            continue\n\n        if ts.shape[0] < MIN_TIMEPOINTS:\n            print(f\"  Subject {i}: skipped ({ts.shape[0]} timepoints < {MIN_TIMEPOINTS})\")\n            continue\n\n        time_series_list.append(ts)\n        valid_labels.append(int(label))\n        valid_indices.append(i)\n\n    except Exception as e:\n        print(f\"  Subject {i}: failed ({e})\")\n        continue\n\nvalid_labels = np.array(valid_labels)\n\nprint(f\"\\n✓ Loaded {len(time_series_list)} valid subjects\")\nprint(f\"  ASD: {valid_labels.sum()}  |  TD: {(valid_labels==0).sum()}\")\n\nif len(time_series_list) > 0:\n    shapes = [ts.shape[0] for ts in time_series_list]\n    print(f\"  Timepoints — min: {min(shapes)}, max: {max(shapes)}, \"\n          f\"mean: {np.mean(shapes):.1f}\")\n    print(f\"  ROIs per subject: {time_series_list[0].shape[1]}\")\nelse:\n    print(\"  No subjects loaded — run the diagnostic cell above first.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:06:10.077775Z","iopub.execute_input":"2026-05-24T05:06:10.078066Z","iopub.status.idle":"2026-05-24T05:06:16.857476Z","shell.execute_reply.started":"2026-05-24T05:06:10.078034Z","shell.execute_reply":"2026-05-24T05:06:16.856620Z"}},"outputs":[{"name":"stdout","text":"nilearn installed.\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_57/1159481199.py:32: FutureWarning: The import path 'nilearn.input_data' is deprecated in version 0.9. Importing from 'nilearn.input_data' will be possible at l