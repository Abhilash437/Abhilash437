    print(f\"\\n{'='*55}\")\n    print(f\"  {encoder_name}\")\n    print(f\"{'='*55}\")\n\n    # Test 1: Eigenvalue magnitudes\n    # mannwhitneyu args:\n    #   x, y        : the two samples to compare\n    #   alternative : 'two-sided' — we test for ANY difference, not just one direction\n    stat_mag, p_mag = mannwhitneyu(asd_mags, td_mags, alternative='two-sided')\n\n    print(f\"\\n[Magnitude Test]  H0: ASD and TD magnitude distributions are identical\")\n    print(f\"  ASD mean magnitude : {asd_mags.mean():.4f}\")\n    print(f\"  TD  mean magnitude : {td_mags.mean():.4f}\")\n    print(f\"  U statistic        : {stat_mag:.1f}\")\n    print(f\"  p-value            : {p_mag:.4f}  \", end=\"\")\n    print(\"*** SIGNIFICANT ***\" if p_mag < 0.05 else \"(not significant)\")\n\n    # Test 2: Oscillation frequencies\n    stat_freq, p_freq = mannwhitneyu(asd_freqs, td_freqs, alternative='two-sided')\n\n    print(f\"\\n[Frequency Test]  H0: ASD and TD frequency distributions are identical\")\n    print(f\"  ASD mean frequency : {asd_freqs.mean():.4f}\")\n    print(f\"  TD  mean frequency : {td_freqs.mean():.4f}\")\n    print(f\"  U statistic        : {stat_freq:.1f}\")\n    print(f\"  p-value            : {p_freq:.4f}  \", end=\"\")\n    print(\"*** SIGNIFICANT ***\" if p_freq < 0.05 else \"(not significant)\")\n\n    return p_mag, p_freq\n\n# ── Run tests for both encoders ───────────────────────────────\nprint(\"MANN-WHITNEY U TEST RESULTS\")\n\n# v7: with global Koopman regularizer\np_mag_v7, p_freq_v7 = run_spectral_tests(\n    asd_mags, td_mags, asd_freqs, td_freqs,\n    \"v7 Encoder (Global Koopman Regularizer)\"\n)\n\n# v5: no Koopman regularizer\np_mag_v5, p_freq_v5 = run_spectral_tests(\n    asd_mags_v5, td_mags_v5, asd_freqs_v5, td_freqs_v5,\n    \"v5 Encoder (No Koopman Regularizer)\"\n)\n\n# ── Visualization: 2×2 grid ───────────────────────────────────\n# Row 1: v7 encoder  |  Row 2: v5 encoder\n# Col 1: magnitude distributions  |  Col 2: frequency distributions\n\nfig, axes = plt.subplots(2, 2, figsize=(14, 10))\nfig.suptitle(\"Per-Subject Koopman Spectral Analysis\\nASD vs TD: v7 (Global K) vs v5 (No K)\",\n             fontsize=14, fontweight='bold')\n\n# Color palette\nC_TD  = '#2196F3'   # blue  for TD\nC_ASD = '#F44336'   # red   for ASD\n\nconfigs = [\n    # (row, col, asd_data,    td_data,    p_val,    xlabel,               title_tag)\n    (0, 0, asd_mags,     td_mags,     p_mag_v7,  '|λ| Magnitude',      'v7 — Magnitude'),\n    (0, 1, asd_freqs,    td_freqs,    p_freq_v7, 'Frequency f=θ/2π',   'v7 — Frequency'),\n    (1, 0, asd_mags_v5,  td_mags_v5,  p_mag_v5,  '|λ| Magnitude',      'v5 — Magnitude'),\n    (1, 1, asd_freqs_v5, td_freqs_v5, p_freq_v5, 'Frequency f=θ/2π',   'v5 — Frequency'),\n]\n\nfor (row, col, asd_data, td_data, p_val, xlabel, title_tag) in configs:\n    ax = axes[row, col]\n\n    # KDE plots\n    # sns.kdeplot explanation:\n    # Draws a smooth density curve estimating the distribution of the data.\n    # fill=True fills the area under the curve for readability.\n    # alpha controls transparency so overlapping regions are visible.\n    import seaborn as sns\n    sns.kdeplot(td_data,  ax=ax, color=C_TD,  fill=True, alpha=0.4,\n                linewidth=2, label='TD')\n    sns.kdeplot(asd_data, ax=ax, color=C_ASD, fill=True, alpha=0.4,\n                linewidth=2, label='ASD')\n\n    # Significance annotation\n    sig_text = f\"p = {p_val:.4f}\" + (\" ✓ sig.\" if p_val < 0.05 else \" (n.s.)\")\n    ax.set_title(f\"{title_tag}\\n{sig_text}\", fontsize=11, fontweight='bold')\n    ax.set_xlabel(xlabel)\n    ax.set_ylabel('Density')\n    ax.legend()\n    ax.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.savefig('spectral_comparison_v5_vs_v7.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"\\nFigure saved: spectral_comparison_v5_vs_v7.png\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T16:26:05.323214Z","iopub.execute_input":"2026-05-18T16:26:05.323605Z","iopub.status.idle":"2026-05-18T16:26:06.853398Z","shell.execute_reply.started":"2026-05-18T16:26:05.323567Z","shell.execute_reply":"2026-05-18T16:26:06.852608Z"}},"outputs":[{"name":"stdout","text":"MANN-WHITNEY U TEST RESULTS\n\n=======================================================\n  v7 Encoder (Global Koopman Regularizer)\n=======================================================\n\n[Magnitude Test]  H0: ASD and TD magnitude distributions are identical\n  ASD mean magnitude : 0.0295\n  TD  mean magnitude : 0.0286\n  U statistic        : 458551.0\n  p-value            : 0.8863  (not significant)\n\n[Frequency Test]  H0: ASD and TD frequency distributions are identical\n  ASD mean frequency : 0.2483\n  TD  mean frequency : 0.2491\n  U statistic        : 458352.0\n  p-value            : 0.8718  (not significant)\n\n=======================================================\n  v5 Encoder (No Koopman Regularizer)\n=======================================================\n\n[Magnitude Test]  H0: ASD and TD magnitude distributions are identical\n  ASD mean magnitude : 0.0469\n  TD  mean magnitude : 0.0468\n  U statistic        : 458399.0\n  p-value            : 0.8764  (not significant)\n\n[Frequency Test]  H0: ASD and TD frequency distributions are identical\n  ASD mean frequency : 0.2423\n  TD  mean frequency : 0.2424\n  U statistic        : 459893.0\n  p-value            : 0.9738  (not significant)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x1000 with 4 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nFigure saved: spectral_comparison_v5_vs_v7.png\n","output_type":"stream"}],"execution_count":40},{"cell_type":"code","source":"# Cell 5 PATCHED — Ridge Alpha Selection with Dynamic Walk-Forward Splits\n# ────────────────────────────────────────────────────────────────────────\n# Key fix: split points are computed PER SUBJECT based on actual n_pairs\n# instead of hardcoded indices that assume all subjects have 16+ pairs\n#\n# Split strategy:\n#   Train : first 60% of pairs\n#   Val   : remaining 40% of pairs\n# Minimum pairs needed: we need at least 2 pairs for val and n_latent+1\n# for a meaningful ridge fit, so we skip subjects with fewer than 6 pairs\n\nimport numpy as np\nfrom numpy.linalg import lstsq\n\nALPHA_CANDIDATES = np.logspace(-3, 3, 13)\nMIN_PAIRS = 6   # skip subjects too short for a meaningful fit\n\ndef fit_ridge_ki(Z, Z_, alpha):\n    n_latent   = Z.shape[1]\n    sqrt_alpha = np.sqrt(alpha)\n    Z_aug      = np.vstack([Z,  sqrt_alpha * np.eye(n_latent)])\n    Z__aug     = np.vstack([Z_, np.zeros((n_latent, n_latent))])\n    K_i_T, _, _, _ = lstsq(Z_aug, Z__aug, rcond=None)\n    return K_i_T.T\n\ndef val_mse(K_i, Z_val, Z_val_):\n    Z_pred = Z_val @ K_i.T\n    return np.mean((Z_pred - Z_val_) ** 2)\n\ndef get_dynamic_splits(n_pairs):\n    \"\"\"\n    Compute two walk-forward folds based on actual n_pairs.\n    \n    Fold 1: train on first 50%, validate on next 25%\n    Fold 2: train on first 75%, validate on last 25%\n    \n    All indices are computed as fractions of n_pairs so every\n    subject gets valid non-empty train and val windows.\n    \"\"\"\n    t1 = max(2, int(n_pairs * 0.50))   # end of fold-1 train\n    v1 = max(t1 + 1, int(n_pairs * 0.75))  # end of fold-1 val\n    t2 = v1                             # fold-2 train extends to fold-1 val end\n    v2 = n_pairs                        # fold-2 val goes to end\n\n    splits = []\n    # Only add fold if val window is non-empty\n    if v1 > t1:\n        splits.append({'train': (0, t1), 'val': (t1, v1)})\n    if v2 > t2:\n        splits.append({'train': (0, t2), 'val': (t2, v2)})\n    return splits\n\n# ── Sanity check splits for a few lengths ─────────────────────\nprint(\"Split preview for different trajectory lengths:\")\nfor n in [9, 11, 13, 15, 17]:\n    splits = get_dynamic_splits(n)\n    print(f\"  n_pairs={n}: {splits}\")\n\nprint(f\"\\nRunning CV over {len(ALPHA_CANDIDATES)} alphas...\\n\")\n\n# ── Main cross-validation loop ────────────────────────────────\nalpha_scores = []\n\nfor alpha in ALPHA_CANDIDATES:\n    fold_mses    = []\n    skipped      = 0\n\n    for subject in subject_trajectories_v5:\n        traj    = subject['trajectory']\n        n_pairs = traj.shape[0] - 1       # actual number of (z_t, z_{t+1}) pairs\n\n        if n_pairs < MIN_PAIRS:\n            skipped += 1\n            continue\n\n        Z  = traj[:-1]   # (n_pairs, 32)\n        Z_ = traj[1:]    # (n_pairs, 32)\n\n        splits = get_dynamic_splits(n_pairs)\n\n        for split in splits:\n            t0, t1 = split['train']\n            v0, v1 = split['val']\n\n            Z_train  = Z[t0:t1]\n            Z__train = Z_[t0:t1]\n            Z_val    = Z[v0:v1]\n            Z__val   = Z_[v0:v1]\n\n            # Guard: skip if either window is somehow empty\n            if Z_train.shape[0] == 0 or Z_val.shape[0] == 0:\n                continue\n\n            K_i = fit_ridge_ki(Z_train, Z__train, alpha)\n            mse = val_mse(K_i, Z_val, Z__val)\n\n            # Guard: skip NaN MSE (shouldn't happen now, but be safe)\n            if not np.isnan(mse):\n                fold_mses.append(mse)\n\n    avg_mse = np.mean(fold_mses) if fold_mses else np.nan\n    alpha_scores.append(avg_mse)\n    print(f\"  alpha = {alpha:>10.5f}  |  avg val MSE = {avg_mse:.6f}\"\n          f\"  (skipped {skipped} short subjects)\")\n\n# ── Pick best alpha ───────────────────────────────────────────\nvalid_scores = [(a, s) for a, s in zip(ALPHA_CANDIDATES, alpha_scores)\n                if not np.isnan(s)]\nbest_alpha, best_mse = min(valid_scores, key=lambda x: x[1])\n\nprint(f\"\\nBest alpha   : {best_alpha:.5f}\")\nprint(f\"Best val MSE : {best_mse:.6f}\")\n\n# ── Plot ──────────────────────────────────────────────────────\nimport matplotlib.pyplot as plt\n\nplt.figure(figsize=(8, 4))\nplt.semilogx(ALPHA_CANDIDATES, alpha_scores, 'o-', color='steelblue', linewidth=2)\nplt.axvline(best_alpha, color='red', linestyle='--',\n            label=f'Best α = {best_alpha:.5f}')\nplt.xlabel('Ridge Alpha (log scale)')\nplt.ylabel('Average Validation MSE')\nplt.title('Walk-Forward CV: Alpha Selection (Dynamic Splits)')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig('alpha_selection_patched.png', dpi=150, bbox_inches='tight')\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T16:26:07.752169Z","iopub.execute_input":"2026-05-18T16:26:07.752574Z","iopub.status.idle":"2026-05-18T16:26:08.833873Z","shell.execute_reply.started":"2026-05-18T16:26:07.752494Z","shell.execute_reply":"2026-05-18T16:26:08.833297Z"}},"outputs":[{"name":"stdout","text":"Split preview for different trajectory lengths:\n  n_pairs=9: [{'train': (0, 4), 'val': (4, 6)}, {'train': (0, 6), 'val': (6, 9)}]\n  n_pairs=11: [{'train': (0, 5), 'val': (5, 8)}, {'train': (0, 8), 'val': (8, 11)}]\n  n_pairs=13: [{'train': (0, 6), 'val': (6, 9)}, {'train': (0, 9), 'val': (9, 13)}]\n  n_pairs=15: [{'train': (0, 7), 'val': (7, 11)}, {'train': (0, 11), 'val': (11, 15)}]\n  n_pairs=17: [{'train': (0, 8), 'val': (8, 12)}, {'train': (0, 12), 'val': (12, 17)}]\n\nRunning CV over 13 alphas...\n\n  alpha =    0.00100  |  avg val MSE = 0.312481  (skipped 0 short subjects)\n  alpha =    0.00316  |  avg val MSE = 0.147781  (skipped 0 short subjects)\n  alpha =    0.01000  |  avg val MSE = 0.067739  (skipped 0 short subjects)\n  alpha =    0.03162  |  avg val MSE = 0.040231  (skipped 0 short subjects)\n  alpha =    0.10000  |  avg val MSE = 0.031291  (skipped 0 short subjects)\n  alpha =    0.31623  |  avg val MSE = 0.027301  (skipped 0 short subjects)\n  alpha =    1.00000  |  avg val MSE = 0.025905  (skipped 0 short subjects)\n  alpha =    3.16228  |  avg val MSE = 0.026735  (skipped 0 short subjects)\n  alpha =   10.00000  |  avg val MSE = 0.030530  (skipped 0 short subjects)\n  alpha =   31.62278  |  avg val MSE = 0.037768  (skipped 0 short subjects)\n  alpha 