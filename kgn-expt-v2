  ).long().to(DEVICE)\n            z_t = encoder(edge_index, num_nodes=n_nodes)\n            latent_seq.append(z_t.squeeze(0).cpu().numpy())\n\n    z = np.array(latent_seq)  # (T, latent_dim)\n\n    # Fit linear map on first 75% of the sequence\n    T       = len(z)\n    n_train = int(T * 0.75)\n\n    z_in  = z[:-1]   # z_t\n    z_out = z[1:]    # z_{t+1}\n\n    reg   = LinearRegression(fit_intercept=False).fit(z_in[:n_train], z_out[:n_train])\n    z_hat = reg.predict(z_in[n_train:])  # test on held-out 25%\n\n    # R² computed per latent dimension, then averaged\n    r2_per_dim = [\n        r2_score(z_out[n_train:, d], z_hat[:, d])\n        for d in range(latent_dim)\n    ]\n    return float(np.mean(r2_per_dim)), r2_per_dim\n\n\nif USE_COTRAIN:\n    print(\"Linearity diagnostic (R^2 of linear fit on latent trajectories)\\n\")\n    print(f\"{'Variant':<22}  {'Latent Dim':>10}  {'R²':>8}\")\n    print(\"-\" * 45)\n    \n    DIAG_VARIANT = 'SBM-Signal-Strong'  # most signal → fairest test for linearity\n    \n    linearity_results = {}\n    \n    for latent_dim in LATENT_DIMS:\n        enc = trained_encoders[(SBM_VARIANTS[DIAG_VARIANT]['n_nodes'], latent_dim)]\n        r2, per_dim = compute_latent_linearity(enc, DIAG_VARIANT, latent_dim, seed=4)\n        linearity_results[latent_dim] = r2\n        print(f\"{DIAG_VARIANT:<22}  {latent_dim:>10}  {r2:>8.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T10:57:40.596348Z","iopub.execute_input":"2026-05-16T10:57:40.596618Z","iopub.status.idle":"2026-05-16T10:57:40.846581Z","shell.execute_reply.started":"2026-05-16T10:57:40.596590Z","shell.execute_reply":"2026-05-16T10:57:40.845987Z"}},"outputs":[],"execution_count":7},{"cell_type":"code","source":"# Encode all the graphs to latent space\n\nprint(f\"\\nEncoding all graphs to latent space\\n\")\n\nfor variant_name, params in SBM_VARIANTS.items():\n    n_nodes = params['n_nodes']\n\n    for latent_dim in LATENT_DIMS:\n        # Get the correct enc