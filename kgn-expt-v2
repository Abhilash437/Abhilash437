eq = train_subject_graphs[idx]\n        label = subject_labels[idx]\n        T = adj_seq.shape[0]\n        if T < 3: continue\n        \n        # 1. Extract frozen trajectories\n        with torch.no_grad():\n            z_list = []\n            for t in range(T):\n                edge_index = torch.from_numpy(np.array(np.where(adj_seq[t] > 0))).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n            Z = torch.cat(z_list, dim=0).cpu().numpy()\n            \n        # 2. Compute individual Empirical Koopman matrix\n        X = Z[:-1, :]\n        Y = Z[1:, :]\n        XTX = np.dot(X.T, X) + alpha_ridge * np.eye(latent_dim)\n        XTY = np.dot(X.T, Y)\n        K_subject = np.dot(np.linalg.inv(XTX), XTY)\n        \n        # 3. Extract frequencies from complex angles\n        evals, _ = np.linalg.eig(K_subject)\n        frequencies = np.array([cmath.phase(ev) / (2 * np.pi) for ev in evals])\n        active_freqs = frequencies[frequencies > 0] # Filter out negative mirror frequencies\n        \n        if len(active_freqs) == 0: continue\n            \n        # 4. Calculate the fraction of active modes landing in our target band\n        modes_in_band = np.sum((active_freqs >= f_low) & (active_freqs <= f_high))\n        mass_fraction = modes_in_band / len(active_freqs)\n        \n        if label == 1:\n            asd_masses.append(mass_fraction)\n        else:\n            td_masses.append(mass_fraction)\n            \n    asd_masses = np.array(asd_masses)\n    td_masses = np.array(td_masses)\n    \n    # ────────────────────────────────────────────────────────\n    # STATISTICAL TESTING 1: MANN-WHITNEY U TEST\n    # ────────────────────────────────────────────────────────\n    u_stat, mwu_p = mannwhitneyu(asd_masses, td_masses, alternative='two-sided')\n    \n    # ──────────────────────────────────────────────────