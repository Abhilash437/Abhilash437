cution_count":null},{"cell_type":"code","source":"# Cell 52E — Full-batch supervised training\n#\n# Two structural changes from 52C:\n#   Change 1: optimizer.zero_grad() moved OUTSIDE subject loop\n#   Change 2: optimizer.step() moved OUTSIDE subject loop\n#   Change 3: Added subject shuffling each epoch to avoid\n#             order-dependent gradient bias\n#\n# Everything else identical to 52C\n\ndef train_supervised_encoder_abide_v3(\n    n_nodes,\n    latent_dim,\n    train_subject_graphs,\n    train_subject_labels,\n    n_epochs   = 200,\n    lr         = 1e-3,\n    lambda_cls = None\n):\n    enc        = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    dec        = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    classifier = nn.Sequential(\n        nn.Linear(latent_dim, 16),\n        nn.ReLU(),\n        nn.Dropout(p=0.3),\n        nn.Linear(16, 2)\n    ).to(DEVICE)\n\n    optimizer  = Adam(\n        list(enc.parameters()) +\n        list(dec.parameters()) +\n        list(classifier.parameters()),\n        lr=lr\n    )\n    ce_loss_fn = nn.CrossEntropyLoss()\n\n    # ── Calibration pass ─────────────────────────────────────\n    # Identical to 52C — measure loss scales before training\n    # update_weights=False so parameters do not change here\n    def run_epoch(update_weights=True):\n        enc.train(); dec.train(); classifier.train()\n\n        total_recon = 0.0\n        total_cls   = 0.0\n        correct     = 0\n        n_subjects  = len(train_subject_graphs)\n\n        # Shuffle subject order each epoch\n        # This prevents the gradient accumulation from being\n        # biased toward whichever subject appears last\n        # np.random.permutation returns a shuffled index array\n        perm = np.random.permutation(n_subjects)\n\n        # ── Full-batch: zero gradients ONCE before all subjects ──\n        if update_weights:\n            optimizer.zero_grad()\n\n        for idx in perm:\n            adj_seq = tra