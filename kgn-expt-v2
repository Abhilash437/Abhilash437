och-0 cls loss   : {c0:.4f}\")\n    print(f\"  Calibrated λ       : {lambda_cls:.4f}\")\n\n    print(f\"\\n {'Epoch':>6} | {'Recon':>8} | {'Koop Physics':>12} | {'Cls':>8} | {'Train Acc':>10}\")\n    print(\"-\" * 65)\n\n    for epoch in range(1, n_epochs + 1):\n        r, c, k, acc = run_epoch(update_weights=True, epoch=epoch)\n        if epoch % 25 == 0:\n            print(f\" {epoch:>3}/{n_epochs} | {r:>8.4f} | {k:>12.4f} | {c:>8.4f} | {acc:>10.3f}\")\n\n    return enc, dec, koopman_transition, classifier\n\n\n# ── Run it ──\nprint(\"=\" * 65)\nprint(\"Training supervised encoder v7 (Parametric Koopman Evolution)\")\nprint(\"=\" * 65)\n\nsup_encoder_v7, _, sup_koopman_v7, sup_classifier_v7 = train_supervised_encoder_abide_v7(\n    n_nodes               = ABIDE_N_NODES,\n    latent_dim            = ABIDE_LATENT_DIM,\n    train_subject_graphs  = train_subject_graphs,\n    train_subject_labels  = train_subject_labels,\n    pretrained_encoder    = abide_encoder,\n    n_epochs              = 200,\n    lr                    = 1e-2,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:44:40.742404Z","iopub.execute_input":"2026-05-18T15:44:40.742816Z","iopub.status.idle":"2026-05-18T16:02:31.246566Z","shell.execute_reply.started":"2026-05-18T15:44:40.742788Z","shell.execute_reply":"2026-05-18T16:02:31.245871Z"}},"outputs":[{"name":"stdout","text":"=================================================================\nTraining supervised encoder v7 (Parametric Koopman Evolution)\n=================================================================\nCalibrating λ from epoch-0 loss scales...\n  Epoch-0 recon loss : 173.6650\n  Epoch-0 cls loss   : 41.7911\n  Calibrated λ       : 2.0778\n\n  Epoch |    Recon | Koop Physics |      Cls |  Train Acc\n-----------------------------------------------------------------\n  25/200 | 102.8743 |       0.5207 |  40.3703 |      0.583\n  50/200 | 101.0405 |       0.3943 |  39.6647 |      0.583\n  75/200 | 100.4890 |    