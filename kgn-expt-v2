amics to Frequencies and Magnitudes\n        magnitudes = np.abs(evals)\n        frequencies = np.array([cmath.phase(ev) / (2 * np.pi) for ev in evals])\n        \n        if label == 1: # ASD Cohort\n            asd_eigenvalues.extend(evals)\n            asd_max_mags.append(np.max(magnitudes))\n            asd_frequencies.extend(frequencies[frequencies > 0]) \n        else: # Typically Developing Controls (TD)\n            td_eigenvalues.extend(evals)\n            td_max_mags.append(np.max(magnitudes))\n            td_frequencies.extend(frequencies[frequencies > 0])\n\n    asd_evals = np.array(asd_eigenvalues)\n    td_evals = np.array(td_eigenvalues)\n    \n    # ────────────────────────────────────────────────────────\n    # DIAGNOSTIC PLOT 1: COMPLEX PLANAR MAP (Using Raw Strings)\n    # ────────────────────────────────────────────────────────\n    plt.figure(figsize=(8, 8))\n    \n    # Plot mathematical Unit Circle boundary line\n    theta = np.linspace(0, 2*np.pi, 200)\n    plt.plot(np.cos(theta), np.sin(theta), color='black', linestyle='--', alpha=0.6, label='Unit Circle (Stability Bounds)')\n    \n    # Scatter spectral vectors across Real vs Imaginary components\n    plt.scatter(td_evals.real, td_evals.imag, color='teal', alpha=0.4, marker='o', s=25, label='Typically Developing (TD)')\n    plt.scatter(asd_evals.real, asd_evals.imag, color='darkorange', alpha=0.4, marker='x', s=30, label='Autism Spectrum (ASD)')\n    \n    plt.title(\"Koopman Spectral Footprint: ASD vs. TD Eigenvalue Domain\", fontsize=12, fontweight='bold')\n    plt.xlabel(r\"Real Component ($\\mathcal{R}e(\\lambda)$)\", fontsize=10)\n    plt.ylabel(r\"Imaginary Component ($\\mathcal{I}m(\\lambda)$)\", fontsize=10)\n    plt.axhline(0, color='gray', linestyle=':', alpha=0.5)\n    plt.axvline(0, color='gray', linestyle=':', alpha=0.5)\n    plt.grid(True, linestyle='--', alpha=0.3)\n    plt.legend(loc='upper right', fontsize=10)\n    plt.axis('equal')\n    \n    plt.tight_layout()\n    plt.savefig(os.path.join(SAVE_DIR, \"koopman_spectral_plane.png\"), dpi=300)\n    plt.show()\n    \n    # ────────────────────────────────────────────────────────\n    # DIAGNOSTIC PLOT 2: DISTRIBUTION OF CYCLICAL MODES\n    # ────────────────────────────────────────────────────────\n    plt.figure(figsize=(10, 5))\n    sns.kdeplot(td_frequencies, fill=True, color='teal', label='Typically Developing (TD)', bw_adjust=0.7, alpha=0.4, linewidth=2)\n    sns.kdeplot(asd_frequencies, fill=True, color='darkorange', label='Autism Spectrum (ASD)', bw_adjust=0.7, alpha=0.4, linewidth=2)\n    \n    plt.title(\"Latent Trajectory Oscillation Profile: Dominant Frequency Signatures\", fontsize=12, fontweight='bold')\n    plt.xlabel(r\"Normalized Latent Cycle Frequency ($f = \\theta / 2\\pi$)\", fontsize=10)\n    plt.ylabel(\"Density Estimation\", fontsize=10)\n    plt.grid(True, linestyle='--', alpha=0.3)\n    plt.legend(loc='upper right', fontsize=10)\n    \n    plt.tight_layout()\n    plt.savefig(os.path.join(SAVE_DIR, \"koopman_frequency_distribution.png\"), dpi=300)\n    plt.show()\n    \n    print(\"\\n\" + \"-\"*50)\n    print(\"QUANTITATIVE DYNAMICS PROFILE SUMMARY\")\n    print(\"-\"*50)\n    print(f\"Mean Max Eigenvalue Magnitude (TD)  : {np.mean(td_max_mags):.5f}\")\n    print(f\"Mean Max Eigenvalue Magnitude (ASD) : {np.mean(asd_max_mags):.5f}\")\n    print(f\"Peak Frequency Mode observed (TD)   : {np.mean(td_frequencies):.5f}\")\n    print(f\"Peak Frequency Mode observed (ASD)  : {np.mean(asd_frequencies):.5f}\")\n    print(\"-\" * 50)\n    \n    return {\"asd_evals\": asd_evals, \"td_evals\": td_evals}\n\n# Re-run execution mapping directly to your workspace variable array\nspectral_data = analyze_koopman_spectral_biomarkers(\n    encoder=sup_encoder_v7,\n    train_subject_graphs=train_subject_graphs,\n    subject_labels=train_subject_labels, # Successfully pointed to native notebook array\n    latent_dim=ABIDE_LATENT_DIM\n)","metadata":{"trusted":true,"execution":{"iopub.st