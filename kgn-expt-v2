gives the encoder time to converge.\n    \"\"\"\n    enc = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n\n    optimizer = Adam(\n        list(enc.parameters()) + list(dec.parameters()), lr=lr\n    )\n\n    enc.train(); dec.train()\n\n    for epoch in range(n_epochs):\n        total_loss = 0\n        for adj_t in train_graphs:\n            adj_t      = adj_t.to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy() > 0))\n            ).long().to(DEVICE)\n\n            z        = enc(edge_index, num_nodes=n_nodes)\n            adj_pred = dec.reconstruct_adjacency(z)\n\n            num_ones  = adj_t.sum()\n            num_zeros = adj_t.numel() - num_ones\n\n            # Fix 1: true ratio, no artificial floor\n            pw_val = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n\n            loss = F.binary_cross_entropy_with_logits(\n                adj_pred, adj_t,\n                pos_weight=torch.tensor([pw_val], device=DEVICE)\n            )\n\n            optimizer.zero_grad()\n            loss.backward()\n            optimizer.step()\n            total_loss += loss.item()\n\n        if (epoch + 1) % 25 == 0:\n            print(f\"    Epoch {epoch+1}/{n_epochs}  \"\n                  f\"Loss: {total_loss/len(train_graphs):.4f}  \"\n                  f\"pos_weight≈{pw_val:.2f}\")\n\n    return enc.eval(), dec.eval()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:06:18.654195Z","iopub.execute_input":"2026-05-24T05:06:18.654733Z","iopub.status.idle":"2026-05-24T05:06:18.677848Z","shell.execute_reply.started":"2026-05-24T05:06:18.654696Z","shell.execute_reply":"2026-05-24T05:06:18.676852Z"}},"outputs":[],"execution_count":17},{"cell_type":"code","source":"# ============================================================\n# CELL C — Koopman Feature Extraction + ASD/TD Classification\n#\n# Pipeline per subject:\n#   1. Encode graph sequence → latent trajectory Z (T × latent_dim)\n#   2. Fit K via least squares: Z[1:] ≈ Z[:-1] @ K.T\n#   3. Extract eigenvalues of K → magnitudes + phases (spectral features)\n#   4. Concatenate with mean of Z (mean features)\n#   5. Train logistic regression classifier on combined features\n#\n# References:\n#   - Koopman spectral analysis: Brunton et al., PLOS Computational Biology 2016\n#     https://doi.org/10.1371/journal.pcbi.1005146\n#   - Dynamic FC in ASD: Dynamics of functional connectivity in ASD\n#     Falahpour et al., Cerebral Cortex 2016\n#     https://doi.org/10.1093/cercor/bhw027\n# ============================================================\n\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.model_selection import StratifiedKFold, cross_val_score\nfrom sklearn.metrics import classification_report, roc_auc_score\nimport numpy as np\n\n# ── Configuration ─────────────────────────────────────────────\nABIDE_LATENT_DIM = 32     # smaller than SBM — fewer snapshots per subject\n                           # latent_dim should be < n_snapshots for K to be well-fitted\nN_ROIS_ABIDE     = 116\nABIDE_N_NODES    = N_ROIS_ABIDE\n\n# ── Block 1: Train encoder on ABIDE graphs ───────────────────\n# We use the same GraphEncoder architecture as SBM/JODIE.\n# Training objective: reconstruct each FC adjacency matrix.\n# No co-training here — we want reconstruction quality first,\n# then extract Koopman features from the learned latent space.\n#\n# Important: we train ONE shared encoder across all subjects.\n# This is standard in neuroimaging — a shared feature extractor\n# learns what brain graph structure looks like in general,\n# then subject-specific trajectories diverge in latent space.\n\nprint(\"=\" * 55)\nprint(\"BLOCK 1: Training shared GraphEncoder on ABIDE\")\nprint(\"=\" * 55)\n\n# Collect all snapshots from all subjects into one flat list\n# for encoder training — the encoder sees individual graphs,\n# not sequences. Sequence structure is only used in Block 2.\nall_train_graphs = []\nfor adj_seq in abide_adj_tensors:\n    for t in range(adj_seq.shape[0]):\n        all_train_graphs.append(\n            torch.from_numpy(adj_seq[t]).float()\n        )\n\nprint(f\"Total snapshots for encoder training: {len(all_train_graphs)}\")\nprint(f\"n_nodes={ABIDE_N_NODES}, latent_dim={ABIDE_LATENT_DIM}\\n\")\n\nabide_encoder, abide_decoder = train_encoder_decoder_abide(\n    n_nodes     = ABIDE_N_NODES,\n    latent_dim  = ABIDE_LATENT_DIM,\n    train_graphs= all_train_graphs,\n    n_epochs    = 150,\n    lr          = 1e-3\n)\n\nprint(f\"\\n✓ Encoder trained on {len(all_train_graphs)} ABIDE snapshots\")\n\n# ── Block 2: Encode each subject → latent trajectory ────────\n# For each subject, encode their sequence of T snapshots\n# into a (T, latent_dim) latent trajectory Z.\n# Then fit the Koopman operator K via least squares.\n\nprint(\"\\n\" + \"=\" * 55)\nprint(\"BLOCK 2: Encoding subjects → Koopman features\")\nprint(\"=\" * 55)\n\ndef extract_koopman_features(encoder, adj_seq, n_nodes, latent_dim):\n    \"\"\"\n    Encodes a subject's graph sequence and extracts Koopman features.\n\n    Step 1 — Encode: run GraphEncoder on each snapshot\n             → Z shape: (T, latent_dim)\n\n    Step 2 — Fit K via least squares:\n             We want K such that Z[1:] ≈ Z[:-1] @ K.T\n             This is equivalent to: for each t, z_{t+1} ≈ K z_t\n             Least squares solution: K = (Z[:-1]^+ Z[1:]).T\n             where ^+ is the pseudoinverse.\n\n             Why least squares and not gradient descent?\n             With only ~17 timepoints, gradient descent is unstable.\n             Least squares gives the globally optimal K in one shot.\n\n    Step 3 — Eigendecomposition of K:\n             K has latent_dim eigenvalues (complex numbers).\n             Each eigenvalue λ = r·e^{iθ} encodes:\n               |λ| (magnitude) = how fast this mode decays (|λ|=1: stable)\n               θ   (phase)     = oscillation frequency of this mode\n\n    Step 4 — Feature vector:\n             Concatenate [sorted eigenvalue magnitudes,\n                          sorted eigenvalue phases,\n                          mean of Z across time]\n             Shape: latent_dim + latent_dim + latent_dim = 3 × latent_dim\n\n    Parameters\n    ----------\n    encoder   : trained GraphEncoder\n    adj_seq   : np.ndarray (T, 116, 116) — subject's adjacency sequence\n    n_nodes   : int\n    latent_dim: int\n\n    Returns\n    -------\n    features  : np.ndarray (3 × latent_dim,) — Koopman + mean features\n    Z         : np.ndarray (T, latent_dim)   — latent trajectory (for diagnostics)\n    K         : np.ndarray (latent_dim, latent_dim) — fitted Koopman matrix\n    \"\"\"\n    T = adj_seq.shape[0]\n\n    # Step 1 — Encode all snapshots\n    encoder.eval()\n    Z = []\n    with torch.no_grad():\n        for t in range(T):\n            adj_t      = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_seq[t] > 0))\n            ).long().to(DEVICE)\n\n            # Guard: skip empty graphs (shouldn't happen after density filter)\n            if edge_index.numel() == 0:\n                z_t = torch.zeros(1, latent_dim, device=DEVICE)\n            else:\n                z_t = encoder(edge_index, num_nodes=n_nodes)\n\n            Z.append(z_t.squeeze(0).cpu().numpy())\n\n    Z = np.array(Z)   # (T, latent_dim)\n\n    # Step 2 — Fit K via least squares\n    # Z_in  = Z[0:T-1]  shape (T-1, latent_dim) — current states\n    # Z_out = Z[1:T]    shape (T-1, latent_dim) — next states\n    # We solve: Z_out = Z_in @ K.T\n    # np.linalg.lstsq solves: min ||Z_in @ K.T - Z_out||_F\n    Z_in  = Z[:-1]   # (T-1, latent_dim)\n    Z_out = Z[1:]    # (T-1, latent_dim)\n\n    # lstsq returns K.T, so we transpose\n    K_T, _, _, _ = np.linalg.lstsq(Z_in, Z_out, rcond=None)\n    K = K_T.T        # (latent_dim, latent_dim)\n\n    # Step 3 — Eigendecomposition\n    # np.linalg.eigvals: returns complex eigenvalues\n    # We sort by magnitude (descending) so the feature vector\n    # is order-invariant — same subject always gives same feature order\n    eigenvalues = np.linalg.eigvals(K)                        # (latent_dim,) complex\n    magnitudes  = np.abs(eigenvalues)                         # |λ|\n    phases      = np.angle(eigenvalues)                       # θ in [-π, π]\n\n    sort_idx    = np.argsort(magnitudes)[::-1]                # descending by magnitude\n    magnitudes  = magnitudes[sort_idx]\n    phases      = phases[sort_idx]\n\n    # Step 4 — Feature vector\n    mean_z      = Z.mean(axis=0)                              # (latent_dim,)\n    features    = np.concatenate([magnitudes, phases, mean_z]) # (3×latent_dim,)\n\n    return features, Z, K\n\n\n# Extract features for all subjects\nfeature_list = []\ntrajectory_list = []   # store Z for each subject (diagnostics)\n\nprint(f\"Extracting Koopman features for {len(abide_adj_tensors)} subjects...\")\n\nfor i, adj_seq in enumerate(abide_adj_tensors):\n    feats, Z, K = extract_koopman_features(\n        abide_encoder, adj_seq, ABIDE_N_NODES, ABIDE_LATENT_DIM\n    )\n    feature_list.append(feats)\n    trajectory_list.append(Z)\n\nX = np.array(feature_list)    # (n_subjects, 3×latent_dim)\ny = valid_labels_b             # (n_subjects,) — ASD=1, TD=0\n\nprint(f\"✓ Feature matrix: {X.shape}\")\nprint(f\"  Features per subject: {X.shape[1]} \"\n      f\"({ABIDE_LATENT_DIM} magnitudes + \"\n      f\"{ABIDE_LATENT_DIM} phases + \"\n      f\"{ABIDE_LATENT_DIM} mean)\")\n\n# ── Block 3: Classification ───────────────────────────────────\nprint(\"\\n\" + \"=\" * 55)\nprint(\"BLOCK 3: ASD vs TD Classification\")\nprint(\"=\" * 55)\n\n# Stratified 5-fold cross-validation\n# Stratified = each fold preserves the ASD/TD ratio\n# This is essential with only 76 subjects — a random split\n# could accidentally put all ASD in train or test.\ncv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n\n# We compare three feature sets to isolate Koopman's contribution\nfeature_sets = {\n    'Koopman eigenvalues only' : X[:, :2*ABIDE_LATENT_DIM],   # magnitudes + phases\n    'Mean latent only'         : X[:, 2*ABIDE_LATENT_DIM:],   # mean_z\n    'Koopman + Mean (full)'    : X,                            # all three\n}\n\nprint(f\"\\nLogistic Regression, 5-fold stratified CV\\n\")\nprint(f\"{'Feature Set':<30} {'Mean AUC':>10} {'Std':>8} {'Mean Acc':>10}\")\nprint(\"-\" * 62)\n\nresults = {}\n\nfor name, X_feat in feature_sets.items():\n    # StandardScaler: zero-mean, unit-variance per feature\n    # Must be fit inside CV to avoid data leakage\n    # We use a Pipeline implicitly by scaling inside the loop\n    auc_scores = []\n    acc_scores = []\n\n    for train_idx, test_idx in cv.split(X_feat, y):\n        X_tr, X_te = X_feat[train_idx], X_feat[test_idx]\n        y_tr, y_te = y[train_idx],      y[test_idx]\n\n        # Scale — fit on train only, apply to test\n        scaler = StandardScaler()\n        X_tr   = scaler.fit_transform(X_tr)\n        X_te   = scaler.transform(X_te)\n\n        clf = LogisticRegression(max_iter=1000, random_state=42, C=0.1)\n        clf.fit(X_tr, y_tr)\n\n        auc_scores.append(roc_auc_score(y_te, clf.predict_proba(X_te)[:, 1]))\n        acc_scores.append(clf.score(X_te, y_te))\n\n    results[name] = {'auc': auc_scores, 'acc': acc_scores}\n    print(f\"{name:<30} {np.mean(auc_scores):>10.4f} \"\n          f\"{np.std(auc_scores):>8.4f} \"\n          f\"{np.mean(acc_scores):>10.4f}\")\n\nprint(\"\\n✓ Classification complete\")\n\n# ── Density reminder for paper ────────────────────────────────\nprint(f\"\\nKey contrast for paper:\")\nprint(f\"  JODIE density : 0.09% → encoder collapse → co-training fails\")\nprint(f\"  ABIDE density : {np.mean(all_densities)*100:.1f}%  → stable encoding → classification possible\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:06:18.680116Z","iopub.execute_input":"2026-05-24T05:06:18.680542Z","iopub.status.idle":"2026-05-24T05:49:18.663776Z","shell.execute_reply.started":"2026-05-24T05:06:18.680490Z","shell.execute_reply":"2026-05-24T05:49:18.663019Z"}},"outputs":[{"name":"stdout","text":"=======================================================\nBLOCK 1: Training shared GraphEncoder on ABIDE\n=======================================================\nTotal snapshots for encoder training: 1222\nn_nodes=116, latent_dim=32\n\n    Epoch 25/150  Loss: 0.9052  pos_weight≈3.12\n    Epoch 50/150  Loss: 0.9261  pos_weight≈3.12\n    Epoch 75/150  Loss: 0.9231  pos_weight≈3.12\n    Epoch 100/150  Loss: 0.9221  pos_weight≈3.12\n    Epoch 125/150  Loss: 0.9219  pos_weight≈3.12\n    Epoch 150/150  Loss: 0.9249  pos_weight≈3.12\n\n✓ Encoder trained on 1222 ABIDE snapshots\n\n=======================================================\nBLOCK 2: Encoding subjects → Koopman features\n=======================================================\nExtracting Koopman features for 76 subjects...\n✓ Feature matrix: (76, 96)\n  Features per subject: 96 (32 magnitudes + 32 phases + 32 mean)\n\n=======================================================\nBLOCK 3: ASD vs TD Classification\n=======================================================\n\nLogistic Regression, 5-fold stratified CV\n\nFeature Set                      Mean AUC      Std   Mean Acc\n--------------------------------------------------------------\nKoopman eigenvalues only           0.6406   0.1451     0.6317\nMean latent only                   0.4004   0.1115     0.4750\nKoopman + Mean (full)              0.6344   0.1254     0.5800\n\n✓ Classification complete\n\nKey contrast for paper:\n  JODIE density : 0.09% → encoder collapse → co-training fails\n  ABIDE density : 23.4%  → stable encoding → classification possible\n","output_type":"stream"}],"execution_count":18},{"cell_type":"code","source":"# ── Sanity Check — can we classify with raw FC at all? ───────\n# If even raw FC features can't classify ASD vs TD on this subset,\n# the problem is data quality, not the Koopman pipeline.\n\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.model_selection import StratifiedKFold\nfrom sklearn.metrics import roc_auc_score\n\nprint(\"SANITY CHECK: Raw mean FC matrix as features\")\nprint(\"=\" * 50)\n\n# For each subject, flatten the mean FC matrix → feature vector\n# This is the simplest possible brain fingerprint\nraw_fc_features = []\nfor adj_seq in abide_adj_tensors:\n    mean_fc = adj_seq.mean(axis=0)                          # (116, 116)\n    triu    = mean_fc[np.triu_indices(116, k=1)]            # upper triangle only\n    raw_fc_features.append(triu)\n\nX_raw = np.array(raw_fc_features)   # (76, 6670)\nprint(f\"Raw FC feature shape: {X_raw.shape}\")\n\ncv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\nauc_scores = []\n\nfor train_idx, test_idx in cv.split(X_raw, y):\n    X_tr, X_te = X_raw[train_idx], X_raw[test_idx]\n    y_tr, y_te = y[train_idx],     y[test_idx]\n\n    scaler = StandardScaler()\n    X_tr   = scaler.fit_transform(X_tr)\n    X_te   = scaler.transform(X_te)\n\n    clf = LogisticRegression(max_iter=1000, C=0.01, random_state=42)\n    clf.fit(X_tr, y_tr)\n    auc_scores.append(roc_auc_score(y_te, clf.predict_proba(X_te)[:, 1]))\n\nprint(f\"Raw FC AUC: {np.mean(auc_scores):.4f} ± {np.std(auc_scores):.4f}\")\nprint()\n\n# Also check label balance per fold\nprint(\"Label distribution check:\")\nprint(f\"  Total: ASD={y.sum()}, TD={(y==0).sum()}, n={len(y)}\")\nfor fold, (train_idx, test_idx) in enumerate(cv.split(X_raw, y)):\n    print(f\"  Fold {fold+1}: train ASD={y[train_idx].sum()}, \"\n          f\"TD={(y[train_idx]==0).sum()} | \"\n          f\"test ASD={y[test_idx].sum()}, \"\n          f\"TD={(y[test_idx]==0).sum()}\")\n\n# Check encoder quality — does it produce different latents for different graphs?\nprint(\"\\nEncoder quality check:\")\nZ_all = np.array([t.mean(axis=0) for t in trajectory_list])  # (76, 32)\nprint(f\"  Mean latent variance across subjects: {Z_all.var(axis=0).mean():.6f}\")\nprint(f\"  If near zero → encoder collapsed (all subjects look the same)\")\nprint(f\"  If > 0.001   → encoder is discriminative\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:49:18.664840Z","iopub.execute_input":"2026-05-24T05:49:18.665700Z","iopub.status.idle":"2026-05-24T05:49:18.954648Z","shell.execute_reply.started":"2026-05-24T05:49:18.665647Z","shell.execute_reply":"2026-05-24T05:49:18.953900Z"}},"outputs":[{"name":"stdout","text":"SANITY CHECK: Raw mean FC matrix as features\n==================================================\nRaw FC feature shape: (76, 6670)\nRaw FC AUC: 0.5987 ± 0.0985\n\nLabel distribution check:\n  Total: ASD=37, TD=39, n=76\n  Fold 1: train ASD=29, TD=31 | test ASD=8, TD=8\n  Fold 2: train ASD=29, TD=32 | test ASD=8, TD=7\n  Fold 3: train ASD=30, TD=31 | test ASD=7, TD=8\n  Fold 4: train ASD=30, TD=31 | test ASD=7, TD=8\n  Fold 5: train ASD=30, TD=31 | test ASD=7, TD=8\n\nEncoder quality check:\n  Mean latent variance across subjects: 0.055828\n  If near zero → encoder collapsed (all subjects look the same)\n  If > 0.001   → encoder is discriminative\n","output_type":"stream"}],"execution_count":19},{"cell_type":"code","source":"# Cell 52B — Step 1: Reorganize data by subject\n#\n# Current structure (unsupervised):\n#   all_train_graphs = [adj_t1, adj_t2, ..., adj_tN]  ← flat, no subject grouping\n#\n# New structure (supervised):\n#   subject_graphs = [\n#       [adj_t1, adj_t2, ..., adj_tT],   ← subject 0, T snapshots\n#       [adj_t1, adj_t2, ..., adj_tT],   ← subject 1\n#       ...\n#   ]\n#   subject_labels = [1, 0, 1, ...]      ← one label per subject\n\n# abide_adj_tensors : list of (T, 116, 116) numpy arrays, one per subject\n# valid_labels_b    : numpy array of 0/1 labels, one per subject\n\n# We do a subject-level train/test split (80/20)\n# IMPORTANT: stratified — preserve ASD/TD ratio in both splits\nfrom sklearn.model_selection import train_test_split\n\nsubj_indices = list(range(len(abide_adj_tensors)))\n\ntrain_idx, test_idx = train_test_split(\n    subj_indices,\n    test_size=0.2,\n    stratify=valid_labels_b,   # stratify: ensures both splits have same ASD/TD ratio\n    random_state=42\n)\n\n# Build grouped lists\ntrain_subject_graphs  = [abide_adj_tensors[i] for i in train_idx]\ntrain_subject_labels  = valid_labels_b[train_idx]\n\ntest_subject_graphs   = [abide_adj_tensors[i] for i in test_idx]\ntest_subject_labels   = valid_labels_b[test_idx]\n\nprint(f\"Train subjects: {len(train_subject_graphs)}\")\nprint(f\"  ASD: {train_subject_labels.sum()}  TD: {(train_subject_labels==0).sum()}\")\nprint(f\"Test subjects:  {len(test_subject_graphs)}\")\nprint(f\"  ASD: {test_subject_labels.sum()}  TD: {(test_subject_labels==0).sum()}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:49:18.956178Z","iopub.execute_input":"2026-05-24T05:49:18.956528Z","iopub.status.idle":"2026-05-24T05:49:18.970178Z","shell.execute_reply.started":"2026-05-24T05:49:18.956479Z","shell.execute_reply":"2026-05-24T05:49:18.969413Z"}},"outputs":[{"name":"stdout","text":"Train subjects: 60\n  ASD: 29  TD: 31\nTest subjects:  16\n  ASD: 8  TD: 8\n","output_type":"stream"}],"execution_count":20},{"cell_type":"code","source":"# Cell 52B — Step 2: Supervised encoder training (joint reconstruction + classification)\n#\n# What is new compared to train_encoder_decoder_abide (Cell 52):\n#   - Inner loop is over SUBJECTS, not snapshots\n#   - For each subject: encode all snapshots → mean pool → classify\n#   - Total loss = reconstruction loss + λ × classification loss\n#\n# Architecture:\n#   GraphEncoder  → same as before, no changes\n#   GraphDecoder  → same as before, no changes\n#   Classifier    → small MLP head: latent_dim → 16 → 2\n#                   (2 output logits: one for TD, one for ASD)\n#\n# References:\n#   - Multi-task learning: Caruana, Machine Learning 1997\n#     https://doi.org/10.1023/A:1007379606734\n#   - Joint encoder-classifier training in neuroimaging:\n#     Ktena et al., MICCAI 2018\n#     https://doi.org/10.1007/978-3-030-00931-1_77\n\ndef train_supervised_encoder_abide(\n    n_nodes,\n    latent_dim,\n    train_subject_graphs,    # list of (T, 116, 116) arrays — one per subject\n    train_subject_labels,    # numpy array of 0/1 labels\n    n_epochs     = 150,\n    lr           = 1e-3,\n    lambda_cls   = 0.1       # λ: weight on classification loss\n                             # start small — reconstruction anchors the latent geometry\n                             # classification tilts it toward ASD/TD separation\n):\n    # ── Piece 1: Initialise models ───────────────────────────\n    # Same encoder and decoder as the unsupervised version\n    # New: a small classifier MLP on top of the mean latent vector\n    #\n    # nn.Linear(latent_dim, 16): projects 32-dim latent to 16-dim hidden\n    # nn.ReLU(): non-linearity — without this the two Linear layers\n    #            collapse into a single linear map (no expressive power gain)\n    # nn.Linear(16, 2): outputs 2 logits (one per class: TD=0, ASD=1)\n    #                   we use 2 outputs (not 1) because CrossEntropyLoss\n    #                   expects one logit per class\n\n    enc        = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    dec        = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    classifier = nn.Sequential(\n        nn.Linear(latent_dim, 16),\n        nn.ReLU(),\n        nn.Dropout(p=0.3),      # Dropout: randomly zeros 30% of neurons during training\n                                 # prevents the classifier from over-relying on any\n                                 # single latent dimension — critical with only ~60 subjects\n        nn.Linear(16, 2)\n    ).to(DEVICE)\n\n    # ── Piece 2: Single optimiser over ALL parameters ────────\n    # We pass parameters from all three modules together\n    # This means one .backward() call updates encoder, decoder,\n    # AND classifier simultaneously — they co-adapt\n    #\n    # list(...) + list(...): concatenates two Python lists of tensors\n    # Adam: adaptive learning rate optimiser — handles the fact that\n    #       reconstruction and classification losses have different scales\n    optimizer = Adam(\n        list(enc.parameters()) +\n        list(dec.parameters()) +\n        list(classifier.parameters()),\n        lr=lr\n    )\n\n    # nn.CrossEntropyLoss: combines log-softmax + negative log-likelihood\n    # Expects raw logits (NOT softmax outputs) and integer class labels\n    # Internally computes: loss = -log(softmax(logits)[true_class])\n    ce_loss_fn = nn.CrossEntropyLoss()\n\n    enc.train(); dec.train(); classifier.train()\n\n    for epoch in range(n_epochs):\n        total_recon_loss = 0.0\n        total_cls_loss   = 0.0\n        correct          = 0\n\n        # ── Piece 3: Subject-level loop ──────────────────────\n        for adj_seq, label in zip(train_subject_graphs, train_subject_labels):\n            # adj_seq shape: (T, 116, 116) — T snapshots for this subject\n            T = adj_seq.shape[0]\n\n            subject_recon_loss = 0.0\n            z_list             = []   # will collect z_t for each snapshot\n\n            # Inner loop: encode each snapshot, accumulate reconstruction loss\n            for t in range(T):\n                adj_t = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n\n                # Build edge_index from adjacency matrix\n                # np.where(adj > 0) returns (row_indices, col_indices) of edges\n                # np.array([rows, cols]) → shape (2, n_edges)\n                # .long() converts to integer type required by PyG\n                edge_index = torch.from_numpy(\n                    np.array(np.where(adj_seq[t] > 0))\n                ).long().to(DEVICE)\n\n                if edge_index.numel() == 0:\n                    # Empty graph guard: use zero vector\n                    z_t = torch.zeros(1, latent_dim, device=DEVICE)\n                else:\n                    z_t = enc(edge_index, num_nodes=n_nodes)  # (1, latent_dim)\n\n                z_list.append(z_t)\n\n                # Reconstruction loss for this snapshot\n                adj_pred  = dec.reconstruct_adjacency(z_t)\n                num_ones  = adj_t.sum()\n                num_zeros = adj_t.numel() - num_ones\n                pw_val    = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n\n                # F.binary_cross_entropy_with_logits:\n                #   - expects raw logits (before sigmoid), not probabilities\n                #   - pos_weight: upweights the loss on positive (edge=1) examples\n                #     to compensate for class imbalance in sparse graphs\n                subject_recon_loss += F.binary_cross_entropy_with_logits(\n                    adj_pred, adj_t,\n                    pos_weight=torch.tensor([pw_val], device=DEVICE)\n                )\n\n            # Mean pool across time: z_mean shape (1, latent_dim)\n            # torch.cat: concatenates list of (1, latent_dim) tensors → (T, latent_dim)\n            # .mean(dim=0, keepdim=True): averages across T → (1, latent_dim)\n            z_mean = torch.cat(z_list, dim=0).mean(dim=0, keepdim=True)\n\n            # Classification loss\n            # label_tensor: shape (1,) integer tensor — CrossEntropyLoss requires LongTensor\n            label_tensor = torch.tensor([label], dtype=torch.long, device=DEVICE)\n            logits       = classifier(z_mean)          # (1, 2)\n            cls_loss     = ce_loss_fn(logits, label_tensor)\n\n            # Total loss for this subject\n            # subject_recon_loss is summed over T snapshots — normalise by T\n            # so reconstruction scale does not grow with sequence length\n            recon_loss_norm = subject_recon_loss / T\n            loss            = recon_loss_norm + lambda_cls * cls_loss\n\n            optimizer.zero_grad()\n            loss.backward()    # computes gradients for ALL parameters jointly\n            optimizer.step()\n\n            total_recon_loss += recon_loss_norm.item()\n            total_cls_loss   += cls_loss.item()\n\n            # Track training accuracy\n            pred    = logits.argmax(dim=1)\n            correct += (pred.item() == label)\n\n        # ── Logging every 25 epochs ──────────────────────────\n        if (epoch + 1) % 25 == 0:\n            n_subj    = len(train_subject_graphs)\n            train_acc = correct / n_subj\n            print(f\"Epoch {epoch+1:>3}/{n_epochs} | \"\n                  f\"Recon: {total_recon_loss/n_subj:.4f} | \"\n                  f\"Cls: {total_cls_loss/n_subj:.4f} | \"\n                  f\"Train Acc: {train_acc:.3f}\")\n\n    return enc.eval(), dec.eval(), classifier.eval()\n\n\n# ── Run supervised training ───────────────────────────────────\nprint(\"=\" * 55)\nprint(\"Training supervised encoder (λ=0.1)\")\nprint(\"=\" * 55)\n\nsup_encoder, sup_decoder, sup_classifier = train_supervised_encoder_abide(\n    n_nodes              = ABIDE_N_NODES,\n    latent_dim           = ABIDE_LATENT_DIM,\n    train_subject_graphs = train_subject_graphs,\n    train_subject_labels = train_subject_labels,\n    n_epochs             = 150,\n    lr                   = 1e-3,\n    lambda_cls           = 0.1\n)\n\nprint(\"\\n✓ Supervised encoder trained\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:49:18.972655Z","iopub.execute_input":"2026-05-24T05:49:18.972993Z","iopub.status.idle":"2026-05-24T05:59:51.094853Z","shell.execute_reply.started":"2026-05-24T05:49:18.972949Z","shell.execute_reply":"2026-05-24T05:59:51.094025Z"}},"outputs":[{"name":"stdout","text":"=======================================================\nTraining supervised encoder (λ=0.1)\n=======================================================\nEpoch  25/150 | Recon: 0.9284 | Cls: 0.7012 | Train Acc: 0.433\nEpoch  50/150 | Recon: 0.9256 | Cls: 0.6959 | Train Acc: 0.500\nEpoch  75/150 | Recon: 0.9191 | Cls: 0.6924 | Train Acc: 0.517\nEpoch 100/150 | Recon: 0.9141 | Cls: 0.6927 | Train Acc: 0.500\nEpoch 125/150 | Recon: 0.9123 | Cls: 0.6932 | Train Acc: 0.517\nEpoch 150/150 | Recon: 0.9065 | Cls: 0.6875 | Train Acc: 0.517\n\n✓ Supervised encoder trained\n","output_type":"stream"}],"execution_count":21},{"cell_type":"code","source":"# Cell 52C — Supervised training with loss-calibrated λ\n#\n# Change 1: Run one warm-up epoch to measure loss scales\n# Change 2: Set λ = 0.5 × (recon_scale / cls_scale)\n#\n# Everything else — architecture, loop structure, logging — is identical to 52B\n\ndef train_supervised_encoder_abide_v2(\n    n_nodes,\n    latent_dim,\n    train_subject_graphs,\n    train_subject_labels,\n    n_epochs   = 150,\n    lr         = 1e-3,\n    lambda_cls = None        # None → auto-calibrate from epoch 1\n):\n    enc        = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    dec        = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    classifier = nn.Sequential(\n        nn.Linear(latent_dim, 16),\n        nn.ReLU(),\n        nn.Dropout(p=0.3),\n        nn.Linear(16, 2)\n    ).to(DEVICE)\n\n    optimizer  = Adam(\n        list(enc.parameters()) +\n        list(dec.parameters()) +\n        list(classifier.parameters()),\n        lr=lr\n    )\n    ce_loss_fn = nn.CrossEntropyLoss()\n\n    # ── Helper: one pass over all subjects ───────────────────\n    # Extracted as a function so we can call it identically\n    # during calibration AND during actual training\n    def run_epoch(update_weights=True):\n        \"\"\"\n        Runs one full pass over all training subjects.\n\n        Parameters\n        ----------\n        update_weights : bool\n            If True  → zero_grad + backward + step (normal training)\n            If False → only compute losses, no parameter updates\n                       used during the calibration pass\n\n        Returns\n        -------\n        avg_recon : float — mean reconstruction loss per subject\n        avg_cls   : float — mean classification loss per subject\n        accuracy  : float — fraction of subjects classified correctly\n        \"\"\"\n        enc.train(); dec.train(); classifier.train()\n\n        total_recon = 0.0\n        total_cls   = 0.0\n        correct     = 0\n\n        for adj_seq, label in zip(train_subject_graphs, train_subject_labels):\n            T      = adj_seq.shape[0]\n            z_list = []\n            subj_recon = 0.0\n\n            for t in range(T):\n                adj_t      = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n                edge_index = torch.from_numpy(\n                    np.array(np.where(adj_seq[t] > 0))\n                ).long().to(DEVICE)\n\n                z_t = enc(edge_index, num_nodes=n_nodes) \\\n                      if edge_index.numel() > 0 \\\n                      else torch.zeros(1, latent_dim, device=DEVICE)\n\n                z_list.append(z_t)\n\n                adj_pred  = dec.reconstruct_adjacency(z_t)\n                num_ones  = adj_t.sum()\n                num_zeros = adj_t.numel() - num_ones\n                pw_val    = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n\n                subj_recon += F.binary_cross_entropy_with_logits(\n                    adj_pred, adj_t,\n                    pos_weight=torch.tensor([pw_val], device=DEVICE)\n                )\n\n            z_mean       = torch.cat(z_list, dim=0).mean(dim=0, keepdim=True)\n            label_tensor = torch.tensor([label], dtype=torch.long, device=DEVICE)\n            logits       = classifier(z_mean)\n            cls_loss     = ce_loss_fn(logits, label_tensor)\n\n            recon_norm   = subj_recon / T\n            loss         = recon_norm + lambda_cls * cls_loss\n\n            if update_weights:\n                optimizer.zero_grad()\n                loss.backward()\n                optimizer.step()\n\n            total_recon += recon_norm.item()\n            total_cls   += cls_loss.item()\n            correct     += (logits.argmax(dim=1).item() == label)\n\n        n = len(train_subject_graphs)\n        return total_recon / n, total_cls / n, correct / n\n\n    # ── Step 1: Calibration pass ──────────────────────────────\n    # Run one epoch with λ=1.0 (placeholder) just to measure\n    # the natural scale of both losses before any learning happens.\n    # update_weights=False → no parameters change during this pass.\n    #\n    # We temporarily set lambda_cls=1.0 so the loss computation\n    # inside run_epoch does not crash (it references lambda_cls).\n    # The losses themselves are what we care about, not the total.\n\n    if lambda_cls is None:\n        print(\"Calibrating λ from epoch-0 loss scales...\")\n        lambda_cls     = 1.0          # temporary placeholder\n        r0, c0, _      = run_epoch(update_weights=False)\n\n        # Set λ so classification contributes ~50% of reconstruction\n        # Ratio r0/c0 makes both terms equal scale; ×0.5 keeps recon dominant\n        lambda_cls     = 0.5 * (r0 / c0)\n        print(f\"  Epoch-0 recon loss : {r0:.4f}\")\n        print(f\"  Epoch-0 cls loss   : {c0:.4f}\")\n        print(f\"  Calibrated λ       : {lambda_cls:.4f}\")\n        print(f\"  Effective cls contribution per subject: \"\n              f\"{lambda_cls * c0:.4f} vs recon {r0:.4f}\\n\")\n\n    # ── Step 2: Actual training with calibrated λ ─────────────\n    print(f\"{'Epoch':>8} | {'Recon':>8} | {'Cls':>8} | {'Train Acc':>10}\")\n    print(\"-\" * 45)\n\n    for epoch in range(n_epochs):\n        avg_recon, avg_cls, acc = run_epoch(update_weights=True)\n\n        if (epoch + 1) % 25 == 0:\n            print(f\"{epoch+1:>3}/{n_epochs:>3}   | \"\n                  f\"{avg_recon:>