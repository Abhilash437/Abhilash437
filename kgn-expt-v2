    \n        # Count only trainable parameters\n        trainable_params = sum(p.numel() for p in model_instance.parameters() if p.requires_grad)\n        dynamic_param_counts[model_name] = trainable_params\n        print(f\"  {model_name:<10} : {trainable_params:,} parameters\")\n        \n    except Exception as e:\n        print(f\"  Could not instantiate {model_name} dynamically ({e}). Falling back to theory.\")\n        # Minimal theoretical fallbacks just in case initialization signatures differ\n        fallbacks = {'Koopman': 1024, 'EDMD-lift': 4096, 'MLP': 4224, 'RNN': 9536, 'GRU': 28224}\n        dynamic_param_counts[model_name] = fallbacks[model_name]\n\n# --- 2. Extract Mean Step-1 Performance ---\ndf_bench = df_final[(df_final['step'] == 1) & (df_final['latent_dim'] == TARGET_LATENT_DIM)]\nsummary_bench = df_bench.groupby('model')['f1'].mean().to_dict()\n\n# --- 3. Render the Plot ---\nfig, ax = plt.subplots(figsize=(7, 5))\n\nfor model_name, p_count in dynamic_param_counts.items():\n    if model_name in summary_bench:\n        f1_score = summary_bench[model_name]\n        \n        # Color coding: Blue for Koopman families, Orange for classic Recurrent/MLP networks\n        color = 'dodgerblue' if 'Koopman' in model_name or 'EDMD' in model_name else 'darkorange'\n        marker = 'D' if 'Koopman' in model_name else 'o'\n        \n        ax.scatter(p_count, f1_score, color=color, s=150, marker=marker, edgecolors='black', zorder=3)\n        ax.annotate(\n            f\" {model_name} ({p_count:,} params)\",\n            (p_count, f1_score),\n            textcoords=\"offset points\",\n            xytext=(6, 4),\n            ha='left',\n            fontsize=9,\n            weight='bold' if model_name == 'Koopman' else 'normal'\n        )\n\n# Visual polish\nax.set_xscale('log')\nax.set_xlabel(\"Trainable Transition Parameters (Log Scale)\", fontsize=11)\nax.set_ylabel(f\"Mean F1 Score at Step 1 (Latent Dim = {TARGET_LATENT_DIM})\", fontsize=11)\nax.set_title(\"The Parameter Efficiency Gap (Dynamic)\", fontsize=12, fontweight='bold', pad=15)\nax.grid(True, which=\"both\", linestyle=':', alpha=0.5)\n\n# Emphasize the narrative text block\nax.text(\n    0.05, 0.15,\n    \"Insight:\\nLinear Koopman matches complex recurrent systems\\nperformance at step 1 while being up to ~30× lighter.\",\n    transform=ax.transAxes,\n    bbox=dict(boxstyle=\"round,pad=0.5\", facecolor=\"wheat\", alpha=0.3),\n    fontsize=9\n)\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T13:00:49.491561Z","iopub.execute_input":"2026-05-16T13:00:49.492250Z","iopub.status.idle":"2026-05-16T13:00:49.758582Z","shell.execute_reply.started":"2026-05-16T13:00:49.492216Z","shell.execute_reply":"2026-05-16T13:00:49.757992Z"}},"outputs":[{"name":"stdout","text":"Calculating live model parameter footprints...\n  Koopman    : 8,224 parameters\n  MLP        : 12,448 parameters\n  GRU        : 20,896 parameters\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x500 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":60},{"cell_type":"code","source":"# ================================================================\n# Linearity Diagnostic + Plot 3 (R² bars) + Plot 4 (variance curves)\n#\n# Requires both USE_COTRAIN=True run AND two-stage run to have\n# happened (in either order — both save to disk).\n# r2_results is populated here (SBM) and in the JODIE cell.\n# ================================================================\n\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import r2_score\nimport matplotlib.pyplot as plt\nimport matplotlib.gridspec as gridspec\nimport numpy as np\n\n# DIAG_VARIANT: use the variant with the strongest signal so\n# the R² difference between two-stage and co-trained is clearest.\nDIAG_VARIANT  = 'SBM-Signal-Strong'\nDIAG_LATENT   = 64    # single latent_dim for clean bar chart display\nDIAG_SEED     = 4     # held-out seed — not used in training\nDIAG_N_NODES  = SBM_VARIANTS[DIAG_VARIANT]['n_nodes']  # 100\n\n# r2_results may already have JODIE entries from the JODIE cell.\n# If it doesn't exist yet (running this cell standalone), initialise.\nif 'r2_results' not in dir():\n    r2_results = {}\n\n# ----------------------------------------------------------------\n# Helper — loads encoder weights from disk into a fresh GraphEncoder.\n# This lets us compute R² for BOTH two-stage and co-trained without\n# needing to keep both in memory from training (they may be from\n# separate notebook runs).\n# ----------------------------------------------------------------\ndef load_encoder(dataset, config_tag, n_nodes, latent_dim, in_channels=1, n_users=None):\n    \"\"\"\n    Instantiates a GraphEncoder and loads saved weights from disk.\n\n    Parameters\n    ----------\n    config_tag : str   — 'two_stage' or 'cotrain_balanced' (or other config name)\n    n_nodes    : int\n    latent_dim : int\n    in_channels: int   — 1 for SBM, 3 for JODIE\n    n_users    : int   — only needed when in_channels=3 (JODIE)\n\n    Returns\n    -------\n    enc : GraphEncoder in eval mode, weights loaded from disk\n    \"\"\"\n    path = (MODELS_DIR / dataset / config_tag\n            / f'n_nodes={n_nodes}' / f'latent_dim={latent_dim}' / 'encoder.pt')\n\n    if not path.exists():\n        raise FileNotFoundError(\n            f\"No saved encoder at {path}. \"\n            f\"Run training with config_tag='{config_tag}' first.\"\n        )\n\n    enc = GraphEncoder(\n        latent_dim  = latent_dim,\n        in_channels = in_channels,\n        n_users     = n_users\n    ).to(DEVICE)\n\n    enc.load_state_dict(torch.load(path, map_location=DEVICE))\n    enc.eval()\n    return enc\n\n\n# ----------------------------------------------------------------\n# compute_latent_linearity — unchanged from your original, just\n# exposed here for both SBM configs\n# ----------------------------------------------------------------\ndef compute_latent_linearity(encoder, variant_name, latent_dim, seed=0):\n    \"\"\"\n    Encodes a graph sequence and measures R² of the best linear map\n    z_{t+1} = A·z_t, fitted on the first 75% and evaluated on the\n    held-out 25%.\n\n    R² ≈ 0.07  → latent space has no linear structure (two-stage baseline)\n    R² > 0.50  → co-training shaped the latent space to be linear\n    R² ≈ 1.00  → collapse warning — check latent variance\n    \"\"\"\n    n_nodes = SBM_VARIANTS[variant_name]['n_nodes']\n    graphs  = torch.load(DATA_DIR / variant_name / f'seed_{seed}' / 'graphs.pt')\n\n    encoder.eval()\n    latent_seq = []\n    with torch.no_grad():\n        for t in range(len(graphs)):\n            adj_t      = graphs[t].to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy()))\n            ).long().to(DEVICE)\n            z_t = encoder(edge_index, num_nodes=n_nodes)\n            latent_seq.append(z_t.squeeze(0).cpu().numpy())\n\n    z       = np.array(latent_seq)   # (T, latent_dim)\n    T       = len(z)\n    n_train = int(T * 0.75)\n\n    z_in  = z[:-1]\n    z_out = z[1:]\n\n    reg   = LinearRegression(fit_intercept=False).fit(z_in[:n_train], z_out[:n_train])\n    z_hat = reg.predict(z_in[n_train:])\n\n    r2_per_dim = [\n        r2_score(z_out[n_train:, d], z_hat[:, d])\n        for d in range(latent_dim)\n    ]\n    return float(np.mean(r2_per_dim))\n\n\n# ----------------------------------------------------------------\n# Populate SBM entries in r2_results\n# We load from disk so this cell works whether or not the training\n# cell was run in the same session.\n# ----------------------------------------------------------------\nprint(\"Computing SBM R² scores...\\n\")\n\nfor config_tag, encoder_type in [('two_stage', 'two_stage'),\n                                   (ACTIVE_CONFIG_NAME, 'cotrain')]:\n    try:\n        enc = load_encoder('SBM', config_tag, DIAG_N_NODES, DIAG_LATENT)\n        r2  = compute_latent_linearity(enc, DIAG_VARIANT, DIAG_LATENT, seed=DIAG_SEED)\n        r2_results[('SBM-Signal-Strong', encoder_type, DIAG_LATENT)] = r2\n        print(f\"  SBM  {encoder_type:<15}  latent_dim={DIAG_LATENT}  R²={r2:.4f}\")\n    except FileNotFoundError as e:\n        print(f\"  SKIP: {e}\")\n\n# Pull JODIE entries — already set by the JODIE cell if it ran\njodie_ts  = r2_results.get(('JODIE-Wikipedia', 'two_stage', DIAG_LATENT), None)\njodie_ct  = r2_results.get(('JODIE-Wikipedia', 'cotrain',   DIAG_LATENT), None)\n\nprint(f\"\\n  JODIE two_stage  latent_dim={DIAG_LATENT}  R²={jodie_ts}\")\nprint(f\"  JODIE cotrain    latent_dim={DIAG_LATENT}  R²={jodie_ct}\")\n\n# ----------------------------------------------------------------\n# Pull variance logs (from training cells, or warn if missing)\n# We use latent_dim=32 for both curves — representative and cheap.\n# ----------------------------------------------------------------\nsbm_vlog   = sbm_variance_logs.get((DIAG_N_NODES, DIAG_LATENT), None) if isinstance(sbm_variance_logs, dict) else sbm_variance_logs\njodie_vlog = (jodie_variance_logs.get(DIAG_LATENT, None) if isinstance(jodie_variance_logs, dict) else jodie_variance_logs) \\\n             if 'jodie_variance_logs' in dir() else None\n\nif sbm_vlog is None:\n    print(\"\\nWARNING: sbm_variance_logs not found. \"\n          \"Run SBM training with USE_COTRAIN=True to generate Plot 4.\")\nif jodie_vlog is None:\n    print(\"WARNING: jodie_variance_logs not found. \"\n          \"Run JODIE co-training cell to generate Plot 4.\")\n\n# ================================================================\n# PLOT 3 — R² Linearity Bar Chart\n# ================================================================\nprint(\"\\nGenerating Plot 3: Latent Space Linearity (R²)...\")\n\n# Build bar data — gracefully skip missing entries\nbar_labels = [\n    'SBM\\ntwo-stage',\n    'SBM\\nco-trained',\n    'JODIE\\ntwo-stage',\n    'JODIE\\nco-trained',\n]\nbar_values = [\n    r2_results.get(('SBM-Signal-Strong', 'two_stage', DIAG_LATENT), 0.0),\n    r2_results.get(('SBM-Signal-Strong', 'cotrain',   DIAG_LATENT), 0.0),\n    r2_results.get(('JODIE-Wikipedia',   'two_stage', DIAG_LATENT), 0.0),\n    r2_results.get(('JODIE-Wikipedia',   'cotrain',   DIAG_LATENT), 0.0),\n]\n\n# Color encodes meaning:\n#   seagreen  = co-trained (dynamics loss applied)\n#   steelblue = two-stage  (reconstruction only)\nbar_colors = ['steelblue', 'seagreen', 'steelblue', 'seagreen']\n\nfig, ax = plt.subplots(figsize=(7, 4.5))\n\n# Cap visual height at -1.0 for the extreme outlier so it doesn't crush the scale\nplotted_values = [max(v, -1.0) for v in bar_values]\n\nbars = ax.bar(bar_labels, plotted_values, color=bar_colors,\n              edgecolor='black', linewidth=0.7, width=0.5)\n\n# Value labels positioned cleanly relative to the zero-axis line\nfor bar, val in zip(bars, bar_values):\n    h = bar.get_height()\n    if val < 0:\n        va_dir = 'top'\n        y_pos = h - 0.04\n        text_str = f'{val:.2f}' if val > -10 else f'{val:.1f}\\n(clipped)'\n    else:\n        va_dir = 'bottom'\n        y_pos = h + 0.04\n        text_str = f'{val:.2f}'\n\n    ax.text(\n        bar.get_x() + bar.get_width() / 2,\n        y_pos,\n        text_str,\n        ha='center', va=va_dir,\n        fontsize=10, fontweight='bold'\n    )\n\n# Reference lines\nax.axhline(0.07, color='gray', linestyle=':', linewidth=1.2,\n           label='Two-stage baseline (≈0.07)')\nax.axhline(0.00, color='black', linestyle='-', linewidth=0.8) # Zero line marker\nax.axhline(1.00, color='crimson', linestyle='--', linewidth=1.2,\n           label='Collapse ceiling (R²=1.0)')\n\nax.set_ylim(-1.2, 1.2) # Adjusted scale to allow negative tracking\nax.set_ylabel(r'Mean R² of linear fit $z_{t+1} = A \\cdot z_t$', fontsize=11)\nax.set_title(\n    f'Latent space linearity — does co-training work?\\n'\n    f'(latent dim = {DIAG_LATENT}, variant = {DIAG_VARIANT})',\n    fontsize=11, fontweight='bold'\n)\nax.grid(axis='y', linestyle=':', alpha=0.5)\n\n# Custom legend patch for color meaning\nfrom matplotlib.patches import Patch\nlegend_elements = [\n    Patch(facecolor='steelblue', edgecolor='black', label='Two-stage (recon only)'),\n    Patch(facecolor='seagreen',  edgecolor='black', label='Co-trained (+ dynamics loss)'),\n]\nax.legend(handles=legend_elements, fontsize=9, loc='upper left')\n\nplt.tight_layout()\nplt.savefig(RESULTS_DIR / 'plot3_linearity_r2.pdf', dpi=300, bbox_inches='tight')\nplt.show()\nprint(\"Plot 3 saved.\")\n\n# ================================================================\n# PLOT 4 — Latent Variance Convergence During Co-Training\n# ================================================================\nif sbm_vlog is None and jodie_vlog is None:\n    print(\"\\nSkipping Plot 4 — no variance logs available.\")\n    print(\"Run both training cells with USE_COTRAIN=True first.\")\nelse:\n    print(\"\\nGenerating Plot 4: Latent Variance Convergence History...\")\n\n    fig, ax = plt.subplots(figsize=(7, 4.5))\n\n    if sbm_vlog is not None:\n        epochs_sbm = list(range(1, len(sbm_vlog) + 1))\n        ax.plot(epochs_sbm, sbm_vlog,\n                '-o', markersize=3,\n                color='seagreen', linewidth=2.2,\n                label=f'SBM ({DIAG_VARIANT}, latent_dim={DIAG_LATENT})')\n\n    if jodie_vlog is not None:\n        epochs_jod = list(range(1, len(jodie_vlog) + 1))\n        ax.plot(epochs_jod, jodie_vlog,\n                '-s', markersize=3,\n                color='crimson', linewidth=2.2,\n                label=f'JODIE-Wikipedia (latent_dim={DIAG_LATENT})')\n\n    # Shade the collapse danger zone\n    ax.axhspan(0, 0.01, color='crimson', alpha=0.08,\n               label='Representation collapse zone (var < 0.01)')\n\n    ax.set_xlabel('Co-training epoch', fontsize=11)\n    ax.set_ylabel(r'Mean latent variance $\\sigma^2_z$ (across dimensions)', fontsize=11)\n    ax.set_title(\n        'Does co-training collapse the latent space?\\n'\n        'Variance during joint encoder + Koopman training',\n        fontsize=11, fontweight='bold'\n    )\n    ax.grid(True, linestyle=':', alpha=0.5)\n    ax.legend(fontsize=9, loc='upper right')\n\n    plt.tight_layout()\n    plt.savefig(RESULTS_DIR / 'plot4_variance_convergence.pdf', dpi=300, bbox_inches='tight')\n    plt.show()\n    print(\"Plot 4 saved.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T13:02:57.652995Z","iopub.execute_input":"2026-05-16T13:02:57.653778Z","iopub.status.idle":"2026-05-16T13:02:58.910311Z","shell.execute_reply.started":"2026-05-16T13:02:57.653742Z","shell.execute_reply":"2026-05-16T13:02:58.909413Z"}},"outputs":[{"name":"stdout","text":"Computing SBM R² scores...\n\n  SBM  two_stage        latent_dim=64  R²=-5.4219\n  SBM  cotrain          latent_dim=64  R²=-0.1461\n\n  JODIE two_stage  latent_dim=64  R²=-0.25468581169843674\n  JODIE cotrain    latent_dim=64  R²=-1.1155579071491957\n\nGenerating Plot 3: Latent Space Linearity (R²)...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x450 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Plot 3 saved.\n\nGenerating Plot 4: Latent Variance Convergence History...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 700x450 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"Plot 4 saved.\n","output_type":"stream"}],"execution_count":61},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}