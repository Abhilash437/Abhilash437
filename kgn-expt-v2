cution_count":null},{"cell_type":"code","source":"# Cell 52F — Gradient competition diagnostic\n#\n# Test whether classification loss gradient survives\n# when reconstruction loss is computed through the same z_t tensors\n#\n# We compare two conditions:\n#   A) cls loss only      → clean gradient to encoder\n#   B) recon + cls loss   → gradient to encoder after both paths compete\n#\n# If encoder gradient in B is much smaller than A,\n# reconstruction is suppressing the classification signal\n\nimport torch\nimport torch.nn.functional as F\nimport numpy as np\n\nprint(\"=\" * 55)\nprint(\"Gradient competition diagnostic\")\nprint(\"=\" * 55)\n\nadj_seq_0 = train_subject_graphs[0]\nlabel_0   = train_subject_labels[0]\nT         = adj_seq_0.shape[0]\nce_loss   = torch.nn.CrossEntropyLoss()\n\ndef measure_encoder_grad(use_recon=True, use_cls=True):\n    \"\"\"\n    Measure mean absolute gradient on encoder's first layer\n    under different loss combinations.\n    \"\"\"\n    enc_t = GraphEncoder(latent_dim=ABIDE_LATENT_DIM, in_channels=1).to(DEVICE)\n    dec_t = GraphDecoder(latent_dim=ABIDE_LATENT_DIM, n_nodes=ABIDE_N_NODES).to(DEVICE)\n    clf_t = torch.nn.Sequential(\n        torch.nn.Linear(ABIDE_LATENT_DIM, 16),\n        torch.nn.ReLU(),\n        torch.nn.Linear(16, 2)\n    ).to(DEVICE)\n\n    enc_t.train(); dec_t.train(); clf_t.train()\n\n    z_list     = []\n    recon_loss = 0.0\n\n    for t in range(T):\n        adj_t      = torch.from_numpy(adj_seq_0[t]).float().to(DEVICE)\n        edge_index = torch.from_numpy(\n            np.array(np.where(adj_seq_0[t] > 0))\n        ).long().to(DEVICE)\n\n        z_t = enc_t(edge_index, num_nodes=ABIDE_N_NODES) \\\n              if edge_index.numel() > 0 \\\n              else torch.zeros(1, ABIDE_LATENT_DIM, device=DEVICE)\n\n        z_list.append(z_t)\n\n        if use_recon:\n            adj_pred  = dec_t.reconstruct_adjacency(z_t)\n            num_ones  = adj_t.sum()\n            num_zeros = adj_t.numel() - num_ones\n            pw_val    = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n            recon_loss += F.binary_cross_entropy_with_logits(\n                adj_pred, adj_t,\n                pos_weight=torch.tensor([pw_val], device=DEVICE)\n            )\n\n    z_mean       = torch.cat(z_list, dim=0).mean(dim=0, keepdim=True)\n    label_tensor = torch.tensor([label_0], dtype=torch.long, device=DEVICE)\n    logits       = clf_t(z_mean)\n    cls_loss_val = ce_loss(logits, label_tensor)\n\n    total = 0.0\n    if use_recon:\n        total = total + recon_loss / T\n    if use_cls:\n        total = total + cls_loss_val\n\n    total.backward()\n\n    # Measure gradient on first encoder parameter\n    grad = None\n    for name, param in enc_t.named_parameters():\n        if param.grad is not None:\n            grad = param.grad.abs().mean().item()\n            first_name = name\n            break\n\n    return grad, first_name\n\ngrad_cls_only,  name = measure_encoder_grad(use_recon=False, use_cls=True)\ngrad_recon_only, _   = measure_encoder_grad(use_recon=True,  use_cls=False)\ngrad_both,       _   = measure_encoder_grad(use_recon=True,  use_cls=True)\n\nprint(f\"\\nEncoder layer: '{name}'\")\nprint(f\"  Gradient — cls loss only  : {grad_cls_only:.8f}\")\nprint(f\"  Gradient — recon only     : {grad_recon_only:.8f}\")\nprint(f\"  Gradient — both combined  : {grad_both:.8f}\")\nprint(f\"\\n  Ratio (both / cls-only)   : {grad_both/grad_cls_only:.4f}\")\nprint(f\"  Ratio (recon / cls-only)  : {grad_recon_only/grad_cls_only:.4f}\")\n\nif grad_recon_only > 100 * grad_cls_only:\n    print(\"\\n  ► SUPPRESSION: recon gradient is drowning out cls gradient\")\n    print(\"    The encoder never adapts toward class separation\")\nelif grad_both < 0.1 * grad_cls_only:\n    print(\"\\n  ► CANCELLATION: gradients are opposing each other\")\nelse:\n    print(\"\\n  ► OK: gradients are compatible — problem is elsewhere\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cell 52G — Warm-start supervised encoder from unsupervised weights\n#\n# Why: supervised training from random init gets stuck at SNR≈0\n#      at epoch 0, giving the classifier no signal to learn from.\n#      Warm-starting gives the encoder SNR≈1.19 at epoch 0,\n#      breaking the cold-start deadlock.\n\nimport copy\n\n# ── Step 1: Create a new encoder with the same architecture ──\nenc_warmstart = GraphEncoder(latent_dim=ABIDE_LATENT_DIM, in_channels=1).to(DEVICE)\n\n# ── Step 2: Copy weights from the trained unsupervised encoder ──\n# state_dict() returns all parameters as a {name: tensor} dictionary\n# load_state_dict() copies those tensor values into enc_warmstart\nenc_warmstart.load_state_dict(abide_encoder.state_dict())\n\nprint(\"Weights copied. Verifying SNR in warm-started encoder...\")\n\n# ── Step 3: Verify SNR matches the unsupervised encoder ──\nenc_warmstart.eval()\nz_means = []\n\nwith torch.no_grad():\n    for idx, adj_seq in enumerate(train_subject_graphs):\n        z_list = []\n        for t in range(adj_seq.shape[0]):\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_seq[t] > 0))\n            ).long().to(DEVICE)\n\n            z_t = enc_warmstart(edge_index, num_nodes=ABIDE_N_NODES) \\\n                  if edge_index.numel() > 0 \\\n                  else torch.zeros(1, ABIDE_LATENT_DIM, device=DEVICE)\n            z_list.append(z_t)\n\n        z_mean = torch.cat(z_list, dim=0).mean(dim=0)\n        z_means.append((z_mean.cpu().numpy(), train_subject_labels[idx]))\n\nZ     = np.array([z for z, _ in z_means])\nlabs  = np.array([l for _, l in z_means])\n\nasd_mean = Z[labs == 1].mean(axis=0)\ntd_mean  = Z[labs == 0].mean(axis=0)\nseparation = np.linalg.norm(asd_mean - td_mean)\nwithin_var = (Z[labs == 1].var(axis=0).mean() + Z[labs == 0].var(axis=0).mean()) / 2\nsnr = separation / (within_var ** 0.5)\n\nprint(f\"  L2 separation (ASD vs TD) : {separation:.4f}\")\nprint(f\"  Within-group variance      : {within_var:.4f}\")\nprint(f\"  SNR at epoch 0             : {snr:.4f}\")\nprint()\nif snr > 0.5:\n    print(\"► Warm-start confirmed: encoder carries diagnostic signal at epoch 0\")\nelse:\n    print(\"► WARNING: SNR too low — check that abide_encoder is the correct variable\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cell 52H — Supervised training v4 (warm-started encoder)\n#\n# Single change from v3:\n#   Instead of creating a fresh GraphEncoder,\n#   accept a pre-trained encoder and copy its weights as starting point.\n#\n# Everything else (full-batch, auto-calibrated λ, shuffling) is identical to 52E.\n\ndef train_supervised_encoder_abide_v4(\n    n_nodes,\n    latent_dim,\n    train_subject_graphs,\n    train_subject_labels,\n    pretrained_encoder,          # ← new parameter\n    n_epochs   = 200,\n    lr         = 1e-3,\n    lambda_cls = None\n):\n    # ── Warm-start encoder from pretrained weights ──\n    # We do NOT reuse the pretrained_encoder object directly.\n    # load_state_dict copies the weight VALUES into a new independent model,\n    # so training here does not affect the original unsupervised encoder.\n    enc = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    enc.load_state_dict(pretrained_encoder.state_dict())\n\n    # Decoder and classifier start fresh — decoder has no useful\n    # prior to transfer, classifier architecture is new\n    dec        = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    classifier = nn.Sequential(\n        nn.Linear(latent_dim, 16),\n        nn.ReLU(),\n        nn.Dropout(p=0.3),\n        nn.Linear(16, 2)\n    ).to(DEVICE)\n\n    optimizer  = Adam(\n        list(enc.parameters()) +\n        list(dec.parameters()) +\n        list(classifier.parameters()),\n        lr=lr\n    )\n    ce_loss_fn = nn.CrossEntropyLoss()\n\n    # ── Calibration pass (identical to v3) ──\n    def run_epoch(update_weights=True):\n        enc.train(); dec.train(); classifier.train()\n\n        total_recon = 0.0\n        total_cls = 0.0\n        correct = 0\n        n_subjects = len(train_subject_graphs)\n\n        # Shuffle subject order each epoch to prevent gradient accumulation bias\n        perm = np.random.permutation(n_subjects)\n\n        # Full-batch optimization setup: zero gradients ONCE before stepping over subjects\n        if update_weights:\n            optimizer.zero_grad()\n\n        for idx in perm:\n            adj_seq = train_subject_graphs[idx]\n            label = train_subject_labels[idx]\n            T = adj_seq.shape[0]\n\n            z_list = []\n            subj_recon = 0.0\n\n            for t in range(T):\n                adj_t = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n                edge_index = torch.from_numpy(\n                    np.array(np.where(adj_seq[t] > 0))\n                ).long().to(DEVICE)\n\n                z_t = enc(edge_index, num_nodes=n_nodes) \\\n                    if edge_index.numel() > 0 \\\n                    else torch.zeros(1, latent_dim, device=DEVICE)\n\n                z_list.append(z_t)\n\n                adj_pred = dec.reconstruct_adjacency(z_t)\n                num_ones = adj_t.sum()\n                num_zeros = adj_t.numel() - num_ones\n                pw_val = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n\n                # Fixed binary cross entropy calculation with sigmoid\n                subj_recon += F.binary_cross_entropy(\n                    torch.sigmoid(adj_pred), \n                    adj_t,\n                    weight=torch.full_like(adj_t, pw_val)\n                )\n\n            # Mean-pool embeddings along temporal axis for classification\n            z_mean = torch.cat(z_list, dim=0).mean(dim=0, keepdim=True)\n            label_tensor = torch.tensor([label], dtype=torch.long, device=DEVICE)\n            logits = classifier(z_mean)\n            cls_loss = ce_loss_fn(logits, label_tensor)\n\n            # Track accuracy metrics\n            pred_class = torch.argmax(logits, dim=1).item()\n            if pred_class == label:\n                correct += 1\n\n            recon_norm = subj_recon / T\n            total_recon += recon_norm.item()\n            total_cls += cls_loss.item()\n\n            # --- FIX FOR TYPERROR / CALIBRATION PHASE ---\n            if update_weights:\n                # Only calculate combined loss and backprop if lambda_cls is ready and we are updating weights\n                loss = (recon_norm + lambda_cls * cls_loss) / n_subjects\n                loss.backward()\n            # ---------------------------------------------\n\n        if update_weights:\n            # Step the weights once using the accumulated gradients\n            optimizer.step()\n\n        return total_recon, total_cls, (correct / n_subjects)\n\n    # ── Auto-calibrate λ if not provided ──\n    print(\"Calibrating λ from epoch-0 loss scales...\")\n    with torch.no_grad():\n        r0, c0, _ = run_epoch(update_weights=False)\n    if lambda_cls is None:\n        lambda_cls = 0.5 * (r0 / c0)\n    print(f\"  Epoch-0 recon loss : {r0:.4f}\")\n    print(f\"  Epoch-0 cls loss   : {c0:.4f}\")\n    print(f\"  Calibrated λ       : {lambda_cls:.4f}\")\n\n    # ── Training loop ──\n    print(f\"\\n {'Epoch':>6} | {'Recon':>8} | {'Cls':>8} | {'Train Acc':>10}\")\n    print(\"-\" * 45)\n\n    for epoch in range(1, n_epochs + 1):\n        r, c, acc = run_epoch(update_weights=True)\n        if epoch % 25 == 0:\n            print(f\" {epoch:>3}/{n_epochs} | {r:>8.4f} | {c:>8.4f} | {acc:>10.3f}\")\n\n    return enc, dec, classifier\n\n\n# ── Run it ──\nprint(\"=\" * 55)\nprint(\"Training supervised encoder v4 (warm-started)\")\nprint(\"=\" * 55)\n\nsup_encoder_v4, _, sup_classifier_v4 = train_supervised_encoder_abide_v4(\n    n_nodes               = ABIDE_N_NODES,\n    latent_dim            = ABIDE_LATENT_DIM,\n    train_subject_graphs  = train_subject_graphs,\n    train_subject_labels  = train_subject_labels,\n    pretrained_encoder    = abide_encoder,     # ← warm-start from unsupervised encoder\n    n_epochs              = 200,\n    lr                    = 1e-3,\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cell 52F — Gradient Competition Diagnostic for v4\nimport torch\nimport torch.nn.functional as F\nimport numpy as np\n\nprint(\"=\" * 60)\nprint(\"RUNNING STANDALONE V4 GRADIENT INTERFERENCE DIAGNOSTIC\")\nprint(\"=\" * 60)\n\n# 1. Initialize exact architectural replicas to isolate a single clean step\ndiag_enc = GraphEncoder(latent_dim=ABIDE_LATENT_DIM, in_channels=1).to(DEVICE)\ndiag_enc.load_state_dict(abide_encoder.state_dict())  # Mirror the unsupervised warm-start\n\ndiag_dec = GraphDecoder(latent_dim=ABIDE_LATENT_DIM, n_nodes=ABIDE_N_NODES).to(DEVICE)\ndiag_classifier = nn.Sequential(\n    nn.Linear(ABIDE_LATENT_DIM, 16),\n    nn.ReLU(),\n    nn.Dropout(p=0.3),\n    nn.Linear(16, 2)\n).to(DEVICE)\n\nce_loss_fn = nn.CrossEntropyLoss()\nlambda_cls = 2.0866  # Hardcoded from your v4 calibration logs for exact parity\n\n# Set models to train mode to track gradients cleanly\ndiag_enc.train(); diag_dec.train(); diag_classifier.train()\ndiag_enc.zero_grad()\n\ntotal_recon_loss = 0.0\ntotal_cls_loss = 0.0\nn_subjects = len(train_subject_graphs)\n\n# 2. Complete a full-batch forward pass over all subjects without updating weights\nfor idx in range(n_subjects):\n    adj_seq = train_subject_graphs[idx]\n    label = train_subject_labels[idx]\n    T = adj_seq.shape[0]\n\n    z_list = []\n    subj_recon = 0.0\n\n    for t in range(T):\n        adj_t = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n        edge_index = torch.from_numpy(\n            np.array(np.where(adj_seq[t] > 0))\n        ).long().to(DEVICE)\n\n        z_t = diag_enc(edge_index, num_nodes=ABIDE_N_NODES) \\\n            if edge_index.numel() > 0 \\\n            else torch.zeros(1, ABIDE_LATENT_DIM, device=DEVICE)\n        \n        z_list.append(z_t)\n\n        adj_pred = diag_dec.reconstruct_adjacency(z_t)\n        num_ones = adj_t.sum()\n        num_zeros = adj_t.numel() - num_ones\n        pw_val = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n\n        subj_recon += F.binary_cross_entropy(\n            torch.sigmoid(adj_pred), \n            adj_t,\n            weight=torch.full_like(adj_t, pw_val)\n        )\n\n    z_mean = torch.cat(z_list, dim=0).mean(dim=0, keepdim=True)\n    label_tensor = torch.tensor([label], dtype=torch.long, device=DEVICE)\n    logits = diag_classifier(z_mean)\n\n    total_recon_loss += (subj_recon / T)\n    total_cls_loss += ce_loss_fn(logits, label_tensor)\n\n# 3. Extract isolated gradient components flowing back into the encoder parameters\n# Step A: Capture Reconstruction Gradients Only\ndiag_enc.zero_grad()\n(total_recon_loss / n_subjects).backward(retain_graph=True)\ngrads_recon = torch.cat([p.grad.clone().flatten() for p in diag_enc.parameters() if p.grad is not None])\n\n# Step B: Capture Weighted Classification Gradients Only\ndiag_enc.zero_grad()\n(lambda_cls * total_cls_loss / n_subjects).backward()\ngrads_cls = torch.cat([p.grad.clone().flatten() for p in diag_enc.parameters() if p.grad is not None])\ndiag_enc.zero_grad()\n\n# 4. Compute Directional Alignment and Vector Magnitudes\ncosine_sim = F.cosine_similarity(grads_recon.unsqueeze(0), grads_cls.unsqueeze(0)).item()\nnorm_recon = torch.norm(grads_recon).item()\nnorm_cls = torch.norm(grads_cls).item()\nmagnitude_ratio = norm_recon / (norm_cls + 1e-8)\n\nprint(f\"Reconstruction Gradient Norm : {norm_recon:.6f}\")\nprint(f\"Classification Gradient Norm : {norm_cls:.6f}\")\nprint(f\"Gradient Magnitude Ratio     : {magnitude_ratio:.2f}×\")\nprint(f\"Cosine Similarity (Direction): {cosine_sim:.4f}\")\nprint(\"=\" * 60)\n\nif cosine_sim < -0.1:\n    print(\"⚠️ Verdict: Severe Gradient Competition. The reconstruction task is actively\")\n    print(\"   counteracting and erasing the parameter adjustments demanded by classification.\")\nelif cosine_sim > 0.4:\n    print(\"✅ Verdict: Structurally Aligned. The objectives are complementary.\")\nelse:\n    print(\"ℹ️ Verdict: Orthogonal Signal. The two tasks are updating decoupled feature subspaces.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cell 52I — Supervised training v5 (Two-Speed Full-Batch with Dynamic Decay)\n#\n# Changes:\n# 1. Fixed NameError by explicitly passing 'epoch' to run_epoch().\n# 2. Added the dynamic decay schedule for the reconstruction weight to prevent flatlining.\n# 3. Uses scaled learning rates (1e-2 for encoder, 5e-2 for classifier) and no dropout.\n\ndef train_supervised_encoder_abide_v5(\n    n_nodes,\n    latent_dim,\n    train_subject_graphs,\n    train_subject_labels,\n    pretrained_encoder,\n    n_epochs   = 200,\n    lr         = 1e-2,  # Bounded to 0.01 to match full-batch budget\n    lambda_cls = None\n):\n    # Warm-start encoder from pretrained weights\n    enc = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    enc.load_state_dict(pretrained_encoder.state_dict())\n\n    # Decoder and classifier start fresh (No dropout to stabilize full-batch)\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    classifier = nn.Sequential(\n        nn.Linear(latent_dim, 16),\n        nn.ReLU(),\n        nn.Linear(16, 2)  \n    ).to(DEVICE)\n\n    # MULTI-SPEED OPTIMIZER WITH FULL-BATCH SCALE\n    optimizer = Adam([\n        {'params': enc.parameters(), 'lr': lr},            # Encoder fine-tuning: 0.01\n        {'params': dec.parameters(), 'lr': lr * 2},        # Decoder adaptation: 0.02\n        {'params': classifier.parameters(), 'lr': lr * 5}  # Classifier plateau-breaker: 0.05\n    ])\n    \n    ce_loss_fn = nn.CrossEntropyLoss()\n\n    # Added explicit 'epoch' parameter to fix enclosing scope NameError\n    def run_epoch(update_weights=True, epoch=0):\n        enc.train(); dec.train(); classifier.train()\n        total_recon = 0.0; total_cls = 0.0; correct = 0\n        n_subjects = len(train_subject_graphs)\n        perm = np.random.permutation(n_subjects)\n\n        # Calculate decay factor once per epoch (drops linearly from 1.0 to 0.1 over 150 epochs)\n        decay = max(0.1, 1.0 - (epoch / 150.0))\n\n        if update_weights:\n            optimizer.zero_grad()\n\n        for idx in perm:\n            adj_seq = train_subject_graphs[idx]\n            label = train_subject_labels[idx]\n            T = adj_seq.shape[0]\n\n            z_list = []\n            subj_recon = 0.0\n\n            for t in range(T):\n                adj_t = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n                edge_index = torch.from_numpy(\n                    np.array(np.where(adj_seq[t] > 0))\n                ).long().to(DEVICE)\n\n                z_t = enc(edge_index, num_nodes=n_nodes) \\\n                    if edge_index.numel() > 0 \\\n                    else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n\n                adj_pred = dec.reconstruct_adjacency(z_t)\n                num_ones = adj_t.sum()\n                num_zeros = adj_t.numel() - num_ones\n                pw_val = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n\n                subj_recon += F.binary_cross_entropy(\n                    torch.sigmoid(adj_pred), \n                    adj_t,\n                    weight=torch.full_like(adj_t, pw_val)\n                )\n\n            z_mean = torch.cat(z_list, dim=0).mean(dim=0, keepdim=True)\n            label_tensor = torch.tensor([label], dtype=torch.long, device=DEVICE)\n            logits = classifier(z_mean)\n            cls_loss = ce_loss_fn(logits, label_tensor)\n\n            pred_class = torch.argmax(logits, dim=1).item()\n            if pred_class == label:\n                correct += 1\n\n            recon_norm = subj_recon / T\n            total_recon += recon_norm.item()\n            total_cls += cls_loss.item()\n\n            if update_weights:\n                # Compound loss utilizing dynamic reconstruction scale\n                loss = ((recon_norm * decay) + lambda_cls * cls_loss) / n_subjects\n                loss.backward()\n\n        if update_weights:\n            optimizer.step()\n\n        return total_recon, total_cls, (correct / n_subjects)\n\n    # Calibration pass (explicitly tracking epoch=0)\n    print(\"Calibrating λ from epoch-0 loss scales...\")\n    with torch.no_grad():\n        r0, c0, _ = run_epoch(update_weights=False, epoch=0)\n    if lambda_cls is None:\n        lambda_cls = 0.5 * (r0 / c0)\n    print(f\"  Epoch-0 recon loss : {r0:.4f}\")\n    print(f\"  Epoch-0 cls loss   : {c0:.4f}\")\n    print(f\"  Calibrated λ       : {lambda_cls:.4f}\")\n\n    print(f\"\\n {'Epoch':>6} | {'Recon':>8} | {'Cls':>8} | {'Train Acc':>10}\")\n    print(\"-\" * 45)\n\n    for epoch in range(1, n_epochs + 1):\n        r, c, acc = run_epoch(update_weights=True, epoch=epoch)\n        if epoch % 25 == 0:\n            print(f\" {epoch:>3}/{n_epochs} | {r:>8.4f} | {c:>8.4f} | {acc:>10.3f}\")\n\n    return enc, dec, classifier\n\n\n# ── Run it ──\nprint(\"=\" * 55)\nprint(\"Training supervised encoder v5 (Two-Speed Full-Batch)\")\nprint(\"=\" * 55)\n\nsup_encoder_v5, _, sup_classifier_v5 = train_supervised_encoder_abide_v5(\n    n_nodes               = ABIDE_N_NODES,\n    latent_dim            = ABIDE_LATENT_DIM,\n    train_subject_graphs  = train_subject_graphs,\n    train_subject_labels  = train_subject_labels,\n    pretrained_encoder    = abide_encoder,\n    n_epochs              = 200,\n    lr                    = 1e-2,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:26:47.328136Z","iopub.execute_input":"2026-05-18T15:26:47.328456Z","iopub.status.idle":"2026-05-18T15:44:40.741424Z","shell.execute_reply.started":"2026-05-18T15:26:47.328414Z","shell.execute_reply":"2026-05-18T15:44:40.740818Z"}},"outputs":[{"name":"stdout","text":"=======================================================\nTraining supervised encoder v5 (Two-Speed Full-Batch)\n=======================================================\nCalibrating λ from epoch-0 loss scales...\n  Epoch-0 recon loss : 173.7474\n  Epoch-0 cls loss   : 42.9047\n  Calibrated λ       : 2.0248\n\n  Epoch |    Recon |      Cls |  Train Acc\n---------------------------------------------\n  25/200 | 102.7957 |  40.6301 |      0.517\n  50/200 | 100.8315 |  38.9143 |      0.550\n  75/200 | 100.2565 |  36.3255 |      0.583\n 100/200 |  99.8870 |  34.8383 |      0.617\n 125/200 |  99.6781 |  33.9348 |      0.633\n 150/200 |  99.5681 |  33.0081 |      0.633\n 175/200 |  99.5985 |  31.7597 |      0.717\n 200/200 |  99.3921 |  29.6633 |      0.750\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"# Cell 52J — Supervised training v6 (Stable Analytical Koopman Dynamics)\n#\n# Changes:\n# 1. Added nn.LayerNorm to the Koopman matrix input to prevent exploding values.\n# 2. Hardcoded lambda_cls = 0.1 to override the broken epoch-0 automatic calculation.\n\ndef train_supervised_encoder_abide_v6(\n    n_nodes,\n    latent_dim,\n    train_subject_graphs,\n    train_subject_labels,\n    pretrained_encoder,\n    n_epochs   = 200,\n    lr         = 1e-2,\n    lambda_cls = 0.1  # Hardcoded baseline to bypass exploding epoch-0 scale\n):\n    # Warm-start encoder from pretrained weights\n    enc = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    enc.load_state_dict(pretrained_encoder.state_dict())\n\n    # Decoder starts fresh\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    \n    # NEW: Layer normalization head to scale massive lstsq coefficients safely\n    k_normalizer = nn.LayerNorm(latent_dim * latent_dim).to(DEVICE)\n\n    # Classifier reads the stable normalized operator matrix\n    classifier = nn.Sequential(\n        nn.Linear(latent_dim * latent_dim, 32),\n        nn.ReLU(),\n        nn.Linear(32, 2)\n    ).to(DEVICE)\n\n    # Include k_normalizer parameters in the optimization group\n    optimizer = Adam([\n        {'params': enc.parameters(), 'lr': lr},\n        {'params': dec.parameters(), 'lr': lr * 2},\n        {'params': k_normalizer.parameters(), 'lr': lr * 2},\n        {'params': classifier.parameters(), 'lr': lr * 5}\n    ])\n    \n    ce_loss_fn = nn.CrossEntropyLoss()\n\n    def run_epoch(update_weights=True, epoch=0):\n        enc.train(); dec.train(); k_normalizer.train(); classifier.train()\n        total_recon = 0.0; total_cls = 0.0; total_koop_err = 0.0; correct = 0\n        n_subjects = len(train_subject_graphs)\n        perm = np.random.permutation(n_subjects)\n\n        decay = max(0.1, 1.0 - (epoch / 150.0))\n\n        if update_weights:\n            optimizer.zero_grad()\n\n        for idx in perm:\n            adj_seq = train_subject_graphs[idx]\n            label = train_subject_labels[idx]\n            T = adj_seq.shape[0]\n\n            z_list = []\n            subj_recon = 0.0\n\n            # ── Step 1: Encode snapshots ──\n            for t in range(T):\n                adj_t = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n                edge_index = torch.from_numpy(\n                    np.array(np.where(adj_seq[t] > 0))\n                ).long().to(DEVICE)\n\n                z_t = enc(edge_index, num_nodes=n_nodes) \\\n                    if edge_index.numel() > 0 \\\n                    else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n\n                adj_pred = dec.reconstruct_adjacency(z_t)\n                num_ones = adj_t.sum()\n                num_zeros = adj_t.numel() - num_ones\n                pw_val = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n\n                subj_recon += F.binary_cross_entropy(\n                    torch.sigmoid(adj_pred), \n                    adj_t,\n                    weight=torch.full_like(adj_t, pw_val)\n                )\n\n            z_stack = torch.cat(z_list, dim=0)\n\n            # ── Step 2: Analytically derive Koopman Operator ──\n            X = z_stack[:-1]\n            Y = z_stack[1:]\n\n            try:\n                K_subject = torch.linalg.lstsq(X, Y).solution\n            except RuntimeError:\n                K_subject = torch.eye(latent_dim, device=DEVICE)\n\n            koop_pred = X @ K_subject\n            koop_err = F.mse_loss(koop_pred, Y)\n\n            # ── Step 3: Normalize and Classify ──\n            K_flat = K_subject.reshape(1, -1)\n            \n            # Layer normalization scales values to N(0,1) before classifier mapping\n            K_stable = k_normalizer(K_flat)\n            logits = classifier(K_stable)\n            \n            label_tensor = torch.tensor([label], dtype=torch.long, device=DEVICE)\n            cls_loss = ce_loss_fn(logits, label_tensor)\n\n            pred_class = torch.argmax(logits, dim=1).item()\n            if pred_class == label:\n                correct += 1\n\n            recon_norm = subj_recon / T\n            total_recon += recon_norm.item()\n            total_cls += cls_loss.item()\n            total_koop_err += koop_err.item()\n\n            if update_weights:\n                loss = ((recon_norm * decay) + (0.05 * koop_err) + lambda_cls * cls_loss) / n_subjects\n                loss.backward()\n\n        if update_weights:\n            optimizer.step()\n\n        return total_recon, total_cls, (correct / n_subjects)\n\n    print(f\"Bypassing auto-calibration. Running with fixed λ = {lambda_cls}\")\n    print(f\"\\n {'Epoch':>6} | {'Recon':>8} | {'Cls':>8} | {'Train Acc':>10}\")\n    print(\"-\" * 45)\n\n    for epoch in range(1, n_epochs + 1):\n        r, c, acc = run_epoch(update_weights=True, epoch=epoch)\n        if epoch % 25 == 0:\n            print(f\" {epoch:>3}/{n_epochs