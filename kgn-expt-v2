start encoder from pretrained weights\n    enc = GraphEncoder(latent_dim=latent_dim, in_channels=1).to(DEVICE)\n    enc.load_state_dict(pretrained_encoder.state_dict())\n\n    # Decoder and classifier start fresh (No dropout to stabilize full-batch)\n    dec = GraphDecoder(latent_dim=latent_dim, n_nodes=n_nodes).to(DEVICE)\n    classifier = nn.Sequential(\n        nn.Linear(latent_dim, 16),\n        nn.ReLU(),\n        nn.Linear(16, 2)  \n    ).to(DEVICE)\n\n    # MULTI-SPEED OPTIMIZER WITH FULL-BATCH SCALE\n    optimizer = Adam([\n        {'params': enc.parameters(), 'lr': lr},            # Encoder fine-tuning: 0.01\n        {'params': dec.parameters(), 'lr': lr * 2},        # Decoder adaptation: 0.02\n        {'params': classifier.parameters(), 'lr': lr * 5}  # Classifier plateau-breaker: 0.05\n    ])\n    \n    ce_loss_fn = nn.CrossEntropyLoss()\n\n    # Added explicit 'epoch' parameter to fix enclosing scope NameError\n    def run_epoch(update_weights=True, epoch=0):\n        enc.train(); dec.train(); classifier.train()\n        total_recon = 0.0; total_cls = 0.0; correct = 0\n        n_subjects = len(train_subject_graphs)\n        perm = np.random.permutation(n_subjects)\n\n        # Calculate decay factor once per epoch (drops linearly from 1.0 to 0.1 over 150 epochs)\n        decay = max(0.1, 1.0 - (epoch / 150.0))\n\n        if update_weights:\n            optimizer.zero_grad()\n\n        for idx in perm:\n            adj_seq = train_subject_graphs[idx]\n            label = train_subject_labels[idx]\n            T = adj_seq.shape[0]\n\n            z_list = []\n            subj_recon = 0.0\n\n            for t in range(T):\n                adj_t = torch.from_numpy(adj_seq[t]).float().to(DEVICE)\n                edge_index = torch.from_numpy(\n                    np.array(np.where(adj_seq[t] > 0))\n                ).long().to(DEVICE)\n\n                z_t = enc(edge_index, num_nodes=n_nodes) \\\n                    if edge_index.numel() > 0 \\\n              