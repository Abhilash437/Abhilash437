ABIDE_LATENT_DIM, n_nodes=ABIDE_N_NODES).to(DEVICE)\n    clf_t = torch.nn.Sequential(\n        torch.nn.Linear(ABIDE_LATENT_DIM, 16),\n        torch.nn.ReLU(),\n        torch.nn.Linear(16, 2)\n    ).to(DEVICE)\n\n    enc_t.train(); dec_t.train(); clf_t.train()\n\n    z_list     = []\n    recon_loss = 0.0\n\n    for t in range(T):\n        adj_t      = torch.from_numpy(adj_seq_0[t]).float().to(DEVICE)\n        edge_index = torch.from_numpy(\n            np.array(np.where(adj_seq_0[t] > 0))\n        ).long().to(DEVICE)\n\n        z_t = enc_t(edge_index, num_nodes=ABIDE_N_NODES) \\\n              if edge_index.numel() > 0 \\\n              else torch.zeros(1, ABIDE_LATENT_DIM, device=DEVICE)\n\n        z_list.append(z_t)\n\n        if use_recon:\n            adj_pred  = dec_t.reconstruct_adjacency(z_t)\n            num_ones  = adj_t.sum()\n            num_zeros = adj_t.numel() - num_ones\n            pw_val    = (num_zeros / num_ones).item() if num_ones > 0 else 1.0\n            recon_loss += F.binary_cross_entropy_with_logits(\n                adj_pred, adj_t,\n                pos_weight=torch.tensor([pw_val], device=DEVICE)\n            )\n\n    z_mean       = torch.cat(z_list, dim=0).mean(dim=0, keepdim=True)\n    label_tensor = torch.tensor([label_0], dtype=torch.long, device=DEVICE)\n    logits       = clf_t(z_mean)\n    cls_loss_val = ce_loss(logits, label_tensor)\n\n    total = 0.0\n    if use_recon:\n        total = total + recon_loss / T\n    if use_cls:\n        total = total + cls_loss_val\n\n    total.backward()\n\n    # Measure gradient on first encoder parameter\n    grad = None\n    for name, param in enc_t.named_parameters():\n        if param.grad is not None:\n            grad = param.grad.abs().mean().item()\n            first_name = name\n            break\n\n    return grad, first_name\n\ngrad_cls_only,  name = measure_encoder_grad(use_recon=False, use_cls=True)\ngrad_recon_only, _   = measure_encoder_grad(use_recon=True,  use_cls=False)\ngrad_both,       _   = measure_encoder_grad(use_recon=True,  use_cls=True)\n\nprint(f\"\\nEncoder layer: '{name}'\")\nprint(f\"  Gradient — cls loss only  : {grad_cls_only:.8f}\")\nprint(f\"  Gradient — recon only     : {grad_recon_only:.8f}\")\nprint(f\"  Gradient — both combined  : {grad_both:.8f}\")\nprint(f\"\\n  Ratio (both / cls-only)   : {grad_both/grad_cls_only:.4f}\")\nprint(f\"  Ratio (recon / cls-only)  : {grad_recon_only/grad_cls_only:.4f}\")\n\nif grad_recon_only > 100 * grad_cls_only:\n    print(\"\\n  ► SUPPRESSION: recon gradient is drowning out cls gradient\")\n    print(\"    The encoder never adapts toward class separation\")\nelif grad_both < 0.1 * grad_cls_only:\n    print(\"\\n  ► CANCELLATION: gradients are opposing each other\")\nelse:\n    print(\"\\n  ► OK: gradients are compatible — problem is elsewhere\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cell 52G — Warm-start supervised encoder from unsupervised weights\n#\n# Why: supervised training from random init gets stuck at SNR≈0\n#      at epoch 0, giving the classifier no signal to learn from.\n#      Warm-starting gives the encoder SNR≈1.19 at epoch 0,\n#      breaking the cold-start deadlock.\n\nimport copy\n\n# ── Step 1: Create a new encoder with the same architecture ──\nenc_warmstart = GraphEncoder(latent_dim=ABIDE_LATENT_DIM, in_channels=1).to(DEVICE)\n\n# ── Step 2: Copy weights from the trained unsupervised encoder ──\n# state_dict() returns all parameters as a {name: tensor} dictionary\n# load_state_dict() copies those tensor values into enc_warmstart\nenc_warmstart.load_state_dict(abide_encoder.state_dict())\n\nprint(\"Weights copied. Verifying SNR in warm-started encoder...\")\n\n# ── Step 3: Verify SNR matches the unsupervised encoder ──\nenc_warmstart.eval()\nz_means = []\n\nwith torch.no_grad():\n    for idx, adj_seq in enumerate(train_subject_graphs):\n        z_list = []\n        for t in range(adj_seq.shape[0]):\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_seq[t] > 0))\n            ).long().to(DEVICE)\n\n            z_t = enc_warmstart(edge_index, num_nodes=ABIDE_N_NODES) \\\n                  if edge_index.numel() > 0 \\\n                  else torch.zeros(1, ABIDE_LATENT_DIM, device=DEVICE)\n            z_list.append(z_t)\n\n        z_mean = torch.cat(z_list, dim=0).mean(dim=0)\n        z_means.append((z_mean.cpu().numpy(), train_subject_labels[idx]))\n\nZ     = np.array([z for z, _ in z_means])\nlabs  = np.array([l for _, l in z_means])\n\nasd_mean = Z[labs == 1].mean(axis=0)\ntd_mean  = Z[labs == 0].mean(axis=0)\nseparation = np.linalg.norm(asd_mean - td_mean)\nwithin_var = (Z[labs == 1].var(axis=0).mean() + Z[labs == 0].var(axis=0).mean()) / 2\nsnr = separation / (within_var ** 0.5)\n\nprint(f\"  L2 separation (ASD vs TD) : {separation:.4f}\")\nprint(f\"  Within-group variance      : {within_var:.4f}\")\nprint(f\"  SNR at epoch 0             : {snr:.4f}\")\nprint()\nif snr > 0.5:\n    print(\"► Warm-start confirmed: encoder carries diagnostic signal at epoch 0\")\nelse:\n    print(\"► WARNING: SNR too low — check that abide_encoder is the correct variable\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cell 52H — Supervised training v4 (warm-started encoder)\n#\n# Single change from v3:\n#   Instead of creating a fresh GraphEncoder,\n#   accept a pre-trained encoder and copy its weights as starting point.\n#\n# Everything else (full-batch, auto-calibrated λ, shuffling) is identical to 52E.\n\ndef train_supervised_encoder_abide_v4(\n    n_nodes,\n    latent_dim,\n    train_subject_graphs,\n    train_subject_labels,\n    pretrained_encoder,          # ← new parameter\n    n_epochs   = 200,\n    lr         = 1e-3,\n    lambda_cls = None\n):\n    # ── Warm-start encoder from pretrained weights ──\n 