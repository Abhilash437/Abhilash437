cp_f1s[0] > 0.3 and cp_decay > 0.05:\n    print(\"Temporal signal — edges persist across snapshots.\")\nelif cp_f1s[0] < 0.05:\n    print(\"Copy-prev F1 near zero — snapshots may be too sparse.\")\nelse:\n    print(\"Weak signal. Proceed but expect modest model gains.\")\n\n# Random-encoder latent linearity\nprint(\" Random-encoder latent linearity (R^2)\")\n\nPROBE_DIM = 32  # cheap to compute; representative\n\nprobe_enc = GraphEncoder(latent_dim=PROBE_DIM).to(DEVICE)\n# NOTE: No training — this is a random projection, not a learned encoder.\n# If the graph sequence has ANY temporal structure (smooth edge evolution,\n# recurring patterns), even random projections will show R² > 0.\n\nprobe_enc.eval()\nz_probe = []\nwith torch.no_grad():\n    for t in range(len(jodie_graphs_all)):\n        adj_t      = jodie_graphs_all[t].to(DEVICE)\n        edge_index = torch.from_numpy(\n            np.array(np.where(adj_t.cpu().numpy()))\n        ).long().to(DEVICE)\n        z_t = probe_enc(edge_index, num_nodes=JODIE_N_NODES)\n        z_probe.append(z_t.squeeze(0).cpu().numpy())\n\nz_probe = np.array(z_probe)  # (T, PROBE_DIM)\n\nn_train_probe = T_jodie_train\nz_in  = z_probe[:-1]\nz_out = z_probe[1:]\nreg   = LinearRegression(fit_intercept=False).fit(z_in[:n_train_probe], z_out[:n_train_probe])\nz_hat = reg.predict(z_in[n_train_probe:])\nr2_per_dim = [r2_score(z_out[n_train_probe:, d], z_hat[:, d]) for d in range(PROBE_DIM)]\nr2_random  = float(np.mean(r2_per_dim))\n\nprint(f\"  R² (random encoder, dim={PROBE_DIM}): {r2_random:.4f}\")\nif r2_random > 0.3:\n    print(\" Strong linear structure — co-training should amplify this.\")\nelif r2_random > 0.05:\n    print(\" Moderate structure — co-training should help.\")\nelse:\n    print(\" Very weak. Co-training may struggle; check snapshot window size.\")\n\n# ── Quick plot ───────────────────────────────────────────────────────────────\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\naxes[0].plot(PROBE_STEPS, cp_f1s, marker='