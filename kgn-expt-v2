   adjacency[i, j] = 1\n                adjacency[j, i] = 1\n\n    return community_labels, adjacency\n\ndef add_temporal_drift(p_in_base, p_out_base, t, T_max, drift_type='none'):\n    \"\"\"Add temporal dynamics to SBM edge probabilities.\"\"\"\n    if drift_type == 'none':\n        return p_in_base, p_out_base\n    elif drift_type == 'periodic':\n        phase = 2 * np.pi * t / T_max\n        p_in_t = p_in_base + 0.3 * p_in_base * np.sin(phase)\n        p_out_t = p_out_base + 0.3 * p_out_base * np.sin(phase)\n    elif drift_type == 'linear':\n        trend = (t / T_max)\n        p_in_t = p_in_base * (1 - 0.05 * trend)\n        p_out_t = p_out_base * (1 + 0.10 * trend)\n    else:\n        raise ValueError(f'Unknown drift_type: {drift_type}')\n\n    return np.clip(p_in_t, 0, 1), np.clip(p_out_t, 0, 1)\n\ndef generate_graph_sequence(n_nodes, n_communities, p_in_base, p_out_base,\n                           sequence_length, drift_type='none',\n                           switch_prob=0.05, persistence=0.3, seed=42):\n    \"\"\"\n    Enhanced version: Adds Dynamic Communities and Edge Persistence.\n    \"\"\"\n    rng = np.random.RandomState(seed)\n\n    # Initial community assignment\n    nodes_per_community = n_nodes // n_communities\n    community_labels = np.repeat(np.arange(n_communities), nodes_per_community)\n    if n_nodes % n_communities > 0:\n        community_labels = np.concatenate([community_labels, np.arange(n_nodes % n_communities)])\n    rng.shuffle(community_labels)\n\n    adjacencies = []\n    prev_adj = np.zeros((n_nodes, n_nodes)) # Track previous state for persistence\n\n    for t in range(sequence_length):\n        # --- NEW: Dynamic Community Membership ---\n        # Nodes switch communities with a small probability\n        for i in range(n_nodes):\n            if rng.rand() < switch_prob:\n                community_labels[i] = rng.randint(0, n_communities)\n\n        p_in, p_out = add_temporal_drift(p_in_base, p_out_base, t, sequence_length, drift_type=drift_type)\n\n        adjacency = np.zeros((n_nodes, n_nodes))\n        for i in range(n_nodes):\n            for j in range(i + 1, n_nodes):\n                same_community = (community_labels[i] == community_labels[j])\n                p_base = p_in if same_community else p_out\n\n                # --- NEW: Edge Persistence ---\n                # If an edge existed at t-1, it's much more likely to exist at t\n                if prev_adj[i, j] == 1:\n                    p_final = p_base + (1 - p_base) * persistence\n                else:\n                    p_final = p_base * (1 - persistence)\n\n                # Base edge sampling\n                edge = 1 if rng.rand() < p_final else 0\n\n                # --- NEW: Noise injection ---\n                if rng.rand() < 0.02:  # 2% noise\n                    edge = 1 - edge  # flip\n\n                adjacency[i, j] = edge\n                adjacency[j, i] = edge\n\n        adjacencies.append(adjacency)\n        prev_adj = adjacency # Update history\n\n    return community_labels, adjacencies","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T10:54:25.541440Z","iopub.execute_input":"2026-05-16T10:54:25.542239Z","iopub.status.idle":"2026-05-16T10:54:25.555018Z","shell.execute_reply.started":"2026-05-16T10:54:25.542207Z","shell.execute_reply":"2026-05-16T10:54:25.554165Z"}},"outputs":[],"execution_count":3},{"cell_type":"code","source":"# SBM Variants\nSBM_VARIANTS = {\n    'SBM-Dynamic-Hard': {\n        'n_nodes': 100,\n        'n_communities': 4,\n        'p_in': 0.30,\n        'p_out': 0.05,\n        'drift_type': 'periodic',\n        'switch_prob': 0.25,   # High rate of nodes switching communities\n        'persistence': 0.3     # Strong temporal correlation\n    },\n    'SBM-Signal-Strong': {\n        'n_nodes': 100,\n        'n_communities': 3,\n        'p_in': 0.35,\n        'p_out': 0.01,\n        'drift_type': 'none',\n        'switch_prob': 0.02,\n        'persistence': 0.9\n    },\n\n    'SBM-Signal-Medium': {\n        'n_nodes': 100,\n        'n_communities': 3,\n        'p_in': 0.30,\n        'p_out': 0.05,\n        'drift_type': 'periodic',\n        'switch_prob': 0.10,\n        'persistence': 0.6\n    }\n}\n\nSEQUENCE_LENGTH = 100\nN_SEEDS = 5\n\nprint(f\"Generating {len(SBM_VARIANTS)} variants × {N_SEEDS} seeds = {len(SBM_VARIANTS) * N_SEEDS} sequences\\n\")\n\nfor variant_name, params in SBM_VARIANTS.items():\n    print(f\"Variant: {variant_name}\")\n    print(f\"  Nodes: {params['n_nodes']}, Communities: {params['n_communities']}\")\n    print(f\"  p_in: {params['p_in']}, p_out: {params['p_out']}, drift: {params['drift_type']}\")\n\n    variant_dir = DATA_DIR / variant_name\n    variant_dir.mkdir(parents=True, exist_ok=True)\n\n    for seed in range(N_SEEDS):\n        seed_dir = variant_dir / f'seed_{seed}'\n        seed_dir.mkdir(parents=True, exist_ok=True)\n\n        # Generate sequence\n        labels, sequences = generate_graph_sequence(\n            n_nodes=params['n_nodes'],\n            n_communities=params['n_communities'],\n            p_in_base=params['p_in'],\n            p_out_base=params['p_out'],\n            sequence_length=SEQUENCE_LENGTH,\n            drift_type=params['drift_type'],\n            seed=seed + 1000 * hash(variant_name) % 10000\n        )\n\n        # Save\n        adj_tensor = torch.from_numpy(np.array(sequences, dtype=np.float32))\n        torch.save(adj_tensor, seed_dir / 'graphs.pt')\n        np.save(seed_dir / 'community_labels.npy', labels)\n\n        edge_counts = [int(np.sum(adj) // 2) for adj in sequences]\n        meta = {\n            'variant': variant_name, 'seed': seed,\n            'n_nodes': params['n_nodes'], 'n_communities': params['n_communities'],\n            'p_in': params['p_in'], 'p_out': params['p_out'],\n            'drift_type': params['drift_type'], 'edge_counts': edge_counts\n        }\n        with open(seed_dir / 'meta.json', 'w') as f:\n            json.dump(meta, 