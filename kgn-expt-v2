n                        n_test += 1\n\n                        z_curr = z_pred\n\n        test_loss /= n_test\n        history['test_loss'].append(test_loss)\n\n        # EARLY STOPPING\n        if test_loss < best_test_loss:\n            best_test_loss = test_loss\n            best_state = model.state_dict().copy()\n            patience_counter = 0\n        else:\n            patience_counter += 1\n\n        scheduler.step()\n        model.train()\n\n        if verbose and (epoch + 1) % 10 == 0:\n            print(f\"    Epoch {epoch+1}/{epochs}: train={train_loss:.4f}, test={test_loss:.4f}\")\n\n        if patience_counter >= patience:\n            if verbose:\n                print(f\"    Early stopping at epoch {epoch+1} (best test_loss={best_test_loss:.4f})\")\n            break\n\n    if best_state is not None:\n        model.load_state_dict(best_state)\n\n    model.eval()\n    return history","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:06:10.037148Z","iopub.execute_input":"2026-05-24T05:06:10.037507Z","iopub.status.idle":"2026-05-24T05:06:10.059293Z","shell.execute_reply.started":"2026-05-24T05:06:10.037460Z","shell.execute_reply":"2026-05-24T05:06:10.058381Z"}},"outputs":[],"execution_count":12},{"cell_type":"code","source":"def compute_f1_from_latent(z_pred, adj_true, decoder):\n    \"\"\"Compute F1 by decoding predicted latent and comparing to true adjacency.\"\"\"\n\n    # Ensure tensor\n    if not isinstance(z_pred, torch.Tensor):\n        z_pred = torch.from_numpy(z_pred)\n\n    z_pred = z_pred.float().to(DEVICE)\n\n    if z_pred.dim() == 1:\n        z_pred = z_pred.unsqueeze(0)   # (1, latent_dim)\n\n    # Decode\n    with torch.no_grad():\n        adj_pred = decoder.reconstruct_adjacency(z_pred)\n\n        if adj_pred.dim() == 3:\n            adj_pred = adj_pred[0]\n\n        adj_pred = adj_pred.cpu().numpy()\n\n    # Handle adj_true\n    if isinstance(adj_true, torch.Tensor):\n        adj_true = adj_true.cpu().numpy()\