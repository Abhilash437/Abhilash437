       spec_loss = torch.tensor(0.0, device=z_pred.device)\n\n    return recon_loss + spectral_penalty_weight * spec_loss\n\n\nprint(\"Utility functions defined\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:06:10.012835Z","iopub.execute_input":"2026-05-24T05:06:10.013168Z","iopub.status.idle":"2026-05-24T05:06:10.035992Z","shell.execute_reply.started":"2026-05-24T05:06:10.013132Z","shell.execute_reply":"2026-05-24T05:06:10.035145Z"}},"outputs":[{"name":"stdout","text":"Utility functions defined\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"# Training\n\ndef train_single_model(\n    model, train_loader, test_loader,\n    mode='single_step',\n    epochs=50,\n    learning_rate=1e-3,\n    weight_decay=1e-4,\n    spectral_penalty_weight=0.1,\n    rollout_weight=0.3,     \n    rollout_steps=2,         \n    patience=15,\n    verbose=False\n):\n    optimizer = Adam(model.parameters(), lr=learning_rate, weight_decay=weight_decay)\n    scheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=20, gamma=0.9)\n\n    best_test_loss = float('inf')\n    best_state = None\n    patience_counter = 0\n    history = {'train_loss': [], 'test_loss': []}\n\n    model.train()\n\n    for epoch in range(epochs):\n        train_loss = 0.0\n        n_batches = 0\n\n        # TRAINING\n        if mode == 'single_step':\n            for z_in, z_out in train_loader:\n                z_in, z_out = z_in.to(DEVICE), z_out.to(DEVICE)\n\n                z_pred = model(z_in)\n\n                if z_out.dim() == 1:\n                    z_out = z_out.unsqueeze(-1)\n                if z_pred.dim() == 1:\n                    z_pred = z_pred.unsqueeze(-1)\n\n                # Base loss\n                loss = compute_loss(z_pred, z_out, model, spectral_penalty_weight)\n\n                if rollout_steps > 1:\n                    z_roll = z_pred\n                    rollout_loss = 0.0\n\n                    for k in range(1, rollout_s