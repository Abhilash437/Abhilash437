eam"}],"execution_count":8},{"cell_type":"code","source":"# Linearity diagnostics on co-trained latents\n# Goal: measure how well the latent space z_t follows z_{t+1} = K z_t.\n# We encode a held-out sequence, fit a linear map with least squares,\n# and report R² = 1 - (residual variance / total variance).\n#\n# Interpretation:\n#   R² ≈ 0.07  → original two-stage (confirmed from Step 2 results)\n#   R² > 0.5   → co-training is working; latent space is meaningfully linear\n#   R² ≈ 1.0   → overfitting (latent space collapsed to a degenerate manifold)\n\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import r2_score\n\ndef compute_latent_linearity(encoder, variant_name, latent_dim, seed=0):\n    \"\"\"\n    Encodes a graph sequence and measures R² of the best-fit linear map\n    z_{t+1} = A z_t.\n\n    Parameters\n    ----------\n    encoder      : trained GraphEncoder\n    variant_name : str — which SBM variant to use (use a signal variant)\n    latent_dim   : int\n    seed         : int — which seed to use (use a held-out seed, e.g. 4)\n\n    Returns\n    -------\n    r2 : float — R² of linear fit across all (z_t, z_{t+1}) pairs\n    \"\"\"\n    n_nodes = SBM_VARIANTS[variant_name]['n_nodes']\n    graphs  = torch.load(DATA_DIR / variant_name / f'seed_{seed}' / 'graphs.pt')\n\n    # Encode all frames\n    encoder.eval()\n    latent_seq = []\n    with torch.no_grad():\n        for t in range(len(graphs)):\n            adj_t      = graphs[t].to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy()))\n            ).long().to(DEVICE)\n            z_t = encoder(edge_index, num_nodes=n_nodes)\n            latent_seq.append(z_t.squeeze(0).cpu().numpy())\n\n    z = np.array(latent_seq)  # (T, latent_dim)\n\n    # Fit linear map on first 75% of the sequence\n    T       = len(z)\n    n_train = int(T * 0.75)\n\n    z_in  = z[:-1]   # z_t\n    z_out = z[1:]    # z_{t+1}\n\n    reg   = LinearRegression(fit_intercept=False).fit(z_in[:n_train], z_out[:n_train])\n    z_hat = reg.predict(z_in[n_train:])  # test on held-out 25%\n\n    # R² computed per latent dimension, then averaged\n    r2_per_dim = [\n        r2_score(z_out[n_train:, d], z_hat[:, d])\n        for d in range(latent_dim)\n    ]\n    return float(np.mean(r2_per_dim)), r2_per_dim\n\n\nif USE_COTRAIN:\n    print(\"Linearity diagnostic (R^2 of linear fit on latent trajectories)\\n\")\n    print(f\"{'Variant':<22}  {'Latent Dim':>10}  {'R²':>8}\")\n    print(\"-\" * 45)\n    \n    DIAG_VARIANT = 'SBM-Signal-Strong'  # most signal → fairest test for linearity\n    \n    linearity_results = {}\n    \n    for latent_dim in LATENT_DIMS:\n        enc = trained_encoders[(SBM_VARIANTS[DIAG_VARIANT]['n_nodes'], latent_dim)]\n        r2, per_dim = compute_latent_linearity(enc, DIAG_VARIANT, latent_dim, seed=4)\n        linearity_results[latent_dim] = r2\n        print(f\"{DIAG_VARIANT:<22}  {latent_dim:>10}  {r2:>8.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:05:02.492776Z","iopub.execute_input":"2026-05-18T15:05:02.493681Z","iopub.status.idle":"2026-05-18T15:05:02.595898Z","shell.execute_reply.started":"2026-05-18T15:05:02.493648Z","shell.execute_reply":"2026-05-18T15:05:02.595258Z"}},"outputs":[],"execution_count":9},{"cell_type":"code","source":"# Encode all the graphs to latent space\n\nprint(f\"\\nEncoding all graphs to latent space\\n\")\n\nfor variant_name, params in SBM_VARIANTS.items():\n    n_nodes = params['n_nodes']\n\n    for latent_dim in LATENT_DIMS:\n        # Get the correct encoder for this (n_nodes, latent_dim) combination\n        encoder = trained_encoders[(n_nodes, latent_dim)]\n\n        latent_dir = LATENT_DIR / variant_name / f'latent_dim={latent_dim}'\n        latent_dir.mkdir(parents=True, exist_ok=True)\n\n        for seed in range(N_SEEDS):\n            graphs = torch.load(DATA_DIR / variant_name / f'seed_{seed}' / 'graphs.pt')\n\n            latent_seq = []\n            with torch.no_grad():\n                for t in range(len(graphs)):\n                    adj_t = graphs[t]\n                    edge_index = torch.from_numpy(\n                        np.array(np.where(adj_t.numpy()))\n                    ).long().to(DEVICE)\n\n                    z_t = encoder(edge_index, num_nodes=n_nodes)\n                    latent_seq.append(z_t.squeeze(0).cpu().numpy())\n\n            latent_seq = np.array(latent_seq)  # (20, latent_dim)\n            torch.save(torch.from_numpy(latent_seq).float(),\n                      latent_dir / f'seed_{seed}.pt')\n\n        print(f\"{variant_name} latent_dim={latent_dim}: shape {latent_seq.shape}\")\n\nprint(f\"\\n All graphs encoded! Latent trajectories saved to {LATENT_DIR}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:05:02.596719Z","iopub.execute_input":"2026-05-18T15:05:02.597179Z","iopub.status.idle":"2026-05-18T15:05:17.588354Z","shell.execute_reply.started":"2026-05-18T15:05:02.597128Z","shell.execute_reply":"2026-05-18T15:05:17.587421Z"}},"outputs":[{"name":"stdout","text":"\nEncoding all graphs to latent space\n\nSBM-Dynamic-Hard latent_dim=16: shape (100, 16)\nSBM-Dynamic-Hard latent_dim=32: shape (100, 32)\nSBM-Dynamic-Hard latent_dim=64: shape (100, 64)\nSBM-Dynamic-Hard latent_dim=128: shape (100, 128)\nSBM-Signal-Strong latent_dim=16: shape (100, 16)\nSBM-Signal-Strong latent_dim=32: shape (100, 32)\nSBM-Signal-Strong latent_dim=64: shape (100, 64)\nSBM-Signal-Strong latent_dim=128: shape (100, 128)\nSBM-Signal-Medium latent_dim=16: shape (100, 16)\nSBM-Signal-Medium latent_dim=32: shape (100, 32)\nSBM-Signal-Medium latent_dim=64: shape (100, 64)\nSBM-Signal-Medium latent_dim=128: shape (100, 128)\n\n All graphs encoded! Latent trajectories saved to /kaggle/working/latent\n","output_type":"stream"}],"execution_count":10},{"cell_type":"code","source":"# Transition models\n\nimport torch\nimport torch.nn as nn\n\n# Base Class\nclass BaseTransitionModel(nn.Module):\n    def reset_hidden(self, batch_size, device):\n        return None\n\n# 1. KOOPMAN (LINEAR)\nclass KoopmanLinearSingleStep(nn.Module):\n    \"\"\"z_{t+1} = K z_t\"\"\"\n    def __init__(self, latent_dim):\n        super().__init__()\n        self.K = nn.Linear(latent_dim, latent_dim, bias=False)\n\n    def forward(self, z_t):\n        return self.K(z_t)\n\n\nclass KoopmanLinearStateful(nn.Module):\n    \"\"\"\n    h_{t+1} = A h_t + B z_t\n    z_{t+1} = C h_{t+1}\n    \"\"\"\n    def __init__(self, latent_dim, hidden_dim=64):\n        super().__init__()\n        self.A = nn.Linear(hidden_dim, hidden_dim, bias=False)\n        self.B = nn.Linear(latent_dim, hidden_dim, bias=False)\n        self.C = nn.Linear(hidden_dim, latent_dim)\n\n        self.hidden_dim = hidden_dim\n\n    def forward(self, z_t, h_t=None):\n        if h_t is None:\n            h_t = torch.zeros(z_t.shape[0], self.hidden_dim, device=z_t.device)\n\n        h_next = self.A(h_t) + self.B(z_t)\n        z_next = self.C(h_next)\n\n        return z_next, h_next\n\nclass KoopmanEDMDLift(nn.Module):\n    \"\"\"EDMD with quadratic feature lift: φ(z) = [z, z²]\"\"\"\n    def __init__(self, latent_dim):\n        super().__init__()\n        phi_dim = latent_dim * 2\n        self.K = nn.Linear(phi_dim, phi_dim, bias=False)\n        self.latent_dim = latent_dim\n\n    def lift(self, z):\n        return torch.cat([z, z**2], dim=-1)\n\n    def forward(self, z):\n        return self.lift(self.K(self.lift(z)))[:, :self.latent_dim]\n\n    def spectral_loss(self):\n        evals = torch.linalg.eigvals(self.K.weight)\n        return torch.relu(torch.max(torch.abs(evals)) - 0.9) ** 2\n\n# 2. MLP TRANSITION\nclass MLPTransitionSingleStep(nn.Module):\n    \"\"\"z_{t+1} = MLP(z_t)\"\"\"\n    def __init__(self, latent_dim, hidden_dim=128):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(latent_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, latent_dim)\n        )\n\n    def forward(self, z_t):\n        return self.net(z_t)\n\n\nclass MLPTransitionStateful(nn.Module):\n    \"\"\"\n    h_{t+1} = MLP([h_t, z_t])\n    z_{t+1} = W h_{t+1}\n    \"\"\"\n    def __init__(self, latent_dim, hidden_dim=128):\n        super().__init__()\n        self.hidden_dim = hidden_dim\n\n        self.h_net = nn.Sequential(\n            nn.Linear(hidden_dim + latent_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim)\n        )\n\n        self.W_out = nn.Linear(hidden_dim, latent_dim)\n\n    def forward(self, z_t, h_t=None):\n        if h_t is None:\n            h_t = torch.zeros(z_t.shape[0], self.hidden_dim, device=z_t.device)\n\n        inp = torch.cat([h_t, z_t], dim=-1)\n        h_next = self.h_net(inp)\n        z_next = self.W_out(h_next)\n\n        return z_next, h_next\n\n# 3. GRU\nclass GRUTransitionSingleStep(nn.Module):\n    \"\"\"Stateless GRU (no memory carried)\"\"\"\n    def __init__(self, latent_dim):\n        super().__init__()\n        self.gru_cell = nn.GRUCell(latent_dim, latent_dim)\n\n    def forward(self, z_t):\n        h = torch.zeros(z_t.shape[0], z_t.shape[1], device=z_t.device)\n        return self.gru_cell(z_t, h)\n\n\nclass GRUTransitionStateful(nn.Module):\n    \"\"\"Proper GRU dynamics\"\"\"\n    def __init__(self, latent_dim, hidden_dim=128):\n        super().__init__()\n        self.gru_cell = nn.GRUCell(latent_dim, hidden_dim)\n        self.W_out = nn.Linear(hidden_dim, latent_dim)\n        self.hidden_dim = hidden_dim\n\n    def forward(self, z_t, h_t=None):\n        if h_t is None:\n            h_t = torch.zeros(z_t.shape[0], self.hidden_dim, device=z_t.device)\n\n        h_next = self.gru_cell(z_t, h_t)\n        z_next = self.W_out(h_next)\n\n        return z_next, h_next\n\n\n# 4. VANILLA RNN\nclass RNNTransitionSingleStep(nn.Module):\n    def __init__(self, latent_dim):\n        super().__init__()\n        self.W = nn.Linear(latent_dim, latent_dim)\n\n    def forward(self, z_t):\n        return torch.tanh(self.W(z_t))\n\n\nclass RNNTransitionStateful(nn.Module):\n    \"\"\"\n    h_{t+1} = tanh(W_h h_t + W_z z_t)\n    z_{t+1} = W_out h_{t+1}\n    \"\"\"\n    def __init__(self, latent_dim, hidden_dim=128):\n        super().__init__()\n        self.W_h = nn.Linear(hidden_dim, hidden_dim)\n        self.W_z = nn.Linear(latent_dim, hidden_dim)\n        self.W_out = nn.Linear(hidden_dim, latent_dim)\n\n        self.hidden_dim = hidden_dim\n\n    def forward(self, z_t, h_t=None):\n        if h_t is None:\n            h_t = torch.zeros(z_t.shape[0], self.hidden_dim, device=z_t.device)\n\n        h_next = torch.tanh(self.W_h(h_t) + self.W_z(z_t))\n        z_next = self.W_out(h_next)\n\n        return z_next, h_next\n\n\nprint(\"Transition models (research-grade) loaded\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:05:17.590772Z","iopub.execute_input":"2026-05-18T15:05:17.591174Z","iopub.status.idle":"2026-05-18T15:05:17.619141Z","shell.execute_reply.started":"2026-05-18T15:05:17.591144Z","shell.execute_reply":"2026-05-18T15:05:17.618217Z"}},"outputs":[{"name":"stdout","text":"Transition models (research-grade) loaded\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"# Utilities for training\n\ndef get_model_class(model_name, mode):\n    \"\"\"Return model class for given (model_name, mode) pair.\"\"\"\n    mapping = {\n        ('Koopman', 'single_step'): KoopmanLinearSingleStep,\n        ('Koopman', 'stateful'): KoopmanLinearStateful,\n        ('MLP', 'single_step'): MLPTransitionSingleStep,\n        ('MLP', 'stateful'): MLPTransitionStateful,\n        ('GRU', 'single_step'): GRUTransitionSingleStep,\n        ('GRU', 'stateful'): GRUTransitionStateful,\n        ('RNN', 'single_step'): RNNTransitionSingleStep,\n        ('RNN', 'stateful'): RNNTransitionStateful,\n        ('E