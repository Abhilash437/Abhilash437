n_fd', 'func_num_fd', 'func_perc_fd', 'func_gsr', 'qc_rater_1', 'qc_notes_rater_1', 'qc_anat_rater_2', 'qc_anat_notes_rater_2', 'qc_func_rater_2', 'qc_func_notes_rater_2', 'qc_anat_rater_3', 'qc_anat_notes_rater_3', 'qc_func_rater_3', 'qc_func_notes_rater_3', 'SUB_IN_SMP']\n\nLabel distribution:\n  ASD (label=1): 50\n  TD  (label=0): 50\nLoading ROI time series...\n  Subject 78: skipped (78 timepoints < 100)\n  Subject 79: skipped (78 timepoints < 100)\n  Subject 80: skipped (78 timepoints < 100)\n  Subject 81: skipped (78 timepoints < 100)\n  Subject 82: skipped (78 timepoints < 100)\n  Subject 83: skipped (78 timepoints < 100)\n  Subject 84: skipped (78 timepoints < 100)\n  Subject 85: skipped (78 timepoints < 100)\n  Subject 86: skipped (78 timepoints < 100)\n  Subject 87: skipped (78 timepoints < 100)\n  Subject 88: skipped (78 timepoints < 100)\n  Subject 89: skipped (78 timepoints < 100)\n  Subject 90: skipped (78 timepoints < 100)\n  Subject 91: skipped (78 timepoints < 100)\n  Subject 92: skipped (78 timepoints < 100)\n  Subject 93: skipped (78 timepoints < 100)\n  Subject 94: skipped (78 timepoints < 100)\n  Subject 95: skipped (78 timepoints < 100)\n  Subject 96: skipped (78 timepoints < 100)\n  Subject 97: skipped (78 timepoints < 100)\n  Subject 98: skipped (78 timepoints < 100)\n  Subject 99: skipped (78 timepoints < 100)\n\n✓ Loaded 78 valid subjects\n  ASD: 38  |  TD: 40\n  Timepoints — min: 196, max: 206, mean: 199.6\n  ROIs per subject: 116\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"# ============================================================\n# CELL B — Sliding Window Functional Connectivity\n#\n# What this cell does:\n#   For each subject's (T × 116) BOLD time series:\n#   1. Slide a window of W timepoints across T\n#   2. Compute Pearson correlation between all ROI pairs → FC matrix\n#   3. Threshold: keep edges where correlation > TAU\n#   4. Output: one (n_snapshots × 116 × 116) adjacency tensor per subject\n#\n# References:\n#   - Sliding window FC: Hutchison et al., NeuroImage 2013\n#     https://doi.org/10.1016/j.neuroimage.2013.05.079\n#   - FC thresholding: Garrison et al., NeuroImage 2015\n#     https://doi.org/10.1016/j.neuroimage.2015.05.005\n# ============================================================\n\n# ── Configuration ────────────────────────────────────────────\nWINDOW_SIZE  = 30    # W: timepoints per window\nSTEP_SIZE    = 10    # S: how far the window slides each time\n                     # With T≈200, W=30, S=10:\n                     # n_snapshots = (200-30)//10 + 1 = 18 per subject\nTAU          = 0.6   # correlation threshold — edges with |r| < TAU are zeroed\n                     # 0.3 is standard in dynamic FC literature\nN_ROIS       = 116   # AAL atlas regions\n# ── Configuration addition ───────────────────────────────────\nMIN_DENSITY = 0.05   # drop windows that are too sparse (artifact/noise)\nMAX_DENSITY = 0.50   # drop windows that are too dense (global signal artifact)\n\nABIDE_DATA_DIR = DATA_DIR / 'ABIDE'\nABIDE_DATA_DIR.mkdir(parents=True, exist_ok=True)\n\n# ── Core function ─────────────────────────────────────────────\ndef build_fc_sequence(time_series, window_size=30, step_size=10,\n                      tau=0.6, min_density=0.05, max_density=0.50):\n    \"\"\"\n    Converts a single subject's BOLD time series into a sequence\n    of thresholded FC adjacency matrices, with artifact window filtering.\n    \"\"\"\n    T      = time_series.shape[0]\n    n_rois = time_series.shape[1]\n    starts = list(range(0, T - window_size + 1, step_size))\n\n    adjacencies = []\n    densities   = []\n\n    for start in starts:\n        end    = start + window_size\n        window = time_series[start:end, :]      # (W, 116)\n\n        fc = np.corrcoef(window.T)              # (116, 116)\n        fc = np.nan_to_num(fc, nan=0.0)\n\n        adj = ((fc >= tau) & (fc > 0)).astype(np.float32)\n        np.fill_diagonal(adj, 0.0)\n\n        # Compute density BEFORE appending\n        n_possible = n_rois * (n_rois - 1) / 2\n        n_edges    = adj[np.triu_indices(n_rois, k=1)].sum()\n        dens       = n_edges / n_possible\n\n        # ── Density filter ───────────────────────────────────\n        # Skip this window if it's an artifact\n        if dens < min_density or dens > max_density:\n            continue    # <-- this must be INSIDE the for loop, before append\n\n        adjacencies.append(adj)\n        densities.append(dens)\n\n    # Guard: if no windows survived filtering, return empty\n    if len(adjacencies) == 0:\n        return np.zeros((0, n_rois, n_rois), dtype=np.float32), []\n\n    return np.stack(adjacencies, axis=0), densities\n\n# DEBUG — run on subject 0 only, print every window\nts = time_series_list[0]\nT      = ts.shape[0]\nn_rois = ts.shape[1]\nstarts = list(range(0, T - 30 + 1, 10))\n\nprint(f\"Subject 0: {T} timepoints, {len(starts)} windows\\n\")\nprint(f\"{'Start':>6} {'End':>6} {'Density':>10} {'Kept':>6}\")\nprint(\"-\" * 35)\n\nfor start in starts:\n    end    = start + 30\n    window = ts[start:end, :]\n    fc     = np.corrcoef(window.T)\n    fc     = np.nan_to_num(fc, nan=0.0)\n    adj    = ((fc >= 0.6) & (fc > 0)).astype(np.float32)\n    np.fill_diagonal(adj, 0.0)\n    \n    n_possible = n_rois * (n_rois - 1) / 2\n    n_edges    = adj[np.triu_indices(n_rois, k=1)].sum()\n    dens       = n_edges / n_possible\n    kept       = \"YES\" if 0.05 <= dens <= 0.50 else \"NO\"\n    \n    print(f\"{start:>6} {end:>6} {dens:>10.4f} {kept:>6}\")\n\nprint(f\"\\nMax fc value in last window: {fc.max():.4f}\")\nprint(f\"Min fc value in last window: {fc.min():.4f}\")\nprint(f\"Sample fc row 0: {fc[0, :5]}\")\n\n\n# ── Build adjacency tensors for all subjects ─────────────────\nprint(f\"Building FC sequences...\")\nprint(f\"  Window={WINDOW_SIZE}, Step={STEP_SIZE}, Tau={TAU}\")\nprint(f\"  Expected snapshots per subject: \"\n      f\"{(min(ts.shape[0] for ts in time_series_list) - WINDOW_SIZE) // STEP_SIZE + 1}\"\n      f\" – \"\n      f\"{(max(ts.shape[0] for ts in time_series_list) - WINDOW_SIZE) // STEP_SIZE + 1}\")\nprint()\n\nMIN_SNAPSHOTS = 10   # need at least 10 windows for a meaningful trajectory\n\nabide_adj_tensors = []\nvalid_labels_b    = []   # may differ from valid_labels if some subjects lose too many windows\nall_densities = []\n\nfor i, (ts, label) in enumerate(zip(time_series_list, valid_labels)):\n    adj_seq, dens = build_fc_sequence(ts, WINDOW_SIZE, STEP_SIZE, TAU,\n                                       MIN_DENSITY, MAX_DENSITY)\n\n    if adj_seq.shape[0] < MIN_SNAPSHOTS:\n        print(f\"  Subject {i}: skipped after density filter \"\n              f\"({adj_seq.shape[0]} valid windows < {MIN_SNAPSHOTS})\")\n        continue\n\n    abide_adj_tensors.append(adj_seq)\n    valid_labels_b.append(label)\n    all_densities.extend(dens)\n\n    subj_dir = ABIDE_DATA_DIR / f'subject_{i:03d}'\n    subj_dir.mkdir(parents=True, exist_ok=True)\n    torch.save(torch.from_numpy(adj_seq).float(), subj_dir / 'graphs.pt')\n\nvalid_labels_b = np.array(valid_labels_b)\n\nprint(f\"✓ Built adjacency sequences for {len(abide_adj_tensors)} subjects\")\nprint(f\"  Snapshots per subject: \"\n      f\"min={min(a.shape[0] for a in abide_adj_tensors)}, \"\n      f\"max={max(a.shape[0] for a in abide_adj_tensors)}\")\n\n# Add after the main loop — identify outlier subjects\nprint(\"\\nSubjects with any window > 0.50 density:\")\nfor i, adj_seq in enumerate(abide_adj_tensors):\n    subj_densities = []\n    for t in range(adj_seq.shape[0]):\n        n_rois = adj_seq.shape[1]\n        n_possible = n_rois * (n_rois - 1) / 2\n        n_edges = adj_seq[t][np.triu_indices(n_rois, k=1)].sum()\n        subj_densities.append(n_edges / n_possible)\n    if max(subj_densities) > 0.50:\n        print(f\"  Subject {i}: max density = {max(subj_densities):.4f}, \"\n              f\"site = {abide.phenotypic['SITE_ID'].values[valid_indices[i]]}\")\n\n# ── Density diagnostic ───────────────────────────────────────\n# Replace the all_densities reporting block with this\nfor adj_seq in abide_adj_tensors:\n    for t in range(adj_seq.shape[0]):\n        n_possible = N_ROIS * (N_ROIS - 1) / 2\n        n_edges    = adj_seq[t][np.triu_indices(N_ROIS, k=1)].sum()\n        all_densities.append(n_edges / n_possible)\n\nprint(f\"\\n  Graph density (filtered snapshots only):\")\nprint(f\"    Mean:  {np.mean(all_densities):.4f} ({np.mean(all_densities)*100:.1f}%)\")\nprint(f\"    Min:   {min(all_densities):.4f}\")\nprint(f\"    Max:   {max(all_densities):.4f}\")\nprint(f\"    Subjects: {len(abide_adj_tensors)}\")\nprint(f\"    ASD: {valid_labels_b.sum()}  |  TD: {(valid_labels_b==0).sum()}\")\nmean_density = np.mean(all_densities)\n# Compare with JODIE\nprint(f\"\\n  JODIE density was 0.09% → collapse\")\nprint(f\"  ABIDE density is  {mean_density*100:.1f}%  → \"\n      f\"{'well above' if mean_density > 0.05 else 'still too low — reduce TAU'} collapse threshold\")\n\n# ── Quick density histogram ──────────────────────────────────\nplt.figure(figsize=(7, 3.5))\nplt.hist(all_densities, bins=40, color='steelblue', edgecolor='white', linewidth=0.5)\nplt.axvline(0.01, color='crimson', linestyle='--', linewidth=1.5,\n            label='Collapse threshold (1%)')\nplt.axvline(mean_density, color='seagreen', linestyle='-', linewidth=2,\n            label=f'Mean density ({mean_density*100:.1f}%)')\nplt.xlabel('Edge density per snapshot', fontsize=11)\nplt.ylabel('Count', fontsize=11)\nplt.title('ABIDE FC Graph Density Distribution\\n'\n          f'(W={WINDOW_SIZE}, S={STEP_SIZE}, τ={TAU})', fontsize=11)\nplt.legend(fontsize=9)\nplt.tight_layout()\nplt.savefig(RESULTS_DIR / 'abide_density.png', dpi=150, bbox_inches='tight')\nplt.show()\n\nprint(f\"\\nSaved to {RESULTS_DIR / 'abide_density.png'}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:06:16.858580Z","iopub.execute_input":"2026-05-24T05:06:16.858865Z","iopub.status.idle":"2