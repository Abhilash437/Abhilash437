":"# Cell 30 — Adjacency-Conditioned Multi-Scale Hyper-Koopman Network\n# ──────────────────────────────────────────────────────────────────────────\n\nimport torch\nimport torch.nn as nn\n\nclass AdjacencyConditionedKoopmanNet(nn.Module):\n    def __init__(self, input_dim, latent_dim=32):\n        super(AdjacencyConditionedKoopmanNet, self).__init__()\n        \n        assert latent_dim % 2 == 0, \"Latent dimension must be divisible by 2.\"\n        self.sub_dim = latent_dim // 2\n        self.latent_dim = latent_dim\n        phase_space_dim = input_dim * 2\n        \n        # 1. State Space Encoder\n        self.encoder_shared = nn.Sequential(\n            nn.Linear(phase_space_dim, 128),\n            nn.GELU(),\n            nn.Linear(128, 64),\n            nn.GELU(),\n            nn.Linear(64, latent_dim)\n        )\n        \n        # 2. Topology / Adjacency Hypernetwork Core\n        # Ingests the spatial structure coordinates to map the instant physical boundary context\n        self.hyper_net = nn.Sequential(\n            nn.Linear(input_dim, 64),\n            nn.GELU(),\n            nn.Linear(64, 64),\n            nn.GELU()\n        )\n        \n        # Hyper-projections to generate weight slices dynamically\n        self.to_kin_weights = nn.Linear(64, self.sub_dim * self.sub_dim)\n        self.to_pheno_weights = nn.Linear(64, self.sub_dim * self.sub_dim)\n        \n        # 3. Spatiotemporal Phenotypic Classifier Head\n        self.temporal_conv = nn.Sequential(\n            nn.Conv1d(in_channels=self.sub_dim, out_channels=32, kernel_size=3, padding=1),\n            nn.GELU(),\n            nn.BatchNorm1d(32),\n            nn.AdaptiveAvgPool1d(1)\n        )\n        self.classifier = nn.Sequential(\n            nn.Linear(32, 16),\n            nn.GELU(),\n            nn.Linear(16, 2)\n        )\n\n    def get_conditioned_K(self, spatial_coordinates):\n        \"\"\"\n        Dynamically constructs a unique, structurally stable block-diagonal matrix \n        conditioned entirely on the current geometric topology of the sample.\n        \"\"\"\n        device = spatial_coordinates.device\n        B = spatial_coordinates.shape[0]\n        \n        # Compute topology embedding context\n        h_topology = self.hyper_net(spatial_coordinates) # Shape: (B, 64)\n        \n        # Project raw weight shapes for Block 1 (Kinetic Base) and Block 2 (Phenotypic Base)\n        raw_kin = self.to_kin_weights(h_topology).view(B, self.sub_dim, self.sub_dim)\n        raw_pheno = self.to_pheno_weights(h_topology).view(B, self.sub_dim, self.sub_dim)\n        \n        K_conditioned_batches = []\n        \n        for b in range(B):\n            # Enforce strict skew-symmetric parameterization per sample to shield stability\n            A_raw = raw_kin[b]\n            A = A_raw - A_raw.t()\n            K_kin_b = torch.matrix_exp(A)\n            \n            K_pheno_b = raw_pheno[b]\n            \n            # Assemble sample-specific block diagonal matrix\n            K_top = torch.cat([K_kin_b, torch.zeros(self.sub_dim, self.sub_dim, device=device)], dim=1)\n            K_bot = torch.cat([torch.zeros(self.sub_dim, self.sub_dim, device=device), K_pheno_b], dim=1)\n            K_composite_b = torch.cat([K_top, K_bot], dim=0)\n            \n            K_conditioned_batches.append(K_composite_b.unsqueeze(0))\n            \n        return torch.cat(K_conditioned_batches, dim=0) # Shape: (B, Latent_Dim, Latent_Dim)\n\nprint(\"Topology-Adaptive Hyper-Koopman Operator successfully initialized.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T12:18:31.389693Z","iopub.execute_input":"2026-05-24T12:18:31.390117Z","iopub.status.idle":"2026-05-24T12:18:31.407129Z","shell.execute_reply.started":"2026-05-24T12:18:31.390083Z","shell.execute_reply":"2026-05-24T12:18:31.405927Z"}},"outputs":[{"name":"stdout","text":"Topology-Adaptive Hyper-Koopman Operator successfully initialized.\n","output_type":"stream"}],"executio