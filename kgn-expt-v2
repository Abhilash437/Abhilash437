y sequence has enough remaining steps for this horizon evaluation\n            if t_len <= step + 1:\n                continue\n                \n            valid_sequences += 1\n            max_valid_t = t_len - step\n            \n            # --- BASELINE MODEL ROLLOUT ---\n            z_base_start = z_base_gt[b, :max_valid_t] # Starting states at t\n            z_base_target = z_base_gt[b, step:t_len]  # True target states at t + step\n            # Matrix power simulation: apply operator recursively\n            K_pow_base = torch.matrix_power(K_base, step)\n            z_base_pred = torch.matmul(z_base_start, K_pow_base.t())\n            step_base_mse += torch.nn.functional.mse_loss(z_base_pred, z_base_target).item()\n            \n            # --- BLOCK-DIAGONAL MODEL ROLLOUT (FULL 32D) ---\n            z_block_start = z_block_gt[b, :max_valid_t]\n            z_block_target = z_block_gt[b, step:t_len]\n            K_pow_block = torch.matrix_power(K_block, step)\n            z_block_pred = torch.matmul(z_block_start, K_pow_block.t())\n            step_block_mse += torch.nn.functional.mse_loss(z_block_pred, z_block_target).item()\n            \n            # --- ISOLATED KINETIC SUB-BLOCK ROLLOUT (FIRST 16D) ---\n            z_kin_start = z_block_gt[b, :max_valid_t, 0:16]\n            z_kin_target = z_block_gt[b, step:t_len, 0:16]\n            K_pow_kin = torch.matrix_power(K_block[0:16, 0:16], step)\n            z_kin_pred = torch.matmul(z_kin_start, K_pow_kin.t())\n            step_kin_mse += torch.nn.functional.mse_loss(z_kin_pred, z_kin_target).item()\n            \n        baseline_errors[step-1] = step_base_mse / valid_sequences\n        block_errors[step-1] = step_block_mse / valid_sequences\n        block_kin_errors[step-1] = step_kin_mse / valid_sequences\n\nprint(\"Autoregressive multi-step rollouts completed successfully.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T12:14:33.787372Z","iopub.execute_input":"2026-05-24