hs, latent_dim, n_epochs=100, horizon=5):\n    encoder.eval()\n    \n    # Instantiate using your exact notebook class names\n    mlp = MLPTransitionSingleStep(latent_dim=latent_dim).to(DEVICE)\n    gru = GRUTransitionStateful(latent_dim=latent_dim, hidden_dim=128).to(DEVICE)\n    \n    opt_mlp = torch.optim.Adam(mlp.parameters(), lr=1e-3)\n    opt_gru = torch.optim.Adam(gru.parameters(), lr=1e-3)\n    \n    # Pre-extract frozen v7 embeddings for optimal pipeline performance\n    extracted_trajectories = []\n    for idx in range(len(train_subject_graphs)):\n        adj_seq = train_subject_graphs[idx]\n        with torch.no_grad():\n            z_list = []\n            for t in range(adj_seq.shape[0]):\n                edge_index = torch.from_numpy(np.array(np.where(adj_seq[t] > 0))).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n            extracted_trajectories.append(torch.cat(z_list, dim=0))\n\n    print(\"=\" * 65)\n    print(\"TRAINING NATIVE BASELINES (MLP SingleStep vs. GRU Stateful)\")\n    print(\"=\" * 65)\n    print(f\"\\n {'Epoch':>6} | {'MLP 1-Step':>10} | {'MLP 5-Step':>10} | {'GRU 1-Step':>10} | {'GRU 5-Step':>10}\")\n    print(\"-\" * 65)\n    \n    for epoch in range(1, n_epochs + 1):\n        mlp.train(); gru.train()\n        mlp_1s, mlp_ms = 0.0, 0.0\n        gru_1s, gru_ms = 0.0, 0.0\n        n_subs = len(extracted_trajectories)\n        \n        opt_mlp.zero_grad()\n        opt_gru.zero_grad()\n        \n        for z_stack in extracted_trajectories:\n            T = z_stack.shape[0]\n            max_start_t = T - horizon - 1\n            if max_start_t <= 0: continue\n            \n            # ────────────────────────────────────────────────────────\n            # 1. MLP MODEL EVALUATION (MLPTransitionSingleStep)\n            # ────────────────────────────────────────────────────────\n            z_curr, z_next = z_stack[:-1], z_stack[1:]\n            mlp_preds = mlp(z_curr)\n            l_mlp_1s = F.mse_loss(mlp_preds, z_next)\n            \n            l_mlp_ms = 0.0\n            for t in range(max_start_t):\n                z_roll = z_stack[t].unsqueeze(0)\n                for h in range(horizon):\n                    z_roll = mlp(z_roll)\n                    l_mlp_ms += F.mse_loss(z_roll, z_stack[t + h + 1].unsqueeze(0))\n            l_mlp_ms /= (max_start_t * horizon)\n            \n            (l_mlp_1s + 0.5 * l_mlp_ms).backward()\n            mlp_1s += l_mlp_1s.item(); mlp_ms += l_mlp_ms.item()\n            \n            # ────────────────────────────────────────────────────────\n            # 2. STATEFUL GRU EVALUATION (GRUTransitionStateful)\n            # ────────────────────────────────────────────────────────\n            # 1-Step evaluation pass across the sequence timeline\n            gru_preds = []\n            h_t = torch.zeros(1, gru.hidden_dim, device=DEVICE)\n            \n            for t in range(T - 1):\n                # Unroll step sequentially through the hidden cells\n                z_pred, h_t = gru(z_stack[t].unsqueeze(0), h_t)\n                gru_preds.append(z_pred)\n                \n            gru_preds = torch.cat(gru_preds, dim=0)\n            l_gru_1s = F.mse_loss(gru_preds, z_stack[1:])\n            \n            # Autoregressive Multi-Step Horizon Rollout\n            l_gru_ms = 0.0\n            for t in range(max_start_t):\n                # Reconstruct hidden state memory up to step 't'\n                h_warm = torch.zeros(1, gru.hidden_dim, device=DEVICE)\n                for t_warm in range(t + 1):\n                    _, h_warm = gru(z_stack[t_warm].unsqueeze(0), h_warm)\n                \n                # Roll forward step-by-step using memory-primed context\n                z_roll = z_stack[t].unsqueeze(0)\n                h_roll = h_warm.clone()\n                for h in range(horizon):\n                    z_roll, h_roll = gru(z_roll, h_roll)\n                    l_gru_ms += F.mse_loss(z_roll, z_stack[t + h + 1].unsqueeze(0))\n                    \n            l_gru_ms /= (max_start_t * horizon)\n            \n            (l_gru_1s + 0.5 * l_gru_ms).backward()\n            gru_1s += l_gru_1s.item(); gru_ms += l_gru_ms.item()\n            \n        opt_mlp.step()\n        opt_gru.step()\n        \n        if epoch % 25 == 0:\n            print(f\" {epoch:>3}/{n_epochs} | {mlp_1s/n_subs:>10.5f} | {mlp_ms/n_subs:>10.5f} | {gru_1s/n_subs:>10.5f} | {gru_ms/n_subs:>10.5f}\")\n\n    return mlp, gru\n\n# Run the comparative benchmarks over your exact models\nbench_mlp, bench_gru = train_notebook_baselines_v3(\n    encoder              = sup_encoder_v7,\n    train_subject_graphs = train_subject_graphs,\n    latent_dim           = ABIDE_LATENT_DIM,\n    n_epochs             = 100,\n    horizon              = 5\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:31:59.689748Z","iopub.execute_input":"2026-05-24T06:31:59.690159Z","iopub.status.idle":"2026-05-24T06:38:43.452553Z","shell.execute_reply.started":"2026-05-24T06:31:59.690105Z","shell.execute_reply":"2026-05-24T06:38:43.451465Z"}},"outputs":[{"name":"stdout","text":"=================================================================\nTRAINING NATIVE BASELINES (MLP SingleStep vs. GRU Stateful)\n=================================================================\n\n  Epoch | MLP 1-Step | MLP 5-Step | GRU 1-Step | GRU 5-Step\n-----------------------------------------------------------------\n  25/100 |    0.01560 |    0.02432 |    0.01586 |    0.02115\n  50/100 |    0.01342 |    0.02069 |    0.01404 |    0.02029\n  75/100 |    0.01307 |    0.02045 |    0.01309 |    0.01976\n 100/100 |    0.01293 |    0.02032 |    0.01270 |    0.01932\n","output_type":"stream"}],"execution_count":28},{"cell_type":"code","source":"# Cell 57 — Adaptive Long-Horizon Diagnostic (Safe up to 20+ Steps)\n#\n# Changes:\n# 1. Replaced the hard 'continue' filter with an adaptive horizon calculator.\n# 2. Prevents IndexError and ZeroDivisionError on short fMRI scan lengths.\n\ndef evaluate_adaptive_long_horizon(encoder, train_subject_graphs, koopman_model, mlp_model, gru_model, latent_dim, max_horizon=20):\n    encoder.eval()\n    koopman_model.eval()\n    mlp_model.eval()\n    gru_model.eval()\n    \n    total_koop_ms = 0.0\n    total_mlp_ms = 0.0\n    total_gru_ms = 0.0\n    total_windows_evaluated = 0\n    \n    print(\"=\" * 65)\n    print(f\"EVALUATING ADAPTIVE STABILITY (TARGET HORIZON: {max_horizon} STEPS)\")\n    print(\"=\" * 65)\n    \n    with torch.no_grad():\n        for idx in range(len(train_subject_graphs)):\n            adj_seq = train_subject_graphs[idx]\n            T = adj_seq.shape[0]\n            \n            # Ensure we have at least 2 frames to make a 1-step prediction\n            if T < 2: continue \n            \n            # Extract frozen v7 trajectories\n            z_list = []\n            for t in range(T):\n                edge_index = torch.from_numpy(np.array(np.where(adj_seq[t] > 0))).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=ABIDE_N_NODES) if edge_index.numel() > 0 else torch.zeros(1, latent_dim, device=DEVICE)\n                z_list.append(z_t)\n            z_stack = torch.cat(z_list, dim=0)\n            \n            # Slide a window across all available steps\n            for t in range(T - 1):\n                # Calculate the maximum possible rollout horizon for this specific snapshot\n                current_horizon = min(max_horizon, T - t - 1)\n                if current_horizon == 0: continue\n                \n                z_start = z_stack[t].unsqueeze(0)\n                total_windows_evaluated += 1\n                \n                # --- Koopman Adaptive Rollout ---\n                z_roll_koop = z_start.clone()\n                koop_loss = 0.0\n                for h in range(current_horizon):\n                    z_roll_koop = koopman_model(z_roll_koop)\n                    koop_loss += F.mse_loss(z_roll_koop, z_stack[t + h + 1].unsqueeze(0)).item()\n                total_koop_ms += (koop_loss / current_horizon)\n                \n                # --- MLP Adaptive Rollout ---\n                z_roll_mlp = z_start.clone()\n                mlp_loss = 0.0\n                for h in range(current_horizon):\n                    z_roll_mlp = mlp_model(z_roll_mlp)\n                    mlp_loss += F.mse_loss(z_roll_mlp, z_stack[t + h + 1].unsqueeze(0)).item()\n                total_mlp_ms += (mlp_loss / current_horizon)\n                \n                # --- Stateful GRU Adaptive Rollout ---\n                h_warm = torch.zeros(1, gru_model.hidden_dim, device=DEVICE)\n                for t_warm in range(t + 1):\n                    _, h_warm = gru_model(z_stack[t_warm].unsqueeze(0), h_warm)\n                    \n                z_roll_gru = z_start.clone()\n                h_roll_gru = h_warm.clone()\n                gru_loss = 0.0\n                for h in range(current_horizon):\n                    z_roll_gru, h_roll_gru = gru_model(z_roll_gru, h_roll_gru)\n                    gru_loss += F.mse_loss(z_roll_gru, z_stack[t + h + 1].unsqueeze(0)).item()\n                total_gru_ms += (gru_loss / current_horizon)\n                \n    avg_koop = total_koop_ms / total_windows_evaluated\n    avg_mlp = total_mlp_ms / total_windows_evaluated\n    avg_gru = total_gru_ms / total_windows_evaluated\n    \n    print(f\"Successfully evaluated across {total_windows_evaluated} window segments:\")\n    print(f\"  --> Koopman Forecaster Avg MSE : {avg_koop:.6f}\")\n    print(f\"  --> MLP Transition     Avg MSE : {avg_mlp:.6f}\")\n    print(f\"  --> Stateful GRU        Avg MSE : {avg_gru:.6f}\")\n    print(\"=\" * 65)\n    \n    return {\"koopman\": avg_koop, \"mlp\": avg_mlp, \"gru\": avg_gru}\n\n# Run the adaptive rollout testing safely at 20 steps\nadaptive_metrics = evaluate