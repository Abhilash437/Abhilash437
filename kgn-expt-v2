.675258Z"}},"outputs":[{"name":"stdout","text":"Fitted K_i for 60 subjects\n  ASD : 29  |  TD : 31\n  K_i shape : (32, 32)\n  Ridge alpha : 1.0\n","output_type":"stream"}],"execution_count":35},{"cell_type":"code","source":"# Cell 3 — Per-Subject Eigenvalue Decomposition\n# ──────────────────────────────────────────────\n# For each subject's K_i, compute all 32 eigenvalues\n# Each eigenvalue is complex: λ = Re(λ) + i·Im(λ)\n#\n# Output: asd_eigenvalues, td_eigenvalues\n#         each is a flat list of all eigenvalues across subjects\n\n# np.linalg.eigvals computes eigenvalues of a square matrix\n# For a real (32,32) matrix → returns 32 complex eigenvalues\n# Complex eigenvalues always come in conjugate pairs: a+bi and a-bi\n\nasd_eigenvalues = []   # all eigenvalues from ASD subjects pooled\ntd_eigenvalues  = []   # all eigenvalues from TD  subjects pooled\n\n# Per-subject summaries for statistical comparison\nasd_subject_stats = []   # one dict per ASD subject\ntd_subject_stats  = []   # one dict per TD  subject\n\nfor subject in subject_operators:\n\n    K_i   = subject['K']      # (32, 32) numpy array\n    label = subject['label']  # 'ASD' or 'TD'\n\n    # np.linalg.eigvals explanation:\n    # Computes the eigenvalues λ_1,...,λ_32 of K_i\n    # Returns a complex array of shape (32,)\n    # Does NOT return eigenvectors (we don't need them here)\n    evals = np.linalg.eigvals(K_i)   # shape: (32,) complex\n\n    # Eigenvalue magnitude: |λ| = sqrt(Re(λ)² + Im(λ)²)\n    # np.abs on complex numbers automatically computes magnitude\n    magnitudes = np.abs(evals)        # shape: (32,) real\n\n    # Oscillation frequency: f = angle(λ) / (2π)\n    # np.angle returns the angle θ in radians ∈ (-π, π]\n    # Dividing by 2π normalizes to (-0.5, 0.5]\n    # We take np.abs to get positive frequencies only ∈ [0, 0.5]\n    frequencies = np.abs(np.angle(evals)) / (2 * np.pi)  # shape: (32,)\n\n    # Per-subject summary statistics\n    stats = {\n        'max_magnitude'  : magnitudes.max(),\n        'mean_magnitude' : magnitudes.mean(),\n        'dominant_freq'  : frequencies[magnitudes.argmax()],  \n        # dominant_freq: frequency of the eigenvalue with LARGEST magnitude\n        # This is the mode that contributes most to long-term dynamics\n    }\n\n    if label == 'ASD':\n        asd_eigenvalues.extend(evals.tolist())\n        asd_subject_stats.append(stats)\n    else:\n        td_eigenvalues.extend(evals.tolist())\n        td_subject_stats.append(stats)\n\n# Convert to arrays for easy analysis\nasd_eigenvalues = np.array(asd_eigenvalues)   # (29*32,) complex\ntd_eigenvalues  = np.array(td_eigenvalues)    # (31*32,) complex\n\nasd_mags = np.abs(asd_eigenvalues)\ntd_mags  = np.abs(td_eigenvalues)\n\nasd_freqs = np.abs(np.angle(asd_eigenvalues)) / (2 * np.pi)\ntd_freqs  = np.abs(np.angle(td_eigenvalues))  / (2 * np.pi)\n\n# ── Sanity check ──────────────────────────────────────────────\nprint(f\"ASD eigenvalues : {len(asd_eigenvalues)}  ({len(asd_subject_stats)} subjects × 32)\")\nprint(f\"TD  eigenvalues : {len(td_eigenvalues)}  ({len(td_subject_stats)} subjects × 32)\")\nprint(f\"\\nPer-subject summary (means across subjects):\")\nprint(f\"  ASD mean max-magnitude : {np.mean([s['max_magnitude']  for s in asd_subject_stats]):.4f}\")\nprint(f\"  TD  mean max-magnitude : {np.mean([s['max_magnitude']  for s in td_subject_stats]):.4f}\")\nprint(f\"  ASD mean dominant-freq : {np.mean([s['dominant_freq']  for s in asd_subject_stats]):.4f}\")\nprint(f\"  TD  mean dominant-freq : {np.mean([s['dominant_freq']  for s in td_subject_stats]):.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T16:26:02.676763Z","iopub.execute_input":"2026-05-18T16:26:02.677091Z","iopub.status.idle":"2026-05-18T16:26:02.707446Z","shell.execute_reply.started":"2026-05-18T16:26:02.677066Z","shell.execute_reply":"2026-05-18T16:26:02.706603Z"}},"outputs":[{"name":"stdout","text":"ASD eigenvalues : 928  (29 subjects × 32)\nTD  eigenvalues : 99