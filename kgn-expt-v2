 * (nodes_per_community - 1) // 2\n    N_in  = n_communities * pairs_per_community\n    N_out = n_nodes * n_nodes // 4 * (n_communities - 1)\n    # More general formula for cross-community pairs:\n    # Each community pairs with every other community\n    N_out = (n_nodes ** 2 - n_communities * nodes_per_community ** 2) // 2\n\n    # --- Step 2: Transition probabilities for each group ---\n    # alpha = P(A_{t+1}=1 | A_t=1), beta = P(A_{t+1}=1 | A_t=0)\n    def transitions(p, rho):\n        alpha = rho + (1 - rho) * p   # edge survives or gets resampled as 1\n        beta  = (1 - rho) * p         # non-edge gets resampled as 1\n        pi    = p                      # stationary probability (proved above)\n        return alpha, beta, pi\n\n    alpha_in,  beta_in,  pi_in  = transitions(p_in,  persistence)\n    alpha_out, beta_out, pi_out = transitions(p_out, persistence)\n\n    # --- Step 3: Expected TP, FP, FN per group ---\n    def expected_counts(N, pi, alpha, beta):\n        \"\"\"\n        Computes expected TP, FP, FN under the optimal oracle decision rule.\n        \n        The oracle predicts 1 only when the conditional probability exceeds 0.5.\n        This means we check alpha and beta independently against the 0.5 threshold.\n        \n        N     : number of pairs in this group\n        pi    : stationary edge probability\n        alpha : P(A_{t+1}=1 | A_t=1)\n        beta  : P(A_{t+1}=1 | A_t=0)\n        \"\"\"\n        TP, FP, FN = 0.0, 0.0, 0.0\n    \n        # Case: oracle predicts 1 when it sees an existing edge (A_t=1)\n        if alpha >= 0.5:\n            TP += N * pi * alpha          # predicted 1, actual 1\n            FP += N * pi * (1 - alpha)    # predicted 1, actual 0\n    \n        # Case: oracle predicts 1 when it sees a non-edge (A_t=0)\n        if beta >= 0.5:\n            TP += N * (1 - pi) * beta         # predicted 1, actual 1\n            FP += N * (1 - pi) * (1 - beta)  # predicted 1, actual 0\n    \n        # False negatives: actual positives the oracle predicted as 0\n        if alpha < 0.5:\n            FN += N * pi * alpha          # oracle said 0, but edge exists at t+1\n        if beta < 0.5:\n            FN += N * (1 - pi) * beta     # oracle said 0, but edge appeared at t+1\n    \n        return TP, FP, FN\n\n    TP_in,  FP_in,  FN_in  = expected_counts(N_in,  pi_in,  alpha_in,  beta_in)\n    TP_out, FP_out, FN_out = expected_counts(N_out, pi_out, alpha_out, beta_out)\n\n    # --- Step 4: Pool and compute graph-level F1 ---\n    TP = TP_in + TP_out\n    FP = FP_in + FP_out\n    FN = FN_in + FN_out\n\n    f1 = (2 * TP) / (2 * TP + FP + FN)\n\n    return {\n        \"oracle_f1\"   : round(f1, 4),\n        \"N_in\"        : N_in,\n        \"N_out\"       : N_out,\n        \"alpha_in\"    : round(alpha_in, 4),\n        \"beta_in\"     : round(beta_in, 4),\n        \"alpha_out\"   : round(alpha_out, 4),\n        \"beta_out\"    : round(beta_out, 4),\n        \"TP\"          : round(TP, 2),\n        \"FP\"          : round(FP, 2),\n        \"FN\"          : round(FN, 2),\n    }","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#  ORACLE F1 LOOKUP TABLE\n# Pre-computed oracle F1 for each variant.\n# persistence=0 variants tp oracle F1 = 0 (i.i.d. edges, no temporal signal)\n# Only signal variants have meaningful ceilings.\n\nORACLE_F1 = {}\nSIGNAL_VARIANTS = ['SBM-Signal-Strong', 'SBM-Signal-Medium', 'SBM-Dynamic-Hard']\n\nfor variant_name, params in SBM_VARIANTS.items():\n    persistence = params.get('persistence', 0.0)\n    result = oracle_f1(\n        n_nodes       = params['n_nodes'],\n        n_communities = params['n_communities'],\n        p_in          = params['p_in'],\n        p_out         = params['p_out'],\n        persistence   = persistence\n    )\n\n    ORACLE_F1[variant_name] = result['oracle_f1']\n    \n    print(\n        f\"{variant_name:<22}\"\n        f\"{params['persistence']:>8.1f}\"\n        f\"{result['oracle_f1']:>10.4f}\"\n        f\"{result['alpha_in']:>9.4f}\"\n        f\"{result['beta_in']:>8.4f}\"\n        f\"{result['TP']:>8.1f}\"\n        f\"{result['FP']:>8.1f}\"\n        f\"{result['FN']:>8.1f}\"\n    )","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# COPY-PREVIOUS BASELINE\n\ndef evaluate_copy_previous(variant_name, test_seeds, eval_steps):\n    \"\"\"\n    Evaluates the copy-previous baseline on a given variant.\n\n    Strategy: predict A_{t+1} = A_t exactly.\n    This is the optimal oracle strategy when alpha >= 0.5.\n    Has zero learnable parameters.\n\n    Parameters\n    ----------\n    variant_name : str  — key in SBM_VARIANTS\n    test_seeds   : list — seed indices to evaluate on (e.g. [3, 4])\n    eval_steps   : list — prediction horizons to evaluate (e.g. [1, 5, 10, 50])\n\n    Returns\n    -------\n    List of dicts, one per (seed, step) combination.\n    \"\"\"\n    params   = SBM_VARIANTS[variant_name]\n    n_nodes  = params['n_nodes']\n    rows     = []\n\n    for seed in test_seeds:\n        # Load the raw adjacency sequence for this seed\n        # Shape: (sequence_length, n_nodes, n_nodes)\n        graphs = torch.load(\n            DATA_DIR / variant_name / f'seed_{seed}' / 'graphs.pt'\n        )  # (T, n_nodes, n_nodes)\n\n        T = len(graphs)\n\n        for step in eval_steps:\n            f1_scores = []\n\n            # For each valid starting point t, predict A_{t+step} = A_t\n            # Valid range: t from 0 to T - step - 1\n            for t in range(T - step):\n                A_current = graphs[t].numpy()       # the graph we observe\n                A_future  = graphs[t + step].numpy() # the graph we want to predict\n\n                # Copy-previous prediction: use A_current as the prediction\n                # For step=1: predict A_{t+1} = A_t\n                # For step=k: predict A_{t+k} = A_t  (no rollout, just copy)\n                pred_binary = (A_current >= 0.5).astype(int).flatten()\n                true_binary = (A_future  >= 0.5).astype(int).flatten()\n\n                f1 = f1_score(true_binary, pred_binary, zero_division=0)\n                f1_scores.append(f1)\n\n            rows.append({\n                'variant'  : variant_name,\n                'model'    : 'CopyPrev',\n                'mode'     : 'baseline',\n                'seed'     : seed,\n                'step'     : step,\n                'f1'       : np.mean(f1_scores),\n                'latent_dim': 0   # no latent space used\n            })\n\n    return rows","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"copy_prev_rows = []\n\nfor variant_name in SIGNAL_VARIANTS:\n    print(f\"Evaluating copy-previous on {variant_name}\")\n    rows = evaluate_copy_previous(\n        variant_name = variant_name,\n        test_seeds   = TEST_SEEDS,    # [3, 4] — same held-out seeds as your models\n        eval_steps   = EVAL_STEPS     # [1, 5, 10, 15, 20, 50]\n    )\n    copy_prev_rows.extend(rows)\n    \n    # Print per-step summary for this variant\n    for row in rows:\n        print(f\"  seed={row['seed']}  step={row['step']:>2}  F1={row['f1']:.4f}\")\n\ndf_copy_prev = pd.DataFrame(copy_prev_rows)\nprint(\"\\nCopy-previous summary (mean across seeds):\")\nprint(\n    df_copy_prev.groupby(['variant', 'step'])['f1']\n    .mean()\n    .round(4)\n    .to_string()\n)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# EFFICIENCY SCORES\n# Efficiency = model F1 / oracle F1\n# Answers: \"of the available temporal signal, how much does each model capture?\"\n# 1.0 = perfect, 0.0 = no better than always predicting no edges\n\nprint(\"Computing efficiency scores on signal variants...\\n\")\n\n# --- Step 1: Filter df_final to signal variants only ---\ndf_signal = df_final[df_final['variant'].isin(SIGNAL_VARIANTS)].copy()\n\nif df_signal.empty:\n    print(\"WARNING: No signal variant data found in df_final.\")\n    print(\"Check that variant column values match:\", SIGNAL_VARIANTS)\nelse:\n    # --- Step 2: Add oracle F1 column ---\n    df_signal['oracle_f1'] = df_signal['variant'].map(ORACLE_F1)\n\n    # --- Step 3: Compute efficiency ---\n    # Clip to [0, 1] — a model can overshoot oracle F1 due to lucky thresholding\n    df_signal['efficiency'] = (\n        df_signal['f1'] / df_signal['oracle_f1']\n    ).clip(0, 1)\n\n    # --- Step 4: Add copy-previous results for comparison ---\n    df_copy_signal = df_copy_prev.copy()\n    df_copy_signal['oracle_f1']  = df_copy_signal['variant'].map(ORACLE_F1)\n    df_copy_signal['efficiency'] = (\n        df_copy_signal['f1'] / df_copy_signal['oracle_f1']\n    ).clip(0, 1)\n\n    # --- Step 5: Combine and summarize at step 50 ---\n    df_combined = pd.concat([df_signal, df_copy_signal], ignore_index=True)\n\n    step50 = df_combined[df_combined['step'] == 50]\n\n    summary = (\n        step50\n        .groupby(['variant', 'model'])['efficiency']\n        .agg(['mean', 'std'])\n        .round(4)\n        .rename(columns={'mean': 'efficiency_mean', 'std': 'efficiency_std'})\n        .reset_index()\n        .sort_values(['variant', 'efficiency_mean'], ascending=[True, False])\n    )\n\n    print(summary.to_string(index=False))\n    \n    # --- Step 6: Save ---\n    summary.to_csv(os.path.join(RESULTS_DIR, 'efficiency_scores.csv'), index=False)\n    print(f\"\\nSaved to {RESULTS_DIR / 'efficiency_scores.csv'}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# EFFICIENCY PLOT\n\nfig, axes = plt.subplots(1, len(SIGNAL_VARIANTS), \n                          figsize=(5 * len(SIGNAL_VARIANTS), 5),\n                          sharey=True)\n\nfor ax, variant_name in zip(axes, SIGNAL_VARIANTS):\n    oracle = ORACLE_F1[variant_name]\n    \n    subset = df_combined[\n        (df_combined['variant'] == variant_name) &\n        (df_combined['step'].isin(EVAL_STEPS))\n    ]\n\n    # Mean F1 per model per step\n    plot_df = (\n        subset.groupby(['model', 'step'])['f1']\n        .mean()\n        .reset_index()\n    )\n\n    # Plot each model\n    for model_name in plot_df['model'].unique():\n        model_data = plot_df[plot_df['model'] == model_name]\n        linestyle  = '--' if model_name == 'CopyPrev' else '-'\n        linewidth  = 2.5  if model_name == 'CopyPrev' else 1.5\n        ax.plot(\n            model_data['step'], model_data['f1'],\n            label     = model_name,\n            linestyle = linestyle,\n            linewidth = linewidth,\n            marker    = 'o'\n        )\n\n    # Draw oracle ceiling as a horizontal line\n    ax.axhline(\n        y         = oracle,\n        color     = 'black',\n        linestyle = ':',\n        linewidth = 2,\n        label     = f'Oracle ({oracle:.3f})'\n    )\n\n    ax.set_title(variant_name, fontweight='bold')\n    ax.set_xlabel('Prediction Step')\n    ax.set_ylim(0, 1.05)\n    ax.grid(True, alpha=0.3)\n    ax.legend(fontsize=8)\n\naxes[0].set_ylabel('F1 Score')\nfig.suptitle('Model F1 vs Oracle Ceiling on Signal Variants', \n             fontsize=13, fontweight='bold')\nplt.tight_layout()\nplt.savefig(os.path.join(RESULTS_DIR, 'efficiency_plot.png'), dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"Saved to efficiency_plot.png\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import urllib.request\n# Data download — run once if wikipedia.csv is not present\n\nif not os.path.exists(\"/kaggle/working/wikipedia.csv\"):\n     urllib.request.urlretrieve(\n         \"http://snap.stanford.edu/jodie/wikipedia.csv\",\n         \"/kaggle/working/wikipedia.csv\"\n     )","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Raw JODIE format: each row is one interaction event\n#   user_id | item_id | timestamp | state_label | features (comma-separated)\n#\n# We build a sequence of bipartite graph snapshots by:\n#   1. Selecting top-50 users and top-100 items by interaction frequency\n#   2. Binning interactions into fixed-size windows (by interaction count)\n#   3. In each window: edge exists if user U interacted with item I\n#   4. Output: (T, 100, 100) adjacency tensor matching existing pipeline shape\n#\n# Node index layout (important for decoder):\n#   indices 0–49  → top-50 users\n#   indices 50–149 → top-100 items\n\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom pathlib import Path\n\n# ------------------------------------------------------------------\n# Download from: http://snap.stanford.edu/jodie/wikipedia.csv\n# ------------------------------------------------------------------\nJODIE_PATH     = Path('/kaggle/working/wikipedia.csv')\nJODIE_N_USERS  = 50      # top users to keep\nJODIE_N_ITEMS  = 100      # top items to keep\nJODIE_N_NODES  = JODIE_N_USERS + JODIE_N_ITEMS\nJODIE_WINDOW   = 50     # interactions per snapshot\nJODIE_N_SNAPS  = 700     # total snapshots to generate\n\n\ndef load_jodie_snapshots(path, n_users=50, n_items=50,\n                         window_size=500, n_snapshots=500):\n    \"\"\"\n    Converts a JODIE interaction log into a sequence of bipartite\n    adjacency matrices.\n\n    Parameters\n    ----------\n    path        : Path — location of wikipedia.csv\n    n_users     : int  — how many top users to keep (by interaction count)\n    n_items     : int  — how many top items to keep (by interaction count)\n    window_size : int  — number of interactions per snapshot\n    n_snapshots : int  — how many snapshots to produce\n\n    Returns\n    -------\n    adj_tensor  : torch.FloatTensor of shape (n_snapshots, n_nodes, n_nodes)\n                  where n_nodes = n_users + n_items\n    user_index  : dict mapping original user_id → row index (0 to n_users-1)\n    item_index  : dict mapping original item_id → col index (0 to n_items-1)\n                  (actual matrix index = col index + n_users)\n    \"\"\"\n\n    # Load raw interaction log\n    df_raw = pd.read_csv(path, header=None, skiprows=1)\n    print(f\"  Total columns in file: {df_raw.shape[1]}\")\n    print(f\"  First row (cols 0-4): {df_raw.iloc[0, :5].tolist()}\")\n\n    df = pd.DataFrame({\n        'user_id'   : df_raw.iloc[:, 0].astype(int),\n        'item_id'   : df_raw.iloc[:, 1].astype(int),\n        'timestamp' : df_raw.iloc[:, 2].astype(float),\n    })\n\n    print(f\"  Total interactions: {len(df):,}\")\n    print(f\"  Unique users: {df['user_id'].nunique():,}\")\n    print(f\"  Unique items: {df['item_id'].nunique():,}\")\n    print(f\"  Time range:   {df['timestamp'].min():.1f} → {df['timestamp'].max():.1f}\")\n\n    # Select top-N users and top-N items by frequency\n    # Frequency = total number of interactions in the full log.\n    # We want the most active nodes because they appear in more windows,\n    # giving denser, more informative snapshots.\n    top_users = (df['user_id'].value_counts()\n                              .head(n_users)\n                              .index.tolist())\n    top_items = (df['item_id'].value_counts()\n                              .head(n_items)\n                              .index.tolist())\n\n    # Filter to only interactions involving selected nodes\n    df_filtered = df[\n        df['user_id'].isin(top_users) &\n        df['item_id'].isin(top_items)\n    ].copy()\n\n    print(f\"\\n  After filtering to top-{n_users} users + top-{n_items} items:\")\n    print(f\"  Retained interactions: {len(df_filtered):,} \"\n          f\"({100*len(df_filtered)/len(df):.1f}% of total)\")\n\n    # Build node index maps\n    # Users map to rows 0..(n_users-1)\n    # Items map to rows n_users..(n_users+n_items-1)\n    user_index = {uid: i            for i, uid in enumerate(top_users)}\n    item_index = {iid: i + n_users  for i, iid in enumerate(top_items)}\n\n    df_filtered = df_filtered.sort_values('timestamp').reset_index(drop=True)\n\n    # Step 4: Bin into fixed-size interaction windows\n    # Window k contains interactions at rows [k*window_size, (k+1)*window_size)\n    # This gives uniform graph density per snapshot — each snapshot summarises\n    # exactly window_size interactions regardless of wall-clock time.\n    n_nodes = n_users + n_items\n    adjacencies = []\n\n    total_needed = window_size * n_snapshots\n    if len(df_filtered) < total_needed:\n        print(f\"\\n  WARNING: only {len(df_filtered):,} interactions available, \"\n              f\"need {total_needed:,} for {n_snapshots} snapshots of size {window_size}.\")\n        print(f\"  Reducing n_snapshots to {len(df_filtered) // window_size}\")\n        n_snapshots = len(df_filtered) // window_size\n\n    for k in range(n_snapshots):\n        start = k * window_size\n        end   = start + window_size\n        window_df = df_filtered.iloc[start:end]\n\n        # Build adjacency matrix for this window\n        # Edge (u, i) = 1 if user u interacted with item i at least once\n        adj = np.zeros((n_nodes, n_nodes), dtype=np.float32)\n\n        for _, row in window_df.iterrows():\n            u = user_index[row['user_id']]\n            i = item_index[row['item_id']]\n            adj[u, i] = 1.0\n            adj[i, u] = 1.0   # symmetrise — GCNConv expects undirected\n\n        adjacencies.append(adj)\n\n    adj_tensor = torch.from_numpy(np.array(adjacencies))  # (T, n_nodes, n_nodes)\n\n    # --- Step 5: Diagnostic summary ---\n    edge_counts = [int(adj.sum()) // 2 for adj in adjacencies]\n    print(f\"\\n  Snapshots generated: {len(adjacencies)}\")\n    print(f\"  Edges per snapshot:  min={min(edge_counts)}, \"\n          f\"max={max(edge_counts)}, \"\n          f\"mean={np.mean(edge_counts):.1f}\")\n    print(f\"  Density range: \"\n          f\"{min(edge_counts)/((n_nodes*(n_nodes-1))//2):.4f} – \"\n          f\"{max(edge_counts)/((n_nodes*(n_nodes-1))//2):.4f}\")\n\n    return adj_tensor, user_index, item_index\n\njodie_graphs, jodie_user_idx, jodie_item_idx = load_jodie_snapshots(\n    path        = JODIE_PATH,\n    n_users     = JODIE_N_USERS,\n    n_items     = JODIE_N_ITEMS,\n    window_size = JODIE_WINDOW,\n    n_snapshots = JODIE_N_SNAPS\n)\n\njodie_dir = DATA_DIR / 'JODIE-Wikipedia' / 'seed_0'\njodie_dir.mkdir(parents=True, exist_ok=True)\ntorch.save(jodie_graphs, jodie_dir / 'graphs.pt')\n\nprint(f\"\\n Saved to {jodie_dir / 'graphs.pt'}\")\nprint(f\"  Shape: {jodie_graphs.shape}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Registering JODIE as a pipeline variant\n#\n# JODIE has a single seed (seed_0) — one long temporal sequence.\n# We do NOT use N_SEEDS for JODIE; instead we split the single\n# sequence by time: first 60% = train, last 40% = held-out test.\n# This is handled inside the co-train and eval loops below.\n#\n# n_communities, p_in, p_out are None because JODIE is real data —\n# the theoretical oracle_f1() formula does not apply.\n# We use an empirical oracle instead (see Cell J).\n\nJODIE_VARIANT_META = {\n    'JODIE-Wikipedia': {\n        'n_nodes'       : JODIE_N_NODES, \n        'n_communities' : None,             # real data — unknown\n        'p_in'          : None,\n        'p_out'         : None,\n        'drift_type'    : 'real',\n        'persistence'   : None,             # unknown — to be estimated empirically\n    }\n}\n\nSBM_VARIANTS.update(JODIE_VARIANT_META)\nUNIQUE_N_NODES = sorted(set(params['n_nodes'] for params in SBM_VARIANTS.values()))\nVARIANT_TO_N_NODES = {name: params['n_nodes'] for name, params in SBM_VARIANTS.items()}\n\njodie_graphs_all = torch.load(DATA_DIR / 'JODIE-Wikipedia' / 'seed_0' / 'graphs.pt')\nT_jodie          = len(jodie_graphs_all)   \nT_jodie_train    = int(T_jodie * 0.70)     \nT_jodie_test     = T_jodie - T_jodie_train \n\njodie_train_graphs = jodie_graphs_all[:T_jodie_train]  \njodie_test_graphs  = jodie_graphs_all[T_jodie_train:] \n\njodie_dir = DATA_DIR / 'JODIE-Wikipedia' / 'seed_0'\ntorch.save(jodie_train_graphs, jodie_dir / 'graphs_train.pt')\ntorch.save(jodie_test_graphs,  jodie_dir / 'graphs_test.pt')\n\nprint(f\"JODIE registered: n_nodes={JODIE_N_NODES}\")\nprint(f\"Updated UNIQUE_N_NODES: {UNIQUE_N_NODES}\")\nprint(f\"Train snapshots: {T_jodie_train}  |  Test snapshots: {T_jodie_test}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Purpose: Confirm JODIE has exploitable temporal signal \n# spending GPU time on co-training.\n#\n# Two zero-training tests:\n#   1. Copy-previous F1 at steps [1,5,10,20] — measures raw persistence\n#   2. Random-encoder latent linearity R² — lower bound on linear structure\n#\n# Decision rule:\n#   CopyPrev F1 at step=1 >> step=10  temporal persistence exists\n#   R² with random encoder > 0.05     linear structure present   \n#   If both fail then JODIE snapshots are too coarse (window too large); \n#                  reduce JODIE_WINDOW in Cell G and re-run.\n\nimport matplotlib.pyplot as plt\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import r2_score, f1_score\n\n# ── Check 1: Copy-previous F1 decay ────────────────────────────────────────\nprint(\"=\" * 60)\nprint(\"CHECK 1: Copy-previous F1 decay\")\nprint(\"=\" * 60)\n\nPROBE_STEPS = [1, 2, 5, 10, 20]\ncp_f1s      = []\n\nfor step in PROBE_STEPS:\n    f1_scores = []\n    for t in range(T_jodie_test - step):\n        A_curr = jodie_test_graphs[t].numpy()\n        A_fut  = jodie_test_graphs[t + step].numpy()\n        pred   = (A_curr >= 0.5).astype(int).flatten()\n        true   = (A_fut  >= 0.5).astype(int).flatten()\n        f1_scores.append(f1_score(true, pred, zero_division=0))\n    mean_f1 = float(np.mean(f1_scores))\n    cp_f1s.append(mean_f1)\n    print(f\"  step={step:>2}  CopyPrev F1 = {mean_f1:.4f}\")\n\n# Signal verdict\ncp_decay = cp_f1s[0] - cp_f1s[-1]\nprint(f\"\\n  F1 drop from step=1 to step={PROBE_STEPS[-1]}: {cp_decay:.4f}\")\nif cp_f1s[0] > 0.3 and cp_decay > 0.05:\n    print(\"Temporal signal — edges persist across snapshots.\")\nelif cp_f1s[0] < 0.05:\n    print(\"Copy-prev F1 near zero — snapshots may be too sparse.\")\nelse:\n    print(\"Weak signal. Proceed but expect modest model gains.\")\n\n# Random-encoder latent linearity\nprint(\" Random-encoder latent linearity (R^2)\")\n\nPROBE_DIM = 32  # cheap to compute; representative\n\nprobe_enc = GraphEncoder(latent_dim=PROBE_DIM).to(DEVICE)\n# NOTE: No training — this is a random projection, not a learned encoder.\n# If the graph sequence has ANY temporal structure (smooth edge evolution,\n# recurring patterns), even random projections will show R² > 0.\n\nprobe_enc.eval()\nz_probe = []\nwith torch.no_grad():\n    for t in range(len(jodie_graphs_all)):\n        adj_t      = jodie_graphs_all[t].to(DEVICE)\n        edge_index = torch.from_numpy(\n            np.array(np.where(adj_t.cpu().numpy()))\n        ).long().to(DEVICE)\n        z_t = probe_enc(edge_index, num_nodes=JODIE_N_NODES)\n        z_probe.append(z_t.squeeze(0).cpu().numpy())\n\nz_probe = np.array(z_probe)  # (T, PROBE_DIM)\n\nn_train_probe = T_jodie_train\nz_in  = z_probe[:-1]\nz_out = z_probe[1:]\nreg   = LinearRegression(fit_intercept=False).fit(z_in[:n_train_probe], z_out[:n_train_probe])\nz_hat = reg.predict(z_in[n_train_probe:])\nr2_per_dim = [r2_score(z_out[n_train_probe:, d], z_hat[:, d]) for d in range(PROBE_DIM)]\nr2_random  = float(np.mean(r2_per_dim))\n\nprint(f\"  R² (random encoder, dim={PROBE_DIM}): {r2_random:.4f}\")\nif r2_random > 0.3:\n    print(\" Strong linear structure — co-training should amplify this.\")\nelif r2_random > 0.05:\n    print(\" Moderate structure — co-training should help.\")\nelse:\n    print(\" Very weak. Co-training may struggle; check snapshot window size.\")\n\n# ── Quick plot ───────────────────────────────────────────────────────────────\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\n\naxes[0].plot(PROBE_STEPS, cp_f1s, marker='o', color='steelblue')\naxes[0].set_xlabel(\"Prediction Step\")\naxes[0].set_ylabel(\"Copy-Previous F1\")\naxes[0].set_title(\"JODIE: Temporal Persistence Check\")\naxes[0].grid(True, alpha=0.3)\n\naxes[1].bar(range(PROBE_DIM), sorted(r2_per_dim, reverse=True), color='coral')\naxes[1].set_xlabel(\"Latent Dimension (sorted by R²)\")\naxes[1].set_ylabel(\"R² of linear fit\")\naxes[1].set_title(f\"JODIE: Latent Linearity (random encoder, dim={PROBE_DIM})\")\naxes[1].axhline(0.05, linestyle='--', color='gray', label='R²=0.05 threshold')\naxes[1].legend()\naxes[1].grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.savefig(RESULTS_DIR / 'jodie_dynamics_check.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint(f\"\\nSaved to {RESULTS_DIR / 'jodie_dynamics_check.png'}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import r2_score\n\nJODIE_N_NODES     = JODIE_N_USERS + JODIE_N_ITEMS\nJODIE_LATENT_DIMS = [32, 64]\n\n# Shared dict — will hold ALL 4 bars needed for Plot 3\n# Keys: (dataset, encoder_type, latent_dim)\n# Populated here (JODIE) and in the SBM diagnostic block (SBM)\nr2_results = {}\n\njodie_twostage_encoders = {}\njodie_twostage_decoders = {}\n\nprint(\"Training TWO-STAGE encoder/decoder on JODIE-Wikipedia...\\n\")\nprint(f\"n_nodes={JODIE_N_NODES}, training snapshots={len(jodie_train_graphs)}\\n\")\n\nfor latent_dim in JODIE_LATENT_DIMS:\n    print(f\"  latent_dim={latent_dim}...\")\n\n    # train_encoder_decoder() is the original reconstruction-only function.\n    # It takes a flat list of adjacency matrices and returns (enc, dec).\n    # We pass jodie_train_graphs which is a Tensor of shape (T_train, N, N).\n    enc_ts, dec_ts = train_encoder_decoder(\n        n_nodes    = JODIE_N_NODES,\n        latent_dim = latent_dim,\n        train_graphs = jodie_train_graphs,\n        n_epochs   = ENCODER_EPOCHS\n    )\n\n    # Save under the two_stage config tag — mirrors how SBM models are saved\n    model_dir_ts = MODELS_DIR / 'JODIE' / 'two_stage' / f'n_nodes={JODIE_N_NODES}' / f'latent_dim={latent_dim}'\n    model_dir_ts.mkdir(parents=True, exist_ok=True)\n    torch.save(enc_ts.state_dict(), model_dir_ts / 'encoder.pt')\n    torch.save(dec_ts.state_dict(), model_dir_ts / 'decoder.pt')\n\n    jodie_twostage_encoders[(JODIE_N_NODES, latent_dim)] = enc_ts\n    jodie_twostage_decoders[(JODIE_N_NODES, latent_dim)] = dec_ts\n    print(f\"  ✓ Two-stage saved to {model_dir_ts}\")\n\nprint(\"\\nTwo-stage JODIE training complete.\\n\")\n\n# Co-training on JODIE\njodie_cotrain_encoders = {}\njodie_cotrain_decoders = {}\njodie_cotrain_K        = {}\njodie_variance_logs = {}   # { latent_dim: [float, ...] }\n\nprint(\"Co-training encoder/decoder on JODIE-Wikipedia...\\n\")\nprint(f\"Config: {ACTIVE_CONFIG_NAME} → {ACTIVE_CONFIG}\")\nprint(f\"n_nodes={JODIE_N_NODES}, training snapshots={len(jodie_train_graphs)}\\n\")\n\nJODIE_COTRAIN_CONFIG = {}\n\nfor latent_dim in JODIE_LATENT_DIMS:\n    print(f\"\\nlatent_dim={latent_dim}\")\n\n    JODIE_COTRAIN_CONFIG = dict(alpha=1.0, beta=0.5, gamma=0.1, delta=10.0)\n\n    enc, dec, K_learned, variance_log = train_encoder_decoder_cotrain(\n        n_nodes               = JODIE_N_NODES,\n        latent_dim            = latent_dim,\n        train_graph_sequences = jodie_train_graphs,\n        n_epochs              = ENCODER_EPOCHS,\n        in_channels           = 3,\n        n_users               = JODIE_N_USERS,\n        **JODIE_COTRAIN_CONFIG\n    )\n\n    # Store variance log for Plot 4\n    jodie_variance_logs[latent_dim] = variance_log\n\n    # Save co-trained models\n    config_tag = ACTIVE_CONFIG_NAME\n    model_dir = MODELS_DIR / 'JODIE' / config_tag / f'n_nodes={JODIE_N_NODES}' / f'latent_dim={latent_dim}'\n    model_dir.mkdir(parents=True, exist_ok=True)\n    torch.save(enc.state_dict(),       model_dir / 'encoder.pt')\n    torch.save(dec.state_dict(),       model_dir / 'decoder.pt')\n    torch.save(K_learned.state_dict(), model_dir / 'K_cotrain.pt')\n\n    jodie_cotrain_encoders[(JODIE_N_NODES, latent_dim)] = enc\n    jodie_cotrain_decoders[(JODIE_N_NODES, latent_dim)] = dec\n    jodie_cotrain_K[(JODIE_N_NODES, latent_dim)]        = K_learned\n\n    print(f\"  ✓ Co-trained saved to {model_dir}\")\n\n    # ---- R² helper ----\n    # Given an encoder and a sequence of graphs, encodes all frames and\n    # fits a linear map z_{t+1} = A·z_t on the first 75%, reports R²\n    # on the held-out 25%. Used for both two-stage and co-trained encoders.\n    def compute_jodie_r2(encoder, graphs, n_nodes, latent_dim):\n        encoder.eval()\n        z_seq = []\n        with torch.no_grad():\n            for t in range(len(graphs)):\n                adj_t      = graphs[t].to(DEVICE)\n                edge_index = torch.from_numpy(\n                    np.array(np.where(adj_t.cpu().numpy()))\n                ).long().to(DEVICE)\n                z_t = encoder(edge_index, num_nodes=n_nodes)\n                z_seq.append(z_t.squeeze(0).cpu().numpy())\n\n        z = np.array(z_seq)     # (T, latent_dim)\n        T = len(z)\n        n_tr = int(T * 0.75)\n\n        z_in  = z[:-1]\n        z_out = z[1:]\n\n        reg   = LinearRegression(fit_intercept=False).fit(z_in[:n_tr], z_out[:n_tr])\n        z_hat = reg.predict(z_in[n_tr:])\n\n        r2_per_dim = [\n            r2_score(z_out[n_tr:, d], z_hat[:, d])\n            for d in range(latent_dim)\n        ]\n        return float(np.mean(r2_per_dim))\n\n    r2_ct = compute_jodie_r2(enc, jodie_test_graphs, JODIE_N_NODES, latent_dim)\n    r2_results[('JODIE-Wikipedia', 'cotrain', latent_dim)] = r2_ct\n    print(f\"\\n  Co-trained R² (latent_dim={latent_dim}): {r2_ct:.4f}\")\n\n    if latent_dim == PROBE_DIM:\n        improvement = r2_ct - r2_random\n        print(f\"  vs. random encoder R²: {r2_random:.4f}\")\n        print(f\"  Improvement from co-training: {improvement:+.4f}\")\n        if improvement > 0.1:\n            print(\"Co-training successfully shaped the latent space.\")\n        else:\n            print(\"Co-training did not linearise the latent space — expected on real data.\")\n\n    enc_ts = jodie_twostage_encoders[(JODIE_N_NODES, latent_dim)]\n    r2_ts  = compute_jodie_r2(enc_ts, jodie_test_graphs, JODIE_N_NODES, latent_dim)\n    r2_results[('JODIE-Wikipedia', 'two_stage', latent_dim)] = r2_ts\n    print(f\"  Two-stage R²  (latent_dim={latent_dim}): {r2_ts:.4f}\")\n\n    # Save encoded latents for transition model training (unchanged from original)\n    latent_dir = LATENT_DIR / 'JODIE-Wikipedia' / f'latent_dim={latent_dim}'\n    latent_dir.mkdir(parents=True, exist_ok=True)\n\n    enc.eval()\n    z_full = []\n    with torch.no_grad():\n        for t in range(len(jodie_graphs_all)):\n            adj_t      = jodie_graphs_all[t].to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy()))\n            ).long().to(DEVICE)\n            z_t = enc(edge_index, num_nodes=JODIE_N_NODES)\n            z_full.append(z_t.squeeze(0).cpu().numpy())\n\n    z_full = np.array(z_full)\n    torch.save(torch.from_numpy(z_full).float(), latent_dir / 'seed_0.pt')\n    print(f\"  Saved full latent sequence: {z_full.shape} → {latent_dir / 'seed_0.pt'}\")\n\nprint(\"\\nJODIE co-training complete.\")\nprint(f\"\\nr2_results keys populated: {list(r2_results.keys())}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Emperical Oracle for JODIE\n#\n# For SBM variants, oracle_f1() computes the theoretical F1 ceiling\n# using known p_in, p_out, and persistence.\n#\n# For JODIE (real data), those parameters are unknown.\n# Instead we estimate the oracle empirically:\n#   - Run copy-previous on the test split at step=1.\n#   - This is the BEST any model can do WITHOUT learning a transition\n#     model, purely from temporal persistence.\n#   - It is a LOWER BOUND on the true oracle (a learned model can beat it\n#     by predicting edge changes, not just copying).\n#   - We also compute a persistence estimate: fraction of edges that\n#     remain the same between consecutive snapshots.\n#\n# ORACLE_F1['JODIE-Wikipedia'] is set to the copy-previous F1 at step=1.\n# Efficiency = model F1 / oracle F1 is then directly interpretable:\n#   > 1.0 means the model predicts BETTER than pure copying.\n#   < 1.0 means the model has not yet learned to beat persistence.\n\nprint(\"=\" * 60)\nprint(\"EMPIRICAL ORACLE ESTIMATION FOR JODIE\")\nprint(\"=\" * 60)\n\nJODIE_EVAL_STEPS = [1, 5, 10, 20]\n\n# Persistence = fraction of edges that remain unchanged between t and t+1\n# on the test split.\npersistence_scores = []\nfor t in range(len(jodie_test_graphs) - 1):\n    A_curr = (jodie_test_graphs[t]     >= 0.5).numpy().astype(int)\n    A_next = (jodie_test_graphs[t + 1] >= 0.5).numpy().astype(int)\n    same   = (A_curr == A_next).mean()\n    persistence_scores.append(float(same))\n\njodie_persistence = float(np.mean(persistence_scores))\nprint(f\"\\n  Estimated persistence (fraction unchanged per step): {jodie_persistence:.4f}\")\nif jodie_persistence > 0.95:\n    print(\"High persistence — strong temporal signal to exploit.\")\nelif jodie_persistence > 0.85:\n    print(\"Moderate persistence.\")\nelse:\n    print(\"Low persistence — graphs change rapidly; signal may be weak.\")\n\nprint(\"\\n  Copy-previous F1 on test split:\")\ncp_f1_by_step = {}\nfor step in JODIE_EVAL_STEPS:\n    f1s = []\n    for t in range(len(jodie_test_graphs) - step):\n        A_curr = jodie_test_graphs[t].numpy()\n        A_fut  = jodie_test_graphs[t + step].numpy()\n        pred   = (A_curr >= 0.5).astype(int).flatten()\n        true   = (A_fut  >= 0.5).astype(int).flatten()\n        f1s.append(f1_score(true, pred, zero_division=0))\n    cp_f1_by_step[step] = float(np.mean(f1s))\n    print(f\"    step={step:>2}  F1={cp_f1_by_step[step]:.4f}\")\n\n# Use step=1 copy-previous F1 as the oracle ceiling.\n# A model that beats this at step=1 has learned to predict edge changes,\n# which is stronger than pure persistence.\njodie_oracle_f1 = cp_f1_by_step[1]\nORACLE_F1['JODIE-Wikipedia'] = jodie_oracle_f1\n\nprint(f\"\\n  Oracle F1 (copy-prev at step=1) = {jodie_oracle_f1:.4f}\")\nprint(f\"  This is set as ORACLE_F1['JODIE-Wikipedia'].\")\n\n# Also add JODIE to SIGNAL_VARIANTS so efficiency plots include it\nif 'JODIE-Wikipedia' not in SIGNAL_VARIANTS:\n    SIGNAL_VARIANTS.append('JODIE-Wikipedia')\n    print(\"  Added 'JODIE-Wikipedia' to SIGNAL_VARIANTS.\")\n\nprint(f\"\\n  Updated SIGNAL_VARIANTS: {SIGNAL_VARIANTS}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Train and Evaluate transition models on JODIE\n#\n# Reuses: get_model_class, train_single_model, create_data_loader,\n#         create_sequence_data_loader, compute_f1_from_latent\n# from earlier cells — no redefinition needed.\n#\n#   - Only one seed (seed_0), so train/test split is by TIME not by seed.\n#   - Latent dims: JODIE_LATENT_DIMS = [32, 64]\n#   - Decoder loaded from jodie_cotrain_decoders\n\nJODIE_EVAL_STEPS   = [1, 5, 10, 20]\nSPECTRAL_PENALTY = 0.1\nHIDDEN_DIM = 64\nJODIE_MODEL_NAMES  = ['Koopman', 'MLP', 'GRU']   # skip EDMD-lift (needs many train steps)\n                                                   # skip RNN (redundant with GRU here)\nJODIE_MODES        = ['single_step', 'stateful']\n\njodie_rows = []   # separate results list — merged with all_rows at the end\n\nprint(\"Training transition models on JODIE-Wikipedia...\\n\")\nprint(f\"Models: {JODIE_MODEL_NAMES}\")\nprint(f\"Modes:  {JODIE_MODES}\")\nprint(f\"Latent dims: {JODIE_LATENT_DIMS}\")\nprint(f\"Eval steps: {JODIE_EVAL_STEPS}\\n\")\n\nfor latent_dim in JODIE_LATENT_DIMS:\n\n    z_all = torch.load(\n        LATENT_DIR / 'JODIE-Wikipedia' / f'latent_dim={latent_dim}' / 'seed_0.pt'\n    ).cpu().numpy()\n\n    z_train = z_all[:T_jodie_train]\n    z_test  = z_all[T_jodie_train:]\n\n    # Load decoder\n    decoder = jodie_cotrain_decoders[(JODIE_N_NODES, latent_dim)]\n    decoder.eval()\n\n    for model_name in JODIE_MODEL_NAMES:\n        for mode in JODIE_MODES:\n            print(f\"  {model_name} / {mode} / dim={latent_dim} ...\", end=' ')\n\n            # Build data loaders from the time-split latent sequences\n            if mode == 'stateful':\n                train_loader, _ = create_sequence_data_loader(\n                    z_train, batch_size=16, train_split=0.8\n                )\n                _, test_loader = create_sequence_data_loader(\n                    z_test, batch_size=16, train_split=0.0  # use all of z_test\n                )\n            else:\n                train_loader, _ = create_data_loader(\n                    z_train, batch_size=16, train_split=0.8\n                )\n                _, test_loader = create_data_loader(\n                    z_test, batch_size=16, train_split=0.0\n                )\n\n            # Create and train the transition model\n            model_class = get_model_class(model_name, mode)\n            if mode == 'stateful':\n                model = model_class(latent_dim, hidden_dim=HIDDEN_DIM).to(DEVICE)\n            else:\n                model = model_class(latent_dim).to(DEVICE)\n\n            train_single_model(\n                model, train_loader, test_loader,\n                mode=mode, epochs=50, learning_rate=1e-3,\n                spectral_penalty_weight=SPECTRAL_PENALTY,\n                verbose=False\n            )\n\n            # Save checkpoint\n            ckpt_name = f\"JODIE-Wikipedia_latent={latent_dim}_{model_name}_{mode}.pt\"\n            torch.save(model.state_dict(), MODELS_DIR / 'JODIE' / config_tag / ckpt_name)\n            print(\"trained.\", end=' ')\n\n            # Rollout evaluation on test split\n            model.eval()\n            z_test_tensor = torch.from_numpy(z_test).float().to(DEVICE)\n            T_test        = len(z_test)\n            max_step      = max(JODIE_EVAL_STEPS)\n\n            with torch.no_grad():\n                for start_t in range(T_test - max_step - 1):\n                    z_curr = z_test_tensor[start_t].unsqueeze(0)\n                    h_curr = None\n                    z_preds = []\n\n                    for _ in range(max_step):\n                        if mode == 'stateful':\n                            z_curr, h_curr = model(z_curr, h_curr)\n                        else:\n                            z_curr = model(z_curr)\n                        z_preds.append(z_curr.squeeze(0))\n\n                    for step in JODIE_EVAL_STEPS:\n                        target_t = (T_jodie_train + start_t + step)\n                        z_p      = z_preds[step - 1].unsqueeze(0)\n\n                        # Decode to adjacency\n                        logits    = decoder(z_p).squeeze(0)\n                        adj_logits = torch.zeros(JODIE_N_NODES, JODIE_N_NODES,\n                                                 device=logits.device)\n                        triu_idx = torch.triu_indices(JODIE_N_NODES, JODIE_N_NODES, offset=1).to(logits.device)\n                        adj_logits[triu_idx[0], triu_idx[1]] = logits\n                        adj_logits = adj_logits + adj_logits.t()\n\n                        pred_bin = (torch.sigmoid(adj_logits) >= 0.5).cpu().numpy().astype(int)\n                        true_bin = (jodie_graphs_all[target_t] >= 0.5).numpy().astype(int)\n\n                        f1 = f1_score(true_bin.flatten(), pred_bin.flatten(),\n                                      zero_division=0)\n                        jodie_rows.append({\n                            'variant'   : 'JODIE-Wikipedia',\n                            'model'     : model_name,\n                            'mode'      : mode,\n                            'latent_dim': latent_dim,\n                            'seed'      : 0,\n                            'step'      : step,\n                            'f1'        : f1,\n                        })\n\n            print(\"evaluated.\")\n\n# Merge JODIE results into df_final\ndf_jodie = pd.DataFrame(jodie_rows)\n\n\ncsv_path = RESULTS_DIR / 'comparison_table.csv'\nif csv_path.exists():\n    df_final = pd.read_csv(csv_path)\n    df_final = pd.concat([df_final, df_jodie], ignore_index=True)\nelse:\n    df_final = df_jodie\n\ndf_final.to_csv(csv_path, index=False)\n\nprint(f\"\\n✓ JODIE results added. df_final now has {len(df_final)} rows.\")\nprint(f\"  Variants: {df_final['variant'].unique().tolist()}\")\nprint(f\"  Saved to {RESULTS_DIR / 'comparison_table.csv'}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import matplotlib.pyplot as plt\nimport seaborn as sns\n\n# --- 1. Data Wrangling ---\n# Filter main dataframe to step 1 across all SBM and JODIE variants\ndf_step1 = df_final[df_final['step'] == 1].copy()\ndf_copy_step1 = df_copy_prev[df_copy_prev['step'] == 1].copy() if 'df_copy_prev' in locals() else None\n\n# Combine into a single plotting frame\nplot_data = df_step1.copy()\n\n# Set up the plot layout\nvariants = plot_data['variant'].unique()\nfig, axes = plt.subplots(1, len(variants), figsize=(5 * len(variants), 5), sharey=True)\nif len(variants) == 1:\n    axes = [axes]\n\nprint(\"Generating Plot 1: Step 1 Performance Ceiling...\")\n\n# --- 2. Plotting Loop ---\nfor ax, variant_name in zip(axes, variants):\n    subset = plot_data[plot_data['variant'] == variant_name]\n    \n    # Draw grouped bars for our trained models\n    sns.barplot(\n        data=subset,\n        x='model',\n        y='f1',\n        hue='mode',\n        ax=ax,\n        palette='muted',\n        errorbar='sd',\n        capsize=0.1\n    )\n    \n    # Draw Reference Baseline: Copy Previous\n    if df_copy_step1 is not None:\n        cp_subset = df_copy_step1[df_copy_step1['variant'] == variant_name]\n        if not cp_subset.empty:\n            cp_mean = cp_subset['f1'].mean()\n            ax.axhline(cp_mean, color='black', linestyle='--', linewidth=1.5, label='Copy-Previous Baseline')\n            \n    # Draw Upper Bound Ceiling: Oracle F1\n    if variant_name in ORACLE_F1:\n        oracle_val = ORACLE_F1[variant_name]\n        ax.axhline(oracle_val, color='crimson', linestyle=':', linewidth=2, label='Theoretical Oracle F1')\n        \n    ax.set_title(f\"{variant_name}\\n(Horizon $t=1$)\", fontsize=11, fontweight='bold')\n    ax.set_xlabel(\"Model Architecture\")\n    ax.set_ylabel(\"F1 Score\")\n    ax.grid(axis='y', linestyle=':', alpha=0.6)\n    \n    # Clean up duplicate legends per subplot\n    handles, labels = ax.get_legend_handles_labels()\n    by_label = dict(zip(labels, handles))\n    ax.legend(by_label.values(), by_label.keys(), loc='lower right', fontsize=9)\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import matplotlib.pyplot as plt\nimport torch\nimport numpy as np\n\n# --- 1. Dynamically Calculate Parameter Counts ---\n# Define the architectural setups used in your experiments\nTARGET_LATENT_DIM = 32\nTARGET_HIDDEN_DIM = 64\nMODE = 'stateful'  # or 'stateful', parameter scaling follows a similar trend\n\ndynamic_param_counts = {}\n\nprint(\"Calculating live model parameter footprints...\")\n\nfor model_name in ['Koopman', 'MLP', 'GRU']:\n    try:\n        # Fetch the model class using your Cell 9 utility function\n        model_cls = get_model_class(model_name, MODE)\n        \n        # Instantiate with your exact project hyperparameters\n        if model_name == 'EDMD-lift':\n            # EDMD usually takes input_dim, lift_dim\n            model_instance = model_cls(input_dim=TARGET_LATENT_DIM, lift_dim=TARGET_HIDDEN_DIM)\n        elif model_name == 'Koopman':\n            # Pure linear matrix operator mapping latent_dim -> latent_dim\n            model_instance = model_cls(latent_dim=TARGET_LATENT_DIM)\n        else:\n            # Neural baselines mapping latent -> hidden -> latent\n            model_instance = model_cls(latent_dim=TARGET_LATENT_DIM, hidden_dim=TARGET_HIDDEN_DIM)\n            \n        # Count only trainable parameters\n        trainable_params = sum(p.numel() for p in model_instance.parameters() if p.requires_grad)\n        dynamic_param_counts[model_name] = trainable_params\n        print(f\"  {model_name:<10} : {trainable_params:,} parameters\")\n        \n    except Exception as e:\n        print(f\"  Could not instantiate {model_name} dynamically ({e}). Falling back to theory.\")\n        # Minimal theoretical fallbacks just in case initialization signatures differ\n        fallbacks = {'Koopman': 1024, 'EDMD-lift': 4096, 'MLP': 4224, 'RNN': 9536, 'GRU': 28224}\n        dynamic_param_counts[model_name] = fallbacks[model_name]\n\n# --- 2. Extract Mean Step-1 Performance ---\ndf_bench = df_final[(df_final['step'] == 1) & (df_final['latent_dim'] == TARGET_LATENT_DIM)]\nsummary_bench = df_bench.groupby('model')['f1'].mean().to_dict()\n\n# --- 3. Render the Plot ---\nfig, ax = plt.subplots(figsize=(7, 5))\n\nfor model_name, p_count in dynamic_param_counts.items():\n    if model_name in summary_bench:\n        f1_score = summary_bench[model_name]\n        \n        # Color coding: Blue for Koopman families, Orange for classic Recurrent/MLP networks\n        color = 'dodgerblue' if 'Koopman' in model_name or 'EDMD' in model_name else 'darkorange'\n        marker = 'D' if 'Koopman' in model_name else 'o'\n        \n        ax.scatter(p_count, f1_score, color=color, s=150, marker=marker, edgecolors='black', zorder=3)\n        ax.annotate(\n            f\" {model_name} ({p_count:,} params)\",\n            (p_count, f1_score),\n            textcoords=\"offset points\",\n            xytext=(6, 4),\n            ha='left',\n            fontsize=9,\n            weight='bold' if model_name == 'Koopman' else 'normal'\n        )\n\n# Visual polish\nax.set_xscale('log')\nax.set_xlabel(\"Trainable Transition Parameters (Log Scale)\", fontsize=11)\nax.set_ylabel(f\"Mean F1 Score at Step 1 (Latent Dim = {TARGET_LATENT_DIM})\", fontsize=11)\nax.set_title(\"The Parameter Efficiency Gap (Dynamic)\", fontsize=12, fontweight='bold', pad=15)\nax.grid(True, which=\"both\", linestyle=':', alpha=0.5)\n\n# Emphasize the narrative text block\nax.text(\n    0.05, 0.15,\n    \"Insight:\\nLinear Koopman matches complex recurrent systems\\nperformance at step 1 while being up to ~30× lighter.\",\n    transform=ax.transAxes,\n    bbox=dict(boxstyle=\"round,pad=0.5\", facecolor=\"wheat\", alpha=0.3),\n    fontsize=9\n)\n\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ================================================================\n# Linearity Diagnostic + Plot 3 (R² bars) + Plot 4 (variance curves)\n#\n# Requires both USE_COTRAIN=True run AND two-stage run to have\n# happened (in either order — both save to disk).\n# r2_results is populated here (SBM) and in the JODIE cell.\n# ================================================================\n\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import r2_score\nimport matplotlib.pyplot as plt\nimport matplotlib.gridspec as gridspec\nimport numpy as np\n\n# DIAG_VARIANT: use the variant with the strongest signal so\n# the R² difference between two-stage and co-trained is clearest.\nDIAG_VARIANT  = 'SBM-Signal-Strong'\nDIAG_LATENT   = 64    # single latent_dim for clean bar chart display\nDIAG_SEED     = 4     # held-out seed — not used in training\nDIAG_N_NODES  = SBM_VARIANTS[DIAG_VARIANT]['n_nodes']  # 100\n\n# r2_results may already have JODIE entries from the JODIE cell.\n# If it doesn't exist yet (running this cell standalone), initialise.\nif 'r2_results' not in dir():\n    r2_results = {}\n\n# ----------------------------------------------------------------\n# Helper — loads encoder weights from disk into a fresh GraphEncoder.\n# This lets us compute R² for BOTH two-stage and co-trained without\n# needing to keep both in memory from training (they may be from\n# separate notebook runs).\n# ----------------------------------------------------------------\ndef load_encoder(dataset, config_tag, n_nodes, latent_dim, in_channels=1, n_users=None):\n    \"\"\"\n    Instantiates a GraphEncoder and loads saved weights from disk.\n\n    Parameters\n    ----------\n    config_tag : str   — 'two_stage' or 'cotrain_balanced' (or other config name)\n    n_nodes    : int\n    latent_dim : int\n    in_channels: int   — 1 for SBM, 3 for JODIE\n    n_users    : int   — only needed when in_channels=3 (JODIE)\n\n    Returns\n    -------\n    enc : GraphEncoder in eval mode, weights loaded from disk\n    \"\"\"\n    path = (MODELS_DIR / dataset / config_tag\n            / f'n_nodes={n_nodes}' / f'latent_dim={latent_dim}' / 'encoder.pt')\n\n    if not path.exists():\n        raise FileNotFoundError(\n            f\"No saved encoder at {path}. \"\n            f\"Run training with config_tag='{config_tag}' first.\"\n        )\n\n    enc = GraphEncoder(\n        latent_dim  = latent_dim,\n        in_channels = in_channels,\n        n_users     = n_users\n    ).to(DEVICE)\n\n    enc.load_state_dict(torch.load(path, map_location=DEVICE))\n    enc.eval()\n    return enc\n\n\n# ----------------------------------------------------------------\n# compute_latent_linearity — unchanged from your original, just\n# exposed here for both SBM configs\n# ----------------------------------------------------------------\ndef compute_latent_linearity(encoder, variant_name, latent_dim, seed=0):\n    \"\"\"\n    Encodes a graph sequence and measures R² of the best linear map\n    z_{t+1} = A·z_t, fitted on the first 75% and evaluated on the\n    held-out 25%.\n\n    R² ≈ 0.07  → latent space has no linear structure (two-stage baseline)\n    R² > 0.50  → co-training shaped the latent space to be linear\n    R² ≈ 1.00  → collapse warning — check latent variance\n    \"\"\"\n    n_nodes = SBM_VARIANTS[variant_name]['n_nodes']\n    graphs  = torch.load(DATA_DIR / variant_name / f'seed_{seed}' / 'graphs.pt')\n\n    encoder.eval()\n    latent_seq = []\n    with torch.no_grad():\n        for t in range(len(graphs)):\n            adj_t      = graphs[t].to(DEVICE)\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy()))\n            ).long().to(DEVICE)\n            z_t = encoder(edge_index, num_nodes=n_nodes)\n            latent_seq.append(z_t.squeeze(0).cpu().numpy())\n\n    z       = np.array(latent_seq)   # (T, latent_dim)\n    T       = len(z)\n    n_train = int(T * 0.75)\n\n    z_in  = z[:-1]\n    z_out = z[1:]\n\n    reg   = LinearRegression(fit_intercept=False).fit(z_in[:n_train], z_out[:n_train])\n    z_hat = reg.predict(z_in[n_train:])\n\n    r2_per_dim = [\n        r2_score(z_out[n_train:, d], z_hat[:, d])\n        for d in range(latent_dim)\n    ]\n    return float(np.mean(r2_per_dim))\n\n\n# ----------------------------------------------------------------\n# Populate SBM entries in r2_results\n# We load from disk so this cell works whether or not the training\n# cell was run in the same session.\n# ----------------------------------------------------------------\nprint(\"Computing SBM R² scores...\\n\")\n\nfor config_tag, encoder_type in [('two_stage', 'two_stage'),\n                                   (ACTIVE_CONFIG_NAME, 'cotrain')]:\n    try:\n        enc = load_encoder('SBM', config_tag, DIAG_N_NODES, DIAG_LATENT)\n        r2  = compute_latent_linearity(enc, DIAG_VARIANT, DIAG_LATENT, seed=DIAG_SEED)\n        r2_results[('SBM-Signal-Strong', encoder_type, DIAG_LATENT)] = r2\n        print(f\"  SBM  {encoder_type:<15}  latent_dim={DIAG_LATENT}  R²={r2:.4f}\")\n    except FileNotFoundError as e:\n        print(f\"  SKIP: {e}\")\n\n# Pull JODIE entries — already set by the JODIE cell if it ran\njodie_ts  = r2_results.get(('JODIE-Wikipedia', 'two_stage', DIAG_LATENT), None)\njodie_ct  = r2_results.get(('JODIE-Wikipedia', 'cotrain',   DIAG_LATENT), None)\n\nprint(f\"\\n  JODIE two_stage  latent_dim={DIAG_LATENT}  R²={jodie_ts}\")\nprint(f\"  JODIE cotrain    latent_dim={DIAG_LATENT}  R²={jodie_ct}\")\n\n# ----------------------------------------------------------------\n# Pull variance logs (from training cells, or warn if missing)\n# We use latent_dim=32 for both curves — representative and cheap.\n# ----------------------------------------------------------------\nsbm_vlog   = sbm_variance_logs.get((DIAG_N_NODES, DIAG_LATENT), None) if isinstance(sbm_variance_logs, dict) else sbm_variance_logs\njodie_vlog = (jodie_variance_logs.get(DIAG_LATENT, None) if isinstance(jodie_variance_logs, dict) else jodie_variance_logs) \\\n             if 'jodie_variance_logs' in dir() else None\n\nif sbm_vlog is None:\n    print(\"\\nWARNING: sbm_variance_logs not found. \"\n          \"Run SBM training with USE_COTRAIN=True to generate Plot 4.\")\nif jodie_vlog is None:\n    print(\"WARNING: jodie_variance_logs not found. \"\n          \"Run JODIE co-training cell to generate Plot 4.\")\n\n# ================================================================\n# PLOT 3 — R² Linearity Bar Chart\n# ================================================================\nprint(\"\\nGenerating Plot 3: Latent Space Linearity (R²)...\")\n\n# Build bar data — gracefully skip missing entries\nbar_labels = [\n    'SBM\\ntwo-stage',\n    'SBM\\nco-trained',\n    'JODIE\\ntwo-stage',\n    'JODIE\\nco-trained',\n]\nbar_values = [\n    r2_results.get(('SBM-Signal-Strong', 'two_stage', DIAG_LATENT), 0.0),\n    r2_results.get(('SBM-Signal-Strong', 'cotrain',   DIAG_LATENT), 0.0),\n    r2_results.get(('JODIE-Wikipedia',   'two_stage', DIAG_LATENT), 0.0),\n    r2_results.get(('JODIE-Wikipedia',   'cotrain',   DIAG_LATENT), 0.0),\n]\n\n# Color encodes meaning:\n#   seagreen  = co-trained (dynamics loss applied)\n#   steelblue = two-stage  (reconstruction only)\nbar_colors = ['steelblue', 'seagreen', 'steelblue', 'seagreen']\n\nfig, ax = plt.subplots(figsize=(7, 4.5))\n\n# Cap visual height at -1.0 for the extreme outlier so it doesn't crush the scale\nplotted_values = [max(v, -1.0) for v in bar_values]\n\nbars = ax.bar(bar_labels, plotted_values, color=bar_colors,\n              edgecolor='black', linewidth=0.7, width=0.5)\n\n# Value labels positioned cleanly relative to the zero-axis line\nfor bar, val in zip(bars, bar_values):\n    h = bar.get_height()\n    if val < 0:\n        va_dir = 'top'\n        y_pos = h - 0.04\n        text_str = f'{val:.2f}' if val > -10 else f'{val:.1f}\\n(clipped)'\n    else:\n        va_dir = 'bottom'\n        y_pos = h + 0.04\n        text_str = f'{val:.2f}'\n\n    ax.text(\n        bar.get_x() + bar.get_width() / 2,\n        y_pos,\n        text_str,\n        ha='center', va=va_dir,\n        fontsize=10, fontweight='bold'\n    )\n\n# Reference lines\nax.axhline(0.07, color='gray', linestyle=':', linewidth=1.2,\n           label='Two-stage baseline (≈0.07)')\nax.axhline(0.00, color='black', linestyle='-', linewidth=0.8) # Zero line marker\nax.axhline(1.00, color='crimson', linestyle='--', linewidth=1.2,\n           label='Collapse ceiling (R²=1.0)')\n\nax.set_ylim(-1.2, 1.2) # Adjusted scale to allow negative tracking\nax.set_ylabel(r'Mean R² of linear fit $z_{t+1} = A \\cdot z_t$', fontsize=11)\nax.set_title(\n    f'Latent space linearity — does co-training work?\\n'\n    f'(latent dim = {DIAG_LATENT}, variant = {DIAG_VARIANT})',\n    fontsize=11, fontweight='bold'\n)\nax.grid(axis='y', linestyle=':', alpha=0.5)\n\n# Custom legend patch for color meaning\nfrom matplotlib.patches import Patch\nlegend_elements = [\n    Patch(facecolor='steelblue', edgecolor='black', label='Two-stage (recon only)'),\n    Patch(facecolor='seagreen',  edgecolor='black', label='Co-trained (+ dynamics loss)'),\n]\nax.legend(handles=legend_elements, fontsize=9, loc='upper left')\n\nplt.tight_layout()\nplt.savefig(RESULTS_DIR / 'plot3_linearity_r2.pdf', dpi=300, bbox_inches='tight')\nplt.show()\nprint(\"Plot 3 saved.\")\n\n# ================================================================\n# PLOT 4 — Latent Variance Convergence During Co-Training\n# ================================================================\nif sbm_vlog is None and jodie_vlog is None:\n    print(\"\\nSkipping Plot 4 — no variance logs available.\")\n    print(\"Run both training cells with USE_COTRAIN=True first.\")\nelse:\n    print(\"\\nGenerating Plot 4: Latent Variance Convergence History...\")\n\n    fig, ax = plt.subplots(figsize=(7, 4.5))\n\n    if sbm_vlog is not None:\n        epochs_sbm = list(range(1, len(sbm_vlog) + 1))\n        ax.plot(epochs_sbm, sbm_vlog,\n                '-o', markersize=3,\n                color='seagreen', linewidth=2.2,\n                label=f'SBM ({DIAG_VARIANT}, latent_dim={DIAG_LATENT})')\n\n    if jodie_vlog is not None:\n        epochs_jod = list(range(1, len(jodie_vlog) + 1))\n        ax.plot(epochs_jod, jodie_vlog,\n                '-s', markersize=3,\n                color='crimson', linewidth=2.2,\n                label=f'JODIE-Wikipedia (latent_dim={DIAG_LATENT})')\n\n    # Shade the collapse danger zone\n    ax.axhspan(0, 0.01, color='crimson', alpha=0.08,\n               label='Representation collapse zone (var < 0.01)')\n\n    ax.set_xlabel('Co-training epoch', fontsize=11)\n    ax.set_ylabel(r'Mean latent variance $\\sigma^2_z$ (across dimensions)', fontsize=11)\n    ax.set_title(\n        'Does co-training collapse the latent space?\\n'\n        'Variance during joint encoder + Koopman training',\n        fontsize=11, fontweight='bold'\n    )\n    ax.grid(True, linestyle=':', alpha=0.5)\n    ax.legend(fontsize=9, loc='upper right')\n\n    plt.tight_layout()\n    plt.savefig(RESULTS_DIR / 'plot4_variance_convergence.pdf', dpi=300, bbox_inches='tight')\n    plt.show()\n    print(\"Plot 4 saved.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Cell — JODIE Density Diagnostic (add after Cell 39)\n\nn_possible = (JODIE_N_NODES * (JODIE_N_NODES - 1)) // 2\nedge_counts = [(jodie_graphs_all[t] >= 0.5).sum().item() // 2 \n               for t in range(len(jodie_graphs_all))]\n\nprint(f\"Nodes: {JODIE_N_NODES}\")\nprint(f\"Possible edges: {n_possible:,}\")\nprint(f\"Edges per snapshot — min: {min(edge_counts)}, \"\n      f\"max: {max(edge_counts)}, mean: {sum(edge_counts)/len(edge_counts):.1f}\")\nprint(f\"Density — min: {min(edge_counts)/n_possible:.4f}, \"\n      f\"max: {max(edge_counts)/n_possible:.4f}, \"\n      f\"mean: {sum(edge_counts)/len(edge_counts)/n_possible:.4f}\")\nprint(f\"\\nCollapse threshold: ~1% density\")\nprint(f\"JODIE density: {sum(edge_counts)/len(edge_counts)/n_possible*100:.2f}% \"\n      f\"→ {'BELOW' if sum(edge_counts)/len(edge_counts)/n_possible < 0.01 else 'ABOVE'} threshold\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# CELL A — ABIDE Dataset: Download + ROI Time Series Extraction\n#\n# What this cell does:\n#   1. Installs nilearn — a neuroimaging library that handles\n#      fMRI data fetching and ROI signal extraction\n#   2. Downloads preprocessed ABIDE data directly from the\n#      Preprocessed Connectomes Project (PCP) server\n#   3. Extracts the mean BOLD signal per ROI for each subject\n#      Output: one (n_timepoints × 116) matrix per subject\n#\n# References:\n#   - ABIDE dataset: Di Martino et al., Molecular Psychiatry, 2014\n#     https://doi.org/10.1038/mp.2013.78\n#   - nilearn: Abraham et al., Frontiers in Neuroinformatics, 2014\n#     https://doi.org/10.3389/fninf.2014.00014\n#   - AAL atlas: Tzourio-Mazoyer et al., NeuroImage, 2002\n#     https://doi.org/10.1006/nimg.2001.0978\n# ============================================================\n\n# ── Step 1: Install nilearn ──────────────────────────────────\n# nilearn is not available by default on Kaggle.\n# We install it quietly with pip.\nimport subprocess\nsubprocess.run(['pip', 'install', 'nilearn', '--quiet'], check=True)\nprint(\"nilearn installed.\")\n\n# ── Step 2: Imports ──────────────────────────────────────────\nimport numpy as np\nimport torch\nfrom pathlib import Path\nfrom nilearn import datasets, input_data\n\n# ── Step 3: Configuration ────────────────────────────────────\nABIDE_DIR      = Path('/kaggle/working/abide')\nABIDE_DIR.mkdir(exist_ok=True)\n\nN_SUBJECTS     = 100   # start small — full ABIDE is 1112 subjects\n                       # 100 gives ~50 ASD + 50 TD for a balanced pilot\nMIN_TIMEPOINTS = 100   # discard subjects with fewer than 100 timepoints\n                       # (some sites have shorter scans)\n\n# ── Step 4: Fetch ABIDE ──────────────────────────────────────\n# datasets.fetch_abide_pcp() downloads preprocessed ABIDE data\n# from the Preprocessed Connectomes Project (PCP) server.\n#\n# Key parameters:\n#   n_subjects   : how many subjects to download\n#   pipeline     : preprocessing pipeline used on the raw scans.\n#                  'cpac' (Configurable Pipeline for the Analysis\n#                  of Connectomes) is the most commonly used —\n#                  it includes motion correction, nuisance regression,\n#                  bandpass filtering, and spatial smoothing.\n#   band_pass_filtering : True — keeps only slow BOLD fluctuations\n#                  (0.01–0.1 Hz), which are the frequencies that\n#                  carry resting-state network information.\n#   global_signal_regression : False — a contested preprocessing\n#                  step; we leave it off to avoid artifacts.\n#   derivatives  : ['rois_aal'] — we want ROI-level time series\n#                  already extracted using the AAL atlas (116 regions),\n#                  NOT the raw voxel-level data (which is ~200k voxels).\n#   data_dir     : where to cache downloaded files\n\nprint(f\"Fetching {N_SUBJECTS} ABIDE subjects (this may take a few minutes)...\")\n\nabide = datasets.fetch_abide_pcp(\n    n_subjects              = N_SUBJECTS,\n    pipeline                = 'cpac',\n    band_pass_filtering     = True,\n    global_signal_regression= False,\n    derivatives             = ['rois_aal'],\n    data_dir                = str(ABIDE_DIR),\n    verbose                 = 0\n)\n\n# abide is a Bunch object (like a dict with dot-access).\n# abide.rois_aal  : list of file paths, one per subject\n#                   each file is a (n_timepoints × 116) .1D text file\n# abide.phenotypic: structured array with subject metadata\n#                   columns include DX_GROUP (1=ASD, 2=TD), AGE_AT_SCAN, SEX, SITE_ID\n\nprint(f\"Downloaded {len(abide.rois_aal)} subjects.\")\nprint(f\"Phenotypic columns: {list(abide.phenotypic.columns)}\")\n\n# ── Step 5: Extract labels ───────────────────────────────────\n# DX_GROUP: 1 = Autism (ASD), 2 = Typically Developing (TD)\n# We recode to binary: ASD=1, TD=0\n\ndx_raw = abide.phenotypic['DX_GROUP'].values   # .values converts DataFrame column to numpy array\nlabels = (dx_raw == 1).astype(int)\n\nprint(f\"\\nLabel distribution:\")\nprint(f\"  ASD (label=1): {labels.sum()}\")\nprint(f\"  TD  (label=0): {(labels == 0).sum()}\")\n\n# ── Step 6: Load ROI time series ─────────────────────────────\n# In newer nilearn versions, abide.rois_aal already contains\n# numpy arrays in memory — NOT file paths.\n# We check which case we have and handle both.\n\nprint(\"Loading ROI time series...\")\n\ntime_series_list = []\nvalid_labels     = []\nvalid_indices    = []\n\nfor i, (data, label) in enumerate(zip(abide.rois_aal, labels)):\n    try:\n        # Handle both cases:\n        #   Old nilearn → data is a file path string → load with np.loadtxt\n        #   New nilearn → data is already a numpy array → use directly\n        if isinstance(data, np.ndarray):\n            ts = data.astype(np.float32)\n        else:\n            ts = np.loadtxt(data).astype(np.float32)\n\n        # Shape check — expect (n_timepoints, 116)\n        # Some sites return (116, n_timepoints) — transpose if needed\n        if ts.ndim == 2 and ts.shape[0] == 116 and ts.shape[1] != 116:\n            ts = ts.T   # fix transposed arrays\n\n        if ts.ndim != 2:\n            print(f\"  Subject {i}: skipped (unexpected shape {ts.shape})\")\n            continue\n\n        if ts.shape[1] != 116:\n            print(f\"  Subject {i}: skipped (expected 116 ROIs, got {ts.shape[1]})\")\n            continue\n\n        if ts.shape[0] < MIN_TIMEPOINTS:\n            print(f\"  Subject {i}: skipped ({ts.shape[0]} timepoints < {MIN_TIMEPOINTS})\")\n            continue\n\n        time_series_list.append(ts)\n        valid_labels.append(int(label))\n        valid_indices.append(i)\n\n    except Exception as e:\n        print(f\"  Subject {i}: failed ({e})\")\n        continue\n\nvalid_labels = np.array(valid_labels)\n\nprint(f\"\\n✓ Loaded {len(time_series_list)} valid subjects\")\nprint(f\"  ASD: {valid_labels.sum()}  |  TD: {(valid_labels==0).sum()}\")\n\nif len(time_series_list) > 0:\n    shapes = [ts.shape[0] for ts in time_series_list]\n    print(f\"  Timepoints — min: {min(shapes)}, max: {max(shapes)}, \"\n          f\"mean: {np.mean(shapes):.1f}\")\n    print(f\"  ROIs per subject: {time_series_list[0].shape[1]}\")\nelse:\n    print(\"  No subjects loaded — run the diagnostic cell above first.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T15:05:17.680937Z","iopub.execute_input":"2026-05-18T15:05:17.681359Z","iopub.status.idle":"2026-05-18T15:05:23.126439Z","shell.execute_reply.started":"2026-05-18T15:05:17.681333Z","shell.execute_reply":"2026-05-18T15:05:23.125692Z"}},"outputs":[{"name":"stdout","text":"nilearn installed.\n","output_type":"stream"},{"name":"stderr","text":"/tmp/ipykernel_58/1159481199.py:32: FutureWarning: The import path 'nilearn.input_data' is deprecated in version 0.9. Importing from 'nilearn.input_data' will be possible at least u