n of edges that remain unchanged between t and t+1\n# on the test split.\npersistence_scores = []\nfor t in range(len(jodie_test_graphs) - 1):\n    A_curr = (jodie_test_graphs[t]     >= 0.5).numpy().astype(int)\n    A_next = (jodie_test_graphs[t + 1] >= 0.5).numpy().astype(int)\n    same   = (A_curr == A_next).mean()\n    persistence_scores.append(float(same))\n\njodie_persistence = float(np.mean(persistence_scores))\nprint(f\"\\n  Estimated persistence (fraction unchanged per step): {jodie_persistence:.4f}\")\nif jodie_persistence > 0.95:\n    print(\"High persistence — strong temporal signal to exploit.\")\nelif jodie_persistence > 0.85:\n    print(\"Moderate persistence.\")\nelse:\n    print(\"Low persistence — graphs change rapidly; signal may be weak.\")\n\nprint(\"\\n  Copy-previous F1 on test split:\")\ncp_f1_by_step = {}\nfor step in JODIE_EVAL_STEPS:\n    f1s = []\n    for t in range(len(jodie_test_graphs) - step):\n        A_curr = jodie_test_graphs[t].numpy()\n        A_fut  = jodie_test_graphs[t + step].numpy()\n        pred   = (A_curr >= 0.5).astype(int).flatten()\n        true   = (A_fut  >= 0.5).astype(int).flatten()\n        f1s.append(f1_score(true, pred, zero_division=0))\n    cp_f1_by_step[step] = float(np.mean(f1s))\n    print(f\"    step={step:>2}  F1={cp_f1_by_step[step]:.4f}\")\n\n# Use step=1 copy-previous F1 as the oracle ceiling.\n# A model that beats this at step=1 has learned to predict edge changes,\n# which is stronger than pure persistence.\njodie_oracle_f1 = cp_f1_by_step[1]\nORACLE_F1['JODIE-Wikipedia'] = jodie_oracle_f1\n\nprint(f\"\\n  Oracle F1 (copy-prev at step=1) = {jodie_oracle_f1:.4f}\")\nprint(f\"  This is set as ORACLE_F1['JODIE-Wikipedia'].\")\n\n# Also add JODIE to SIGNAL_VARIANTS so efficiency plots include it\nif 'JODIE-Wikipedia' not in SIGNAL_VARIANTS:\n    SIGNAL_VARIANTS.append('JODIE-Wikipedia')\n    print(\"  Added 'JODIE-Wikipedia' to SIGNAL_VARIANTS.\")\n\nprint(f\"\\n  Updated SIGNAL_VARIANTS: {SIGNAL_VARIANTS}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T12:25:48.803424Z","iopub.execute_input":"2026-05-16T12:25:48.803743Z","iopub.status.idle":"2026-05-16T12:25:49.701370Z"}},"outputs":[{"name":"stdout","text":"============================================================\nEMPIRICAL ORACLE ESTIMATION FOR JODIE\n============================================================\n\n  Estimated persistence (fraction unchanged per step): 0.9988\nHigh persistence — strong temporal signal to exploit.\n\n  Copy-previous F1 on test split:\n    step= 1  F1=0.4050\n    step= 5  F1=0.2275\n    step=10  F1=0.2027\n    step=20  F1=0.1613\n\n  Oracle F1 (copy-prev at step=1) = 0.4050\n  This is set as ORACLE_F1['JODIE-Wikipedia'].\n  Added 'JODIE-Wikipedia' to SIGNAL_VARIANTS.\n\n  Updated SIGNAL_VARIANTS: ['SBM-Signal-Strong', 'SBM-Signal-Medium', 'SBM-Dynamic-Hard', 'JODIE-Wikipedia']\n","output_type":"stream"}],"execution_count":null},{"cell_type":"code","source":"# Train and Evaluate transition models on JODIE\n#\n# Reuses: get_model_class, train_single_model, create_data_loader,\n#         create_sequence_data_loader, compute_f1_from_latent\n# from earlier cells — no redefinition needed.\n#\n#   - Only one seed (seed_0), so train/test split is by TIME not by seed.\n#   - Latent dims: JODIE_LATENT_DIMS = [32, 64]\n#   - Decoder loaded from jodie_cotrain_decoders\n\nJODIE_EVAL_STEPS   = [1, 5, 10, 20]\nJODIE_MODEL_NAMES  = ['Koopman', 'MLP', 'GRU']   # skip EDMD-lift (needs many train steps)\n                                                   # skip RNN (redundant with GRU here)\nJODIE_MODES        = ['single_step', 'stateful']\n\njodie_rows = []   # separate results list — merged with all_rows at the end\n\nprint(\"Training transition models on JODIE-Wikipedia...\\n\")\nprint(f\"Models: {JODIE_MODEL_NAMES}\")\nprint(f\"Modes:  {JODIE_MODES}\")\nprint(f\"Latent dims: {JODIE_LATENT_DIMS}\")\nprint(f\"Eval steps: {JODIE_EVAL_STEPS}\\n\")\n\nfor latent_dim in JODIE_LATENT_DIMS:\n\n    z_all = torch.load(\n        LATENT_DIR / 'JODIE-Wikipedia' / f'latent_dim={latent_dim}' / 'seed_0.pt'\n    ).cpu().numpy()\n\n    z_train = z_all[:T_jodie_train]\n    z_test  = z_all[T_jodie_train:]\n\n    # Load decoder\n    decoder = jodie_cotrain_decoders[(JODIE_N_NODES, latent_dim)]\n    decoder.eval()\n\n    for model_name in JODIE_MODEL_NAMES:\n        for mode in JODIE_MODES:\n            print(f\"  {model_name} / {mode} / dim={latent_dim} ...\", end=' ')\n\n            # Build data loaders from the time-split latent sequences\n            if mode == 'stateful':\n                train_loader, _ = create_sequence_data_loader(\n                    z_train, batch_size=16, train_split=0.8\n                )\n                _, test_loader = create_sequence_data_loader(\n                    z_test, batch_size=16, train_split=0.0  # use all of z_test\n                )\n            else:\n                train_loader, _ = create_data_loader(\n                    z_train, batch_size=16, train_split=0.8\n                )\n                _, test_loader = create_data_loader(\n                    z_test, batch_size=16, train_split=0.0\n                )\n\n            # Create and train the transition model\n            model_class = get_model_class(model_name, mode)\n            if mode == 'stateful':\n                model = model_class(latent_dim, hidden_dim=HIDDEN_DIM).to(DEVICE)\n            else:\n                model = model_class(latent_dim).to(DEVICE)\n\n            train_single_model(\n                model, train_loader, test_loader,\n                mode=mode, epochs=50, learning_rate=1e-3,\n                spectral_penalty_weight=SPECTRAL_PENALTY,\n                verbose=False\n            )\n\n            # Save checkpoint\n            ckpt_name = f\"JODIE-Wikipedia_latent={latent_dim}_{model_name}_{mode}.pt\"\n            torch.save(model.state_dict(), MODELS_DIR / 'JODIE' / config_tag / ckpt_name)\n            print(\"trained