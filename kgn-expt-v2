T, L = z_shared.shape\n    \n    valid_z_t   = []\n    valid_z_t1  = []\n    \n    # Collect transitions only where real time steps exist\n    for b_idx in range(B):\n        true_len = lengths[b_idx]\n        valid_z_t.append(z_shared[b_idx, :true_len-1])\n        valid_z_t1.append(z_shared[b_idx, 1:true_len])\n        \n    z_t  = torch.cat(valid_z_t, dim=0)   # (Total_Valid_Steps, latent_dim)\n    z_t1 = torch.cat(valid_z_t1, dim=0)  # (Total_Valid_Steps, latent_dim)\n    \n    # Project forward via the global operator K\n    z_t1_pred = torch.matmul(z_t, model.K.t())\n    \n    loss_dyn = nn.functional.mse_loss(z_t1_pred, z_t1)\n    loss_cls = nn.functional.cross_entropy(cls_logits, targets)\n    \n    total_loss = (lambda_dyn * loss_dyn) + (lambda_cls * loss_cls)\n    return total_loss, loss_dyn.item(), loss_cls.item()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T10:26:18.664303Z","iopub.execute_input":"2026-05-24T10:26:18.664722Z","iopub.status.idle":"2026-05-24T10:26:18.680581Z","shell.execute_reply.started":"2026-05-24T10:26:18.664687Z","shell.execute_reply":"2026-05-24T10:26:18.679527Z"}},"outputs":[],"execution_count":57},{"cell_type":"code","source":"# Cell 9 — Dynamic Collate Training & Test Evaluation\n# ──────────────────────────────────────────────────────────────────────────\n\ndef prepare_variable_dataset(trajectories_list):\n    \"\"\"Keeps trajectories as a list of independent sub-tensors to prevent array crashes\"\"\"\n    tensors_X = []\n    labels_y   = []\n    for s in trajectories_list:\n        data = s['trajectory'] if 'trajectory' in s else s['lifted']\n        tensors_X.append(torch.tensor(data, dtype=torch.float32))\n        labels_y.append(1 if s['label'] == 'ASD' else 0)\n    return tensors_X, torch.tensor(labels_y, dtype=torch.long)\n\n# 1. Separate individual scans safely\nX_train_list, y_train_t = prepare_variable_dataset(subject_trajectories)\nX_test_list, y_test_t   = prepare_variable_dataset(test_trajectories)\n\ndef build_dynamic_batch(X_list, y_tensor, indices):\n    \"\"\"Pads a subset of subjects dynamically to match the batch's max sequence length\"\"\"\n    batch_X = [X_list[idx] for idx in indices]\n    batch_y = y_tensor[indices]\n    lengths = [traj.shape[0] for traj in batch_X]\n    max_len = max(lengths)\n    \n    padded_X = torch.zeros(len(batch_X), max_len, batch_X[0].shape[1])\n    for i, traj in enumerate(batch_X):\n        padded_X[i, :traj.shape[0], :] = traj\n        \n    return padded_X, batch_y, lengths\n\n# Model Initialization\nmodel = DecoupledKoopmanNet(input_dim=32, latent_dim=32)\noptimizer = optim.AdamW(model.parameters(), lr=0.001, weight_decay=1e-4)\n\nepochs = 150\nbatch_size = 16\nN_train = len(X_train_list)\n\nprint(\"Beginning Phase 5 Variable-Length Optimization Cycle...\")\nprint(\"=\"*65)\n\nfor epoch in range(1, epochs + 1):\n    model.train()\n    permutation = torch.randperm(N_train)\n    \n    epoch_loss, epoch_dyn, epoch_cls = 0, 0, 0\n    num_batches = 0\n    \n    for i in range(0, N_train, batch_size):\n        indices = permutation[i:i+batch_size]\n        # Construct padded matrices on-the-fly for this batch\n        batch_x, batch_y, batch_lens = build_dynamic_batch(X_train_list, y_train_t, indices)\n        \n        optimizer.zero_grad()\n        z_shared, cls_logits = model(batch_x, batch_lens)\n        \n        loss, l_dyn, l_cls = compute_multitask_loss(\n            model, z_shared, cls_logits, batch_y, batch_lens, lambda_dyn=2.0, lambda_cls=1.0\n        )\n        \n        loss.backward()\n        optimizer.step()\n        \n        epoch_loss += loss.item()\n        epoch_dyn += l_dyn\n        epoch_cls += l_cls\n        num_batches += 1\n        \n    if epoch % 20 == 0 or epoch == 1:\n        print(f\"Epoch {epoch:03d}/{epochs} | Total Loss: {epoch_loss/num_batches:.4f} | \"\n              f\"Dyn MSE: {epoch_dyn/num_batches:.5f} | Cls Loss: {epoch_cls/num_batches:.4f}\")\n\n# ── Evaluate on Unseen Test Subjects ──────────────────────────────────────\nmodel.eval()\nfrom sklearn.metrics import roc_auc_score, f1_score\n\nwith torch.no_grad():\n    # Build a single evaluation batch encompassing all test subjects\n    test_indices = list(range(len(X_test_list)))\n    test_x, test_y, test_lens = build_dynamic_batch(X_test_list, y_test_t, test_indices)\n    \n    z_shared_test, test_logits = model(test_x, test_lens)\n    \n    # Calculate masked R² over the active time elements\n    valid_true, valid_pred = [], []\n    for b_idx in range(len(test_lens)):\n        t_len = test_lens[b_idx]\n        valid_true.append(z_shared_test[b_idx, 1:t_len])\n        valid_pred.append(torch.matmul(z_shared_test[b_idx, :t_len-1], model.K.t()))\n        \n    true_stacked = torch.cat(valid_true, dim=0)\n    pred_stacked = torch.cat(valid_pred, dim=0)\n    \n    res_ss = torch.sum((true_stacked - pred_stacked) ** 2).item()\n    tot_ss = torch.sum((true_stacked - true_stacked.mean(dim=0)) ** 2).item()\n    r2_shared_test = 1.0 - (res_ss / tot_ss)\n    \n    # Probabilities and performance scoring\n    test_probs = nn.functional.softmax(test_logits, dim=1)[:, 1].numpy()\n    test_preds = torch.argmax(test_logits, dim=1).numpy()\n    \n    auc_pheno = roc_auc_score(y_test_t.numpy(), test_probs)\n    f1_pheno  = f1_score(y_test_t.numpy(), test_preds)\n\nprint(\"\\n\" + \"=\"*65)\nprint(\"PHASE 5 DECOUPLED EVALUATION RESULTS\")\nprint(\"=\"*65)\nprint(f\"Shared Linear Core Test R²       : {r2_shared_test:.4f}\")\nprint(f\"Phenotypic Diagnostic Head AUC   : {auc_pheno:.4f}\")\nprint(f\"Phenotypic Diagnostic Head F1    : {f1_pheno:.4f}\")\nprint(\"=\"*65)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T10:26:29.910563Z","iopub.execute_input":"2026-05-24T10:26:29.910951Z","iopub.status.idle":"2026-05-24T10:26:33.478167Z","shell.execute_reply.started":"2026-05-24T10:26:29.910911Z","shell.execute_reply":"2026-05-24T10:26:33.477218Z"}},"outputs":[{"name":"stdout","text":"Be