}\")\n\n    # Test 1: Eigenvalue magnitudes\n    # mannwhitneyu args:\n    #   x, y        : the two samples to compare\n    #   alternative : 'two-sided' — we test for ANY difference, not just one direction\n    stat_mag, p_mag = mannwhitneyu(asd_mags, td_mags, alternative='two-sided')\n\n    print(f\"\\n[Magnitude Test]  H0: ASD and TD magnitude distributions are identical\")\n    print(f\"  ASD mean magnitude : {asd_mags.mean():.4f}\")\n    print(f\"  TD  mean magnitude : {td_mags.mean():.4f}\")\n    print(f\"  U statistic        : {stat_mag:.1f}\")\n    print(f\"  p-value            : {p_mag:.4f}  \", end=\"\")\n    print(\"*** SIGNIFICANT ***\" if p_mag < 0.05 else \"(not significant)\")\n\n    # Test 2: Oscillation frequencies\n    stat_freq, p_freq = mannwhitneyu(asd_freqs, td_freqs, alternative='two-sided')\n\n    print(f\"\\n[Frequency Test]  H0: ASD and TD frequency distributions are identical\")\n    print(f\"  ASD mean frequency : {asd_freqs.mean():.4f}\")\n    print(f\"  TD  mean frequency : {td_freqs.mean():.4f}\")\n    print(f\"  U statistic        : {stat_freq:.1f}\")\n    print(f\"  p-value            : {p_freq:.4f}  \", end=\"\")\n    print(\"*** SIGNIFICANT ***\" if p_freq < 0.05 else \"(not significant)\")\n\n    return p_mag, p_freq\n\n# ── Run tests for both encoders ───────────────────────────────\nprint(\"MANN-WHITNEY U TEST RESULTS\")\n\n# v7: with global Koopman regularizer\np_mag_v7, p_freq_v7 = run_spectral_tests(\n    asd_mags, td_mags, asd_freqs, td_freqs,\n    \"v7 Encoder (Global Koopman Regularizer)\"\n)\n\n# v5: no Koopman regularizer\np_mag_v5, p_freq_v5 = run_spectral_tests(\n    asd_mags_v5, td_mags_v5, asd_freqs_v5, td_freqs_v5,\n    \"v5 Encoder (No Koopman Regularizer)\"\n)\n\n# ── Visualization: 2×2 grid ───────────────────────────────────\n# Row 1: v7 encoder  |  Row 2: v5 encoder\n# Col 1: magnitude distributions  |  Col 2: frequency distributions\n\nfig, axes = plt.subplots(2, 2, figsize=(14, 10))\nfig.suptitle(\"Per-Subject Koopman Spectral Analysis\\nASD vs TD: v7 (Global K) vs v5 (No K)\",\n             fontsize=14, fontweight='bold')\n\n# Color palette\nC_TD  = '#2196F3'   # blue  for TD\nC_ASD = '#F44336'   # red   for ASD\n\nconfigs = [\n    # (row, col, asd_data,    td_data,    p_val,    xlabel,               title_tag)\n    (0, 0, asd_mags,     td_mags,     p_mag_v7,  '|λ| Magnitude',      'v7 — Magnitude'),\n    (0, 1, asd_freqs,    td_freqs,    p_freq_v7, 'Frequency f=θ/2π',   'v7 — Frequency'),\n    (1, 0, asd_mags_v5,  td_mags_v5,  p_mag_v5,  '|λ| Magnitude',      'v5 — Magnitude'),\n    (1, 1, asd_freqs_v5, td_freqs_v5, p_freq_v5, 'Frequency f=θ/2π',   'v5 — Frequency'),\n]\n\nfor (row, col, asd_data, td_data, p_val, xlabel, title_tag) in configs:\n    ax = axes[row, col]\n\n    # KDE plots\n    # sns.kdeplot explanation:\n    # Draws a smooth density curve estimating the distribution of the data.\n    # fill=True fills the area under the curve for readability.\n    # alpha controls transparency so overlapping regions are visible.\n    import seaborn as sns\n    sns.kdeplot(td_data,  ax=ax, color=C_TD,  fill=True, alpha=0.4,\n                linewidth=2, label='TD')\n    sns.kdeplot(asd_data, ax=ax, color=C_ASD, fill=True, alpha=0.4,\n                linewidth=2, label='ASD')\n\n    # Significance annotation\n    sig_text = f\"p = {p_val:.4f}\" + (\" ✓ sig.\" if p_val < 0.05 else \" (n.s.)\")\n    ax.set_title(f\"{title_tag}\\n{sig_text}\", fontsize=11, fontweight='bold')\n    ax.set_xlabel(xlabel)\n    ax.set_ylabel('Density')\n    ax.legend()\n    ax.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.savefig('spectral_comparison_v5_vs_v7.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint(\"\\nFigure saved: spectral_comparison_v5_vs_v7.png\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:39:04.186407Z","iopub.execute_input":"2026-05-24T06:39:04.186657Z","iopub.status.idle":"2026-05-24T06:39:05.972230Z","shell.execute_reply.started":"2026-05-24T06:39:04.186627Z","shell.execute_reply":"2026-05-24T06:39:05.971403Z"}},"outputs":[{"name":"stdout","text":"MANN-WHITNEY U TEST RESULTS\n\n=======================================================\n  v7 Encoder (Global Koopman Regularizer)\n=======================================================\n\n[Magnitude Test]  H0: ASD and TD magnitude distributions are identical\n  ASD mean magnitude : 0.0384\n  TD  mean magnitude : 0.0392\n  U statistic        : 460322.0\n  p-value            : 0.9978  (not significant)\n\n[Frequency Test]  H0: ASD and TD frequency distributions are identical\n  ASD mean frequency : 0.2469\n  TD  mean frequency : 0.2473\n  U statistic        : 459941.0\n  p-value            : 0.9770  (not significant)\n\n=======================================================\n  v5 Encoder (No Koopman Regularizer)\n=======================================================\n\n[Magnitude Test]  H0: ASD and TD magnitude distributions are identical\n  ASD mean magnitude : 0.0384\n  TD  mean magnitude : 0.0387\n  U statistic        : 463412.0\n  p-value            : 0.7969  (not significant)\n\n[Frequency Test]  H0: ASD and TD frequency distributions are identical\n  ASD mean frequency : 0.2443\n  TD  mean frequency : 0.2476\n  U statistic        : 457016.0\n  p-value            : 0.7853  (not significant)\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x1000 with 4 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nFigure saved: spectral_comparison_v5_vs_v7.png\n","output_type":"stream"}],"execution_count":40},{"cell_type":"code","source":"# Cell 5 PATCHED — Ridge Alpha Selection with Dynamic Walk-Forward Splits\n# ────────────────────────────────────────────────────────────────────────\n# Key fix: split points are computed PER SUBJECT based on actual n_pairs\n# instead of hardcoded indices that assume all subjects have 16+ pairs\n#\n# Split strategy:\n#   Train : first 60% of pairs\n#   Val   : remaining 40% of pairs\n# Minimum pairs needed: we need at least 2 pairs for val and n_latent+1\n# for a meaningful ridge fit, so we skip subjects with fewer than 6 pairs\n\nimport numpy as np\nfrom numpy.linalg import lstsq\n\nALPHA_CANDIDATES = np.logspace(-3, 3, 13)\nMIN_PAIRS = 6   # skip subjects too short for a meaningful fit\n\ndef fit_ridge_ki(Z, Z_, alpha):\n    n_latent   = Z.shape[1]\n    sqrt_alpha = np.sqrt(alpha)\n    Z_aug      = np.vstack([Z,  sqrt_alpha * np.eye(n_latent)])\n    Z__aug     = np.vstack([Z_, np.zeros((n_latent, n_latent))])\n    K_i_T, _, _, _ = lstsq(Z_aug, Z__aug, rcond=None)\n    return K_i_T.T\n\ndef val_mse(K_i, Z_val, Z_val_):\n    Z_pred = Z_val @ K_i.T\n    return np.mean((Z_pred - Z_val_) ** 2)\n\ndef get_dynamic_splits(n_pairs):\n    \"\"\"\n    Compute two walk-forward folds based on actual n_pairs.\n    \n    Fold 1: train on first 50%, validate on next 25%\n    Fold 2: train on first 75%, validate on last 25%\n    \n    All indices are computed as fractions of n_pairs so every\n    subject gets valid non-empty train and val windows.\n    \"\"\"\n    t1 = max(2, int(n_pairs * 0.50))   # end of fold-1 train\n    v1 = max(t1 + 1, int(n_pairs * 0.75))  # end of fold-1 val\n    t2 = v1                             # fold-2 train extends to fold-1 val end\n    v2 = n_pairs                        # fold-2 val goes to end\n\n    splits = []\n    # Only add fold if val window is non-empty\n    if v1 > t1:\n        splits.append({'train': (0, t1), 'val': (t1, v1)})\n    if v2 > t2:\n        splits.append({'train': (0, t2), 'val': (t2, v2)})\n    return splits\n\n# ── Sanity check splits for a few lengths ─────────────────────\nprint(\"Split preview for different trajectory lengths:\")\nfor n in [9, 11, 13, 15, 17]:\n    splits = get_dynamic_splits(n)\n    print(f\"  n_pairs={n}: {splits}\")\n\nprint(f\"\\nRunning CV over {len(ALPHA_CANDIDATES)} alphas...\\n\")\n\n# ── Main cross-validation loop ────────────────────────────────\nalpha_scores = []\n\nfor alpha in ALPHA_CANDIDATES:\n    fold_mses    = []\n    skipped      = 0\n\n    for subject in subject_trajectories_v5:\n        traj    = subject['trajectory']\n        n_pairs = traj.shape[0] - 1       # actual number of (z_t, z_{t+1}) pairs\n\n        if n_pairs < MIN_PAIRS:\n            skipped += 1\n            continue\n\n        Z  = traj[:-1]   # (n_pairs, 32)\n        Z_ = traj[1:]    # (n_pairs, 32)\n\n        splits = get_dynamic_splits(n_pairs)\n\n        for split in splits:\n            t0, t1 = split['train']\n            v0, v1 = split['val']\n\n            Z_train  = Z[t0:t1]\n            Z__train = Z_[t0:t1]\n            Z_val    = Z[v0:v1]\n            Z__val   = Z_[v0:v1]\n\n            # Guard: skip if either window is somehow empty\n            if Z_train.shape[0] == 0 or Z_val.shape[0] == 0:\n                continue\n\n            K_i = fit_ridge_ki(Z_train, Z__train, alpha)\n            mse = val_mse(K_i, Z_val, Z__val)\n\n            # Guard: skip NaN MSE (shouldn't happen now, but be safe)\n            if not np.isnan(mse):\n                fold_mses.append(mse)\n\n    avg_mse = np.mean(fold_mses) if fold_mses else np.nan\n    alpha_scores.append(avg_mse)\n    print(f\"  alpha = {alpha:>10.5f}  |  avg val MSE = {avg_mse:.6f}\"\n          f\"  (skipped {skipped} short subjects)\")\n\n# ── Pick best alpha ───────────────────────────────────────────\nvalid_scores = [(a, s) for a, s in zip(ALPHA_CANDIDATES, alpha_scores)\n                if not np.isnan(s)]\nbest_alpha, best_mse = min(valid_scores, key=lambda x: x[1])\n\nprint(f\"\\nBest alpha   : {best_alpha:.5f}\")\nprint(f\"Best val MSE : {best_mse:.6f}\")\n\n# ── Plot ──────────────────────────────────────────────────────\nimport matplotlib.pyplot as plt\n\nplt.figure(figsize=(8, 4))\nplt.semilogx(ALPHA_CANDIDATES, alpha_scores, 'o-', color='steelblue', linewidth=2)\nplt.axvline(best_alpha, color='red', linestyle='--',\n            label=f'Best α = {best_alpha:.5f}')\nplt.xlabel('Ridge Alpha (log scale)')\nplt.ylabel('Average Validation MSE')\nplt.title('Walk-Forward CV: Alpha Selection (Dynamic Splits)')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig('alpha_selection_patched.png', dpi=150, bbox_inches='tight')\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:39:05.973649Z","iopub.execute_input":"2026-05-24T06:39:05.974071Z","iopub.status.idle":"2026-05-24T06:39:07.217699Z","shell.execute_reply.started":"2026-05-24T06:39:05.974024Z","shell.execute_reply":"2026-05-24T06:39:07.216891Z"}},"outputs":[{"name":"stdout","text":"Split preview for different trajectory lengths:\n  n_pairs=9: [{'train': (0, 4), 'val': (4, 6)}, {'train': (0, 6), 'val': (6, 9)}]\n  n_pairs=11: [{'train': (0, 5), 'val': (5, 8)}, {'train': (0, 8), 'val': (8, 11)}]\n  n_pairs=13: [{'train': (0, 6), 'val': (6, 9)}, {'train': (0, 9), 'val': (9, 13)}]\n  n_pairs=15: [{'train': (0, 7), 'val': (7, 11)}, {'train': (0, 11), 'val': (11, 15)}]\n  n_pairs=17: [{'train': (0, 8), 'val': (8, 12)}, {'train': (0, 12), 'val': (12, 17)}]\n\nRunning CV over 13 alphas...\n\n  alpha =    0.00100  |  avg val MSE = 0.029453  (skipped 0 short subjects)\n  alpha =    0.00316  |  avg val MSE = 0.024442  (skipped 0 short subjects)\n  alpha =    0.01000  |  avg val MSE = 0.020169  (skipped 0 short subjects)\n  alpha =    0.03162  |  avg val MSE = 0.017213  (skipped 0 short subjects)\n  alpha =    0.10000  |  avg val MSE = 0.015258  (skipped 0 short subjects)\n  alpha =    0.31623  |  avg val MSE = 0.014468  (skipped 0 short subjects)\n  alpha =    1.00000  |  avg val MSE = 0.015008  (skipped 0 short subjects)\n  alpha =    3.16228  |  avg val MSE = 0.017096  (skipped 0 short subjects)\n  alpha =   10.00000  |  avg val MSE = 0.022788  (skipped 0 short subjects)\n  alpha =   31.62278  |  avg val MSE = 0.034816  (skipped 0 short subjects)\n  alpha =  100.00000  |  avg val MSE = 0.050394  (skipped 0 short subjects)\n  alpha =  316.22777  |  avg val MSE = 0.061551  (skipped 0 short subjects)\n  alpha = 1000.00000  |  avg val MSE = 0.066645  (skipped 0 short subjects)\n\nBest alpha   : 0.31623\nBest val MSE : 0.014468\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":41},{"cell_type":"code","source":"# Cell 1 — Extract Test Subject Latent Trajectories (v7 encoder)\n# ──────────────────────────────────────────────────────────────\n# We already have subject_trajectories (60 train subjects)\n# Now extract trajectories for the 16 held-out test subjects\n\nimport torch\nimport numpy as np\n\nsup_encoder_v7.eval()\n\ntest_trajectories = []   # will hold 16 dicts with 'label' and 'trajectory'\n\nwith torch.no_grad():\n    for adj_seq, label in zip(test_subject_graphs, test_subject_labels):\n\n        z_seq = []\n\n        for t in range(adj_seq.shape[0]):\n            adj_t = torch.tensor(adj_seq[t], dtype=torch.float32).to(DEVICE)\n\n            edge_index = torch.from_numpy(\n                np.array(np.where(adj_t.cpu().numpy()))\n            ).long().to(DEVICE)\n\n            num_nodes = adj_t.shape[0]\n\n            z_t = sup_encoder_v7(edge_index, num_nodes=num_nodes)\n            z_seq.append(z_t.squeeze(0).cpu().numpy())\n\n        trajectory = np.stack(z_seq, axis=0)   # (T, 32)\n\n        test_trajectories.append({\n            'label':      'ASD' if label == 1 else 'TD',\n            'trajectory': trajectory\n        })\n\n# Sanity check\nn_asd = sum(1 for s in test_trajectories if s['label'] == 'ASD')\nn_td  = sum(1 for s in test_trajectories if s['label'] == 'TD')\n\nprint(f\"Test subjects extracted : {len(test_trajectories)}\")\nprint(f\"  ASD : {n_asd}  |  TD : {n_td}\")\nprint(f\"  Trajectory shape : {test_trajectories[0]['trajectory'].shape}\")\nprint(f\"\\nTrain subjects available : {len(subject_trajectories)}\")\nprint(f\"  (using existing subject_trajectories from earlier cells)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:39:07.218805Z","iopub.execute_input":"2026-05-24T06:39:07.219072Z","iopub.status.idle":"2026-05-24T06:39:07.752544Z","shell.execute_reply.started":"2026-05-24T06:39:07.219040Z","shell.execute_reply":"2026-05-24T06:39:07.751551Z"}},"outputs":[{"name":"stdout","text":"Test subjects extracted : 16\n  ASD : 8  |  TD : 8\n  Trajectory shape : (13, 32)\n\nTrain subjects available : 60\n  (using existing subject_trajectories from earlier cells)\n","output_type":"stream"}],"execution_count":42},{"cell_type":"code","source":"# Cell 2 — Define Four Lifting Functions\n# ───────────────────────────────────────\n# Each lifting φ takes a trajectory of shape (T, 32)\n# and returns a lifted trajectory of shape (T, D_lifted)\n#\n# All liftings are STATELESS — they operate timestep by timestep.\n# φ(trajectory) = stack([φ(z_t) for each z_t])\n\nimport numpy as np\nfrom itertools import combinations_with_replacement\n\n# ── Lifting 1: Linear (baseline — identity) ───────────────────\ndef lift_linear(z):\n    \"\"\"\n    φ(z) = z\n    No transformation. This is the baseline — your current v7 result.\n    Output dim: 32\n    \"\"\"\n    return z   # (T, 32) → (T, 32)\n\n\n# ── Lifting 2: Polynomial Degree-2 ────────────────────────────\ndef build_poly_indices(n_dims):\n    \"\"\"\n    Precomputes index pairs (i,j) for all degree-2 monomials z_i * z_j\n    including i==j (squared terms).\n    \n    combinations_with_replacement([0,1,...,31], 2) generates all pairs\n    (i,j) where i <= j — these are the unique degree-2 monomials.\n    \n    Example for n_dims=3:\n      (0,0) → z0²\n      (0,1) → z0*z1\n      (0,2) → z0*z2\n      (1,1) → z1²\n      (1,2) → z1*z2\n      (2,2) → z2²\n    Total: n*(n+1)/2 = 3*4/2 = 6 monomials\n    For n=32: 32*33/2 = 528 monomials\n    \"\"\"\n    return list(combinations_with_replacement(range(n_dims), 2))\n\nPOLY_INDICES = build_poly_indices(32)   # precompute once — 528 pairs\n\ndef lift_polynomial(trajectory):\n    \"\"\"\n    φ(z) = [z, z_i*z_j for all i<=j]\n    Concatenates original features with all degree-2 monomials.\n    \n    Output dim: 32 (linear) + 528 (quadratic) = 560\n    \n    np.einsum explanation:\n    'bi,bj->bij' computes the outer product for each row b:\n      result[b,i,j] = trajectory[b,i] * trajectory[b,j]\n    Then we index with our precomputed pairs to get the upper triangle.\n    \"\"\"\n    T = trajectory.shape[0]\n\n    # Compute all pairwise products at once using broadcasting\n    # trajectory[:, :, None] shape: (T, 32, 1)\n    # trajectory[:, None, :] shape: (T, 1, 32)\n    # product shape: (T, 32, 32)\n    outer = trajectory[:, :, None] * trajectory[:, None, :]  # (T, 32, 32)\n\n    # Extract upper triangle (i <= j) using precomputed indices\n    i_idx = [p[0] for p in POLY_INDICES]\n    j_idx = [p[1] for p in POLY_INDICES]\n    quad_features = outer[:, i_idx, j_idx]   # (T, 528)\n\n    # Concatenate linear + quadratic features\n    # np.concatenate joins arrays along an existing axis\n    return np.concatenate([trajectory, quad_features], axis=1)  # (T, 560)\n\n\n# ── Lifting 3: RBF / Random Fourier Features ──────────────────\n# Bochner's theorem: any stationary kernel k(x,y) = k(x-y) can be\n# approximated by random Fourier features.\n# For the RBF kernel k(x,y) = exp(-γ||x-y||²):\n#   φ(z) = sqrt(2/D) * cos(Ω z + b)\n# where Ω ~ N(0, γ²I) and b ~ Uniform(0, 2π)\n#\n# This approximates a kernel inner product without computing it exactly:\n#   φ(x)ᵀφ(y) ≈ k(x,y)\n#\n# Key property: these are FIXED random features — no training needed.\n# Different random seeds give different (but equivalent) approximations.\n\nRBF_DIM   = 128    # number of random features\nRBF_GAMMA = 1.0    # kernel bandwidth — controls how quickly similarity decays\nRNG       = np.random.RandomState(42)   # fixed seed for reproducibility\n\n# Sample random frequencies from N(0, γ²I)\nOMEGA = RNG.randn(32, RBF_DIM) * RBF_GAMMA   # (32, 128)\n# Sample random phases from Uniform(0, 2π)\nBIAS  = RNG.uniform(0, 2 * np.pi, RBF_DIM)   # (128,)\n\ndef lift_rbf(trajectory):\n    \"\"\"\n    φ(z) = sqrt(2/D) * cos(Ω^T z + b)\n    \n    trajectory @ OMEGA : (T, 32) @ (32, 128) = (T, 128)\n    Adding BIAS broadcasts across T rows.\n    np.cos applies elementwise.\n    \n    Output dim: 128\n    \"\"\"\n    projection = trajectory @ OMEGA + BIAS    # (T, 128)\n    return np.sqrt(2.0 / RBF_DIM) * np.cos(projection)   # (T, 128)\n\n\n# ── Lifting 4: Learned MLP (placeholder — trained in Cell 3) ──\n# Defined here as a PyTorch module.\n# Architecture: 32 → 64 → 64 with tanh activation\n# tanh chosen over ReLU because:\n#   - ReLU produces piecewise-linear features → similar to polynomial\n#   - tanh produces smooth nonlinear features → closer to RBF character\n#     but data-adaptive (trained to maximize linear predictability)\n\nimport torch\nimport torch.nn as nn\n\nclass KoopmanLifting(nn.Module):\n    \"\"\"\n    Small MLP that learns to lift z_t into a space\n    where linear dynamics K are most predictable.\n    \n    Training objective: minimize ||φ(z_{t+1}) - K φ(z_t)||²\n    Both φ (this MLP) and K (a linear layer) are trained jointly.\n    \"\"\"\n    def __init__(self, input_dim=32, lifted_dim=64):\n        super().__init__()\n\n        # nn.Sequential chains layers in order:\n        # input → Linear(32,64) → Tanh → Linear(64,64) → Tanh\n        self.phi = nn.Sequential(\n            nn.Linear(input_dim, lifted_dim),\n            nn.Tanh(),\n            nn.Linear(lifted_dim, lifted_dim),\n            nn.Tanh()\n        )\n\n        # Linear Koopman operator in lifted space\n        # bias=False enforces strict z_{t+1} = K z_t structure\n        self.K = nn.Linear(lifted_dim, lifted_dim, bias=False)\n\n    def forward(self, z_seq):\n        \"\"\"\n        z_seq : (T, 32) tensor — one subject's latent trajectory\n        Returns lifted trajectory φ(z_seq) of shape (T, 64)\n        \"\"\"\n        return self.phi(z_seq)   # (T, 64)\n\n    def dynamics_loss(self, z_seq):\n        \"\"\"\n        Computes ||φ(z_{t+1}) - K φ(z_t)||² averaged over timesteps.\n        This is the training signal — forces lifted space to be\n        linearly predictable.\n        \"\"\"\n        phi_seq  = self.phi(z_seq)          # (T, 64)\n        phi_curr = phi_seq[:-1]             # (T-1, 64) — φ(z_t)\n        phi_next = phi_seq[1:]              # (T-1, 64) — φ(z_{t+1})\n        pred     = self.K(phi_curr)         # (T-1, 64) — K φ(z_t)\n\n        # Mean squared error over all timesteps and lifted dims\n        return torch.mean((pred - phi_next) ** 2)\n\n\n# ── Sanity check all liftings on one trajectory ───────────────\nsample_traj = subject_trajectories[0]['trajectory']   # (T, 32)\nsample_tensor = torch.tensor(sample_traj, dtype=torch.float32)\nmlp_lifting = KoopmanLifting(input_dim=32, lifted_dim=64)   # untrained\n\nprint(\"Lifting output dimensions (on one trajectory):\")\nprint(f\"  Linear     : {lift_linear(sample_traj).shape}\")\nprint(f\"  Polynomial : {lift_polynomial(sample_traj).shape}\")\nprint(f\"  RBF        : {lift_rbf(sample_traj).shape}\")\nprint(f\"  MLP        : {mlp_lifting(sample_tensor).detach().numpy().shape}\")\nprint(f\"\\nAll liftings operate on (T=17, 32) → (T, D_lifted)\")\nprint(f\"Next: Cell 3 trains the MLP lifting, Cell 4 fits K for all methods\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:39:07.753862Z","iopub.execute_input":"2026-05-24T06:39:07.754274Z","iopub.status.idle":"2026-05-24T06:39:07.781781Z","shell.execute_reply.started":"2026-05-24T06:39:07.754223Z","shell.execute_reply":"2026-05-24T06:39:07.780926Z"}},"outputs":[{"name":"stdout","text":"Lifting output dimensions (on one trajectory):\n  Linear     : (17, 32)\n  Polynomial : (17, 560)\n  RBF        : (17, 128)\n  MLP        : (17, 64)\n\nAll liftings operate on (T=17, 32) → (T, D_lifted)\nNext: Cell 3 trains the MLP lifting, Cell 4 fits K for all methods\n","output_type":"stream"}],"execution_count":43},{"cell_type":"code","source":"# Cell 3 — Train MLP Lifting on Train Subjects Only\n# ──────────────────────────────────────────────────\n# Goal: find φ (the MLP) such that the lifted space z̃_t = φ(z_t)\n# is as linearly predictable as possible.\n#\n# Training objective: min_{φ, K} Σ_subjects Σ_t ||φ(z_{t+1}) - K·φ(z_t)||²\n#\n# IMPORTANT:\n# - Only train subjects are used here\n# - Test subjects are never touched until Cell 5 (evaluation)\n# - Both φ and K are trained jointly — they co-adapt\n# - The v7 encoder is completely frozen — we never backprop into it\n\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport numpy as np\n\n# ── Hyperparameters ───────────────────────────────────────────\nMLP_LIFTED_DIM = 64\nMLP_LR         = 1e-3\nMLP_EPOCHS     = 300\nMLP_SEED       = 42\n\ntorch.manual_seed(MLP_SEED)\nnp.random.seed(MLP_SEED)\n\n# ── Initialize model ──────────────────────────────────────────\nmlp_lifting = KoopmanLifting(input_dim=32, lifted_dim=MLP_LIFTED_DIM).to(DEVICE)\n\n# Adam optimizer explanation:\n# Adaptive learning rate optimizer — adjusts step size per parameter\n# based on running estimates of gradient mean and variance.\n# Generally more stable than plain SGD for small datasets.\noptimizer = optim.Adam(mlp_lifting.parameters(), lr=MLP_LR)\n\n# ── Prepare training data ─────────────────────────────────────\n# Convert all train trajectories to tensors once — avoids repeated\n# conversion inside the training loop\ntrain_tensors = [\n    torch.tensor(s['trajectory'], dtype=torch.float32).to(DEVICE)\n    for s in subject_trajectories   # 60 train subjects\n]\n\n# ── Training loop ─────────────────────────────────────────────\nprint(f\"Training MLP lifting on {len(train_tensors)} subjects for {MLP_EPOCHS} epochs\")\nprint(f\"Architecture: 32 → 64 → 64 (tanh) | Lifted dim: {MLP_LIFTED_DIM}\\n\")\n\nloss_history = []\n\nfor epoch in range(MLP_EPOCHS):\n    mlp_lifting.train()   # enable training mode\n    optimizer.zero_grad() # clear gradients from previous epoch\n\n    # Full-batch: accumulate loss across ALL subjects before stepping.\n    # Same principle as ABIDE v5 training — with 60 subjects,\n    # full-batch gives a stable gradient estimate.\n    total_loss = 0.0\n\n    for z_seq in train_tensors:\n        # z_seq shape: (T, 32)\n        # dynamics_loss computes ||φ(z_{t+1}) - K·φ(z_t)||²\n        loss = mlp_lifting.dynamics_loss(z_seq)\n        total_loss += loss\n\n    # Average loss across subjects so magnitude doesn't scale with dataset size\n    avg_loss = total_loss / len(train_tensors)\n\n    # Backpropagate and update\n    avg_loss.backward()\n    optimizer.step()\n\n    loss_history.append(avg_loss.item())\n\n    if epoch % 50 == 0 or epoch == MLP_EPOCHS - 1:\n        print(f\"  Epoch {epoch:>4} | Loss: {avg_loss.item():.6f}\")\n\n# ── Plot training curve ───────────────────────────────────────\nimport matplotlib.pyplot as plt\n\nplt.figure(figsize=(8, 3))\nplt.plot(loss_history, color='steelblue', linewidth=1.5)\nplt.xlabel('Epoch')\nplt.ylabel('Avg Dynamics Loss ||φ(z_{t+1}) - K·φ(z_t)||²')\nplt.title('MLP Lifting Training Curve')\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig('mlp_lifting_training.png', dpi=150, bbox_inches='tight')\nplt.show()\n\nprint(f\"\\nFinal training loss : {loss_history[-1]:.6f}\")\nprint(f\"Initial loss        : {loss_history[0]:.6f}\")\nprint(f\"Reduction           : {(1 - loss_history[-1]/loss_history[0])*100:.1f}%\")\n\n# ── Extract MLP lifting function for Cell 4 ───────────────────\n# Wrap in a callable that takes numpy (T,32) → numpy (T,64)\n# matching the interface of lift_linear, lift_polynomial, lift_rbf\n\nmlp_lifting.eval()\n\ndef lift_mlp(trajectory):\n    \"\"\"\n    φ_MLP(z) — trained lifting.\n    trajectory : numpy (T, 32)\n    returns    : numpy (T, 64)\n    \"\"\"\n    with torch.no_grad():\n        z_tensor = torch.tensor(trajectory, dtype=torch.float32).to(DEVICE)\n        lifted   = mlp_lifting(z_tensor)      # (T, 64)\n        return lifted.cpu().numpy()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:39:07.782928Z","iopub.execute_input":"2026-05-24T06:39:07.783341Z","iopub.status.idle":"2026-05-24T06:39:14.979819Z","shell.execute_reply.started":"2026-05-24T06:39:07.783272Z","shell.execute_reply":"2026-05-24T06:39:14.978916Z"}},"outputs":[{"name":"stdout","text":"Training MLP lifting on 60 subjects for 300 epochs\nArchitecture: 32 → 64 → 64 (tanh) | Lifted dim: 64\n\n  Epoch    0 | Loss: 0.012289\n  Epoch   50 | Loss: 0.000038\n  Epoch  100 | Loss: 0.000006\n  Epoch  150 | Loss: 0.000003\n  Epoch  200 | Loss: 0.000002\n  Epoch  250 | Loss: 0.000002\n  Epoch  299 | Loss: 0.000002\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 800x300 with 1 Axes>","image/png":"\n"},"metadata":{}},{"name":"stdout","text":"\nFinal training loss : 0.000002\nInitial loss        : 0.012289\nReduction           : 100.0%\n","output_type":"stream"}],"execution_count":44},{"cell_type":"code","source":"# Cell 4 — Fit Global K for Each Lifting + Compute Train R²\n# ──────────────────────────────────────────────────────────\n# For each lifting φ:\n#   1. Lift all 60 train trajectories → (T, D_lifted)\n#   2. Apply PCA if D_lifted > 64 (Polynomial=560, RBF=128)\n#   3. Stack all (z_t, z_{t+1}) pairs across all subjects\n#   4. Fit K via Ridge regression\n#   5. Compute R² on training data\n#\n# PCA is fit on TRAIN data only — never on test data.\n\nimport numpy as np\nfrom numpy.linalg import lstsq\nfrom sklearn.decomposition import PCA\nfrom sklearn.preprocessing import StandardScaler\n\nRIDGE_ALPHA  = 1.0\nPCA_DIM      = 64     # target dimension after PCA for poly and RBF\n\ndef fit_ridge_K(Z_in, Z_out, alpha=1.0):\n    \"\"\"\n    Fit K via Ridge regression: Z_out ≈ Z_in @ K.T\n    Z_in  : (N, D) — current lifted states\n    Z_out : (N, D) — next lifted states\n    Returns K of shape (D, D)\n    \"\"\"\n    n  = Z_in.shape[1]\n    sa = np.sqrt(alpha)\n    Za = np.vstack([Z_in,  sa * np.eye(n)])\n    Zb = np.vstack([Z_out, np.zeros((n, n))])\n    Kt, _, _, _ = lstsq(Za, Zb, rcond=None)\n    return Kt.T   # (D, D)\n\ndef compute_r2(K, Z_in, Z_out):\n    \"\"\"\n    R² = 1 - SS_res / SS_tot\n    SS_res: sum of squared residuals from K prediction\n    SS_tot: sum of squared deviations from mean (baseline)\n\n    R² = 1.0  → perfect linear prediction\n    R² = 0.0  → no better than predicting the mean\n    R² < 0.0  → worse than predicting the mean (active harm)\n    \"\"\"\n    Z_pred  = Z_in @ K.T                          # (N, D)\n    SS_res  = np.sum((Z_out - Z_pred) ** 2)\n    SS_tot  = np.sum((Z_out - Z_out.mean(axis=0)) ** 2)\n    return 1.0 - SS_res / SS_tot\n\ndef collect_pairs(trajectories, lift_fn):\n    \"\"\"\n    Apply lift_fn to each subject's trajectory and collect\n    consecutive (z_t, z_{t+1}) pairs.\n\n    Returns:\n      Z_in  : (N_total, D) — all current lifted states\n      Z_out : (N_total, D) — all next lifted states\n    \"\"\"\n    Z_in_list  = []\n    Z_out_list = []\n\n    for subject in trajectories:\n        traj   = subject['trajectory']       # (T, 32)\n        lifted = lift_fn(traj)               # (T, D_lifted)\n        Z_in_list.append(lifted[:-1])        # (T-1, D_lifted)\n        Z_out_list.append(lifted[1:])        # (T-1, D_lifted)\n\n    return (np.vstack(Z_in_list),    # (N_total, D_lifted)\n            np.vstack(Z_out_list))   # (N_total, D_lifted)\n\n# ── Results storage ───────────────────────────────────────────\nlifting_results = {}   # keyed by method name\n\n# ── Method configs ────────────────────────────────────────────\n# Each entry: (name, lift_fn, needs_pca, pca_dim)\nMETHODS = [\n    ('Linear',     lift_linear,     False, None),\n    ('Polynomial', lift_polynomial, True,  PCA_DIM),\n    ('RBF',        lift_rbf,        True,  PCA_DIM),\n    ('MLP',        lift_mlp,        False, None),\n]\n\nprint(\"Fitting K for each lifting method on 60 train subjects\")\nprint(\"=\"*55)\n\nfor name, lift_fn, needs_pca, pca_dim in METHODS:\n\n    print(f\"\\n[{name}]\")\n\n    # ── Step 1: Lift train trajectories ───────────────────────\n    Z_in_train, Z_out_train = collect_pairs(subject_trajectories, lift_fn)\n    print(f\"  Lifted train pairs shape : {Z_in_train.shape}\")\n\n    # ── Step 2: PCA if needed ─────────────────────────────────\n    pca = None\n    if needs_pca:\n        # Fit PCA on training data only\n        # StandardScaler normalizes each feature to zero mean,\n        # unit variance before PCA — important when features\n        # have very different scales (polynomial features can be\n        # much larger than linear features)\n        scaler = StandardScaler()\n        Z_in_scaled = scaler.fit_transform(Z_in_train)\n\n        pca = PCA(n_components=pca_dim, random_state=42)\n        # fit_transform: fit PCA on training data AND transform it\n        # This learns the principal components from training data only\n        Z_in_train  = pca.fit_transform(Z_in_scaled)\n\n        # Transform Z_out using the SAME scaler and PCA\n        # (fitted on Z_in — consistent projection)\n        Z_out_train = pca.transform(scaler.transform(Z_out_train))\n\n        var_explained = pca.explained_variance_ratio_.sum()\n        print(f\"  PCA: {Z_in_train.shape[1]}D | \"\n              f\"Variance explained: {var_explained:.3f}\")\n    else:\n        scaler = None\n\n    # ── Step 3: Fit K ─────────────────────────────────────────\n    K = fit_ridge_K(Z_in_train, Z_out_train, alpha=RIDGE_ALPHA)\n    print(f\"  K shape : {K.shape}\")\n\n    # ── Step 4: Train R² ──────────────────────────────────────\n    r2_train = compute_r2(K, Z_in_train, Z_out_train)\n    print(f\"  Train R² : {r2_train:.4f}\")\n\n    # ── Store everything needed for test evaluation ───────────\n    lifting_results[name] = {\n        'lift_fn'  : lift_fn,\n        'pca'      : pca,\n        'scaler'   : scaler,\n        'K'        : K,\n        'r2_train' : r2_train,\n        'needs_pca': needs_pca,\n    }\n\nprint(\"\\n\" + \"=\"*55)\nprint(\"Train R² Summary:\")\nfor name, res in lifting_results.items():\n    print(f\"  {name:<12} : {res['r2_train']:.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:39:14.980865Z","iopub.execute_input":"2026-05-24T06:39:14.981149Z","iopub.status.idle":"2026-05-24T06:39:15.741926Z","shell.execute_reply.started":"2026-05-24T06:39:14.981105Z","shell.execute_reply":"2026-05-24T06:39:15.741139Z"}},"outputs":[{"name":"stdout","text":"Fitting K for each lifting method on 60 train subjects\n=======================================================\n\n[Linear]\n  Lifted train pairs shape : (902, 32)\n  K shape : (32, 32)\n  Train R² : 0.5401\n\n[Polynomial]\n  Lifted train pairs shape : (902, 560)\n  PCA: 64D | Variance explained: 1.000\n  K shape : (64, 64)\n  Train R² : 0.5249\n\n[RBF]\n  Lifted train pairs shape : (902, 128)\n  PCA: 64D | Variance explained: 1.000\n  K shape : (64, 64)\n  Train R² : 0.4644\n\n[MLP]\n  Lifted train pairs shape : (902, 64)\n  K shape : (64, 64)\n  Train R² : -0.2257\n\n=======================================================\nTrain R² Summary:\n  Linear       : 0.5401\n  Polynomial   : 0.5249\n  RBF          : 0.4644\n  MLP          : -0.2257\n","output_type":"stream"}],"execution_count":45},{"cell_type":"code","source":"# Cell 5 — Evaluate Global K on Unseen Test Subjects\n# ──────────────────────────────────────────────────────────\n# For each lifting method:\n#   1. Lift all test trajectories\n#   2. Apply the SAME scaler and SAME PCA mapping fit on train data\n#   3. Use the pre-computed K matrix to predict z_{t+1}\n#   4. Compute Test R²\n\nprint(\"Evaluating pre-fitted K on test subjects\")\nprint(\"=\"*55)\n\ntest_results = {}\n\nfor name, config in lifting_results.items():\n    print(f\"\\n[{name}]\")\n    \n    # ── Step 1: Lift test trajectories ────────────────────────\n    # FIX: Changed variable name to match your workspace variable `test_trajectories.`\n    Z_in_test, Z_out_test = collect_pairs(test_trajectories, config['lift_fn'])\n    print(f\"  Lifted test pairs shape : {Z_in_test.shape}\")\n    \n    # ── Step 2: Apply matching preprocessing ──────────────────\n    if config['needs_pca']:\n        # NEVER fit on test data. Transform using the train-fitted scaler and PCA.\n        Z_in_test_scaled = config['scaler'].transform(Z_in_test)\n        Z_in_test        = config['pca'].transform(Z_in_test_scaled)\n        \n        # Transform output states symmetrically\n        Z_out_test_scaled = config['scaler'].transform(Z_out_test)\n        Z_out_test        = config['pca'].transform(Z_out_test_scaled)\n        print(f\"  Projected test shape    : {Z_in_test.shape}\")\n        \n    # ── Step 3: Evaluate with pre-computed K ──────────────────\n    K = config['K']\n    r2_test = compute_r2(K, Z_in_test, Z_out_test)\n    print(f\"  Test R²  : {r2_test:.4f}\")\n    \n    test_results[name] = r2_test\n\nprint(\"\\n\" + \"=\"*55)\nprint(f\"{'Method':<12} | {'Train R²':>10} | {'Test R²':>10}\")\nprint(\"-\"*55)\nfor name in lifting_results.keys():\n    train_r2 = lifting_results[name]['r2_train']\n    test_r2  = test_results[name]\n    print(f\"{name:<12} | {train_r2:10.4f} | {test_r2:10.4f}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T07:46:11.491376Z","iopub.execute_input":"2026-05-24T07:46:11.491761Z","iopub.status.idle":"2026-05-24T07:46:11.518885Z","shell.execute_reply.started":"2026-05-24T07:46:11.491704Z","shell.execute_reply":"2026-05-24T07:46:11.518104Z"}},"outputs":[{"name":"stdout","text":"Evaluating pre-fitted K on test subjects\n=======================================================\n\n[Linear]\n  Lifted test pairs shape : (244, 32)\n  Test R²  : 0.4695\n\n[Polynomial]\n  Lifted test pairs shape : (244, 560)\n  Projected test shape    : (244, 64)\n  Test R²  : 0.3475\n\n[RBF]\n  Lifted test pairs shape : (244, 128)\n  Projected test shape    : (244, 64)\n  Test R²  : 0.3047\n\n[MLP]\n  Lifted test pairs shape : (244, 64)\n  Test R²  : -0.2386\n\n=======================================================\nMethod       |   Train R² |    Test R²\n-------------------------------------------------------\nLinear       |     0.5401 |     0.4695\nPolynomial   |     0.5249 |     0.3475\nRBF          |     0.4644 |     0.3047\nMLP          |    -0.2257 |    -0.2386\n","output_type":"stream"}],"execution_count":48},{"cell_type":"code","source":"# Cell 5 — Full Evaluation: Test R², Rollout MSE, FDR, and Spectral Dynamics\n# ───────────────────────────────────────────────────────────────────────────\n# All metrics computed on TEST subjects only.\n# Global K was fitted on train subjects in Cell 4 — never touched test data.\n\nimport numpy as np\nfrom scipy.stats import mannwhitneyu\nfrom numpy.linalg import lstsq\n\ndef apply_lifting_and_pca(trajectories, lift_fn, pca, scaler, needs_pca):\n    \"\"\"\n    Apply lifting + optional PCA projection to a list of trajectories.\n    Returns list of lifted trajectories, one per subject.\n    PCA and scaler must already be fitted (from Cell 4 train data).\n    \"\"\"\n    lifted_list = []\n    for subject in trajectories:\n        traj   = subject['trajectory']    # (T, 32)\n        lifted = lift_fn(traj)            # (T, D_lifted)\n\n        if needs_pca:\n            lifted = pca.transform(scaler.transform(lifted))  # (T, 64)\n\n        lifted_list.append({\n            'label'    : subject['label'],\n            'lifted'   : lifted            # (T, D)\n        })\n    return lifted_list\n\ndef compute_rollout_mse(K, lifted_traj, n_steps=10):\n    \"\"\"\n    Pure autoregressive rollout: ẑ_{t+k} = K^k · ẑ_t\n    Starting from z_0, predict n_steps ahead using K repeatedly.\n    MSE averaged over all steps and all latent dims.\n    \"\"\"\n    z0      = lifted_traj[0]       # (D,) — seed state\n    T       = lifted_traj.shape[0]\n    n_steps = min(n_steps, T - 1)  # can't predict beyond available data\n\n    mses = []\n    z_pred = z0.copy()\n\n    for step in range(1, n_steps + 1):\n        z_pred = K @ z_pred                                # one step forward\n        z_true = lifted_traj[step]                         # ground truth\n        mse    = np.mean((z_pred - z_true) ** 2)\n        mses.append(mse)\n\n    return np.mean(mses)   # average MSE across all steps\n\ndef compute_fdr(lifted_subjects):\n    \"\"\"\n    Fisher's Discriminant Ratio:\n      FDR = ||μ_ASD - μ_TD||² / (σ²_ASD + σ²_TD)\n    Measures downstream group clinical separability in the lifted geometry.\n    \"\"\"\n    asd_means = []\n    td_means  = []\n\n    for s in lifted_subjects:\n        mean_z = s['lifted'].mean(axis=0)   # (D,)\n        if s['label'] == 'ASD':\n            asd_means.append(mean_z)\n        else:\n            td_means.append(mean_z)\n\n    if len(asd_means) == 0 or len(td_means) == 0:\n        return 0.0\n\n    asd_means = np.array(asd_means)   # (n_ASD, D)\n    td_means  = np.array(td_means)    # (n_TD,  D)\n\n    mu_asd = asd_means.mean(axis=0)   # (D,)\n    mu_td  = td_means.mean(axis=0)    # (D,)\n\n    between = np.sum((mu_asd - mu_td) ** 2)\n    var_asd = np.var(asd_means, axis=0).mean()\n    var_td  = np.var(td_means,  axis=0).mean()\n\n    if var_asd + var_td < 1e-10:\n        return 0.0\n\n    return between / (var_asd + var_td)\n\ndef compute_spectral_metrics(lifted_subjects, ridge_alpha=1.0):\n    \"\"\"\n    Fits subject-specific operators K_i to extract spectral biomarkers.\n    Spectral smoothness: low variance across subjects = stable dynamics.\n    Spectral diversity: high variance across subjects = personalized signatures.\n    \"\"\"\n    max_mags  = []\n    dom_freqs = []\n\n    for subject in lifted_subjects:\n        lifted = subject['lifted']   # (T, D)\n        Z      = lifted[:-1]         # (T-1, D)\n        Z_     = lifted[1:]          # (T-1, D)\n\n        n = Z.shape[1]\n        sa = np.sqrt(ridge_alpha)\n        Za = np.vstack([Z,  sa * np.eye(n)])\n        Zb = np.vstack([Z_, np.zeros((n, n))])\n        Ki_T, _, _, _ = lstsq(Za, Zb, rcond=None)\n        Ki = Ki_T.T   # (D, D)\n\n        evals = np.linalg.eigvals(Ki)                  # (D,) complex\n        mags  = np.abs(evals)                          # (D,) real\n        freqs = np.abs(np.angle(evals)) / (2 * np.pi)  # (D,) real\n\n        max_mags.append(mags.max())\n        dom_freqs.append(freqs[mags.argmax()])\n\n    max_mags  = np.array(max_mags)\n    dom_freqs = np.array(dom_freqs)\n\n    return {\n        'spectral_smoothness' : np.var(max_mags),   # low = smooth\n        'spectral_diversity'  : np.var(dom_freqs),  # high = individual\n    }\n\n# ── Run full evaluation on test subjects ──────────────────────\nprint(\"Full Multi-Metric Evaluation on 16 Test Subjects\")\nprint(\"=\"*65)\n\nfull_results = {}\n\nfor name, res in lifting_results.items():\n    print(f\"\\n[{name}]\")\n\n    lift_fn   = res['lift_fn']\n    pca       = res['pca']\n    scaler    = res['scaler']\n    K         = res['K']\n    needs_pca = res['needs_pca']\n\n    # 1. Apply lifting + matching PCA to test subjects\n    test_lifted = apply_lifting_and_pca(\n        test_trajectories, lift_fn, pca, scaler, needs_pca\n    )\n    \n    # Extract stacked arrays for single-step test R² evaluation\n    Z_in_list, Z_out_list = [], []\n    for s in test_lifted:\n        Z_in_list.append(s['lifted'][:-1])\n        Z_out_list.append(s['lifted'][1:])\n    Z_in_test  = np.vstack(Z_in_list)\n    Z_out_test = np.vstack(Z_out_list)\n\n    # 2. Compute Single-Step Test R²\n    r2_test = compute_r2(K, Z_in_test, Z_out_test)\n\n    # 3. Compute Multi-Step Rollout MSE\n    rollout_mses = [\n        compute_rollout_mse(K, s['lifted'], n_steps=10)\n        for s in test_lifted\n    ]\n    avg_rollout_mse = np.mean(rollout_mses)\n\n    # 4. Compute Fisher's Discriminant Ratio\n    fdr = compute_fdr(test_lifted)\n\n    # 5. Compute Subject-Specific Spectral Profiles\n    spectral = compute_spectral_metrics(test_lifted, ridge_alpha=RIDGE_ALPHA)\n\n    print(f\"  Test R²               : {r2_test:.4f}\")\n    print(f\"  Rollout MSE (10 steps): {avg_rollout_mse:.6f}\")\n    print(f\"  FDR (Separability)    : {fdr:.4f}\")\n    print(f\"  Spectral Smoothness   : {spectral['spectral_smoothness']:.6f} (lower = smoother)\")\n    print(f\"  Spectral Diversity    : {spectral['spectral_diversity']:.6f} (higher = more individual)\")\n\n    full_results[name] = {\n        'r2_test'             : r2_test,\n        'rollout_mse'         : avg_rollout_mse,\n        'fdr'                 : fdr,\n        'spectral_smoothness' : spectral['spectral_smoothness'],\n        'spectral_diversity'  : spectral['spectral_diversity'],\n    }\n\n# ── Final Comprehensive Summary Table ───────────────────────────────────────\nprint(\"\\n\" + \"=\"*80)\nprint(f\"{'Method':<12} | {'Test R²':>8} | {'Rollout MSE':>11} | \"\n      f\"{'FDR':>7} | {'Spec.Smooth':>11} | {'Spec.Div':>9}\")\nprint(\"-\"*80)\n\nfor name, res in full_results.items():\n    print(f\"{name:<12} | {res['r2_test']:>8.4f} | {res['rollout_mse']:>11.6f} | \"\n          f\"{res['fdr']:>7.4f} | {res['spectral_smoothness']:>11.6f} | \"\n          f\"{res['spectral_diversity']:>9.6f}\")\nprint(\"=\"*80)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T09:03:44.141969Z","iopub.execute_input":"2026-05-24T09:03:44.142465Z","iopub.status.idle":"2026-05-24T09:03:44.516257Z","shell.execute_reply.started":"2026-05-24T09:03:44.142408Z","shell.execute_reply":"2026-05-24T09:03:44.515397Z"}},"outputs":[{"name":"stdout","text":"Full Multi-Metric Evaluation on 16 Test Subjects\n=================================================================\n\n[Linear]\n  Test R²               : 0.4695\n  Rollout MSE (10 steps): 0.017787\n  FDR (Separability)    : 3.3904\n  Spectral Smoothness   : 0.012113 (lower = smoother)\n  Spectral Diversity    : 0.000000 (higher = more individual)\n\n[Polynomial]\n  Test R²               : 0.3475\n  Rollout MSE (10 steps): 4.455261\n  FDR (Separability)    : 12.1573\n  Spectral Smoothness   : 0.004302 (lower = smoother)\n  Spectral Diversity    : 0.001113 (higher = more individual)\n\n[RBF]\n  Test R²               : 0.3047\n  Rollout MSE (10 steps): 1.483575\n  FDR (Separability)    : 10.6345\n  Spectral Smoothness   : 0.001556 (lower = smoother)\n  Spectral Diversity    : 0.001592 (higher = more individual)\n\n[MLP]\n  Test R²               : -0.2386\n  Rollout MSE (10 steps): 0.000012\n  FDR (Separability)    : 9.9516\n  Spectral Smoothness   : 0.000565 (lower = smoother)\n  Spectral Diversity    : 0.000000 (higher = more individual)\n\n================================================================================\nMethod       |  Test R² | Rollout MSE |     FDR | Spec.Smooth |  Spec.Div\n--------------------------------------------------------------------------------\nLinear       |   0.4695 |    0.017787 |  3.3904 |    0.012113 |  0.000000\nPolynomial   |   0.3475 |    4.455261 | 12.1573 |    0.004302 |  0.001113\nRBF          |   0.3047 |    1.483575 | 10.6345 |    0.001556 |  0.001592\nMLP          |  -0.2386 |    0.000012 |  9.9516 |    0.000565 |  0.000000\n================================================================================\n","output_type":"stream"}],"execution_count":52},{"cell_type":"code","source":"# Cell 6 — Extract Spectral Biomarkers & Train Downstream Classifier\n# ──────────────────────────────────────────────────────────────────\n# 1. Fit subject-specific K_i in the raw 32D Linear space for all train/test subjects.\n# 2. Extract spectral features: magnitude (damping) & phase angle (frequency).\n# 3. Flatten these into feature vectors per subject.\n# 4. Train a Logistic Regression model on Train subjects and evaluate on Test subjects.\n\nimport numpy as np\nfrom numpy.linalg import lstsq, eigvals\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import roc_auc_score, f1_score, classification_report\n\ndef extract_spectral_features(subjects_list, ridge_alpha=1.0):\n    \"\"\"\n    Fits per-subject K_i and extracts magnitude/phase features from eigenvalues.\n    \"\"\"\n    X_features = []\n    y_labels   = []\n    \n    for subject in subjects_list:\n        # Use either 'trajectory' (raw train format) or 'lifted' (processed test format)\n        traj = subject.get('trajectory', subject.get('lifted'))\n        \n        # Split into current and next pairs\n        Z  = traj[:-1]  # (T-1, 32)\n        Z_ = traj[1:]   # (T-1, 32)\n        \n        # Fit subject-specific K_i via Ridge Regression\n        n = Z.shape[1]\n        sa = np.sqrt(ridge_alpha)\n        Za = np.vstack([Z,  sa * np.eye(n)])\n        Zb = np.vstack([Z_, np.zeros((n, n))])\n        Ki_T, _, _, _ = lstsq(Za, Zb, rcond=None)\n        Ki = Ki_T.T  # (32, 32)\n        \n        # Compute Complex Eigenvalues\n        evals = eigvals(Ki)  # (32,) complex numbers\n        \n        # Extract Magnitudes (|λ|) and Frequencies (Phase angles scaled to [0, 0.5])\n        mags  = np.abs(evals)\n        freqs = np.abs(np.angle(evals)) / (2 * np.pi)\n        \n        # Sort features so they line up consistently across subjects (e.g., by frequency)\n        sort_idx = np.argsort(freqs)\n        sorted_mags  = mags[sort_idx]\n        sorted_freqs = freqs[sort_idx]\n        \n        # Concatenate both arrays into a single subject feature vector\n        # (Alternatively, you can include the trajectory mean, but let's stick to pure dynamics first)\n        feat_vector = np.concatenate([sorted_mags, sorted_freqs]) # Length 64 feature vector\n        \n        X_features.append(feat_vector)\n        y_labels.append(1 if subject['label'] == 'ASD' else 0)\n        \n    return np.array(X_features), np.array(y_labels)\n\n# ── Step 1: Extract features from Train and Test sets ───────────────\nprint(\"Extracting spectral biomarkers from trajectories...\")\n# `subject_trajectories` contains the 60 training subjects\nX_train, y_train = extract_spectral_features(subject_trajectories, ridge_alpha=RIDGE_ALPHA)\n# `test_trajectories` contains the 16 test subjects\nX_test, y_test   = extract_spectral_features(test_trajectories, ridge_alpha=RIDGE_ALPHA)\n\nprint(f\"  Train features shape : {X_train.shape} (60 subjects, 64 features)\")\nprint(f\"  Test features shape  : {X_test.shape}  (16 subjects, 64 features)\")\n\n# ── Step 2: Scale and Normalize Features ───────────────────────────\n# Crucial: Fit the scaler on Train features only, then transform Test\nscaler  = StandardScaler()\nX_train_scaled = scaler.fit_transform(X_train)\nX_test_scaled  = scaler.transform(X_test)\n\n# ── Step 3: Train Downstream Classifier ───────────────────────────\n# Using L2 regularized Logistic Regression (C=1.0 balanced weights)\nclf = LogisticRegression(C=1.0, class_weight='balanced', random_state=42)\nclf.fit(X_train_scaled, y_train)\n\n# ── Step 4: Evaluate Model Performance ────────────────────────────\ny_pred_proba = clf.predict_proba(X_test_scaled)[:, 1]\ny_pred       = clf.predict(X_test_scaled)\n\n# Metrics\ntest_auc = roc_auc_score(y_test, y_pred_proba)\ntest_f1  = f1_score(y_test, y_pred, average='binary')\n\nprint(\"\\n\" + \"=\"*55)\nprint(\"DOWNSTREAM CLASSIFICATION RESULTS (Linear Koopman Space)\")\nprint(\"=\"*55)\nprint(f\"Test AUC-ROC : {test_auc:.4f}\")\nprint(f\"Test F1-Score : {test_f1:.4f}\")\nprint(\"\\nClassification Report:\")\nprint(classification_report(y_test, y_pred, target_names=['TD', 'ASD']))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T09:03:50.735135Z","iopub.execute_input":"2026-05-24T09:03:50.736021Z","iopub.status.idle":"2026-05-24T09:03:50.813765Z","shell.execute_reply.started":"2026-05-24T09:03:50.735982Z","shell.execute_reply":"2026-05-24T09:03:50.813007Z"}},"outputs":[{"name":"stdout","text":"Extracting spectral biomarkers from trajectories...\n  Train features shape : (60, 64) (60 subjects, 64 features)\n  Test features shape  : (16, 64)  (16 subjects, 64 features)\n\n=======================================================\nDOWNSTREAM CLASSIFICATION RESULTS (Linear Koopman Space)\n=======================================================\nTest AUC-ROC : 0.4531\nTest F1-Score : 0.4286\n\nClassification Report:\n              precision    recall  f1-score   support\n\n          TD       0.50      0.62      0.56         8\n         ASD       0.50      0.38      0.43         8\n\n    accuracy                           0.50        16\n   macro avg       0.50      0.50      0.49        16\nweighted avg       0.50      0.50      0.49        16\n\n","output_type":"stream"}],"execution_count":53},{"cell_type":"code","source":"# Cell 7 — Downstream Classification Benchmark Across All Liftings\n# ──────────────────────────────────────────────────────────────────\n# For each lifting method, we:\n#   1. Extract subject-specific K_i operators from the lifted trajectories.\n#   2. Compute spectral biomarkers (sorted magnitudes + frequencies).\n#   3. Train an L2 Logistic Regression classifier on train subjects.\n#   4. Report Test AUC-ROC and F1-Score on unseen test subjects.\n\nprint(\"Running Downstream Classification Benchmark...\")\nprint(\"=\"*65)\n\nclassification_results = {}\n\nfor name, res in lifting_results.items():\n    print(f\"\\n[{name} Lifting Pipeline]\")\n    \n    lift_fn   = res['lift_fn']\n    pca       = res['pca']\n    scaler    = res['scaler']\n    needs_pca = res['needs_pca']\n    \n    # ── Step 1: Preprocess and Lift both datasets ─────────────────\n    # For training data: we need to lift it manually from raw trajectories\n    train_lifted = apply_lifting_and_pca(subject_trajectories, lift_fn, pca, scaler, needs_pca)\n    \n    # For test data: we already have `test_lifted` calculated in Cell 5, \n    # but let's re-