else:\n                multistep_loss = one_step_loss # Fallback if sequence is too short\n                \n            # Accumulate full-batch gradients across tasks\n            combined_loss = (one_step_loss + 0.5 * multistep_loss) / n_subjects\n            combined_loss.backward()\n            \n            total_1step_loss += one_step_loss.item()\n            total_multistep_loss += multistep_loss.item()\n            \n        optimizer.step()\n        \n        if epoch % 25 == 0:\n            avg_1s = total_1step_loss / n_subjects\n            avg_ms = total_multistep_loss / n_subjects\n            print(f\" {epoch:>3}/{n_epochs} | {avg_1s:>12.6f} | {avg_ms:>15.6f}\")\n            \n    return predictor\n\n# ── Run the Multi-Step Forecaster ──\nkoopman_forecaster = train_multi_step_forecaster(\n    encoder              = sup_encoder_v7,\n    train_subject_graphs = train_subject_graphs,\n    latent_dim           = ABIDE_LATENT_DIM,\n    n_epochs             = 100,\n    horizon              = 5\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-18T16:02:31.247836Z","iopub.execute_input":"2026-05-18T16:02:31.248351Z","iopub.status.idle":"2026-05-18T16:11:46.771584Z","shell.execute_reply.started":"2026-05-18T16:02:31.248322Z","shell.execute_reply":"2026-05-18T16:11:46.770651Z"}},"outputs":[{"name":"stdout","text":"=================================================================\nTraining Dedicated Forecaster over a 5-Step Prediction Horizon\n=================================================================\n\n  Epoch |   1-Step MSE |  Multi-Step MSE\n---------------------------------------------\n  25/100 |     0.006191 |        0.008099\n  50/100 |     0.004405 |        0.006078\n  75/100 |     0.003973 |        0.005525\n 100/100 |     0.003784 |        0.005362\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"# Cell 54 — Final Latent Linearity and System Validation\n#\n# Objectives:\n# 1. Analytically fit 