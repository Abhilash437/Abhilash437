nsitions(p, rho):\n        alpha = rho + (1 - rho) * p   # edge survives or gets resampled as 1\n        beta  = (1 - rho) * p         # non-edge gets resampled as 1\n        pi    = p                      # stationary probability (proved above)\n        return alpha, beta, pi\n\n    alpha_in,  beta_in,  pi_in  = transitions(p_in,  persistence)\n    alpha_out, beta_out, pi_out = transitions(p_out, persistence)\n\n    # --- Step 3: Expected TP, FP, FN per group ---\n    def expected_counts(N, pi, alpha, beta):\n        \"\"\"\n        Computes expected TP, FP, FN under the optimal oracle decision rule.\n        \n        The oracle predicts 1 only when the conditional probability exceeds 0.5.\n        This means we check alpha and beta independently against the 0.5 threshold.\n        \n        N     : number of pairs in this group\n        pi    : stationary edge probability\n        alpha : P(A_{t+1}=1 | A_t=1)\n        beta  : P(A_{t+1}=1 | A_t=0)\n        \"\"\"\n        TP, FP, FN = 0.0, 0.0, 0.0\n    \n        # Case: oracle predicts 1 when it sees an existing edge (A_t=1)\n        if alpha >= 0.5:\n            TP += N * pi * alpha          # predicted 1, actual 1\n            FP += N * pi * (1 - alpha)    # predicted 1, actual 0\n    \n        # Case: oracle predicts 1 when it sees a non-edge (A_t=0)\n        if beta >= 0.5:\n            TP += N * (1 - pi) * beta         # predicted 1, actual 1\n            FP += N * (1 - pi) * (1 - beta)  # predicted 1, actual 0\n    \n        # False negatives: actual positives the oracle predicted as 0\n        if alpha < 0.5:\n            FN += N * pi * alpha          # oracle said 0, but edge exists at t+1\n        if beta < 0.5:\n            FN += N * (1 - pi) * beta     # oracle said 0, but edge appeared at t+1\n    \n        return TP, FP, FN\n\n    TP_in,  FP_in,  FN_in  = expected_counts(N_in,  pi_in,  alpha_in,  beta_in)\n    TP_out, FP_out, FN_out = expected_counts(N_out, pi_out, alpha_out, beta_out)\n\n    # --- Step 4: Pool and compute graph-level F1 ---\n    TP = TP_in + TP_out\n    FP = FP_in + FP_out\n    FN = FN_in + FN_out\n\n    f1 = (2 * TP) / (2 * TP + FP + FN)\n\n    return {\n        \"oracle_f1\"   : round(f1, 4),\n        \"N_in\"        : N_in,\n        \"N_out\"       : N_out,\n        \"alpha_in\"    : round(alpha_in, 4),\n        \"beta_in\"     : round(beta_in, 4),\n        \"alpha_out\"   : round(alpha_out, 4),\n        \"beta_out\"    : round(beta_out, 4),\n        \"TP\"          : round(TP, 2),\n        \"FP\"          : round(FP, 2),\n        \"FN\"          : round(FN, 2),\n    }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T12:17:23.024765Z","iopub.execute_input":"2026-05-16T12:17:23.025050Z","iopub.status.idle":"2026-05-16T12:17:23.036521Z","shell.execute_reply.started":"2026-05-16T12:17:23.025023Z","shell.execute_reply":"2026-05-16T12:17:23.035901Z"}},"outputs":[],"execution_count":33},{"cell_type":"code","source":"#  ORACLE F1 LOOKUP TABLE\n# Pre-computed oracle F1 for each variant.\n# persistence=0 variants tp oracle F1 = 0 (i.i.d. edges, no temporal signal)\n# Only signal variants have meaningful ceilings.\n\nORACLE_F1 = {}\nSIGNAL_VARIANTS = ['SBM-Signal-Strong', 'SBM-Signal-Medium', 'SBM-Dynamic-Hard']\n\nfor variant_name, params in SBM_VARIANTS.items():\n    persistence = params.get('persistence', 0.0)\n    result = oracle_f1(\n        n_nodes       = params['n_nodes'],\n        n_communities = params['n_communities'],\n        p_in          = params['p_in'],\n        p_out         = params['p_out'],\n        persistence   = persistence\n    )\n\n    ORACLE_F1[variant_name] = result['oracle_f1']\n    \n    print(\n        f\"{variant_name:<22}\"\n        f\"{params['persistence']:>8.1f}\"\n        f\"{result['oracle_f1']:>10.4f}\"\n        f\"{result['alpha_in']:>9.4f}\"\n        f\"{result['beta_in']:>8.4f}\"\n        f\"{result['TP']:>8.1f}\"\n        f\"{result['FP']:>8.1f}\"\n        f\"{result['FN']:>8.1f}\"\n    )","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T12:17:23.037407Z","iopub.execute_input":"2026-05-16T12:17:23.037622Z","iopub.status.idle":"2026-05-16T12:17:23.057745Z","shell.execute_reply.started":"2026-05-16T12:17:23.037596Z","shell.execute_reply":"2026-05-16T12:17:23.057055Z"}},"outputs":[{"name":"stdout","text":"SBM-Dynamic-Hard           0.3    0.4046   0.5100  0.2100   183.6   176.4   363.9\nSBM-Signal-Strong          0.9    0.9331   0.9350  0.0350   548.7    39.4    39.4\nSBM-Signal-Medium          0.6    0.6938   0.7200  0.1200   446.5   197.0   197.0\n","output_type":"stream"}],"execution_count":34},{"cell_type":"code","source":"# COPY-PREVIOUS BASELINE\n\ndef evaluate_copy_previous(variant_name, test_seeds, eval_steps):\n    \"\"\"\n    Evaluates the copy-previous baseline on a given variant.\n\n    Strategy: predict A_{t+1} = A_t exactly.\n    This is the optimal oracle strategy when alpha >= 0.5.\n    Has zero learnable parameters.\n\n    Parameters\n    ----------\n    variant_name : str  — key in SBM_VARIANTS\n    test_seeds   : list — seed indices to evaluate on (e.g. [3, 4])\n    eval_steps   : list — prediction horizons to evaluate (e.g. [1, 5, 10, 50])\n\n    Returns\n    -------\n    List of dicts, one per (seed, step) combination.\n    \"\"\"\n    params   = SBM_VARIANTS[variant_name]\n    n_nodes  = params['n_nodes']\n    rows     = []\n\n    for seed in test_seeds:\n        # Load the raw adjacency sequence for this seed\n        # Shape: (sequence_length, n_nodes, n_nodes)\n        graphs = torch.load(\n            DATA_DIR / variant_name / f'seed_{seed}' / 'graphs.pt'\n        )  # (T, n_nodes, n_nodes)\n\n        T = len(graphs)\n\n        for step in eval_steps:\n            f1_scores = []\n\n            # For each valid starting point t, predict A_{t+step} = A_t\n            # Valid range: t from 0 to T - step - 1\n            for t in range(T - step):\n                A_current = graphs[t].numpy()       # the graph we observe\n                A_future  = graphs[t + step].numpy() # the graph we want to predict\n\n                # Copy-previous prediction: use A_current as the prediction\n                # For step=1: predict A_{t+1} = A_t\n                # For step=k: predict A_{t+k} = A_t  (no rollout, just copy)\n                pred_binary = (A_current >= 0.5).astype(int).flatten()\n                true_binary = (A_future  >= 0.5).astype(int).flatten()\n\n                f1 = f1_score(true_binary, pred_binary, zero_division=0)\n                f1_scores.append(f1)\n\n            rows.append({\n                'variant'  : variant_name,\n                'model'    : 'CopyPrev',\n                'mode'     : 'baseline',\n                'seed'     : seed,\n                'step'     : step,\n                'f1'       : np.mean(f1_scores),\n                'latent_dim': 0   # no latent space used\n            })\n\n    return rows","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-16T12:17:23.058573Z","iopub.execute_input":"2026-05-16T12:17:23.058799Z","iopub.status.idle":"2026-05-16T12:17:23.077859Z","shell.execute_reply.started":"2026-05-16T12:17:23.058773Z","shell.execute_reply":"2026-05-16T12:17:23.077101Z"}},"outputs":[],"execution_count":35},{"cell_type":"code","source":"copy_prev_rows = []\n\nfor variant_name in SIGNAL_VARIANTS:\n    print(f\"Evaluating copy-previous on {variant_name}\")\n    rows = evaluate_copy_previous(\n        variant_name = variant_name,\n        test_seeds   = TEST_SEEDS,    # [3, 4] — same held-out seeds as your models\n        eval_steps   = EVAL_STEPS     # [1, 5, 10, 15, 20, 50]\n    )\n    copy_prev_rows.extend(rows)\n    \n    # Print per-step summary for this variant\n    for row in rows:\n        print(f\"  seed={row['seed']}  step={row['step']:>2}  F1={row['f1']:.4f}\")\n\ndf_copy_prev = pd.DataFrame(copy_prev_rows)\nprint(\"\\nCopy-previous summary (mean across seeds):\")\nprint(\n    df_copy_prev.groupby(['v