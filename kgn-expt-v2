ed system ─────────────────\n    # Ridge has no direct flag in lstsq, so we augment the system.\n    # Appending sqrt(alpha)*I to Z and zeros to Z_ is mathematically\n    # equivalent to solving the ridge problem:\n    #   min ||Z' - Z K^T||^2 + alpha ||K||^2\n    #\n    # Why this works:\n    # lstsq minimizes ||[Z; sqrt(a)*I] K^T - [Z'; 0]||^2\n    #                = ||Z K^T - Z'||^2 + a||K||^2   ✓\n\n    n_latent = Z.shape[1]   # 32\n    sqrt_alpha = np.sqrt(RIDGE_ALPHA)\n\n    # Augment Z by stacking identity matrix below it\n    # np.eye(n) creates an n×n identity matrix\n    # np.vstack stacks arrays vertically (row-wise)\n    Z_aug  = np.vstack([Z,  sqrt_alpha * np.eye(n_latent)])   # (16+32, 32)\n    Z__aug = np.vstack([Z_, np.zeros((n_latent, n_latent))])  # (16+32, 32)\n\n    # Solve: find K_i.T such that Z_aug @ K_i.T ≈ Z__aug\n    # lstsq returns: solution, residuals, rank, singular values\n    # We only need the solution (index 0)\n    K_i_T, _, _, _ = lstsq(Z_aug, Z__aug, rcond=None)\n\n    K_i = K_i_T.T   # transpose back → shape (32, 32)\n\n    subject_operators.append({\n        'label': label,\n        'K':     K_i          # (32, 32) numpy array\n    })\n\n# ── Sanity check ──────────────────────────────────────────────\nn_asd = sum(1 for s in subject_operators if s['label'] == 'ASD')\nn_td  = sum(1 for s in subject_operators if s['label'] == 'TD')\nK_shape = subject_operators[0]['K'].shape\n\nprint(f\"Fitted K_i for {len(subject_operators)} subjects\")\nprint(f\"  ASD : {n_asd}  |  TD : {n_td}\")\nprint(f\"  K_i shape : {K_shape}\")\nprint(f\"  Ridge alpha : {RIDGE_ALPHA}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T06:39:02.259530Z","iopub.execute_input":"2026-05-24T06:39:02.259815Z","iopub.status.idle":"2026-05-24T06:39:02.287383Z","shell.execute_reply.started":"2026-05-24T06:39:02.259783Z","shell.execute_reply":"2026-05-24T06:39:02.286228Z"}},"outputs":[{"name":"stdout","text":"Fitted K_i for 60 subjects\n  ASD : 29  |  TD : 31\n  K_i shape : (32, 32)\n  Ridge alpha : 1.0\n","output_type":"stream"}],"execution_count":35},{"cell_type":"code","source":"# Cell 3 — Per-Subject Eigenvalue Decomposition\n# ──────────────────────────────────────────────\n# For each subject's K_i, compute all 32 eigenvalues\n# Each eigenvalue is complex: λ = Re(λ) + i·Im(λ)\n#\n# Output: asd_eigenvalues, td_eigenvalues\n#         each is a flat list of all eigenvalues across subjects\n\n# np.linalg.eigvals computes eigenvalues of a square matrix\n# For a real (32,32) matrix → returns 32 complex eigenvalues\n# Complex eigenvalues always come in conjugate pairs: a+bi and a-bi\n\nasd_eigenvalues = []   # all eigenvalues from ASD subjects pooled\ntd_eigenvalues  = []   # all eigenvalues from TD  subjects pooled\n\n# Per-subject summaries for statistical comparison\nasd_subject_stats = []   # one dict per ASD subject\ntd_subject_stats  = []   # one dict per TD  subject\n\nfor subject in subject_operators:\n\n    K_i   = subject['K']      # (32, 32) numpy array\n    label = subject['label']  # 'ASD' or 'TD'\n\n    # np.linalg.eigvals explanation:\n    # Computes the eigenvalues λ_1,...,λ_32 of K_i\n    # Returns a complex array of shape (32,)\n    # Does NOT return eigenvectors (we don't need them here)\n    evals = np.linalg.eigvals(K_i)   # shape: (32,) complex\n\n    # Eigenvalue magnitude: |λ| = sqrt(Re(λ)² + Im(λ)²)\n    # np.abs on complex numbers automatically computes magnitude\n    magnitudes = np.abs(evals)        # shape: (32,) real\n\n    # Oscillation frequency: f = angle(λ) / (2π)\n    # np.angle returns the angle θ in radians ∈ (-π, π]\n    # Dividing by 2π normalizes to (-0.5, 0.5]\n    # We take np.abs to get positive frequencies only ∈ [0, 0.5]\n    frequencies = np.abs(np.angle(evals)) / (2 * np.pi)  # shape: (32,)\n\n    # Per-subject summary statistics\n    stats = {\n        'max_magnitude'  : magnitudes.max(),\n        'mean_magnitude' : magnitudes.mean(),\n        'dominant_freq' 