      extra_labels = np.arange(remainder)\n        community_labels = np.concatenate([extra_labels, community_labels])\n    rng.shuffle(community_labels)\n\n    adjacency = np.zeros((n_nodes, n_nodes))\n    for i in range(n_nodes):\n        for j in range(i + 1, n_nodes):\n            same_community = (community_labels[i] == community_labels[j])\n            p_edge = p_in if same_community else p_out\n            if rng.rand() < p_edge:\n                adjacency[i, j] = 1\n                adjacency[j, i] = 1\n\n    return community_labels, adjacency\n\ndef add_temporal_drift(p_in_base, p_out_base, t, T_max, drift_type='none'):\n    \"\"\"Add temporal dynamics to SBM edge probabilities.\"\"\"\n    if drift_type == 'none':\n        return p_in_base, p_out_base\n    elif drift_type == 'periodic':\n        phase = 2 * np.pi * t / T_max\n        p_in_t = p_in_base + 0.3 * p_in_base * np.sin(phase)\n        p_out_t = p_out_base + 0.3 * p_out_base * np.sin(phase)\n    elif drift_type == 'linear':\n        trend = (t / T_max)\n        p_in_t = p_in_base * (1 - 0.05 * trend)\n        p_out_t = p_out_base * (1 + 0.10 * trend)\n    else:\n        raise ValueError(f'Unknown drift_type: {drift_type}')\n\n    return np.clip(p_in_t, 0, 1), np.clip(p_out_t, 0, 1)\n\ndef generate_graph_sequence(n_nodes, n_communities, p_in_base, p_out_base,\n                           sequence_length, drift_type='none',\n                           switch_prob=0.05, persistence=0.3, seed=42):\n    \"\"\"\n    Enhanced version: Adds Dynamic Communities and Edge Persistence.\n    \"\"\"\n    rng = np.random.RandomState(seed)\n\n    # Initial community assignment\n    nodes_per_community = n_nodes // n_communities\n    community_labels = np.repeat(np.arange(n_communities), nodes_per_community)\n    if n_nodes % n_communities > 0:\n        community_labels = np.concatenate([community_labels, np.arange(n_nodes % n_communities)])\n    rng.shuffle(community_labels)\n\n    adjacencies = []\n    prev_adj = np.zeros((n_nodes, n_nodes)) # Track previous state for persistence\n\n    for t in range(sequence_length):\n        # --- NEW: Dynamic Community Membership ---\n        # Nodes switch communities with a small probability\n        for i in range(n_nodes):\n            if rng.rand() < switch_prob:\n                community_labels[i] = rng.randint(0, n_communities)\n\n        p_in, p_out = add_temporal_drift(p_in_base, p_out_base, t, sequence_length, drift_type=drift_type)\n\n        adjacency = np.zeros((n_nodes, n_nodes))\n        for i in range(n_nodes):\n            for j in range(i + 1, n_nodes):\n                same_community = (community_labels[i] == community_labels[j])\n                p_base = p_in if same_community else p_out\n\n                # --- NEW: Edge Persistence ---\n                # If an edge existed at t-1, it's much more likely to exist at t\n                if prev_adj[i, j] == 1:\n                    p_final = p_base + (1 - p_base) * persistence\n                else:\n                    p_final = p_base * (1 - persistence)\n\n                # Base edge sampling\n                edge = 1 if rng.rand() < p_final else 0\n\n                # --- NEW: Noise injection ---\n                if rng.rand() < 0.02:  # 2% noise\n                    edge = 1 - edge  # flip\n\n                adjacency[i, j] = edge\n                adjacency[j, i] = edge\n\n        adjacencies.append(adjacency)\n        prev_adj = adjacency # Update history\n\n    return community_labels, adjacencies","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:00:32.168569Z","iopub.execute_input":"2026-05-24T05:00:32.169052Z","iopub.status.idle":"2026-05-24T05:00:32.185146Z","shell.execute_reply.started":"2026-05-24T05:00:32.169015Z","shell.execute_reply":"2026-05-24T05:00:32.184328Z"}},"outputs":[],"execution_count":4},{"cell_type":"code","source":"# SBM Variants\nSBM_VARIANTS = {\n    'SBM-Dynamic-Hard': {\n        'n_nodes': 100,\n        'n_communities': 4,\n        'p_in': 0.30,\n        'p_out': 0.05,\n        'drift_type': 'periodic',\n        'switch_prob': 0.25,   # High rate of nodes switching communities\n        'persistence': 0.3     # Strong temporal correlation\n    },\n    'SBM-Signal-Strong': {\n        'n_nodes': 100,\n        'n_communities': 3,\n        'p_in': 0.35,\n        'p_out': 0.01,\n        'drift_type': 'none',\n        'switch_prob': 0.02,\n        'persistence': 0.9\n    },\n\n    'SBM-Signal-Medium': {\n        'n_nodes': 100,\n        'n_communities': 3,\n        'p_in': 0.30,\n        'p_out': 0.05,\n        'drift_type': 'periodic',\n        'switch_prob': 0.10,\n        'persistence': 0.6\n    }\n}\n\nSEQUENCE_LENGTH = 100\nN_SEEDS = 5\n\nprint(f\"Generating {len(SBM_VARIANTS)} variants × {N_SEEDS} seeds = {len(SBM_VARIANTS) * N_SEEDS} sequences\\n\")\n\nfor variant_name, params in SBM_VARIANTS.items():\n    print(f\"Variant: {variant_name}\")\n    print(f\"  Nodes: {params['n_nodes']}, Communities: {params['n_communities']}\")\n    print(f\"  p_in: {params['p_in']}, p_out: {params['p_out']}, drift: {params['drift_type']}\")\n\n    variant_dir = DATA_DIR / variant_name\n    variant_dir.mkdir(parents=True, exist_ok=True)\n\n    for seed in range(N_SEEDS):\n        seed_dir = variant_dir / f'seed_{seed}'\n        seed_dir.mkdir(parents=True, exist_ok=True)\n\n        # Generate sequence\n        labels, sequences = generate_graph_sequence(\n            n_nodes=params['n_nodes'],\n            n_communities=params['n_communities'],\n            p_in_base=params['p_in'],\n            p_out_base=params['p_out'],\n            sequence_length=SEQUENCE_LENGTH,\n            drift_type=params['drift_type'],\n            seed=seed + 1000 * hash(variant_name) % 10000\n        )\n\n        # Save\n        adj_tensor = torch.from_numpy(np.array(sequences, dtype=np.float32))\n        torch.save(adj_tensor, seed_dir / 'graphs.pt')\n        np.save(seed_dir / 'community_labels.npy', labels)\n\n        edge_counts = [int(np.sum(adj) // 2) for adj in sequences]\n        meta = {\n            'variant': variant_name, 'seed': seed,\n            'n_nodes': params['n_nodes'], 'n_communities': params['n_communities'],\n            'p_in': params['p_in'], 'p_out': params['p_out'],\n            'drift_type': params['drift_type'], 'edge_counts': edge_counts\n        }\n        with open(seed_dir / 'meta.json', 'w') as f:\n            json.dump(meta, f, indent=2)\n\n        print(f\"  Seed {seed}: edges {min(edge_counts)}–{max(edge_counts)}\")\n\nprint(f\"\\nData generation complete!\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:00:32.186286Z","iopub.execute_input":"2026-05-24T05:00:32.186694Z","iopub.status.idle":"2026-05-24T05:00:49.619684Z","shell.execute_reply.started":"2026-05-24T05:00:32.186642Z","shell.execute_reply":"2026-05-24T05:00:49.618898Z"}},"outputs":[{"name":"stdout","text":"Generating 3 variants × 5 seeds = 15 sequences\n\nVariant: SBM-Dynamic-Hard\n  Nodes: 100, Communities: 4\n  p_in: 0.3, p_out: 0.05, drift: periodic\n  Seed 0: edges 461–872\n  Seed 1: edges 464–833\n  Seed 2: edges 464–875\n  Seed 3: edges 449–849\n  Seed 4: edges 476–872\nVariant: SBM-Signal-Strong\n  Nodes: 100, Communities: 3\n  p_in: 0.35, p_out: 0.01, drift: none\n  Seed 0: edges 518–766\n  Seed 1: edges 512–762\n  Seed 2: edges 492–773\n  Seed 3: edges 506–782\n  Seed 4: edges 487–777\nVariant: SBM-Signal-Medium\n  Nodes: 100, Communities: 3\n  p_in: 0.3, p_out: 0.05, drift: periodic\n  Seed 0: edges 521–975\n  Seed 1: edges 545–991\n  Seed 2: edges 512–1007\n  Seed 3: edges 492–980\n  Seed 4: edges 529–976\n\nData generation complete!\n","output_type":"stream"}],"execution_count":5},{"cell_type":"code","source":"# GNN Encoder and Decoder\nclass GraphEncoder(nn.Module):\n    \"\"\"GCN Encoder: Graph to Latent Vector\n\n    Parameters\n    ----------\n    latent_dim  : int  — size of output latent vector z\n    hidden_dim  : int  — GCN hidden dimension\n    in_channels : int  — number of input node features.\n                         Use 1 for SBM (degree only).\n                         Use 3 for JODIE (degree, norm_degree, node_type).\n    n_users     : int  — number of user nodes, used only when in_channels=3\n                         to compute the bipartite node-type indicator.\n                         Set to num_nodes // 2 if unknown.\n    \"\"\"\n\n    def __init__(self, latent_dim=32, hidden_dim=64, in_channels=1, n_users=None):\n        super().__init__()\n        self.latent_dim  = latent_dim\n        self.in_channels = in_channels\n        self.n_users     = n_users          # only used when in_channels=3\n        self.gc1 = GCNConv(in_channels, hidden_dim)\n        self.gc2 = GCNConv(hidden_dim, hidden_dim)\n        self.fc  = nn.Linear(hidden_dim, latent_dim)\n\n    def forward(self, edge_index, num_nodes, x=None):\n        if edge_index.numel() == 0:\n            return torch.zeros((1, self.latent_dim), device=edge_index.device)\n        if x is None:\n            # raw degree\n            deg  = torch.zeros(num_nodes, device=edge_index.device)\n            ones = torch.ones(edge_index.shape[1], device=edge_index.device)\n            deg.scatter_add_(0, edge_index[0], ones)   # (num_nodes,)\n\n            if self.in_channels == 1:\n                x = deg.unsqueeze(1)                   # (num_nodes, 1)\n\n            else:\n                # Normalised degree\n                # Captures relative activity within the snapshot.\n                # A node with the highest degree gets value 1.0; isolated\n                # nodes get 0.0. Varies more than raw degree across snapshots.\n                max_deg  = deg.max().clamp(min=1.0)\n                norm_deg = deg / max_deg               # (num_nodes,)\n\n                # Bipartite node-type indicator\n                # This is free structural information from the index layout.\n                # It tells the GCN which side of the bipartite graph each\n                # node belongs to, so messages are interpreted correctly.\n                n_u       = self.n_users if self.n_users is not None else num_nodes // 2\n                node_type = torch.zeros(num_nodes, device=edge_index.device)\n                node_type[n_u:] = 1.0                  # (num_nodes,)\n\n                # Stack into (num_nodes, 3)\n                x = torch.stack([deg, norm_deg, node_type], dim=1)\n\n        h = F.relu(self.gc1(x, edge_index))\n        h = F.relu(self.gc2(h, edge_index))\n\n        # Global mean pooling: average node embeddings to graph embedding\n        z = h.mean(dim=0, keepdim=True)   # (1, hidden_dim)\n        z = self.fc(z)                     # (1, latent_dim)\n        return z\n\n\nclass GraphDecoder(nn.Module):\n    \"\"\"MLP Decoder: Latent Vector to Edge Probabilities\"\"\"\n\n    def __init__(self, latent_dim=32, n_nodes=100, hidden_dim=64):\n        super().__init__()\n        self.n_nodes = n_nodes\n        self.n_edges = n_nodes * (n_nodes - 1) // 2\n\n        self.net = nn.Sequential(\n            nn.Linear(latent_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, self.n_edges)\n        )\n\n    def forward(self, z):\n        edges = self.net(z)  # (batch, n_edges)\n        return edges\n\n    def reconstruct_adjacency(self, z):\n        \"\"\"Reconstruct full adjacency matrix from latent vector.\"\"\"\n        edges = self.forward(z).squeeze(0)  # (n_edges,)\n\n        # Fill upper triangle\n        adj = torch.zeros(self.n_nodes, self.n_nodes, device=z.device)\n        triu_idx = torch.triu_indices(self.n_nodes, self.n_nodes, offset=1).to(DEVICE)\n        adj[triu_idx[0], triu_idx[1]] = edges\n        adj = adj + adj.t()\n        return adj # These are now raw logits\n\n\nprint(\"Encoder and Decoder classes defined\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-24T05:00: