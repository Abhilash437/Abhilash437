M-Signal-Medium latent_dim=32: shape (100, 32)\nSBM-Signal-Medium latent_dim=64: shape (100, 64)\nSBM-Signal-Medium latent_dim=128: shape (100, 128)\n\n All graphs encoded! Latent trajectories saved to /kaggle/working/latent\n","output_type":"stream"}],"execution_count":8},{"cell_type":"code","source":"# Transition models\n\nimport torch\nimport torch.nn as nn\n\n# Base Class\nclass BaseTransitionModel(nn.Module):\n    def reset_hidden(self, batch_size, device):\n        return None\n\n# 1. KOOPMAN (LINEAR)\nclass KoopmanLinearSingleStep(nn.Module):\n    \"\"\"z_{t+1} = K z_t\"\"\"\n    def __init__(self, latent_dim):\n        super().__init__()\n        self.K = nn.Linear(latent_dim, latent_dim, bias=False)\n\n    def forward(self, z_t):\n        return self.K(z_t)\n\n\nclass KoopmanLinearStateful(nn.Module):\n    \"\"\"\n    h_{t+1} = A h_t + B z_t\n    z_{t+1} = C h_{t+1}\n    \"\"\"\n    def __init__(self, latent_dim, hidden_dim=64):\n        super().__init__()\n        self.A = nn.Linear(hidden_dim, hidden_dim, bias=False)\n        self.B = nn.Linear(latent_dim, hidden_dim, bias=False)\n        self.C = nn.Linear(hidden_dim, latent_dim)\n\n        self.hidden_dim = hidden_dim\n\n    def forward(self, z_t, h_t=None):\n        if h_t is None:\n            h_t = torch.zeros(z_t.shape[0], self.hidden_dim, device=z_t.device)\n\n        h_next = self.A(h_t) + self.B(z_t)\n        z_next = self.C(h_next)\n\n        return z_next, h_next\n\nclass KoopmanEDMDLift(nn.Module):\n    \"\"\"EDMD with quadratic feature lift: φ(z) = [z, z²]\"\"\"\n    def __init__(self, latent_dim):\n        super().__init__()\n        phi_dim = latent_dim * 2\n        self.K = nn.Linear(phi_dim, phi_dim, bias=False)\n        self.latent_dim = latent_dim\n\n    def lift(self, z):\n        return torch.cat([z, z**2], dim=-1)\n\n    def forward(self, z):\n        return self.lift(self.K(self.lift(z)))[:, :self.latent_dim]\n\n    def spectral_loss(self):\n        evals = torch.linalg.eigvals(self.K.weight)\n        return torch.relu(torch.max(torch.abs(evals)) - 0.9) ** 2\n\n# 2. MLP TRANSITION\nclass MLPTransitionSingleStep(nn.Module):\n    \"\"\"z_{t+1} = MLP(z_t)\"\"\"\n    def __init__(self, latent_dim, hidden_dim=128):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(latent_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, latent_dim)\n        )\n\n    def forward(self, z_t):\n        return self.net(z_t)\n\n\nclass MLPTransitionStateful(nn.Module):\n    \"\"\"\n    h_{t+1} = MLP([h_t, z_t])\n    z_{t+1} = W h_{t+1}\n    \"\"\"\n    def __init__(self, latent_dim, hidden_dim=128):\n        super().__init__()\n        self.hidden_dim = hidden_dim\n\n        self.h_net = nn.Sequential(\n            nn.Linear(hidden_dim + latent_dim, hidden_dim),\n            nn.ReLU(),\n            nn.Linear(hidden_dim, hidden_dim)\n        )\n\n        self.W_out = nn.Linear(hidden_dim, latent_dim)\n\n    def forward(self, z_t, h_t=None):\n        if h_t is None:\n            h_t = torch.zeros(z_t.shape[0], self.hidden_dim, device=z_t.device)\n\n        inp = torch.cat([h_t, z_t], dim=-1)\n        h_next = self.h_net(inp)\n        z_next = self.W_out(h_next)\n\n        return z_next, h_next\n\n# 3. GRU\nclass GRUTransitionSingleStep(nn.Module):\n    \"\"\"Stateless GRU (no memory carried)\"\"\"\n    def __init__(self, latent_dim):\n        super().__init__()\n        self.gru_cell = nn.GRUCell(latent_dim, latent_dim)\n\n    def forward(self, z_t):\n        h = torch.zeros(z_t.shape[0], z_t.shape[1], device=z_t.device)\n        return self.gru_cell(z_t, h)\n\n\nclass GRUTransitionStateful(nn.Module):\n    \"\"\"Proper GRU dynamics\"\"\"\n    def __init__(self, latent_dim, hidden_dim=128):\n        super().__init__()\n        self.gru_cell = nn.GRUCell(latent_dim, hidden_dim)\n        self.W_out = nn.Linear(hidden_dim, latent_dim)\n       